@page "/admin/flow-tester"
@attribute [Authorize(Policy = Permissions.ArchitectureView)]
@inject IWebHostEnvironment Env
@inject PermissionGate Gate
<PageTitle>Kiểm thử luồng · TNM.Management</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">HỆ THỐNG / KIỂM THỬ TỰ ĐỘNG TOÀN LUỒNG</div>
        <h1>Kiểm thử toàn bộ luồng nghiệp vụ</h1>
        <p>Tự động khởi tạo cơ sở dữ liệu cô lập trong bộ nhớ tạm và chạy 14 kịch bản xuyên suốt tất cả các phân hệ. Tuyệt đối không làm thay đổi dữ liệu thật đang vận hành.</p>
    </div>
    <div class="button-group">
        <button type="button" class="btn" disabled="@running" @onclick="RunTests">
            @(running ? "Đang chạy kiểm thử..." : "▶ Chạy kiểm thử toàn bộ luồng")
        </button>
    </div>
</div>

@if (report is not null)
{
    <div class="stats-grid">
        <div class="stat">
            <small>Kết quả tổng thể</small>
            <strong class="@(report.AllPassed ? "" : "orange")">@(report.AllPassed ? "ĐẠT 100%" : "CÓ LỖI")</strong>
            <span>Thực thi trên môi trường cô lập</span>
        </div>
        <div class="stat">
            <small>Tổng số kịch bản</small>
            <strong>@report.Total</strong>
            <span>8 phân hệ nghiệp vụ</span>
        </div>
        <div class="stat">
            <small>Đạt / Thất bại</small>
            <strong>@report.Passed / @report.Failed</strong>
            <span>Kiểm tra cả ràng buộc chặn lỗi</span>
        </div>
        <div class="stat">
            <small>Thời gian thực thi</small>
            <strong>@report.TotalDurationMs ms</strong>
            <span>Tự động dọn dẹp sau khi chạy</span>
        </div>
    </div>

    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>Chi tiết các bước kiểm thử</h2>
                <p>Từng bước kiểm tra cả luồng nghiệp vụ chuẩn và các ràng buộc bảo vệ dữ liệu tự động.</p>
            </div>
        </div>
        @{ var pagedSteps = stepPager.Slice(report.Steps, out var totalSteps); }
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>PHÂN HỆ</th>
                        <th>KỊCH BẢN KIỂM THỬ</th>
                        <th>TRẠNG THÁI</th>
                        <th>KẾT QUẢ CHI TIẾT</th>
                        <th>THỜI GIAN</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (stt, step) in pagedSteps)
                    {
                        <tr>
                            <td><strong>@stt</strong></td>
                            <td>@step.Category</td>
                            <td class="wrap-cell"><strong>@VnLabels.LocalizeText(step.Name)</strong></td>
                            <td>
                                <span class="chip @(step.Passed ? "green-chip" : "orange-chip")">
                                    @(step.Passed ? "ĐẠT" : "LỖI")
                                </span>
                            </td>
                            <td class="wrap-cell">@VnLabels.LocalizeText(step.Detail)</td>
                            <td>@step.DurationMs ms</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <TablePager Pager="stepPager" TotalCount="totalSteps" OnChange="StateHasChanged" />
    </section>
}

@code {
    private FlowTestReport? report;
    private bool running;
    private readonly PagerState stepPager = new();

    protected override async Task OnInitializedAsync()
    {
        await Gate.RequireAsync(Permissions.ArchitectureView);
        await RunTests();
    }

    private async Task RunTests()
    {
        running = true;
        StateHasChanged();
        await Task.Yield();
        report = FlowTester.RunAll(Env.ContentRootPath);
        running = false;
    }
}
