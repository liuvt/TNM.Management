    private long GetAvailableInvoiceBalance(InvoiceVm inv)
    {
        var addBack = 0L;
        if (editVoucherId > 0)
        {
            var curV = vouchers.FirstOrDefault(v => v.Id == editVoucherId);
            if (curV is not null && curV.InvoiceId == inv.Id)
                addBack = curV.AmountVnd;
        }
        return Math.Max(0, inv.Balance + addBack);
    }

    private bool MatchVoucherFilter(ExpenseVoucherVm v)
    {
        if (!string.IsNullOrWhiteSpace(filterGroup) && !string.Equals(v.CategoryGroup, filterGroup, StringComparison.OrdinalIgnoreCase))
            return false;
        if (filterCategoryId > 0 && v.CategoryId != filterCategoryId)
            return false;
        if (!string.IsNullOrWhiteSpace(filterMethod) && v.Method != filterMethod)
            return false;
        if (filterLinkMode == "DEBT_LINKED" && !(v.InvoiceId is > 0))
            return false;
        if (filterLinkMode == "DIRECT" && (v.InvoiceId is > 0))
            return false;

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var q = searchText.Trim();
            var hay = $"{v.PaymentNo} {v.CategoryCode} {v.CategoryName} {v.CategoryGroup} {v.PayeeName} {v.LinkedEntityLabel} {v.InvoiceNo} {v.OrderCode} {v.ReferenceDoc} {v.Notes} {v.MethodLabel}";
            if (!hay.Contains(q, StringComparison.OrdinalIgnoreCase))
                return false;
        }
        return true;
    }

    private void OnRangeChanged((DateTime? From, DateTime? To) r)
    {
        rangeFrom = r.From;
        rangeTo = r.To;
        periodYear = 0;
        periodMonth = 0;
        voucherPager.Reset();
        summaryPager.Reset();
    }

    private void OnQuickMonthSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m) && m is >= 1 and <= 12)
        {
            var yr = periodYear > 0 ? periodYear : VnDateTimeHelper.TodayVn.Year;
            SelectPeriod(yr, m);
        }
        else
        {
            ResetPeriodFilter();
        }
    }

    private void SelectPeriod(int year, int month)
    {
        periodYear = year;
        periodMonth = month;
        rangeFrom = new DateTime(year, month, 1, 0, 0, 0);
        rangeTo = new DateTime(year, month, DateTime.DaysInMonth(year, month), 23, 59, 59);
        voucherPager.Reset();
        summaryPager.Reset();
    }

    private void SelectFullYear(int year)
    {
        periodYear = year;
        periodMonth = 0;
        rangeFrom = new DateTime(year, 1, 1, 0, 0, 0);
        rangeTo = new DateTime(year, 12, 31, 23, 59, 59);
        voucherPager.Reset();
        summaryPager.Reset();
    }

    private bool IsExactPeriodSelected(int year, int month) =>
        rangeFrom.HasValue && rangeTo.HasValue &&
        rangeFrom.Value.Year == year && rangeFrom.Value.Month == month && rangeFrom.Value.Day == 1 &&
        rangeTo.Value.Year == year && rangeTo.Value.Month == month && rangeTo.Value.Day == DateTime.DaysInMonth(year, month);

    private bool IsFullYearSelected(int year) =>
        rangeFrom.HasValue && rangeTo.HasValue &&
        rangeFrom.Value == new DateTime(year, 1, 1, 0, 0, 0) &&
        rangeTo.Value.Date == new DateTime(year, 12, 31);

    private void ResetPeriodFilter()
    {
        rangeFrom = null;
        rangeTo = null;
        periodYear = 0;
        periodMonth = 0;
        voucherPager.Reset();
        summaryPager.Reset();
    }

