    private void OpenEditVoucherModal(ExpenseVoucherVm v)
    {
        modalError = "";
        showInlineNewCat = false;
        editVoucherId = v.Id;
        editVoucherNo = v.PaymentNo;
        formDirection = v.Direction == "IN" ? "IN" : "OUT";
        inlineCatDirection = formDirection;

        var matchingCat = v.CategoryId.HasValue
            ? allCategories.FirstOrDefault(x => x.Id == v.CategoryId.Value && x.Direction == formDirection)
            : null;
        formCategoryId = matchingCat?.Id ?? (PickDefaultCategoryForDirection(formDirection)?.Id ?? 0);

        formSupplierId = v.SupplierId ?? 0;
        formEmployeeId = v.EmployeeId ?? 0;
        formSellerId = v.SellerId ?? 0;
        formCustomerId = v.CustomerId ?? 0;
        formOrderId = v.OrderId ?? 0;
        formInvoiceId = v.InvoiceId ?? 0;

        if (formCustomerId > 0) formTargetType = "CUSTOMER";
        else if (formSupplierId > 0) formTargetType = "SUPPLIER";
        else if (formEmployeeId > 0) formTargetType = "INSTALLER";
        else if (formSellerId > 0) formTargetType = "SELLER";
        else formTargetType = "FREE";

        formMethod = v.Method;
        formAmountVnd = v.AmountVnd;
        formPaidAtDt = v.TimestampDt ?? VnDateTimeHelper.NowVn;
        formPayeeName = v.PayeeName == "—" ? "" : v.PayeeName;
        formReferenceDoc = v.ReferenceDoc;
        formNotes = v.Notes;
        showVoucherModal = true;
    }

    private void CloseVoucherModal() => showVoucherModal = false;

    private void OnFormCategorySelectChanged(ChangeEventArgs e)
    {
        if (!long.TryParse(e.Value?.ToString(), out var cid)) return;
        formCategoryId = cid;
        var cat = allCategories.FirstOrDefault(x => x.Id == formCategoryId);
        if (cat is null) return;
        if (editVoucherId == 0)
        {
            formTargetType = cat.TargetEntity;
            formSupplierId = 0;
            formEmployeeId = 0;
            formSellerId = 0;
            formCustomerId = 0;
            formInvoiceId = 0;
            formNotes = !string.IsNullOrWhiteSpace(cat.DefaultNote) ? cat.DefaultNote : "";
        }
    }

    private void OnFormTargetTypeChanged()
    {
        formSupplierId = 0;
        formEmployeeId = 0;
        formSellerId = 0;
        formCustomerId = 0;
        formInvoiceId = 0;
    }

    private void OnLinkedPartnerPicked()
    {
        if (formTargetType == "SUPPLIER" && formSupplierId > 0)
            formPayeeName = suppliers.FirstOrDefault(s => s.Id == formSupplierId).Name ?? "";
        else if (formTargetType == "INSTALLER" && formEmployeeId > 0)
            formPayeeName = installers.FirstOrDefault(e => e.Id == formEmployeeId)?.Name ?? "";
        else if (formTargetType == "SELLER" && formSellerId > 0)
        {
            var sl = sellers.FirstOrDefault(s => s.Id == formSellerId);
            if (sl is not null) formPayeeName = $"{sl.Code} — {sl.Name}";
        }
        else if (formTargetType == "CUSTOMER" && formCustomerId > 0)
            formPayeeName = customers.FirstOrDefault(c => c.Id == formCustomerId)?.B2BDisplayName ?? "";

        // Chỉ tự động điền chứng từ công nợ khi đang chọn đúng 5 khoản công nợ hệ thống
        if (editVoucherId == 0 && formInvoiceId == 0)
        {
            var cat = allCategories.FirstOrDefault(x => x.Id == formCategoryId);
            if (cat?.Code is "THU_DON_LAP" or "THU_GIA_HAN" or "CHI_NCC" or "CHI_CONG_LAP" or "CHI_HOA_HONG")
            {
                var firstOpen = MatchingInvoicesForForm
                    .FirstOrDefault(i => cat.Code switch
                    {
                        "THU_DON_LAP" => i.Type == "SALE",
                        "THU_GIA_HAN" => i.Type == "RENEWAL",
                        "CHI_NCC" => i.Type is "PURCHASE" or "SUPPLIER",
                        "CHI_CONG_LAP" => i.Type == "SERVICE",
                        "CHI_HOA_HONG" => i.Type == "COMMISSION",
                        _ => false
                    });
                if (firstOpen is not null)
                {
                    formInvoiceId = firstOpen.Id;
                    OnFormInvoicePicked();
                }
            }
        }
    }

    private void OnFormInvoicePicked()
    {
        var inv = SelectedFormInvoice;
        if (inv is null) return;
        var avail = GetAvailableInvoiceBalance(inv);
        if (avail > 0) formAmountVnd = avail;
        if (string.IsNullOrWhiteSpace(formPayeeName)) formPayeeName = inv.Customer;
        formReferenceDoc = inv.Code;
        if (editVoucherId == 0)
            formNotes = $"{(formDirection == "IN" ? "Thu" : "Chi")} thanh toán chứng từ {inv.Code} ({inv.Customer})";
    }

    private void OnFormOrderPicked()
    {
        if (formOrderId > 0 && string.IsNullOrWhiteSpace(formReferenceDoc))
        {
            var ord = orderRefs.FirstOrDefault(o => o.Id == formOrderId);
            if (!string.IsNullOrWhiteSpace(ord.Code)) formReferenceDoc = ord.Code;
        }
    }

