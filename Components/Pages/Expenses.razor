@page "/expenses"
@page "/thu-chi"
@attribute [Authorize(Policy = Permissions.FinanceView)]
@inject DemoDb Db
@inject PermissionGate Gate
@inject IJSRuntime JS

<PageTitle>Quản lý Thu/Chi · TNM.Management</PageTitle>

@if (!string.IsNullOrWhiteSpace(openDropdown))
{
    <div class="tc-backdrop" @onclick='() => openDropdown = ""'></div>
}

<div class="page-head">
    <div>
        <div class="eyebrow">TÀI CHÍNH &amp; BÁO CÁO / DANH MỤC CÁC LOẠI KHOẢN THU &amp; KHOẢN CHI</div>
        <h1>Quản lý Thu/Chi — Danh mục các loại Khoản Thu &amp; Khoản Chi</h1>
        <p>
            Kế toán khai báo và quản lý các <strong>Loại Khoản Thu (+)</strong> và <strong>Loại Khoản Chi (−)</strong> tại đây để trang <strong>Công nợ &amp; Thanh toán</strong> chọn chính xác khi lập Phiếu Thu / Phiếu Chi vào Sổ quỹ.
        </p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        @if (canEdit)
        {
            <button type="button" class="btn" style="background:#16a34a;border-color:#16a34a" data-confirm="none" @onclick='() => OpenNewCategoryModal("IN")'>
                <span>↗</span> + Tạo Khoản Thu (+)
            </button>
            <button type="button" class="btn" style="background:#ea580c;border-color:#ea580c" data-confirm="none" @onclick='() => OpenNewCategoryModal("OUT")'>
                <span>↘</span> + Tạo Khoản Chi (−)
            </button>
        }
        <button type="button" class="btn secondary" data-confirm="none" @onclick="ExportCategoriesExcel">
            📥 Xuất Excel (@FilteredCategories.Count)
        </button>
        <a class="btn secondary" href="/finance?tab=PAYMENTS">↗ Sang Công nợ &amp; Thanh toán</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(message.StartsWith("Lỗi") ? "alert-danger" : "alert-ok")" style="margin-bottom:14px;padding:10px 14px;border-radius:10px;background:@(message.StartsWith("Lỗi") ? "#fef2f2" : "#f0fdf4");border:1px solid @(message.StartsWith("Lỗi") ? "#fecaca" : "#86efac");color:@(message.StartsWith("Lỗi") ? "#b91c1c" : "#166534");font-weight:600">
        @message
    </div>
}

@{
    var inCats = allCategories.Where(x => x.IsIncome).ToList();
    var outCats = allCategories.Where(x => !x.IsIncome).ToList();
    var totalMappedInCount = inCats.Sum(x => x.VoucherCount);
    var totalMappedInVnd = inCats.Sum(x => x.TotalAmountVnd);
    var totalMappedOutCount = outCats.Sum(x => x.VoucherCount);
    var totalMappedOutVnd = outCats.Sum(x => x.TotalAmountVnd);
}
<div class="stats-grid three" style="margin-bottom:16px">
    <div class="stat" style="border-left:4px solid #16a34a;cursor:pointer;@(filterDirection == "IN" ? "background:#f0fdf4;border-color:#16a34a" : "")" @onclick='() => SetDirectionFilter("IN")'>
        <small>1. Danh mục Loại Khoản Thu (+)</small>
        <strong style="color:#15803d">@inCats.Count(x => x.IsActive) khoản đang dùng</strong>
        <span>Đã map: <b>@totalMappedInCount phiếu thu</b> · Tổng thu: <b style="color:#15803d">+@Money(totalMappedInVnd)</b></span>
    </div>
    <div class="stat" style="border-left:4px solid #ea580c;cursor:pointer;@(filterDirection == "OUT" ? "background:#fff7ed;border-color:#ea580c" : "")" @onclick='() => SetDirectionFilter("OUT")'>
        <small>2. Danh mục Loại Khoản Chi (−)</small>
        <strong style="color:#c2410c">@outCats.Count(x => x.IsActive) khoản đang dùng</strong>
        <span>Đã map: <b>@totalMappedOutCount phiếu chi</b> · Tổng chi: <b style="color:#dc2626">-@Money(totalMappedOutVnd)</b></span>
    </div>
    <div class="stat" style="border-left:4px solid #0284c7;cursor:pointer;@(string.IsNullOrWhiteSpace(filterDirection) ? "" : "opacity:.92")" @onclick='() => SetDirectionFilter("")'>
        <small>3. Đối chiếu Map với Sổ quỹ</small>
        <strong style="color:#0284c7">@(totalMappedInCount + totalMappedOutCount) phiếu đã gắn khoản</strong>
        <span>Tổng danh mục: <b>@allCategories.Count loại khoản</b> (@allCategories.Count(x => !x.IsActive) đang ẩn)</span>
    </div>
</div>

@* ==================== MỘT BẢNG DUY NHẤT QUẢN LÝ LOẠI KHOẢN THU / CHI MAP VỚI PHIẾU THU / CHI ==================== *@
<section class="panel">
    <div class="panel-head" style="margin-bottom:14px">
        <div>
            <h2>Bảng Quản lý các loại Khoản Thu / Khoản Chi (Map với Phiếu Thu / Phiếu Chi)</h2>
            <p>Các khoản ở trạng thái <strong>Đang dùng</strong> sẽ hiển thị trong hộp chọn <em>Khoản Thu / Khoản Chi</em> khi lập phiếu bên <strong>Công nợ &amp; Thanh toán</strong>.</p>
        </div>
        <div style="font-size:11.8px;color:#64748b;font-weight:600">
            Hiển thị <strong style="color:#14532d">@FilteredCategories.Count</strong> / @allCategories.Count loại khoản
        </div>
    </div>

    @* THANH LỌC NGANG HIỆN ĐẠI (CUSTOM POPOVER DROPDOWNS — KHÔNG DÙNG NATIVE SELECT) *@
    <div class="tc-toolbar">
        <div class="tc-seg" role="tablist">
            <button type="button"
                    class="tc-seg-btn @(string.IsNullOrWhiteSpace(filterDirection) ? "active" : "")"
                    data-confirm="none"
                    @onclick='() => SetDirectionFilter("")'>
                <span>Tất cả</span>
                <span class="tc-seg-count">@allCategories.Count</span>
            </button>
            <button type="button"
                    class="tc-seg-btn @(filterDirection == "IN" ? "active" : "")"
                    data-confirm="none"
                    @onclick='() => SetDirectionFilter("IN")'>
                <span class="tc-dot in"></span>
                <span>Loại Khoản Thu</span>
                <span class="tc-seg-count">@inCats.Count</span>
            </button>
            <button type="button"
                    class="tc-seg-btn @(filterDirection == "OUT" ? "active is-out" : "")"
                    data-confirm="none"
                    @onclick='() => SetDirectionFilter("OUT")'>
                <span class="tc-dot out"></span>
                <span>Loại Khoản Chi</span>
                <span class="tc-seg-count">@outCats.Count</span>
            </button>
        </div>

        <div class="tc-search">
            <span class="tc-search-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
                </svg>
            </span>
            <input type="text"
                   @bind="searchText"
                   @bind:event="oninput"
                   @bind:after="() => categoryPager.Reset()"
                   placeholder="Tìm mã khoản, tên khoản thu/chi, nhóm hoặc mã phiếu PT/PC..." />
            @if (!string.IsNullOrWhiteSpace(searchText))
            {
                <button type="button" class="tc-search-clear" data-confirm="none" title="Xóa từ khóa" @onclick='() => { searchText = ""; categoryPager.Reset(); }'>✕</button>
            }
        </div>

        @* Custom Popover 1: Lọc Nhóm phân loại *@
        <div class="tc-dd" style="min-width:205px">
            <button type="button"
                    class="tc-dd-trigger @(openDropdown == "GROUP" ? "open" : "")"
                    data-confirm="none"
                    @onclick='() => ToggleDropdown("GROUP")'>
                <span class="tc-dd-trigger-left">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2b9348" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" style="flex:none">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                    </svg>
                    <span class="tc-dd-trigger-text">
                        @(string.IsNullOrWhiteSpace(filterGroup) ? "Tất cả nhóm phân loại" : filterGroup)
                    </span>
                </span>
                <span class="tc-dd-chevron">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                </span>
            </button>
            @if (openDropdown == "GROUP")
            {
                <div class="tc-dd-menu align-right" style="min-width:270px" @onclick:stopPropagation="true">
                    <div class="tc-dd-scroll">
                        <button type="button"
                                class="tc-dd-item @(string.IsNullOrWhiteSpace(filterGroup) ? "selected" : "")"
                                data-confirm="none"
                                @onclick='() => SelectGroupFilter("")'>
                            <span class="tc-dd-item-main">Tất cả nhóm phân loại</span>
                            @if (string.IsNullOrWhiteSpace(filterGroup))
                            {
                                <span class="tc-dd-check">✓</span>
                            }
                        </button>
                        @foreach (var grp in AvailableGroupsForFilter)
                        {
                            var cnt = allCategories.Count(c => (string.IsNullOrWhiteSpace(filterDirection) || c.Direction == filterDirection) && string.Equals(c.GroupName, grp, StringComparison.OrdinalIgnoreCase));
                            var isSel = string.Equals(filterGroup, grp, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="tc-dd-item @(isSel ? "selected" : "")"
                                    data-confirm="none"
                                    @onclick="() => SelectGroupFilter(grp)">
                                <span class="tc-dd-item-main">
                                    <span class="tc-dd-trigger-text">@grp</span>
                                </span>
                                <span style="display:inline-flex;align-items:center;gap:6px">
                                    <span class="tc-seg-count">@cnt</span>
                                    @if (isSel)
                                    {
                                        <span class="tc-dd-check">✓</span>
                                    }
                                </span>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @* Custom Popover 2: Lọc Trạng thái hiển thị *@
        <div class="tc-dd" style="min-width:195px">
            <button type="button"
                    class="tc-dd-trigger @(openDropdown == "STATUS" ? "open" : "")"
                    data-confirm="none"
                    @onclick='() => ToggleDropdown("STATUS")'>
                <span class="tc-dd-trigger-left">
                    <span class="tc-dot @(filterStatus == "ACTIVE" ? "in" : filterStatus == "INACTIVE" ? "out" : "muted")"></span>
                    <span class="tc-dd-trigger-text">
                        @(filterStatus == "ACTIVE" ? "Đang dùng (Hiện lập phiếu)" : filterStatus == "INACTIVE" ? "Đã ẩn (Ngừng dùng)" : "Mọi trạng thái")
                    </span>
                </span>
                <span class="tc-dd-chevron">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
                </span>
            </button>
            @if (openDropdown == "STATUS")
            {
                <div class="tc-dd-menu align-right" style="min-width:255px" @onclick:stopPropagation="true">
                    <div class="tc-dd-scroll">
                        <button type="button" class="tc-dd-item @(string.IsNullOrWhiteSpace(filterStatus) ? "selected" : "")" data-confirm="none" @onclick='() => SelectStatusFilter("")'>
                            <span class="tc-dd-item-main">
                                <span class="tc-dot muted"></span>
                                <span class="tc-dd-item-col">
                                    <span>Mọi trạng thái</span>
                                    <span class="tc-dd-item-sub">Bao gồm cả khoản đang dùng &amp; đã ẩn</span>
                                </span>
                            </span>
                            @if (string.IsNullOrWhiteSpace(filterStatus)) { <span class="tc-dd-check">✓</span> }
                        </button>
                        <button type="button" class="tc-dd-item @(filterStatus == "ACTIVE" ? "selected" : "")" data-confirm="none" @onclick='() => SelectStatusFilter("ACTIVE")'>
                            <span class="tc-dd-item-main">
                                <span class="tc-dot in"></span>
                                <span class="tc-dd-item-col">
                                    <span>Đang dùng</span>
                                    <span class="tc-dd-item-sub">Hiển thị khi lập phiếu bên Công nợ</span>
                                </span>
                            </span>
                            @if (filterStatus == "ACTIVE") { <span class="tc-dd-check">✓</span> }
                        </button>
                        <button type="button" class="tc-dd-item @(filterStatus == "INACTIVE" ? "selected" : "")" data-confirm="none" @onclick='() => SelectStatusFilter("INACTIVE")'>
                            <span class="tc-dd-item-main">
                                <span class="tc-dot out"></span>
                                <span class="tc-dd-item-col">
                                    <span>Đã ẩn / Ngừng dùng</span>
                                    <span class="tc-dd-item-sub">Ẩn khi lập phiếu mới, giữ lịch sử cũ</span>
                                </span>
                            </span>
                            @if (filterStatus == "INACTIVE") { <span class="tc-dd-check">✓</span> }
                        </button>
                    </div>
                </div>
            }
        </div>

        @if (HasActiveFilter)
        {
            <button type="button" class="btn secondary btn-sm" style="min-height:38px;border-radius:9px;padding:0 12px" data-confirm="none" @onclick="ClearFilters">
                ✕ Đặt lại
            </button>
        }
    </div>

    @{ var pagedCats = categoryPager.Slice(FilteredCategories, out var totalCats); }
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Phân loại</th>
                    <th>Mã khoản</th>
                    <th>Tên loại Khoản Thu / Khoản Chi</th>
                    <th>Nhóm phân loại</th>
                    <th>Đối tượng map dữ liệu</th>
                    <th>Phiếu Thu / Chi đã map (Sổ quỹ)</th>
                    <th>Trạng thái</th>
                    @if (canEdit)
                    {
                        <th>Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (pagedCats.Count == 0)
                {
                    <tr>
                        <td colspan="@(canEdit ? 9 : 8)" style="text-align:center;padding:32px;color:#64748b">
                            Không có loại khoản Thu/Chi nào khớp bộ lọc. Bấm <strong>“+ Tạo Khoản Thu (+)”</strong> hoặc <strong>“+ Tạo Khoản Chi (−)”</strong> để thêm mới.
                        </td>
                    </tr>
                }
                @foreach (var (stt, cat) in pagedCats)
                {
                    var mappedList = GetMappedVouchers(cat.Id);
                    <tr style="@(!cat.IsActive ? "opacity:0.62" : "")">
                        <td><strong>@stt</strong></td>
                        <td>
                            <span class="chip @(cat.IsIncome ? "green-chip" : "orange-chip")" style="gap:4px;padding:4px 9px;border-radius:6px">
                                <span>@(cat.IsIncome ? "↗" : "↘")</span>
                                <span>@cat.DirectionLabel</span>
                            </span>
                        </td>
                        <td>
                            <span class="tc-code-tag">@cat.Code</span>
                            @if (cat.IsSystem)
                            {
                                <div style="margin-top:3px"><small style="color:#0284c7;font-weight:650;font-size:10px">Mặc định HT</small></div>
                            }
                        </td>
                        <td class="wrap-cell">
                            <div style="font-size:12.4px"><strong>@cat.Name</strong></div>
                            @if (!string.IsNullOrWhiteSpace(cat.DefaultNote))
                            {
                                <small style="color:#64748b;display:block;margin-top:2px">@cat.DefaultNote</small>
                            }
                        </td>
                        <td><span class="chip" style="border-radius:6px">@cat.GroupName</span></td>
                        <td>
                            <span class="tc-entity-pill">
                                <span>@EntityIcon(cat.TargetEntity)</span>
                                <span>@cat.TargetEntityLabel</span>
                            </span>
                        </td>
                        <td class="wrap-cell">
                            @if (mappedList.Count > 0)
                            {
                                <div class="tc-map-box @(cat.IsIncome ? "has-in" : "has-out")">
                                    <strong style="color:@(cat.IsIncome ? "#15803d" : "#c2410c");font-size:12.2px">
                                        @mappedList.Count phiếu · @(cat.IsIncome ? "+" : "-")@Money(mappedList.Sum(v => v.AmountVnd))
                                    </strong>
                                    <button type="button"
                                            class="btn secondary btn-sm"
                                            style="padding:2px 8px;min-height:24px;font-size:11px;border-radius:6px"
                                            data-confirm="none"
                                            @onclick="() => OpenMappedVouchersModal(cat)">
                                        Xem phiếu →
                                    </button>
                                </div>
                                <div style="margin-top:4px">
                                    <small style="color:#64748b;font-size:10.8px">
                                        @string.Join(", ", mappedList.Take(3).Select(v => v.PaymentNo))@(mappedList.Count > 3 ? $" (+{mappedList.Count - 3})" : "")
                                    </small>
                                </div>
                            }
                            else
                            {
                                <span style="color:#94a3b8;font-size:11.5px">Chưa phát sinh phiếu</span>
                            }
                        </td>
                        <td>
                            <span class="chip @(cat.IsActive ? "green-chip" : "orange-chip")" style="gap:5px;border-radius:999px;padding:4px 9px">
                                <span class="tc-dot @(cat.IsActive ? "in" : "out")" style="box-shadow:none;width:6px;height:6px"></span>
                                <span>@(cat.IsActive ? "Đang dùng" : "Đã ẩn")</span>
                            </span>
                        </td>
                        @if (canEdit)
                        {
                            <td class="catalog-row-actions">
                                <div style="display:flex;gap:5px;flex-wrap:wrap">
                                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => OpenEditCategoryModal(cat)">
                                        Sửa
                                    </button>
                                    <button type="button"
                                            class="btn secondary btn-sm"
                                            style="color:#dc2626;border-color:#fecaca"
                                            data-confirm="delete"
                                            data-confirm-title="@($"Xác nhận Xóa / Ẩn {(cat.IsIncome ? "Khoản Thu" : "Khoản Chi")}")"
                                            data-confirm-msg="@(mappedList.Count > 0 || cat.IsSystem
                                                ? $"Khoản '{cat.Name}' ({cat.Code}) đang là khoản mặc định hoặc đã map {mappedList.Count} phiếu Sổ quỹ. Xác nhận ẩn khỏi danh sách chọn khi lập phiếu mới (giữ nguyên phiếu cũ)?"
                                                : $"Bạn có chắc chắn muốn xóa {(cat.IsIncome ? "Khoản Thu" : "Khoản Chi")} '{cat.Name}' ({cat.Code}) không?")"
                                            @onclick="() => RemoveCategory(cat.Id)">
                                        Xóa
                                    </button>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <TablePager Pager="categoryPager" TotalCount="totalCats" OnChange="StateHasChanged" />
</section>

@* ==================== DIALOG TẠO / CHỈNH SỬA LOẠI KHOẢN THU / CHI (THIẾT KẾ VISUAL CARDS HIỆN ĐẠI) ==================== *@
@if (showCategoryModal)
{
    var presetGroups = catDirection == "IN" ? IncomeCategoryGroups : ExpenseCategoryGroups;
    <div class="so-modal-overlay" @onclick="CloseCategoryModal">
        <div class="so-modal-dialog" style="max-width:720px" @onclick:stopPropagation="true">
            <div class="so-modal-header">
                <div>
                    <div class="eyebrow">QUẢN LÝ DANH MỤC KHOẢN THU / CHI</div>
                    <h2 style="margin:0.15rem 0 0 0">
                        @(editCatId > 0
                            ? $"Chỉnh sửa {(catDirection == "IN" ? "Khoản Thu" : "Khoản Chi")}: {catCode}"
                            : $"Tạo {(catDirection == "IN" ? "Loại Khoản Thu (+)" : "Loại Khoản Chi (−)")} mới")
                    </h2>
                    <p style="margin:0.2rem 0 0 0;font-size:0.84rem;color:#64748b">
                        Sau khi lưu, bên trang <strong>Công nợ &amp; Thanh toán</strong> sẽ chọn được ngay khoản @(catDirection == "IN" ? "Thu (+)" : "Chi (−)") này khi lập phiếu vào Sổ quỹ.
                    </p>
                </div>
                <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="CloseCategoryModal">✕ Đóng</button>
            </div>
            <div class="so-modal-body">
                @if (!string.IsNullOrWhiteSpace(modalError))
                {
                    <div style="margin-bottom:0.85rem;padding:0.7rem 0.95rem;border-radius:8px;background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;font-weight:600;font-size:12.5px">
                        @modalError
                    </div>
                }

                @* 1. Chọn Phân loại bằng 2 Thẻ trực quan *@
                <div class="tc-type-grid">
                    <button type="button"
                            class="tc-type-card @(catDirection == "IN" ? "active-in" : "")"
                            disabled="@catIsSystem"
                            data-confirm="none"
                            @onclick='() => SetCatModalDirection("IN")'>
                        <span class="tc-type-icon">↗</span>
                        <span class="tc-type-info">
                            <strong>Loại Khoản Thu (+)</strong>
                            <small>Hiển thị khi lập Phiếu Thu vào Sổ quỹ</small>
                        </span>
                    </button>
                    <button type="button"
                            class="tc-type-card @(catDirection == "OUT" ? "active-out" : "")"
                            disabled="@catIsSystem"
                            data-confirm="none"
                            @onclick='() => SetCatModalDirection("OUT")'>
                        <span class="tc-type-icon">↘</span>
                        <span class="tc-type-info">
                            <strong>Loại Khoản Chi (−)</strong>
                            <small>Hiển thị khi lập Phiếu Chi từ Sổ quỹ</small>
                        </span>
                    </button>
                </div>

                <div class="form-grid">
                    <label style="grid-column:span 2">Tên loại @(catDirection == "IN" ? "khoản thu" : "khoản chi") *
                        <input type="text" @bind="catName" placeholder="@(catDirection == "IN" ? "VD: Thu tiền đặt cọc / Thu bán lẻ SIM & phụ kiện..." : "VD: Chi hoa hồng CTV ngoài / Chi văn phòng phẩm...")" />
                    </label>

                    <label>Mã khoản (Để trống tự sinh @(catDirection == "IN" ? "THU_..." : "CHI_..."))
                        <input type="text" @bind="catCode" disabled="@catIsSystem" placeholder="@(catDirection == "IN" ? "VD: THU_COC_HD" : "VD: CHI_CTV_NGOAI")" />
                    </label>

                    <label>Thứ tự ưu tiên hiển thị
                        <input type="number" min="1" max="999" @bind="catSortOrder" />
                    </label>

                    @* 2. Chọn nhanh Nhóm phân loại bằng Chips 1 chạm hoặc tự gõ *@
                    <div style="grid-column:span 2;display:flex;flex-direction:column;gap:6px">
                        <span style="font-size:11.5px;color:#526058;font-weight:660">Nhóm phân loại (Bấm chọn nhanh hoặc tự nhập nhóm mới) *</span>
                        <div class="tc-group-chips">
                            @foreach (var grp in presetGroups)
                            {
                                var isGrpActive = string.Equals(catGroupName, grp, StringComparison.OrdinalIgnoreCase);
                                <button type="button"
                                        class="tc-group-chip @(isGrpActive ? "active" : "")"
                                        data-confirm="none"
                                        @onclick="() => catGroupName = grp">
                                    @grp
                                </button>
                            }
                        </div>
                        <input type="text"
                               @bind="catGroupName"
                               placeholder="@(catDirection == "IN" ? "Hoặc gõ tên nhóm khoản thu mới..." : "Hoặc gõ tên nhóm khoản chi mới...")" />
                    </div>

                    @* 3. Chọn Đối tượng dữ liệu gắn kèm bằng Thẻ Tile trực quan (thay thế native select) *@
                    <div style="grid-column:span 2;display:flex;flex-direction:column;gap:7px">
                        <span style="font-size:11.5px;color:#526058;font-weight:660">Đối tượng dữ liệu gợi ý khi lập phiếu bên Công nợ &amp; Thanh toán</span>
                        <div class="tc-target-grid">
                            @foreach (var opt in TargetEntityOptions)
                            {
                                var isEntActive = catTargetEntity == opt.Code;
                                <button type="button"
                                        class="tc-target-card @(isEntActive ? "active" : "")"
                                        data-confirm="none"
                                        @onclick="() => catTargetEntity = opt.Code">
                                    <span class="tc-target-ico">@opt.Icon</span>
                                    <span class="tc-target-txt">
                                        <strong>@opt.Title</strong>
                                        <small>@opt.Desc</small>
                                    </span>
                                </button>
                            }
                        </div>
                    </div>

                    <label style="grid-column:span 2">Nội dung diễn giải gợi ý mặc định
                        <input type="text" @bind="catDefaultNote" placeholder="Gợi ý tự điền vào ô diễn giải khi chọn khoản này bên Công nợ & Thanh toán..." />
                    </label>

                    <label class="checkbox-row" style="grid-column:span 2;padding-top:4px">
                        <input type="checkbox" @bind="catIsActive" /> Đang dùng (Hiển thị trong danh sách chọn khi lập Phiếu @(catDirection == "IN" ? "Thu" : "Chi") bên Công nợ &amp; Thanh toán)
                    </label>
                </div>
            </div>
            <div class="so-modal-footer">
                <button type="button"
                        class="btn"
                        style="@(catDirection == "IN" ? "background:#16a34a;border-color:#16a34a" : "background:#ea580c;border-color:#ea580c")"
                        data-confirm="@(editCatId > 0 ? "edit" : "add")"
                        data-confirm-title="@(editCatId > 0 ? $"Xác nhận Cập nhật {(catDirection == "IN" ? "Khoản Thu" : "Khoản Chi")}" : $"Xác nhận Thêm mới {(catDirection == "IN" ? "Khoản Thu" : "Khoản Chi")}")"
                        data-confirm-msg="@($"Bạn có chắc chắn muốn {(editCatId > 0 ? "lưu cập nhật" : "tạo mới")} {(catDirection == "IN" ? "Loại Khoản Thu (+)" : "Loại Khoản Chi (−)")} '{catName}' không?")"
                        @onclick="SaveCategoryModal">
                    💾 @(editCatId > 0
                        ? $"Lưu cập nhật {(catDirection == "IN" ? "Khoản Thu" : "Khoản Chi")}"
                        : $"+ Lưu {(catDirection == "IN" ? "Loại Khoản Thu (+)" : "Loại Khoản Chi (−)")}")
                </button>
                <button type="button" class="btn secondary" data-confirm="none" @onclick="CloseCategoryModal">Đóng</button>
            </div>
        </div>
    </div>
}

@* ==================== DIALOG XEM DANH SÁCH PHIẾU THU / CHI ĐÃ MAP VỚI KHOẢN ĐANG CHỌN ==================== *@
@if (selectedMappedCat is not null)
{
    var catVouchers = GetMappedVouchers(selectedMappedCat.Id);
    <div class="so-modal-overlay" @onclick="() => selectedMappedCat = null">
        <div class="so-modal-dialog" style="max-width:880px" @onclick:stopPropagation="true">
            <div class="so-modal-header">
                <div>
                    <div class="eyebrow">ĐỐI CHIẾU MAP PHIẾU THU / CHI SỔ QUỸ</div>
                    <h2 style="margin:0.15rem 0 0 0">
                        @selectedMappedCat.Name (@selectedMappedCat.Code) — @catVouchers.Count phiếu
                    </h2>
                    <p style="margin:0.2rem 0 0 0;font-size:0.85rem;color:#64748b">
                        Tổng phát sinh đã map:
                        <strong style="color:@(selectedMappedCat.IsIncome ? "#15803d" : "#dc2626")">
                            @(selectedMappedCat.IsIncome ? "+" : "-")@Money(catVouchers.Sum(x => x.AmountVnd))
                        </strong>
                    </p>
                </div>
                <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => selectedMappedCat = null">✕ Đóng</button>
            </div>
            <div class="so-modal-body">
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Số phiếu</th>
                                <th>Thời gian GD</th>
                                <th>Đối tác</th>
                                <th>Chứng từ công nợ</th>
                                <th>Nguồn quỹ</th>
                                <th>Số tiền</th>
                                <th>Diễn giải</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < catVouchers.Count; i++)
                            {
                                var v = catVouchers[i];
                                <tr>
                                    <td><strong>@(i + 1)</strong></td>
                                    <td><strong>@v.PaymentNo</strong></td>
                                    <td>@v.DisplayTimestamp</td>
                                    <td class="wrap-cell"><strong>@v.PayeeName</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(v.InvoiceNo) ? "Trực tiếp" : v.InvoiceNo)</td>
                                    <td><span class="chip @(v.Method == "CASH" ? "green-chip" : "blue-chip")">@v.MethodLabel</span></td>
                                    <td>
                                        <strong style="color:@(v.IsIncome ? "#15803d" : "#dc2626")">
                                            @(v.IsIncome ? "+" : "-")@Money(v.AmountVnd)
                                        </strong>
                                    </td>
                                    <td class="wrap-cell">@(string.IsNullOrWhiteSpace(v.Notes) ? "—" : v.Notes)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="so-modal-footer">
                <a class="btn" href="@($"/finance?tab=PAYMENTS&catId={selectedMappedCat.Id}")">
                    ↗ Mở trên Sổ quỹ (Công nợ &amp; Thanh toán)
                </a>
                <button type="button" class="btn secondary" data-confirm="none" @onclick="() => selectedMappedCat = null">Đóng</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly (string Code, string Icon, string Title, string Desc)[] TargetEntityOptions =
    [
        ("CUSTOMER", "👤", "Khách hàng / HTX", "Map danh sách Khách hàng & Đại lý"),
        ("SUPPLIER", "🏭", "Nhà cung cấp", "Map danh sách Nhà cung cấp"),
        ("INSTALLER", "🔧", "Kỹ thuật / Nhân sự", "Map đơn vị lắp đặt & nhân sự"),
        ("SELLER", "💼", "Nhân viên bán hàng", "Map NV bán hàng & hoa hồng"),
        ("FREE", "⚡", "Tự do / Vận hành", "Nhập tên đối tác tự do")
    ];

    private readonly PagerState categoryPager = new();

    private bool canEdit;
    private string message = "", modalError = "", openDropdown = "";
    private string filterDirection = "", filterGroup = "", searchText = "", filterStatus = "";

    private List<ExpenseCategoryVm> allCategories = [];
    private List<ExpenseVoucherVm> allVouchers = [];
    private Dictionary<long, List<ExpenseVoucherVm>> vouchersByCat = new();

    private ExpenseCategoryVm? selectedMappedCat;

    // Category Modal state
    private bool showCategoryModal, catIsSystem, catIsActive = true;
    private long editCatId = 0;
    private int catSortOrder = 25;
    private string catDirection = "OUT", catCode = "", catName = "", catGroupName = "4. Văn phòng & Quản lý", catTargetEntity = "FREE", catDefaultNote = "";

    private bool HasActiveFilter =>
        !string.IsNullOrWhiteSpace(filterDirection) ||
        !string.IsNullOrWhiteSpace(filterGroup) ||
        !string.IsNullOrWhiteSpace(searchText) ||
        !string.IsNullOrWhiteSpace(filterStatus);

    private List<string> AvailableGroupsForFilter => allCategories
        .Where(x => string.IsNullOrWhiteSpace(filterDirection) || x.Direction == filterDirection)
        .Select(x => x.GroupName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    private List<string> IncomeCategoryGroups => allCategories
        .Where(x => x.IsIncome)
        .Select(x => x.GroupName)
        .Concat(["1. Thu bán hàng & Lắp đặt", "2. Thu gia hạn & Dịch vụ", "3. Thu hoàn ứng & Đối tác", "4. Thu tài chính & Khác"])
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    private List<string> ExpenseCategoryGroups => allCategories
        .Where(x => !x.IsIncome)
        .Select(x => x.GroupName)
        .Concat(["1. Giá vốn & Nhập hàng NCC", "2. Bán hàng & Lắp đặt", "3. Nhân sự & Tiền lương", "4. Văn phòng & Quản lý", "5. Chi phí Khác"])
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    private List<ExpenseCategoryVm> FilteredCategories => allCategories
        .Where(MatchFilter)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var actor = await Gate.RequireAsync(Permissions.FinanceView);
        Db.ActorId = actor;
        canEdit = await Gate.CanAsync(Permissions.FinancePay);
        RefreshData();
    }

    private void RefreshData()
    {
        allCategories = Db.ExpenseCategories(includeInactive: true);
        allVouchers = Db.ExpenseVouchers();
        vouchersByCat = allVouchers
            .Where(v => v.CategoryId.HasValue)
            .GroupBy(v => v.CategoryId!.Value)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private List<ExpenseVoucherVm> GetMappedVouchers(long catId) =>
        vouchersByCat.TryGetValue(catId, out var list) ? list : [];

    private static string EntityIcon(string target) => target switch
    {
        "CUSTOMER" => "👤",
        "SUPPLIER" => "🏭",
        "INSTALLER" => "🔧",
        "SELLER" => "💼",
        _ => "⚡"
    };

    private bool MatchFilter(ExpenseCategoryVm c)
    {
        if (!string.IsNullOrWhiteSpace(filterDirection) && c.Direction != filterDirection)
            return false;
        if (!string.IsNullOrWhiteSpace(filterGroup) && !string.Equals(c.GroupName, filterGroup, StringComparison.OrdinalIgnoreCase))
            return false;
        if (filterStatus == "ACTIVE" && !c.IsActive)
            return false;
        if (filterStatus == "INACTIVE" && c.IsActive)
            return false;

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var q = searchText.Trim();
            var mappedNos = string.Join(" ", GetMappedVouchers(c.Id).Select(v => v.PaymentNo + " " + v.PayeeName));
            var hay = $"{c.Code} {c.Name} {c.GroupName} {c.DirectionLabel} {c.TargetEntityLabel} {c.DefaultNote} {mappedNos}";
            if (!hay.Contains(q, StringComparison.OrdinalIgnoreCase))
                return false;
        }
        return true;
    }

    private void ToggleDropdown(string name) => openDropdown = openDropdown == name ? "" : name;

    private void SetDirectionFilter(string dir)
    {
        filterDirection = dir;
        openDropdown = "";
        if (!string.IsNullOrWhiteSpace(filterGroup) && !AvailableGroupsForFilter.Contains(filterGroup, StringComparer.OrdinalIgnoreCase))
            filterGroup = "";
        categoryPager.Reset();
    }

    private void SelectGroupFilter(string grp)
    {
        filterGroup = grp;
        openDropdown = "";
        categoryPager.Reset();
    }

    private void SelectStatusFilter(string st)
    {
        filterStatus = st;
        openDropdown = "";
        categoryPager.Reset();
    }

    private void ClearFilters()
    {
        filterDirection = "";
        filterGroup = "";
        searchText = "";
        filterStatus = "";
        openDropdown = "";
        categoryPager.Reset();
    }

    private void OpenMappedVouchersModal(ExpenseCategoryVm cat)
    {
        openDropdown = "";
        selectedMappedCat = cat;
    }

    private void OpenNewCategoryModal(string dir)
    {
        var cleanDir = dir == "IN" ? "IN" : "OUT";
        openDropdown = "";
        modalError = "";
        editCatId = 0;
        catDirection = cleanDir;
        catCode = "";
        catName = "";
        catGroupName = cleanDir == "IN" ? "1. Thu bán hàng & Lắp đặt" : "4. Văn phòng & Quản lý";
        catTargetEntity = cleanDir == "IN" ? "CUSTOMER" : "FREE";
        catDefaultNote = "";
        catSortOrder = 25;
        catIsSystem = false;
        catIsActive = true;
        showCategoryModal = true;
    }

    private void SetCatModalDirection(string dir)
    {
        if (catIsSystem) return;
        var cleanDir = dir == "IN" ? "IN" : "OUT";
        if (catDirection == cleanDir) return;
        catDirection = cleanDir;
        if (editCatId == 0)
        {
            catGroupName = cleanDir == "IN" ? "1. Thu bán hàng & Lắp đặt" : "4. Văn phòng & Quản lý";
            catTargetEntity = cleanDir == "IN" ? "CUSTOMER" : "FREE";
        }
    }

    private void OpenEditCategoryModal(ExpenseCategoryVm cat)
    {
        openDropdown = "";
        modalError = "";
        editCatId = cat.Id;
        catDirection = cat.Direction;
        catCode = cat.Code;
        catName = cat.Name;
        catGroupName = cat.GroupName;
        catTargetEntity = cat.TargetEntity;
        catDefaultNote = cat.DefaultNote;
        catSortOrder = cat.SortOrder;
        catIsSystem = cat.IsSystem;
        catIsActive = cat.IsActive;
        showCategoryModal = true;
    }

    private void CloseCategoryModal() => showCategoryModal = false;

    private async Task SaveCategoryModal()
    {
        try
        {
            modalError = "";
            var actor = await Gate.RequireAsync(Permissions.FinancePay);
            Db.ActorId = actor;
            Db.SaveExpenseCategory(editCatId > 0 ? editCatId : null, catCode, catName, catGroupName, catTargetEntity, catDefaultNote, catSortOrder, catIsActive, catDirection);
            var wasEdit = editCatId > 0;
            var dirLbl = catDirection == "IN" ? "Loại Khoản Thu (+)" : "Loại Khoản Chi (−)";
            showCategoryModal = false;
            RefreshData();
            message = wasEdit
                ? $"Đã cập nhật {dirLbl} '{catName}'."
                : $"Đã tạo mới {dirLbl} '{catName}' — sang trang Công nợ & Thanh toán có thể chọn ngay khi lập phiếu!";
        }
        catch (Exception ex)
        {
            modalError = "Lỗi: " + ex.Message;
        }
    }

    private async Task RemoveCategory(long id)
    {
        try
        {
            var actor = await Gate.RequireAsync(Permissions.FinancePay);
            Db.ActorId = actor;
            var res = Db.DeleteExpenseCategory(id);
            RefreshData();
            message = res;
        }
        catch (Exception ex)
        {
            message = "Lỗi: " + ex.Message;
        }
    }

    private async Task ExportCategoriesExcel()
    {
        var list = FilteredCategories;
        var headers = new[]
        {
            "STT", "Phân loại", "Mã khoản", "Tên loại khoản Thu/Chi", "Nhóm phân loại",
            "Đối tượng map mặc định", "Diễn giải gợi ý", "Số phiếu đã map", "Tổng tiền đã map (VND)", "Trạng thái"
        };
        var rows = list.Select((c, idx) => new object?[]
        {
            idx + 1,
            c.DirectionLabel,
            c.Code,
            c.Name,
            c.GroupName,
            c.TargetEntityLabel,
            c.DefaultNote,
            c.VoucherCount,
            c.IsIncome ? c.TotalAmountVnd : -c.TotalAmountVnd,
            c.IsActive ? "Đang dùng" : "Đã ẩn"
        });
        await ExcelExporter.DownloadAsync(JS, "danh-muc-loai-khoan-thu-chi", "Khoản Thu Chi", headers, rows);
        message = $"Đã xuất file Excel (.xlsx) gồm {list.Count} loại khoản Thu/Chi.";
    }

    private static string Money(long v) => v.ToString("N0") + " ₫";
}
