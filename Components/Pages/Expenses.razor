@page "/expenses"
@page "/thu-chi"
@attribute [Authorize(Policy = Permissions.FinanceView)]
@inject DemoDb Db
@inject PermissionGate Gate
@inject IJSRuntime JS

<PageTitle>Quản lý Thu/Chi · TNM.Management</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">TÀI CHÍNH &amp; BÁO CÁO / QUẢN LÝ DANH MỤC CÁC LOẠI KHOẢN THU / CHI</div>
        <h1>Quản lý Thu/Chi — Danh mục các loại Khoản Thu &amp; Khoản Chi</h1>
        <p>
            Kế toán tạo và quản lý tập trung các <strong>Loại Khoản Thu (+)</strong> và <strong>Loại Khoản Chi (−)</strong> tại đây. Khi sang trang <strong>Công nợ &amp; Thanh toán</strong> để lập Phiếu Thu / Phiếu Chi, hệ thống tự động hiển thị đúng danh sách các khoản tương ứng để chọn và lưu, đồng thời đối chiếu số lượng &amp; tổng tiền phiếu đã map ngay trên bảng bên dưới.
        </p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        @if (canEdit)
        {
            <button type="button" class="btn" style="background:#15803d;border-color:#15803d" data-confirm="none" @onclick='() => OpenNewCategoryModal("IN")'>
                + Tạo Khoản Thu (+)
            </button>
            <button type="button" class="btn" data-confirm="none" @onclick='() => OpenNewCategoryModal("OUT")'>
                + Tạo Khoản Chi (−)
            </button>
        }
        <button type="button" class="btn secondary" data-confirm="none" @onclick="ExportCategoriesExcel">
            📥 Xuất Excel (@FilteredCategories.Count)
        </button>
        <a class="btn secondary" href="/finance?tab=PAYMENTS">↗ Sang Công nợ &amp; Thanh toán (Lập Phiếu Thu/Chi)</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(message.StartsWith("Lỗi") ? "alert-danger" : "alert-ok")" style="margin-bottom:14px;padding:10px 14px;border-radius:8px;background:@(message.StartsWith("Lỗi") ? "#fef2f2" : "#f0fdf4");border:1px solid @(message.StartsWith("Lỗi") ? "#fecaca" : "#86efac");color:@(message.StartsWith("Lỗi") ? "#b91c1c" : "#166534");font-weight:600">
        @message
    </div>
}

@{
    var inCats = allCategories.Where(x => x.IsIncome).ToList();
    var outCats = allCategories.Where(x => !x.IsIncome).ToList();
    var totalMappedInCount = inCats.Sum(x => x.VoucherCount);
    var totalMappedInVnd = inCats.Sum(x => x.TotalAmountVnd);
    var totalMappedOutCount = outCats.Sum(x => x.VoucherCount);
    var totalMappedOutVnd = outCats.Sum(x => x.TotalAmountVnd);
}
<div class="stats-grid" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-bottom:16px">
    <div class="stat" style="border-left:4px solid #15803d;cursor:pointer" @onclick='() => SetDirectionFilter("IN")'>
        <small>1. Danh mục Loại Khoản Thu (+)</small>
        <strong style="color:#15803d">@inCats.Count(x => x.IsActive) khoản đang dùng</strong>
        <span>Đã map: <b>@totalMappedInCount phiếu thu</b> · Tổng thu: <b style="color:#15803d">+@Money(totalMappedInVnd)</b></span>
    </div>
    <div class="stat" style="border-left:4px solid #dc2626;cursor:pointer" @onclick='() => SetDirectionFilter("OUT")'>
        <small>2. Danh mục Loại Khoản Chi (−)</small>
        <strong style="color:#dc2626">@outCats.Count(x => x.IsActive) khoản đang dùng</strong>
        <span>Đã map: <b>@totalMappedOutCount phiếu chi</b> · Tổng chi: <b style="color:#dc2626">-@Money(totalMappedOutVnd)</b></span>
    </div>
    <div class="stat" style="border-left:4px solid #0284c7;cursor:pointer" @onclick='() => SetDirectionFilter("")'>
        <small>3. Tổng hợp Map với Sổ quỹ (Phiếu Thu / Chi)</small>
        <strong style="color:#0284c7">@(totalMappedInCount + totalMappedOutCount) phiếu đã gắn khoản</strong>
        <span>Tổng danh mục: <b>@allCategories.Count loại khoản</b> (@allCategories.Count(x => !x.IsActive) đang ẩn)</span>
    </div>
</div>

@* ==================== MỘT BẢNG DUY NHẤT QUẢN LÝ LOẠI KHOẢN THU / CHI MAP VỚI PHIẾU THU / CHI ==================== *@
<section class="panel">
    <div class="panel-head" style="margin-bottom:12px">
        <div>
            <h2>Bảng Quản lý các loại Khoản Thu / Khoản Chi (Map với Phiếu Thu / Phiếu Chi)</h2>
            <p>Các khoản có trạng thái <strong>Đang dùng</strong> sẽ hiển thị trong ô chọn <em>Khoản Thu / Khoản Chi</em> khi lập phiếu bên <strong>Công nợ &amp; Thanh toán</strong>.</p>
        </div>
    </div>

    <div class="erp-filter-bar" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;align-items:center">
        <div class="erp-age-pills">
            <button type="button" class="erp-age-btn @(string.IsNullOrWhiteSpace(filterDirection) ? "active" : "")" data-confirm="none" @onclick='() => SetDirectionFilter("")'>
                Tất cả (@allCategories.Count)
            </button>
            <button type="button" class="erp-age-btn @(filterDirection == "IN" ? "active" : "")" data-confirm="none" @onclick='() => SetDirectionFilter("IN")'>
                🟢 Loại Khoản Thu (@inCats.Count)
            </button>
            <button type="button" class="erp-age-btn @(filterDirection == "OUT" ? "active" : "")" data-confirm="none" @onclick='() => SetDirectionFilter("OUT")'>
                🟠 Loại Khoản Chi (@outCats.Count)
            </button>
        </div>

        <input type="search"
               @bind="searchText"
               @bind:event="oninput"
               @bind:after="() => categoryPager.Reset()"
               placeholder="Tìm mã khoản, tên khoản thu/chi, nhóm, mã phiếu PT/PC..."
               style="min-width:250px;flex:1" />

        <select @bind="filterStatus" @bind:after="() => categoryPager.Reset()" style="min-width:185px">
            <option value="">— Mọi trạng thái —</option>
            <option value="ACTIVE">Đang dùng (Hiện khi lập phiếu)</option>
            <option value="INACTIVE">Ngừng dùng (Đã ẩn)</option>
        </select>

        @if (!string.IsNullOrWhiteSpace(filterDirection) || !string.IsNullOrWhiteSpace(searchText) || !string.IsNullOrWhiteSpace(filterStatus))
        {
            <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="ClearFilters">Xóa lọc</button>
        }
    </div>

    @{ var pagedCats = categoryPager.Slice(FilteredCategories, out var totalCats); }
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Phân loại</th>
                    <th>Mã khoản</th>
                    <th>Tên loại Khoản Thu / Khoản Chi</th>
                    <th>Nhóm phân loại</th>
                    <th>Đối tượng dữ liệu gắn kèm</th>
                    <th>Phiếu Thu / Chi đã map (Sổ quỹ)</th>
                    <th>Trạng thái</th>
                    @if (canEdit)
                    {
                        <th>Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (pagedCats.Count == 0)
                {
                    <tr>
                        <td colspan="@(canEdit ? 9 : 8)" style="text-align:center;padding:28px;color:#64748b">
                            Không có loại khoản Thu/Chi nào khớp bộ lọc. Bấm <strong>“+ Tạo Khoản Thu (+)”</strong> hoặc <strong>“+ Tạo Khoản Chi (−)”</strong> để thêm mới.
                        </td>
                    </tr>
                }
                @foreach (var (stt, cat) in pagedCats)
                {
                    var mappedList = GetMappedVouchers(cat.Id);
                    <tr style="@(!cat.IsActive ? "opacity:0.65" : "")">
                        <td><strong>@stt</strong></td>
                        <td>
                            <span class="chip @(cat.IsIncome ? "green-chip" : "orange-chip")">
                                @cat.DirectionLabel
                            </span>
                        </td>
                        <td>
                            <strong>@cat.Code</strong>
                            @if (cat.IsSystem)
                            {
                                <div><small style="color:#0369a1;font-weight:600">Mặc định HT</small></div>
                            }
                        </td>
                        <td class="wrap-cell">
                            <div><strong>@cat.Name</strong></div>
                            @if (!string.IsNullOrWhiteSpace(cat.DefaultNote))
                            {
                                <small style="color:#64748b">Gợi ý: @cat.DefaultNote</small>
                            }
                        </td>
                        <td><span class="chip">@cat.GroupName</span></td>
                        <td><span class="chip blue-chip">@cat.TargetEntityLabel</span></td>
                        <td class="wrap-cell">
                            @if (mappedList.Count > 0)
                            {
                                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                                    <strong style="color:@(cat.IsIncome ? "#15803d" : "#dc2626")">
                                        @mappedList.Count phiếu · @(cat.IsIncome ? "+" : "-")@Money(mappedList.Sum(v => v.AmountVnd))
                                    </strong>
                                    <button type="button"
                                            class="btn secondary btn-sm"
                                            style="padding:2px 8px;font-size:11.5px"
                                            data-confirm="none"
                                            @onclick="() => OpenMappedVouchersModal(cat)">
                                        Xem phiếu (@mappedList.Count)
                                    </button>
                                </div>
                                <div style="margin-top:3px">
                                    <small style="color:#475569">
                                        Mã phiếu: @string.Join(", ", mappedList.Take(3).Select(v => v.PaymentNo))@(mappedList.Count > 3 ? $" (+{mappedList.Count - 3})" : "")
                                    </small>
                                </div>
                            }
                            else
                            {
                                <span style="color:#94a3b8;font-size:12.5px">Chưa phát sinh phiếu</span>
                            }
                        </td>
                        <td>
                            <span class="chip @(cat.IsActive ? "green-chip" : "orange-chip")">
                                @(cat.IsActive ? "Đang dùng" : "Đã ẩn")
                            </span>
                        </td>
                        @if (canEdit)
                        {
                            <td class="catalog-row-actions">
                                <div style="display:flex;gap:5px;flex-wrap:wrap">
                                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => OpenEditCategoryModal(cat)">
                                        Sửa
                                    </button>
                                    <button type="button"
                                            class="btn secondary btn-sm"
                                            style="color:#dc2626;border-color:#fecaca"
                                            data-confirm="delete"
                                            data-confirm-title="@($"Xác nhận Xóa / Ẩn {(cat.IsIncome ? "Khoản Thu" : "Khoản Chi")}")"
                                            data-confirm-msg="@(mappedList.Count > 0 || cat.IsSystem
                                                ? $"Khoản '{cat.Name}' ({cat.Code}) đang là khoản mặc định hoặc đã map {mappedList.Count} phiếu Sổ quỹ. Xác nhận ẩn khỏi danh sách chọn khi lập phiếu mới (giữ nguyên phiếu cũ)?"
                                                : $"Bạn có chắc chắn muốn xóa {(cat.IsIncome ? "Khoản Thu" : "Khoản Chi")} '{cat.Name}' ({cat.Code}) không?")"
                                            @onclick="() => RemoveCategory(cat.Id)">
                                        Xóa
                                    </button>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <TablePager Pager="categoryPager" TotalCount="totalCats" OnChange="StateHasChanged" />
</section>

@* ==================== DATALISTS GỢI Ý NHÓM THU / NHÓM CHI ==================== *@
<datalist id="income-groups-datalist">
    @foreach (var g in IncomeCategoryGroups)
    {
        <option value="@g"></option>
    }
</datalist>
<datalist id="expense-groups-datalist">
    @foreach (var g in ExpenseCategoryGroups)
    {
        <option value="@g"></option>
    }
</datalist>

@* ==================== DIALOG TẠO / CHỈNH SỬA LOẠI KHOẢN THU / CHI ==================== *@
@if (showCategoryModal)
{
    <div class="so-modal-overlay" @onclick="CloseCategoryModal">
        <div class="so-modal-dialog" style="max-width:660px" @onclick:stopPropagation="true">
            <div class="so-modal-header">
                <div>
                    <div class="eyebrow">QUẢN LÝ DANH MỤC KHOẢN THU / CHI</div>
                    <h2 style="margin:0.15rem 0 0 0">
                        @(editCatId > 0
                            ? $"Chỉnh sửa {(catDirection == "IN" ? "Khoản Thu" : "Khoản Chi")}: {catCode}"
                            : $"Tạo {(catDirection == "IN" ? "Loại Khoản Thu (+)" : "Loại Khoản Chi (−)")} mới")
                    </h2>
                    <p style="margin:0.2rem 0 0 0;font-size:0.85rem;color:#64748b">
                        Sau khi lưu, bên trang <strong>Công nợ &amp; Thanh toán</strong> sẽ chọn được ngay khoản @(catDirection == "IN" ? "Thu (+)" : "Chi (−)") này khi lập phiếu vào Sổ quỹ.
                    </p>
                </div>
                <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="CloseCategoryModal">✕ Đóng</button>
            </div>
            <div class="so-modal-body">
                @if (!string.IsNullOrWhiteSpace(modalError))
                {
                    <div style="margin-bottom:0.85rem;padding:0.7rem 0.95rem;border-radius:8px;background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;font-weight:600;font-size:12.5px">
                        @modalError
                    </div>
                }

                <div style="display:flex;gap:8px;margin-bottom:0.9rem;padding:5px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px">
                    <button type="button"
                            disabled="@catIsSystem"
                            data-confirm="none"
                            @onclick='() => SetCatModalDirection("IN")'
                            style="flex:1;padding:8px 12px;border-radius:8px;font-weight:700;cursor:@(catIsSystem ? "not-allowed" : "pointer");border:1px solid @(catDirection == "IN" ? "#15803d" : "transparent");background:@(catDirection == "IN" ? "#15803d" : "transparent");color:@(catDirection == "IN" ? "#fff" : "#334155")">
                        🟢 LOẠI KHOẢN THU (+) — Cho Phiếu Thu
                    </button>
                    <button type="button"
                            disabled="@catIsSystem"
                            data-confirm="none"
                            @onclick='() => SetCatModalDirection("OUT")'
                            style="flex:1;padding:8px 12px;border-radius:8px;font-weight:700;cursor:@(catIsSystem ? "not-allowed" : "pointer");border:1px solid @(catDirection == "OUT" ? "#c2410c" : "transparent");background:@(catDirection == "OUT" ? "#c2410c" : "transparent");color:@(catDirection == "OUT" ? "#fff" : "#334155")">
                        🟠 LOẠI KHOẢN CHI (−) — Cho Phiếu Chi
                    </button>
                </div>

                <div class="form-grid">
                    <label style="grid-column:span 2">Tên loại @(catDirection == "IN" ? "khoản thu" : "khoản chi") *
                        <input @bind="catName" placeholder="@(catDirection == "IN" ? "VD: Thu tiền đặt cọc / Thu bán lẻ SIM & phụ kiện..." : "VD: Chi hoa hồng CTV ngoài / Chi văn phòng phẩm...")" />
                    </label>
                    <label>Mã khoản (Để trống tự sinh @(catDirection == "IN" ? "THU_..." : "CHI_..."))
                        <input @bind="catCode" disabled="@catIsSystem" placeholder="@(catDirection == "IN" ? "VD: THU_COC_HD" : "VD: CHI_CTV_NGOAI")" />
                    </label>
                    <label>Thứ tự ưu tiên hiển thị
                        <input type="number" min="1" max="999" @bind="catSortOrder" />
                    </label>
                    <label style="grid-column:span 2">Nhóm phân loại (Chọn sẵn hoặc tự gõ nhóm mới) *
                        <input list="@(catDirection == "IN" ? "income-groups-datalist" : "expense-groups-datalist")"
                               @bind="catGroupName"
                               placeholder="@(catDirection == "IN" ? "VD: 1. Thu bán hàng & Lắp đặt" : "VD: 4. Văn phòng & Quản lý")" />
                    </label>
                    <label style="grid-column:span 2">Đối tượng dữ liệu gợi ý khi lập phiếu bên Công nợ &amp; Thanh toán
                        <select @bind="catTargetEntity">
                            <option value="CUSTOMER">Khách hàng / Đại lý / HTX (Map danh sách KH)</option>
                            <option value="SUPPLIER">Nhà cung cấp (Map danh sách NCC)</option>
                            <option value="INSTALLER">Kỹ thuật / Nhân sự (Map danh sách ĐV lắp đặt)</option>
                            <option value="SELLER">Nhân viên bán hàng (Map danh sách NV bán hàng)</option>
                            <option value="FREE">Nhập tự do / Đối tác vận hành chung</option>
                        </select>
                    </label>
                    <label style="grid-column:span 2">Nội dung diễn giải gợi ý mặc định
                        <input @bind="catDefaultNote" placeholder="Gợi ý tự điền vào ô diễn giải khi chọn khoản này bên Công nợ & Thanh toán..." />
                    </label>
                    <label class="checkbox-row" style="grid-column:span 2">
                        <input type="checkbox" @bind="catIsActive" /> Đang dùng (Cho phép chọn khi lập Phiếu @(catDirection == "IN" ? "Thu" : "Chi") bên Công nợ &amp; Thanh toán)
                    </label>
                </div>
            </div>
            <div class="so-modal-footer">
                <button type="button"
                        class="btn"
                        style="@(catDirection == "IN" ? "background:#15803d;border-color:#15803d" : "")"
                        data-confirm="@(editCatId > 0 ? "edit" : "add")"
                        data-confirm-title="@(editCatId > 0 ? $"Xác nhận Cập nhật {(catDirection == "IN" ? "Khoản Thu" : "Khoản Chi")}" : $"Xác nhận Thêm mới {(catDirection == "IN" ? "Khoản Thu" : "Khoản Chi")}")"
                        data-confirm-msg="@($"Bạn có chắc chắn muốn {(editCatId > 0 ? "lưu cập nhật" : "tạo mới")} {(catDirection == "IN" ? "Loại Khoản Thu (+)" : "Loại Khoản Chi (−)")} '{catName}' không?")"
                        @onclick="SaveCategoryModal">
                    💾 @(editCatId > 0
                        ? $"Lưu cập nhật {(catDirection == "IN" ? "Khoản Thu" : "Khoản Chi")}"
                        : $"+ Lưu {(catDirection == "IN" ? "Loại Khoản Thu (+)" : "Loại Khoản Chi (−)")}")
                </button>
                <button type="button" class="btn secondary" data-confirm="none" @onclick="CloseCategoryModal">Đóng</button>
            </div>
        </div>
    </div>
}

@* ==================== DIALOG XEM DANH SÁCH PHIẾU THU / CHI ĐÃ MAP VỚI KHOẢN ĐANG CHỌN ==================== *@
@if (selectedMappedCat is not null)
{
    var catVouchers = GetMappedVouchers(selectedMappedCat.Id);
    <div class="so-modal-overlay" @onclick="() => selectedMappedCat = null">
        <div class="so-modal-dialog" style="max-width:880px" @onclick:stopPropagation="true">
            <div class="so-modal-header">
                <div>
                    <div class="eyebrow">ĐỐI CHIẾU MAP PHIẾU THU / CHI SỔ QUỸ</div>
                    <h2 style="margin:0.15rem 0 0 0">
                        @selectedMappedCat.Name (@selectedMappedCat.Code) — @catVouchers.Count phiếu
                    </h2>
                    <p style="margin:0.2rem 0 0 0;font-size:0.85rem;color:#64748b">
                        Tổng phát sinh đã map:
                        <strong style="color:@(selectedMappedCat.IsIncome ? "#15803d" : "#dc2626")">
                            @(selectedMappedCat.IsIncome ? "+" : "-")@Money(catVouchers.Sum(x => x.AmountVnd))
                        </strong>
                    </p>
                </div>
                <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => selectedMappedCat = null">✕ Đóng</button>
            </div>
            <div class="so-modal-body">
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Số phiếu</th>
                                <th>Thời gian GD</th>
                                <th>Đối tác</th>
                                <th>Chứng từ công nợ</th>
                                <th>Nguồn quỹ</th>
                                <th>Số tiền</th>
                                <th>Diễn giải</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < catVouchers.Count; i++)
                            {
                                var v = catVouchers[i];
                                <tr>
                                    <td><strong>@(i + 1)</strong></td>
                                    <td><strong>@v.PaymentNo</strong></td>
                                    <td>@v.DisplayTimestamp</td>
                                    <td class="wrap-cell"><strong>@v.PayeeName</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(v.InvoiceNo) ? "Trực tiếp" : v.InvoiceNo)</td>
                                    <td><span class="chip @(v.Method == "CASH" ? "green-chip" : "blue-chip")">@v.MethodLabel</span></td>
                                    <td>
                                        <strong style="color:@(v.IsIncome ? "#15803d" : "#dc2626")">
                                            @(v.IsIncome ? "+" : "-")@Money(v.AmountVnd)
                                        </strong>
                                    </td>
                                    <td class="wrap-cell">@(string.IsNullOrWhiteSpace(v.Notes) ? "—" : v.Notes)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="so-modal-footer">
                <a class="btn" href="@($"/finance?tab=PAYMENTS&catId={selectedMappedCat.Id}")">
                    ↗ Xem &amp; Thao tác trên Sổ quỹ (Công nợ &amp; Thanh toán)
                </a>
                <button type="button" class="btn secondary" data-confirm="none" @onclick="() => selectedMappedCat = null">Đóng</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly PagerState categoryPager = new();

    private bool canEdit;
    private string message = "", modalError = "";
    private string filterDirection = "", searchText = "", filterStatus = "";

    private List<ExpenseCategoryVm> allCategories = [];
    private List<ExpenseVoucherVm> allVouchers = [];
    private Dictionary<long, List<ExpenseVoucherVm>> vouchersByCat = new();

    private ExpenseCategoryVm? selectedMappedCat;

    // Category Modal state
    private bool showCategoryModal, catIsSystem, catIsActive = true;
    private long editCatId = 0;
    private int catSortOrder = 25;
    private string catDirection = "OUT", catCode = "", catName = "", catGroupName = "4. Văn phòng & Quản lý", catTargetEntity = "FREE", catDefaultNote = "";

    private List<string> IncomeCategoryGroups => allCategories
        .Where(x => x.IsIncome)
        .Select(x => x.GroupName)
        .Concat(["1. Thu bán hàng & Lắp đặt", "2. Thu gia hạn & Dịch vụ", "3. Thu hoàn ứng & Đối tác", "4. Thu tài chính & Khác"])
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    private List<string> ExpenseCategoryGroups => allCategories
        .Where(x => !x.IsIncome)
        .Select(x => x.GroupName)
        .Concat(["1. Giá vốn & Nhập hàng NCC", "2. Bán hàng & Lắp đặt", "3. Nhân sự & Tiền lương", "4. Văn phòng & Quản lý", "5. Chi phí Khác"])
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    private List<ExpenseCategoryVm> FilteredCategories => allCategories
        .Where(MatchFilter)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var actor = await Gate.RequireAsync(Permissions.FinanceView);
        Db.ActorId = actor;
        canEdit = await Gate.CanAsync(Permissions.FinancePay);
        RefreshData();
    }

    private void RefreshData()
    {
        allCategories = Db.ExpenseCategories(includeInactive: true);
        allVouchers = Db.ExpenseVouchers();
        vouchersByCat = allVouchers
            .Where(v => v.CategoryId.HasValue)
            .GroupBy(v => v.CategoryId!.Value)
            .ToDictionary(g => g.Key, g => g.ToList());
    }

    private List<ExpenseVoucherVm> GetMappedVouchers(long catId) =>
        vouchersByCat.TryGetValue(catId, out var list) ? list : [];

    private bool MatchFilter(ExpenseCategoryVm c)
    {
        if (!string.IsNullOrWhiteSpace(filterDirection) && c.Direction != filterDirection)
            return false;
        if (filterStatus == "ACTIVE" && !c.IsActive)
            return false;
        if (filterStatus == "INACTIVE" && c.IsActive)
            return false;

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var q = searchText.Trim();
            var mappedNos = string.Join(" ", GetMappedVouchers(c.Id).Select(v => v.PaymentNo + " " + v.PayeeName));
            var hay = $"{c.Code} {c.Name} {c.GroupName} {c.DirectionLabel} {c.TargetEntityLabel} {c.DefaultNote} {mappedNos}";
            if (!hay.Contains(q, StringComparison.OrdinalIgnoreCase))
                return false;
        }
        return true;
    }

    private void SetDirectionFilter(string dir)
    {
        filterDirection = dir;
        categoryPager.Reset();
    }

    private void ClearFilters()
    {
        filterDirection = "";
        searchText = "";
        filterStatus = "";
        categoryPager.Reset();
    }

    private void OpenMappedVouchersModal(ExpenseCategoryVm cat)
    {
        selectedMappedCat = cat;
    }

    private void OpenNewCategoryModal(string dir)
    {
        var cleanDir = dir == "IN" ? "IN" : "OUT";
        modalError = "";
        editCatId = 0;
        catDirection = cleanDir;
        catCode = "";
        catName = "";
        catGroupName = cleanDir == "IN" ? "1. Thu bán hàng & Lắp đặt" : "4. Văn phòng & Quản lý";
        catTargetEntity = cleanDir == "IN" ? "CUSTOMER" : "FREE";
        catDefaultNote = "";
        catSortOrder = 25;
        catIsSystem = false;
        catIsActive = true;
        showCategoryModal = true;
    }

    private void SetCatModalDirection(string dir)
    {
        if (catIsSystem) return;
        var cleanDir = dir == "IN" ? "IN" : "OUT";
        if (catDirection == cleanDir) return;
        catDirection = cleanDir;
        if (editCatId == 0)
        {
            catGroupName = cleanDir == "IN" ? "1. Thu bán hàng & Lắp đặt" : "4. Văn phòng & Quản lý";
            catTargetEntity = cleanDir == "IN" ? "CUSTOMER" : "FREE";
        }
    }

    private void OpenEditCategoryModal(ExpenseCategoryVm cat)
    {
        modalError = "";
        editCatId = cat.Id;
        catDirection = cat.Direction;
        catCode = cat.Code;
        catName = cat.Name;
        catGroupName = cat.GroupName;
        catTargetEntity = cat.TargetEntity;
        catDefaultNote = cat.DefaultNote;
        catSortOrder = cat.SortOrder;
        catIsSystem = cat.IsSystem;
        catIsActive = cat.IsActive;
        showCategoryModal = true;
    }

    private void CloseCategoryModal() => showCategoryModal = false;

    private async Task SaveCategoryModal()
    {
        try
        {
            modalError = "";
            var actor = await Gate.RequireAsync(Permissions.FinancePay);
            Db.ActorId = actor;
            Db.SaveExpenseCategory(editCatId > 0 ? editCatId : null, catCode, catName, catGroupName, catTargetEntity, catDefaultNote, catSortOrder, catIsActive, catDirection);
            var wasEdit = editCatId > 0;
            var dirLbl = catDirection == "IN" ? "Loại Khoản Thu (+)" : "Loại Khoản Chi (−)";
            showCategoryModal = false;
            RefreshData();
            message = wasEdit
                ? $"Đã cập nhật {dirLbl} '{catName}'."
                : $"Đã tạo mới {dirLbl} '{catName}' — sang trang Công nợ & Thanh toán có thể chọn ngay khi lập phiếu!";
        }
        catch (Exception ex)
        {
            modalError = "Lỗi: " + ex.Message;
        }
    }

    private async Task RemoveCategory(long id)
    {
        try
        {
            var actor = await Gate.RequireAsync(Permissions.FinancePay);
            Db.ActorId = actor;
            var res = Db.DeleteExpenseCategory(id);
            RefreshData();
            message = res;
        }
        catch (Exception ex)
        {
            message = "Lỗi: " + ex.Message;
        }
    }

    private async Task ExportCategoriesExcel()
    {
        var list = FilteredCategories;
        var headers = new[]
        {
            "STT", "Phân loại", "Mã khoản", "Tên loại khoản Thu/Chi", "Nhóm phân loại",
            "Đối tượng map mặc định", "Diễn giải gợi ý", "Số phiếu đã map", "Tổng tiền đã map (VND)", "Trạng thái"
        };
        var rows = list.Select((c, idx) => new object?[]
        {
            idx + 1,
            c.DirectionLabel,
            c.Code,
            c.Name,
            c.GroupName,
            c.TargetEntityLabel,
            c.DefaultNote,
            c.VoucherCount,
            c.IsIncome ? c.TotalAmountVnd : -c.TotalAmountVnd,
            c.IsActive ? "Đang dùng" : "Đã ẩn"
        });
        await ExcelExporter.DownloadAsync(JS, "danh-muc-loai-khoan-thu-chi", "Khoản Thu Chi", headers, rows);
        message = $"Đã xuất file Excel (.xlsx) gồm {list.Count} loại khoản Thu/Chi.";
    }

    private static string Money(long v) => v.ToString("N0") + " ₫";
}
