    private async Task SaveVoucher()
    {
        try
        {
            modalError = "";
            var actor = await Gate.RequireAsync(Permissions.FinancePay);
            Db.ActorId = actor;
            var paidStr = formPaidAtDt.ToString("yyyy-MM-dd HH:mm:ss");
            var savedId = Db.SaveExpenseVoucher(
                editVoucherId > 0 ? editVoucherId : null,
                formCategoryId,
                formMethod,
                formAmountVnd,
                paidStr,
                formPayeeName,
                formTargetType == "SUPPLIER" && formSupplierId > 0 ? formSupplierId : null,
                formTargetType == "CUSTOMER" && formCustomerId > 0 ? formCustomerId : null,
                formTargetType == "SELLER" && formSellerId > 0 ? formSellerId : null,
                formTargetType == "INSTALLER" && formEmployeeId > 0 ? formEmployeeId : null,
                formOrderId > 0 ? formOrderId : null,
                formInvoiceId > 0 ? formInvoiceId : null,
                formReferenceDoc,
                formNotes,
                formDirection);

            var wasEdit = editVoucherId > 0;
            var dirLabel = formDirection == "IN" ? "Phiếu Thu" : "Phiếu Chi";
            showVoucherModal = false;
            RefreshData();
            var savedRow = vouchers.FirstOrDefault(x => x.Id == savedId);
            message = wasEdit
                ? $"Đã cập nhật {dirLabel} {savedRow?.PaymentNo} [{savedRow?.CategoryName}] ({Money(formAmountVnd)}) và đồng bộ Sổ quỹ / Công nợ."
                : $"Đã lập {dirLabel} {savedRow?.PaymentNo} [{savedRow?.CategoryName}] ({Money(formAmountVnd)}) vào {(formMethod == "CASH" ? "Quỹ Tiền mặt" : "Quỹ Ngân hàng")}!";
        }
        catch (Exception ex)
        {
            modalError = "Lỗi: " + ex.Message;
        }
    }

