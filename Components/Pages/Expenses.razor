    private async Task ExportExpensesExcel()
    {
        var list = FilteredVouchers;
        var headers = new[]
        {
            "STT", "Mã phiếu chi", "Ngày giờ chi", "Nhóm chi phí", "Mã loại chi", "Tên loại khoản chi",
            "Người nhận / Đơn vị thụ hưởng", "Đối tượng liên kết", "Chứng từ công nợ", "Đơn hàng tham chiếu",
            "Số chứng từ gốc", "Nguồn quỹ", "Số tiền chi (VND)", "Diễn giải chi tiết", "Trạng thái", "Người lập"
        };
        var rows = list.Select((v, idx) => new object?[]
        {
            idx + 1,
            v.PaymentNo,
            v.DisplayTimestamp,
            v.CategoryGroup,
            v.CategoryCode,
            v.CategoryName,
            v.PayeeName,
            v.LinkedEntityLabel,
            v.InvoiceNo,
            v.OrderCode,
            v.ReferenceDoc,
            v.MethodLabel,
            v.AmountVnd,
            v.Notes,
            v.IsLocked ? "Đã chốt số" : "Đã ghi quỹ",
            v.CreatedByName
        });
        await ExcelExporter.DownloadAsync(JS, "so-quan-ly-khoan-chi", "Khoản chi", headers, rows);
        message = $"Đã xuất file Excel (.xlsx) gồm {list.Count} phiếu khoản chi.";
    }

    private static string PayableTypeLabel(string type) => type switch
    {
        "PURCHASE" or "SUPPLIER" => "Công nợ NCC",
        "SERVICE" => "Công lắp KT",
        "COMMISSION" => "Hoa hồng NVBH",
        _ => type
    };

    private static string Money(long v) => v.ToString("N0") + " ₫";
