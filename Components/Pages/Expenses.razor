    private async Task ExportVouchersExcel()
    {
        var list = FilteredVouchers;
        var headers = new[]
        {
            "STT", "Mã phiếu", "Loại phiếu", "Ngày giờ GD", "Nhóm khoản", "Mã khoản", "Tên khoản Thu/Chi",
            "Đối tác (Người nộp / Người nhận)", "Đối tượng liên kết", "Chứng từ công nợ", "Đơn hàng tham chiếu",
            "Số chứng từ gốc", "Nguồn quỹ", "Thu (+) (VND)", "Chi (-) (VND)", "Diễn giải chi tiết", "Trạng thái", "Người lập"
        };
        var rows = list.Select((v, idx) => new object?[]
        {
            idx + 1,
            v.PaymentNo,
            v.IsIncome ? "Phiếu Thu (+)" : "Phiếu Chi (-)",
            v.DisplayTimestamp,
            v.CategoryGroup,
            v.CategoryCode,
            v.CategoryName,
            v.PayeeName,
            v.LinkedEntityLabel,
            v.InvoiceNo,
            v.OrderCode,
            v.ReferenceDoc,
            v.MethodLabel,
            v.IsIncome ? v.AmountVnd : 0L,
            !v.IsIncome ? v.AmountVnd : 0L,
            v.Notes,
            v.IsLocked ? "Đã chốt số" : "Đã ghi quỹ",
            v.CreatedByName
        });
        await ExcelExporter.DownloadAsync(JS, "so-quan-ly-thu-chi", "Thu Chi", headers, rows);
        message = $"Đã xuất file Excel (.xlsx) gồm {list.Count} phiếu Thu/Chi.";
    }

    private static string InvoiceShortTypeLabel(string type) => type switch
    {
        "SALE" => "KH Đơn lắp",
        "RENEWAL" => "KH Gia hạn",
        "PURCHASE" or "SUPPLIER" => "Công nợ NCC",
        "SERVICE" => "Công lắp KT",
        "COMMISSION" => "Hoa hồng NVBH",
        _ => type
    };

