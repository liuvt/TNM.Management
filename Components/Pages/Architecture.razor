@attribute [Authorize]
@page "/architecture"
@using System.Security.Claims
@inject AuthRepository Accounts
@inject AuthenticationStateProvider AuthStateProvider
<PageTitle>Mô hình hệ thống &amp; Hướng dẫn sử dụng · TNM.Management</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">SYSTEM ARCHITECTURE / ROLE-BASED USER GUIDE</div>
        <h1>Mô hình hệ thống &amp; Hướng dẫn sử dụng</h1>
        <p>Hiển thị cá nhân hóa các hạng mục chức năng, quy trình và hướng dẫn sử dụng <strong>tương ứng với phân quyền của tài khoản</strong>. Hãy bấm vào từng mục bên dưới để mở hộp thoại (Dialog) xem hướng dẫn chi tiết.</p>
    </div>
</div>

<section class="panel" style="background:linear-gradient(180deg,#f4fcf6 0%,#ffffff 100%);border:1px solid #b2f2bb">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px">
        <div style="display:flex;align-items:center;gap:12px;min-width:0">
            <div style="width:42px;height:42px;border-radius:11px;background:#ebfbee;border:1px solid #8ce99a;color:#1b653e;display:grid;place-items:center;font-weight:800;font-size:15px;flex:none">
                #@targetUserId
            </div>
            <div style="min-width:0">
                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                    <strong style="font-size:14px;color:#1f2924">@targetUsername: ID #@targetUserId — @targetDisplayName</strong>
                    @if (!string.IsNullOrWhiteSpace(targetRolesLabel))
                    {
                        <span class="chip green-chip">Vai trò: @targetRolesLabel</span>
                    }
                </div>
                <div style="font-size:12px;color:#4e5c54;margin-top:3px">
                    Đang mở khóa <strong>@VisibleMenuItemCount / @TotalMenuItemCount hạng mục chức năng</strong>
                    · <strong>@effectivePermissions.Count quyền nghiệp vụ</strong> được phép truy cập và xem hướng dẫn sử dụng.
                </div>
            </div>
        </div>

        @if (canPreviewOtherUsers && allUsers.Count > 0)
        {
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;background:#fff;padding:8px 12px;border:1px solid #dce5df;border-radius:10px">
                <span style="font-size:11.5px;font-weight:700;color:#2b593f">Xem theo phân quyền tài khoản:</span>
                <select value="@targetUserId" @onchange="OnTargetUserChanged" style="min-height:34px;padding:5px 10px;border:1px solid #b2f2bb;border-radius:7px;font-size:12px;font-weight:650;color:#1f2924;background:#fff">
                    @foreach (var u in allUsers)
                    {
                        <option value="@u.Id">@u.Username : ID #@u.Id — @u.DisplayName (@GetUserRolesDisplay(u))</option>
                    }
                </select>
            </div>
        }
    </div>
</section>

<section class="panel">
    <div class="panel-head">
        <div>
            <h2>1. Các hạng mục chức năng được cấp quyền (@VisibleMenuItemCount mục — Bấm vào từng mục để mở Dialog Hướng dẫn)</h2>
            <p>Chỉ hiển thị những phân hệ và màn hình mà tài khoản <strong>@targetUsername (#@targetUserId)</strong> có quyền truy cập và thao tác.</p>
        </div>
    </div>

    @if (VisibleMenuGroups.Count == 0)
    {
        <p class="panel-note">Tài khoản hiện tại chưa được cấp quyền truy cập hạng mục nghiệp vụ nào. Vui lòng liên hệ Quản trị viên để phân quyền.</p>
    }
    else
    {
        @foreach (var grp in VisibleMenuGroups)
        {
            <div style="margin-bottom:1.15rem">
                <div style="font-size:11px;font-weight:780;letter-spacing:.7px;color:#1e6b43;text-transform:uppercase;margin:0 0 8px;display:flex;align-items:center;gap:8px">
                    <span>▣ @grp.GroupTitle (@grp.Items.Count mục được phép)</span>
                    <span style="flex:1;height:1px;background:#e2ece5"></span>
                </div>
                <div class="stats-grid" style="margin-bottom:0">
                    @foreach (var item in grp.Items)
                    {
                        var grantedCount = CountGrantedDetailPermissions(item);
                        <div class="panel catalog-shortcut"
                             style="margin-bottom:0;padding:15px 16px;cursor:pointer;display:flex;flex-direction:column;justify-content:space-between;gap:10px;border:1px solid #e5ece8"
                             @onclick="() => OpenGuide(item.Key)">
                            <div>
                                <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:6px;flex-wrap:wrap">
                                    <span class="chip blue-chip" style="font-size:10px">@item.RouteLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(item.TabBadge))
                                    {
                                        <span class="chip green-chip" style="font-size:10px">@item.TabBadge</span>
                                    }
                                </div>
                                <h3 style="margin:0 0 5px;font-size:14px;font-weight:740;color:#1f2924">@item.Title</h3>
                                <p style="margin:0;font-size:11.6px;color:#58665e;line-height:1.5">@item.Summary</p>
                            </div>
                            <div style="display:flex;align-items:center;justify-content:space-between;padding-top:8px;border-top:1px dashed #e5ece8;gap:6px;flex-wrap:wrap">
                                <small style="color:#1b653e;font-weight:700">✓ Đã cấp @grantedCount quyền thao tác</small>
                                <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick:stopPropagation="true" @onclick="() => OpenGuide(item.Key)">
                                    📖 Hướng dẫn sử dụng
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</section>

<div class="two-column" style="margin-bottom:18px">
    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>2. Phân hệ nghiệp vụ tương ứng quyền hạn (@VisibleCoreModules.Count phân hệ)</h2>
                <p>Bấm vào từng phân hệ để xem quy trình vận hành chuẩn theo quyền được cấp.</p>
            </div>
        </div>
        <div class="step-list">
            @foreach (var mod in VisibleCoreModules)
            {
                <div style="padding:10px 12px;border:1px solid #e5ece8;border-radius:10px;cursor:pointer;transition:background .15s,border-color .15s;justify-content:space-between"
                     @onclick="() => OpenGuide(mod.Key)">
                    <div style="display:flex;align-items:center;gap:12px;min-width:0">
                        <b>@mod.Code</b>
                        <span style="min-width:0">
                            <strong style="color:#1f2924">@mod.Title</strong>
                            <small style="line-height:1.45">@mod.Summary</small>
                        </span>
                    </div>
                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick:stopPropagation="true" @onclick="() => OpenGuide(mod.Key)">
                        Hướng dẫn
                    </button>
                </div>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>3. Quy tắc toàn vẹn dữ liệu &amp; Kiểm soát nghiệp vụ (@VisibleIntegrityRules.Count quy tắc)</h2>
                <p>Bấm vào từng quy tắc để xem cơ chế kiểm soát tự động liên quan đến nghiệp vụ của bạn.</p>
            </div>
        </div>
        <div class="step-list">
            @foreach (var rule in VisibleIntegrityRules)
            {
                <div style="padding:10px 12px;border:1px solid #e5ece8;border-radius:10px;cursor:pointer;justify-content:space-between"
                     @onclick="() => OpenGuide(rule.Key)">
                    <div style="display:flex;align-items:center;gap:12px;min-width:0">
                        <b style="background:#ebfbee;color:#1b653e">@rule.Code</b>
                        <span style="min-width:0">
                            <strong style="color:#1f2924">@rule.Title</strong>
                            <small style="line-height:1.45">@rule.Summary</small>
                        </span>
                    </div>
                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick:stopPropagation="true" @onclick="() => OpenGuide(rule.Key)">
                        Chi tiết
                    </button>
                </div>
            }
        </div>
    </section>
</div>

@if (VisibleWorkflowStages.Count > 0)
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>4. Luồng đi dữ liệu theo phân quyền (@VisibleWorkflowStages.Count giai đoạn)</h2>
                <p>Các bước quy trình nghiệp vụ mà tài khoản <strong>@targetUsername (#@targetUserId)</strong> tham gia xử lý. Bấm vào từng dòng để xem hướng dẫn.</p>
            </div>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Giai đoạn</th>
                        <th>Điểm đầu vào (UI / Tác nhân)</th>
                        <th>Xử lý nghiệp vụ &amp; Dịch vụ C#</th>
                        <th>Bảng dữ liệu SQLite cập nhật</th>
                        <th>Kết quả đầu ra / Kế toán</th>
                        <th>Hướng dẫn</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var wf in VisibleWorkflowStages)
                    {
                        <tr style="cursor:pointer" @onclick="() => OpenGuide(wf.Key)">
                            <td><strong>@wf.Stt</strong></td>
                            <td><strong>@wf.Stage</strong></td>
                            <td class="wrap-cell">@wf.EntryPoint</td>
                            <td class="wrap-cell"><code>@wf.ServiceInfo</code></td>
                            <td class="wrap-cell"><code>@wf.Tables</code></td>
                            <td class="wrap-cell"><strong>@wf.Output</strong></td>
                            <td class="catalog-row-actions">
                                <button type="button" class="btn btn-sm" data-confirm="none" @onclick:stopPropagation="true" @onclick="() => OpenGuide(wf.Key)">
                                    📖 Xem hướng dẫn
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (selectedGuide is not null)
{
    var grantedPerms = GetGrantedPermissionDefs(selectedGuide);
    var ungrantedPerms = GetUngrantedPermissionDefs(selectedGuide);
    var resolvedHref = ResolvePrimaryHref(selectedGuide);

    <div class="so-modal-overlay" @onclick="CloseGuide">
        <div class="so-modal-dialog" style="max-width:880px" @onclick:stopPropagation="true">
            <div class="so-modal-header">
                <div>
                    <h2>
                        <span>📖 @selectedGuide.Title</span>
                        <span class="chip green-chip">@selectedGuide.Category</span>
                        @if (!string.IsNullOrWhiteSpace(selectedGuide.TabBadge))
                        {
                            <span class="chip blue-chip">@selectedGuide.TabBadge</span>
                        }
                    </h2>
                    <p>
                        <strong>Đường dẫn:</strong> <code>@selectedGuide.RouteLabel</code>
                        · <strong>Tài khoản đang xem:</strong> <code>@targetUsername (#@targetUserId — @targetDisplayName)</code>
                    </p>
                </div>
                <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="CloseGuide">✕ Đóng</button>
            </div>

            <div class="so-modal-body" style="display:flex;flex-direction:column;gap:14px">
                @if (grantedPerms.Count > 0 || ungrantedPerms.Count > 0)
                {
                    <div style="padding:12px 14px;background:#f4fcf6;border:1px solid #b2f2bb;border-radius:10px">
                        <strong style="color:#1b653e;display:block;margin-bottom:8px">
                            🔑 Quyền hạn của tài khoản @targetUsername (#@targetUserId) trên hạng mục này (@grantedPerms.Count quyền được cấp):
                        </strong>
                        <div style="display:flex;flex-wrap:wrap;gap:6px">
                            @foreach (var p in grantedPerms)
                            {
                                <span class="chip green-chip" title="@p.Key">✓ @p.Label</span>
                            }
                            @foreach (var p in ungrantedPerms)
                            {
                                <span class="chip" style="opacity:0.65" title="Chưa cấp quyền: @p.Key">🔒 @p.Label (Chưa cấp)</span>
                            }
                        </div>
                    </div>
                }

                <div style="padding:12px 14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;line-height:1.6;color:#334155">
                    <strong style="color:#0f172a;display:block;margin-bottom:4px">🎯 Mục đích &amp; Chức năng chính:</strong>
                    @selectedGuide.Purpose
                </div>

                @if (selectedGuide.Tabs.Count > 0)
                {
                    <div style="padding:12px 14px;background:#fff;border:1px solid #dce5df;border-radius:10px">
                        <strong style="color:#1b653e;display:block;margin-bottom:8px">🗂 Cấu trúc các Tab / Khu vực trong mục này:</strong>
                        <div style="display:grid;gap:8px">
                            @foreach (var tab in selectedGuide.Tabs)
                            {
                                <div style="padding:8px 10px;background:#f8faf9;border:1px solid #e2ebe5;border-radius:8px;font-size:12px;line-height:1.5">
                                    <strong style="color:#1b653e">• @tab.Name:</strong> @tab.Detail
                                </div>
                            }
                        </div>
                    </div>
                }

                <div style="padding:12px 14px;background:#fff;border:1px solid #e5e7eb;border-radius:10px">
                    <strong style="color:#1e293b;display:block;margin-bottom:10px">📋 Hướng dẫn thao tác từng bước (Step-by-Step):</strong>
                    <div class="step-list" style="gap:10px">
                        @for (int i = 0; i < selectedGuide.Steps.Count; i++)
                        {
                            var stepText = selectedGuide.Steps[i];
                            <div style="align-items:flex-start">
                                <b style="width:28px;height:28px;font-size:11.5px;flex:none">B@(i + 1)</b>
                                <span style="font-size:12.2px;color:#334155;line-height:1.55;padding-top:3px">@stepText</span>
                            </div>
                        }
                    </div>
                </div>

                @if (selectedGuide.Notes.Count > 0)
                {
                    <div style="padding:12px 14px;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px">
                        <strong style="color:#166534;display:block;margin-bottom:6px">💡 Quy tắc nghiệp vụ &amp; Lưu ý quan trọng:</strong>
                        <ul style="margin:0;padding-left:18px;color:#14532d;font-size:12px;line-height:1.65">
                            @foreach (var note in selectedGuide.Notes)
                            {
                                <li>@note</li>
                            }
                        </ul>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(selectedGuide.DataFlow))
                {
                    <div style="padding:10px 14px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;font-size:12px;color:#1e3a8a;line-height:1.55">
                        <strong>🔄 Liên kết dữ liệu &amp; Kế toán:</strong> @selectedGuide.DataFlow
                    </div>
                }
            </div>

            <div class="so-modal-footer">
                <div>
                    @if (!string.IsNullOrWhiteSpace(resolvedHref))
                    {
                        <a class="btn" href="@resolvedHref">Mở màn hình @selectedGuide.Title →</a>
                    }
                </div>
                <button type="button" class="btn secondary" data-confirm="none" @onclick="CloseGuide">Đóng hướng dẫn</button>
            </div>
        </div>
    </div>
}

@code {
    private sealed record TabGuide(string Name, string Detail);
    private sealed record GuideTopic(
        string Key,
        string Category,
        string Title,
        string RouteLabel,
        string PrimaryHref,
        string TabBadge,
        string Actor,
        string Summary,
        string Purpose,
        string[] RequiredAnyPermissions,
        string[] DetailPermissionKeys,
        List<TabGuide> Tabs,
        List<string> Steps,
        List<string> Notes,
        string DataFlow);

    private sealed record MenuGroupVm(string GroupTitle, List<GuideTopic> Items);
    private sealed record CoreModuleVm(string Key, string Code, string Title, string Summary, string[] RequiredAnyPermissions);
    private sealed record WorkflowStageVm(string Key, int Stt, string Stage, string EntryPoint, string ServiceInfo, string Tables, string Output, string[] RequiredAnyPermissions);

    private GuideTopic? selectedGuide;
    private long loggedInUserId;
    private long targetUserId;
    private string targetUsername = "";
    private string targetDisplayName = "";
    private string targetRolesLabel = "";
    private bool canPreviewOtherUsers;
    private List<ManagedUser> allUsers = [];
    private List<RoleInfo> allRoles = [];
    private HashSet<string> effectivePermissions = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        loggedInUserId = AuthRepository.PrincipalId(user);
        targetUserId = loggedInUserId;

        allRoles = Accounts.AllRoles().ToList();
        var myPerms = Accounts.AllowedPermissions(loggedInUserId).ToHashSet(StringComparer.OrdinalIgnoreCase);
        canPreviewOtherUsers = myPerms.Contains(Permissions.UsersView) || myPerms.Contains(Permissions.ArchitectureView);

        if (canPreviewOtherUsers)
        {
            allUsers = Accounts.AllUsers().Where(u => u.IsActive).ToList();
        }

        LoadTargetUserPermissions(targetUserId, user);
    }

    private void OnTargetUserChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var uid) && uid > 0)
        {
            targetUserId = uid;
            LoadTargetUserPermissions(targetUserId, null);
            if (selectedGuide is not null && !HasAccess(selectedGuide.RequiredAnyPermissions))
            {
                selectedGuide = null;
            }
        }
    }

    private void LoadTargetUserPermissions(long uid, ClaimsPrincipal? fallbackPrincipal)
    {
        effectivePermissions = Accounts.AllowedPermissions(uid).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var managed = allUsers.FirstOrDefault(u => u.Id == uid) ?? Accounts.AllUsers().FirstOrDefault(u => u.Id == uid);
        if (managed is not null)
        {
            targetUsername = managed.Username;
            targetDisplayName = managed.DisplayName;
            targetRolesLabel = GetUserRolesDisplay(managed);
        }
        else if (fallbackPrincipal is not null)
        {
            targetUsername = fallbackPrincipal.FindFirst("tnm_username")?.Value ?? "user";
            targetDisplayName = fallbackPrincipal.Identity?.Name ?? "Người dùng";
            targetRolesLabel = string.Join(", ", Accounts.Roles(uid).Select(TranslateRoleCode));
        }
    }

    private string GetUserRolesDisplay(ManagedUser u)
    {
        if (u.IsOwner) return "Chủ sở hữu (Owner)";
        var names = u.RoleIds
            .Select(rid => allRoles.FirstOrDefault(r => r.Id == rid))
            .Where(r => r is not null)
            .Select(r => TranslateRoleCode(r!.Code))
            .ToList();
        return names.Count > 0 ? string.Join(", ", names) : "Tùy chỉnh quyền";
    }

    private static string TranslateRoleCode(string code) => code.ToUpperInvariant() switch
    {
        "ADMIN" => "Quản trị",
        "MANAGER" => "Quản lý",
        "ACCOUNTANT" => "Kế toán",
        "WAREHOUSE" => "Kho",
        "CSKH" => "CSKH",
        "TECHNICIAN" => "Kỹ thuật",
        _ => code
    };

    private bool HasAccess(string[] requiredAny)
    {
        if (requiredAny.Length == 0) return true;
        return requiredAny.Any(p => effectivePermissions.Contains(p));
    }

    private int TotalMenuItemCount => AllMenuGroups.Sum(g => g.Items.Count);
    private int VisibleMenuItemCount => VisibleMenuGroups.Sum(g => g.Items.Count);

    private List<MenuGroupVm> VisibleMenuGroups => AllMenuGroups
        .Select(g => new MenuGroupVm(g.GroupTitle, g.Items.Where(i => HasAccess(i.RequiredAnyPermissions)).ToList()))
        .Where(g => g.Items.Count > 0)
        .ToList();

    private List<CoreModuleVm> VisibleCoreModules => CoreModules
        .Where(m => HasAccess(m.RequiredAnyPermissions))
        .ToList();

    private List<CoreModuleVm> VisibleIntegrityRules => IntegrityRules
        .Where(r => HasAccess(r.RequiredAnyPermissions))
        .ToList();

    private List<WorkflowStageVm> VisibleWorkflowStages => WorkflowStages
        .Where(w => HasAccess(w.RequiredAnyPermissions))
        .ToList();

    private int CountGrantedDetailPermissions(GuideTopic item)
    {
        var count = item.DetailPermissionKeys.Count(k => effectivePermissions.Contains(k));
        return Math.Max(1, count);
    }

    private List<PermissionDefinition> GetGrantedPermissionDefs(GuideTopic item) =>
        item.DetailPermissionKeys
            .Where(k => effectivePermissions.Contains(k))
            .Select(k => Permissions.Definitions.FirstOrDefault(d => d.Key == k))
            .Where(d => d is not null)
            .Select(d => d!)
            .ToList();

    private List<PermissionDefinition> GetUngrantedPermissionDefs(GuideTopic item) =>
        item.DetailPermissionKeys
            .Where(k => !effectivePermissions.Contains(k))
            .Select(k => Permissions.Definitions.FirstOrDefault(d => d.Key == k))
            .Where(d => d is not null)
            .Select(d => d!)
            .ToList();

    private string ResolvePrimaryHref(GuideTopic item)
    {
        if (item.Key == "installers" && !effectivePermissions.Contains(Permissions.MasterDataManage) && effectivePermissions.Contains(Permissions.PricesView))
            return "/catalog/installer-rates";
        if (item.Key == "reports-activity" && !effectivePermissions.Contains(Permissions.ReportsView) && effectivePermissions.Contains(Permissions.ReportsAuditView))
            return "/activity";
        if (item.Key == "admin-security")
        {
            if (effectivePermissions.Contains(Permissions.UsersView)) return "/admin/users";
            if (effectivePermissions.Contains(Permissions.WarehouseScopeManage)) return "/admin/warehouses";
            if (effectivePermissions.Contains(Permissions.ArchitectureView)) return "/admin/flow-tester";
        }
        return item.PrimaryHref;
    }

    private void OpenGuide(string key)
    {
        if (AllGuides.TryGetValue(key, out var g) && HasAccess(g.RequiredAnyPermissions))
        {
            selectedGuide = g;
        }
    }

    private void CloseGuide() => selectedGuide = null;

    private static readonly Dictionary<string, GuideTopic> AllGuides = new(StringComparer.OrdinalIgnoreCase)
    {
        ["dashboard"] = new(
            Key: "dashboard",
            Category: "TỔNG QUAN",
            Title: "Dashboard — Bảng điều hành tổng quan",
            RouteLabel: "/",
            PrimaryHref: "/",
            TabBadge: "1 màn hình",
            Actor: "Ban giám đốc / Quản lý / Kế toán / CSKH",
            Summary: "Theo dõi nhanh doanh thu, đã thu, công nợ phải thu, lợi nhuận gộp ước tính, vòng đời thiết bị IMEI và các cảnh báo cần xử lý ngay.",
