@page "/quantity-stock"
@attribute [Authorize(Policy=Permissions.QuantityStockView)]
@inject V6Ops Ops
@inject PermissionGate Gate
<PageTitle>Kho số lượng · TNM v6</PageTitle>
<div class="page-head"><div><div class="eyebrow">INVENTORY / QUANTITY</div><h1>Kho hàng theo số lượng</h1><p>Nhập, xuất, điều chuyển giữa kho/vị trí. Tồn kho được tính từ sổ giao dịch, không sửa tồn trực tiếp.</p></div></div>
<div class="crud-actionbar">@if(canMove){<button type="button" class="btn secondary" @onclick="()=>ToggleForm(nameof(showMove))">@(showMove?"Đóng · + Nhập/xuất":"+ Nhập/xuất")</button>}@if(canMove){<button type="button" class="btn secondary" @onclick="()=>ToggleForm(nameof(showTransfer))">@(showTransfer?"Đóng · + Điều chuyển":"+ Điều chuyển")</button>}@if(canLocation){<button type="button" class="btn secondary" @onclick="()=>ToggleForm(nameof(showLocation))">@(showLocation?"Đóng · + Thêm vị trí":"+ Thêm vị trí")</button>}</div>


<div class="two-column">
@if(canMove)
{
<section class="panel edit-panel" hidden="@(!showMove)"><div class="panel-head"><h2>Phiếu nhập / xuất số lượng</h2></div>
<div class="form-grid one">
<label>Hình thức
    <select @bind="moveKind">
        <option value="IN">Nhập kho</option>
        <option value="OUT">Xuất kho</option>
    </select>
</label>
<label>Sản phẩm
    <select @bind="productId">
        @if(products.Count == 0)
        {
            <option value="0">— Chưa có sản phẩm quản lý số lượng (không IMEI) —</option>
        }
        else
        {
            <option value="0">— Chọn sản phẩm —</option>
            @foreach(var x in products){<option value="@x.Id">@x.Name</option>}
        }
    </select>
</label>
<label>Kho<select @bind="warehouseId" @bind:after="()=>locationId=FirstLocation(warehouseId)">@foreach(var x in warehouses){<option value="@x.Id">@x.Code — @x.Name</option>}</select></label>
<label>Vị trí<select @key="warehouseId" @bind="locationId">@foreach(var x in locations.Where(l=>l.WarehouseId==warehouseId)){<option value="@x.Id">@x.Code — @x.Name</option>}</select></label>
<label>Số lượng<input type="number" min="1" @bind="quantity" /></label>
<label>Ghi chú<input @bind="note" placeholder="Lý do / chứng từ" /></label>
</div><div class="form-actions"><button class="btn" @onclick="SaveMovement">Ghi phiếu</button><span class="feedback">@message</span></div></section>
<section class="panel edit-panel" hidden="@(!showTransfer)"><div class="panel-head"><h2>Điều chuyển vị trí</h2></div>
<div class="form-grid one">
<label>Sản phẩm
    <select @bind="productId">
        @if(products.Count == 0)
        {
            <option value="0">— Chưa có sản phẩm quản lý số lượng (không IMEI) —</option>
        }
        else
        {
            <option value="0">— Chọn sản phẩm —</option>
            @foreach(var x in products){<option value="@x.Id">@x.Name</option>}
        }
    </select>
</label>
<label>Từ kho<select @bind="fromWarehouse" @bind:after="()=>fromLocation=FirstLocation(fromWarehouse)">@foreach(var x in warehouses){<option value="@x.Id">@x.Name</option>}</select></label>
<label>Từ vị trí<select @key="fromWarehouse" @bind="fromLocation">@foreach(var x in locations.Where(l=>l.WarehouseId==fromWarehouse)){<option value="@x.Id">@x.Name</option>}</select></label>
<label>Đến kho<select @bind="toWarehouse" @bind:after="()=>toLocation=FirstLocation(toWarehouse)">@foreach(var x in warehouses){<option value="@x.Id">@x.Name</option>}</select></label>
<label>Đến vị trí<select @key="toWarehouse" @bind="toLocation">@foreach(var x in locations.Where(l=>l.WarehouseId==toWarehouse)){<option value="@x.Id">@x.Name</option>}</select></label>
<label>Số lượng<input type="number" min="1" @bind="transferQty" /></label>
<label>Ghi chú<input @bind="note" placeholder="Lý do điều chuyển" /></label>
</div><div class="form-actions"><button class="btn" @onclick="Transfer">Điều chuyển</button><span class="feedback">@transferMessage</span></div></section>
}
</div>
@if(canLocation)
{<section class="panel edit-panel" hidden="@(!showLocation)"><div class="panel-head"><h2>Tạo vị trí kho</h2></div>
<div class="form-grid"><label>Kho<select @bind="newLocationWarehouse">@foreach(var x in warehouses){<option value="@x.Id">@x.Name</option>}</select></label><label>Mã vị trí<input @bind="newLocationCode" placeholder="VD: BH, VT, KE-A" /></label><label>Tên vị trí<input @bind="newLocationName" /></label></div>
<div class="form-actions"><button class="btn" @onclick="AddLocation">+ Tạo vị trí</button><span class="feedback">@locationMessage</span></div></section>}
<section class="panel"><div class="panel-head"><div><h2>Tồn kho hiện tại</h2><p>@balances.Count dòng theo SKU / kho / vị trí</p></div></div>
<div class="table-wrap"><table><thead><tr><th>SKU</th><th>Tên hàng</th><th>Kho</th><th>Vị trí</th><th>Tồn</th></tr></thead><tbody>
@foreach(var x in balances){<tr><td><strong>@x.Sku</strong></td><td>@x.Product</td><td>@x.Warehouse</td><td>@x.Location</td><td><strong>@x.Quantity</strong></td></tr>}
</tbody></table></div></section>
<section class="panel"><div class="panel-head"><h2>Sổ giao dịch số lượng</h2><a class="btn secondary" href="/export/quantity.csv">Xuất sổ CSV theo quyền kho</a></div>
<div class="table-wrap"><table><thead><tr><th>Ngày</th><th>Phiếu</th><th>SKU</th><th>Kho / Vị trí</th><th>Số lượng ±</th><th>Loại</th><th>Ghi chú</th></tr></thead><tbody>
@foreach(var x in movements){<tr><td>@x.When</td><td>@x.Document</td><td>@x.Sku</td><td>@x.Warehouse / @x.Location</td><td><strong>@x.Delta</strong></td><td>@x.Type</td><td>@x.Note</td></tr>}
</tbody></table></div></section>
@code {
 private bool showMove, showTransfer, showLocation;
 private void ToggleForm(string form){
  showMove = form=="showMove" && !showMove;
  showTransfer = form=="showTransfer" && !showTransfer;
  showLocation = form=="showLocation" && !showLocation;
 }

 private long actor;private bool canMove,canLocation;private string moveKind="IN";
 private List<Pick> products=[];private List<WarehousePick> warehouses=[];private List<LocationPick> locations=[];
 private List<QuantityBalance> balances=[];private List<QuantityEntry> movements=[];
 private long productId,warehouseId,locationId,fromWarehouse,fromLocation,toWarehouse,toLocation,newLocationWarehouse;
 private long quantity=1,transferQty=1;private string note="",message="",transferMessage="",newLocationCode="",newLocationName="",locationMessage="";
 protected override async Task OnInitializedAsync(){actor=await Gate.RequireAsync(Permissions.QuantityStockView);canMove=await Gate.CanAsync(Permissions.QuantityMove);canLocation=await Gate.CanAsync(Permissions.WarehouseLocationManage);
    products=Ops.QuantityProducts();LoadOptions();Refresh();}
 private void LoadOptions(){warehouses=Ops.Warehouses(actor);locations=Ops.Locations(actor);productId=products.FirstOrDefault()?.Id??0;
    warehouseId=warehouses.FirstOrDefault()?.Id??0;locationId=locations.FirstOrDefault(l=>l.WarehouseId==warehouseId)?.Id??0;
    fromWarehouse=warehouseId;toWarehouse=warehouses.LastOrDefault()?.Id??0;fromLocation=locationId;
    toLocation=locations.FirstOrDefault(l=>l.WarehouseId==toWarehouse)?.Id??0;newLocationWarehouse=warehouseId;}
 private long FirstLocation(long warehouse)=>locations.FirstOrDefault(l=>l.WarehouseId==warehouse)?.Id??0;
 private void Refresh(){balances=Ops.Balances(actor);movements=Ops.Movements(actor);}
 private async Task SaveMovement(){try{actor=await Gate.RequireAsync(Permissions.QuantityMove);var target=locations.FirstOrDefault(x=>x.WarehouseId==warehouseId&&x.Id==locationId)?.Id??locations.FirstOrDefault(x=>x.WarehouseId==warehouseId)?.Id??0;
    Ops.MoveQuantity(actor,productId,warehouseId,target,quantity,moveKind=="IN",note);Refresh();message="Đã ghi phiếu nhập/xuất.";}catch(Exception e){message=e.Message;}}
 private async Task Transfer(){try{actor=await Gate.RequireAsync(Permissions.QuantityMove);
    var src=locations.FirstOrDefault(x=>x.WarehouseId==fromWarehouse&&x.Id==fromLocation)?.Id??locations.FirstOrDefault(x=>x.WarehouseId==fromWarehouse)?.Id??0;
    var dest=locations.FirstOrDefault(x=>x.WarehouseId==toWarehouse&&x.Id==toLocation)?.Id??locations.FirstOrDefault(x=>x.WarehouseId==toWarehouse)?.Id??0;
    Ops.TransferQuantity(actor,productId,fromWarehouse,src,toWarehouse,dest,transferQty,note);Refresh();transferMessage="Đã chuyển kho.";
 }catch(Exception e){transferMessage=e.Message;}}
 private async Task AddLocation(){try{actor=await Gate.RequireAsync(Permissions.WarehouseLocationManage);
    Ops.AddLocation(actor,newLocationWarehouse,newLocationCode,newLocationName);locations=Ops.Locations(actor);locationMessage="Đã tạo vị trí.";
 }catch(Exception e){locationMessage=e.Message;}}
}
