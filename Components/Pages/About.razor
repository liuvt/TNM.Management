@page "/about"
@attribute [Authorize]
<PageTitle>Thông tin phiên bản · TNM.Management</PageTitle>
<div class="page-head">
  <div><div class="eyebrow">HỆ THỐNG / THÔNG TIN PHIÊN BẢN</div><h1>Thông tin phiên bản</h1><p>Thông tin ứng dụng, nền tảng và dữ liệu dùng chung.</p></div>
</div>
<section class="panel" style="max-width:760px">
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
    <img src="imgs/logo.png" alt="Logo" style="width:48px;height:48px;object-fit:contain;border-radius:12px;border:1px solid #e6f4ea;background:#fff;padding:3px" />
    <div>
      <h2 style="margin:0">TNM.Management</h2>
      <small style="color:#64748b">Hệ thống quản lý vận hành thiết bị, kho, đơn hàng lắp đặt &amp; kế toán</small>
    </div>
  </div>
  <div class="table-wrap"><table>
    <thead><tr><th>STT</th><th>HẠNG MỤC</th><th>THÔNG TIN</th></tr></thead>
    <tbody>
      <tr><td><strong>1</strong></td><th>Phiên bản nghiệp vụ</th><td>V7</td></tr>
      <tr><td><strong>2</strong></td><th>Nền tảng</th><td>.NET 9 · Blazor Interactive Server</td></tr>
      <tr><td><strong>3</strong></td><th>Cơ sở dữ liệu</th><td>SQLite</td></tr>
      <tr><td><strong>4</strong></td><th>Danh mục dùng chung</th><td class="wrap-cell">Nhóm NCC, NCC, nhóm sản phẩm, sản phẩm, khu vực, kho, nhóm khách hàng, khách hàng, bảng giá và chương trình</td></tr>
    </tbody></table></div>
  <TablePager Pager="pager" TotalCount="4" />
  <p class="panel-note">Tên bảng dữ liệu và dịch vụ nội bộ vẫn giữ nguyên để bảo toàn migration và liên kết chứng từ hiện có.</p>
</section>
@code {
  private readonly PagerState pager = new();
}
