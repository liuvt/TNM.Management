@page "/admin/users"
@attribute [Authorize(Policy = Permissions.UsersView)]
@inject AuthRepository Accounts
@inject PermissionGate Gate
@inject IJSRuntime JS
<PageTitle>Người dùng và phân quyền · TNM.Management</PageTitle>
<div class="page-head"><div><div class="eyebrow">HỆ THỐNG / TÀI KHOẢN → VAI TRÒ → PHÂN QUYỀN CHỨC NĂNG</div><h1>Người dùng &amp; phân quyền chức năng</h1>
<p>Chủ sở hữu hệ thống được gán toàn bộ vai trò và toàn quyền chức năng đã triển khai. Các tài khoản nhân sự khác sử dụng vai trò mẫu hoặc cấp quyền riêng.</p></div>
@if(canViewLog){<div class="button-group"><button type="button" class="btn secondary" data-confirm="none" @onclick="OpenModuleLog">📋 Xem log</button></div>}
</div>
<div class="stats-grid three">
    <div class="stat"><small>Tài khoản</small><strong>@users.Count</strong><span>@users.Count(x=>x.IsActive) đang hoạt động</span></div>
    <div class="stat"><small>Vai trò mẫu</small><strong>@roles.Count</strong><span>Có thể tạo tài khoản chỉ với quyền trực tiếp</span></div>
    <div class="stat"><small>Quyền chức năng</small><strong>@Permissions.Definitions.Count(p=>p.Implemented) / @Permissions.Definitions.Length</strong><span>Đang triển khai / tổng quyền nghiệp vụ</span></div>
</div>
@if(!string.IsNullOrWhiteSpace(userMessage)){<p class="feedback" role="status">@userMessage</p>}
<section class="panel"><div class="panel-head"><div><h2>Danh sách tài khoản</h2><p>Chọn “Phân quyền” để cấp quyền riêng cho từng người dùng. Những người không có quyền sẽ không thấy menu tương ứng.</p></div>
<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
<input class="search-input" @bind="userSearch" @bind:event="oninput" @bind:after="() => userPager.Reset()" placeholder="Tìm tài khoản, họ tên, vai trò..." />
<button type="button" class="btn secondary" data-confirm="none" @onclick="ExportUsersExcel">📥 Xuất Excel (@FilteredUsers.Count)</button>
@if(canManageUsers){<button class="btn" data-confirm="none" @onclick="ResetForm">+ Tạo tài khoản</button>}
</div></div>
@{ var pagedUsers = userPager.Slice(FilteredUsers, out var totalUsers); }
<div class="table-wrap"><table><thead><tr><th>STT</th><th>TÊN ĐĂNG NHẬP</th><th>HỌ TÊN NHÂN SỰ</th><th>VAI TRÒ MẪU</th><th>QUYỀN HIỆU LỰC</th><th>TRẠNG THÁI</th><th>THAO TÁC</th></tr></thead><tbody>
@foreach(var (stt, u) in pagedUsers){<tr><td><strong>@stt</strong></td><td><strong>@u.Username</strong> @if(u.IsOwner){<span class="chip green-chip">Chủ sở hữu · Toàn quyền</span>}<small class="permission-key">Mã #@u.Id</small></td>
<td>@u.DisplayName</td><td>@(u.RoleIds.Count==0 ? "Cấp quyền trực tiếp" : string.Join(", ",roles.Where(r=>u.RoleIds.Contains(r.Id)).Select(x=>VnLabels.RoleName(x.Code))))</td>
<td><span class="chip blue-chip">@(u.IsActive?Accounts.AllowedPermissions(u.Id).Count:0) / @Permissions.Definitions.Count(p=>p.Implemented)</span></td>
<td><span class="chip @(u.IsActive?"green-chip":"orange-chip")">@(u.IsActive?"Hoạt động":"Đã khóa")</span></td>
<td>
<div style="display:flex;gap:6px;flex-wrap:wrap">
@if(!u.IsOwner && u.Id!=myId && (canManageUsers || canUserPermissions)){<button class="btn secondary btn-sm" data-confirm="none" @onclick="()=>EditUser(u)">Phân quyền / Sửa</button>}
@if(canViewRowLog){<button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="()=>OpenUserRecordLog(u.Id)">Xem log</button>}
</div>
</td></tr>}
</tbody></table></div>
<TablePager Pager="userPager" TotalCount="totalUsers" OnChange="StateHasChanged" />
</section>
@if(canManageUsers || canUserPermissions){
<section class="panel edit-panel" id="user-editor" hidden="@(!showUserEditor)"><div class="form-actions"><button type="button" class="btn secondary" data-confirm="none" @onclick="()=>showUserEditor=false">Đóng biểu mẫu</button></div>
<div class="panel-head"><div><div class="eyebrow">BƯỚC 1 / THÔNG TIN TÀI KHOẢN</div><h2>@(editUserId.HasValue ? $"Thiết lập tài khoản: {username}" : "Tạo tài khoản mới")</h2>
<p>Tài khoản mới có thể không thuộc vai trò mẫu nào nếu được cấp quyền trực tiếp.</p></div>
@if(canManageUsers){<button class="btn secondary" data-confirm="none" @onclick="ResetForm">Làm mới</button>}</div>
@if(canManageUsers){
<div class="form-grid">
 @if(!editUserId.HasValue){<label>Tên đăng nhập<input @bind="username" autocomplete="off" placeholder="VD: nv_kho_sg" /></label>}
 <label>Họ tên người dùng<input @bind="displayName" placeholder="Tên nhân viên" /></label>
 <label>@(editUserId.HasValue?"Đổi mật khẩu (để trống nếu không đổi)":"Mật khẩu đăng nhập")<input @bind="password" type="password" autocomplete="new-password" placeholder="Từ 12 ký tự, gồm chữ và số" /></label>
 @if(editUserId.HasValue){<label>Trạng thái tài khoản<select @bind="activeMode"><option value="ACTIVE">Hoạt động</option><option value="LOCKED">Khóa tài khoản</option></select></label>}
</div>
<div class="role-picker"><strong>BƯỚC 2 / VAI TRÒ MẪU (TÙY CHỌN)</strong>
@foreach(var r in roles){<label class="inline-check"><input type="checkbox" checked="@assignedRoles.Contains(r.Id)" @onchange="e => ToggleAssignedRole(r.Id,e.Value is bool b && b)" /> @VnLabels.RoleName(r.Code)</label>}
</div>
} else if(editUserId.HasValue){<p>Chỉ được thay đổi quyền riêng; không được chỉnh thông tin hoặc vai trò.</p>}
@if(canUserPermissions && (canManageUsers || editUserId.HasValue)){
<div class="permission-heading"><div><div class="eyebrow">BƯỚC 3 / QUYỀN TRỰC TIẾP CHO TÀI KHOẢN</div><h2>Ma trận truy cập chức năng</h2>
<p>Quyền theo từng hạng mục nghiệp vụ của hệ thống TNM. Cho phép riêng / Từ chối riêng ưu tiên hơn so với vai trò mẫu. Những dòng chưa có màn hình được đánh dấu Chưa triển khai và không thể cấp.</p></div>
<div class="permission-summary"><span class="chip blue-chip">Cho phép: @EffectiveCount / @Permissions.Definitions.Count(p=>p.Implemented)</span>
<span class="chip orange-chip">Từ chối riêng: @DirectDenyCount</span></div></div>
<div class="form-grid"><label>Tìm chức năng nghiệp vụ<input @bind="permissionSearch" @bind:event="oninput" placeholder="VD: thu hồi ký gửi, D+30, công nợ..." /></label>
<label>Phân hệ<select @bind="areaFilter"><option value="ALL">Tất cả phân hệ</option>@foreach(var areaName in Permissions.Definitions.Select(p=>p.Area).Distinct()){<option value="@areaName">@areaName</option>}</select></label></div>
@if(IsEditingAdmin){<div class="panel-note">Tài khoản Quản trị viên có toàn quyền cố định; không chỉnh quyền riêng để bảo vệ quyền quản trị.</div>}
<div class="panel-note" style="margin-bottom:10px">🔒 <strong>Tính năng cố định hệ thống:</strong> Quyền xem <strong>Lịch sử / Lưu vết / Nhật ký / Log</strong> chỉ áp dụng cố định cho các vai trò <strong>Main</strong>, <strong>Chủ sở hữu (Owner)</strong> và <strong>Quản trị viên (Admin)</strong> — không thể tùy chỉnh cho các vai trò hay cá nhân khác.</div>
var pagedUserPerms = userPermPager.Slice(FilteredPermissions, out var totalUserPerms);
<div class="table-wrap"><table class="permissions-table"><thead><tr><th>STT</th><th>PHÂN HỆ</th><th>NHÁNH / CHỨC NĂNG</th><th>QUYỀN VAI TRÒ</th><th>QUYỀN CÁ NHÂN</th><th>HIỆU LỰC</th></tr></thead><tbody>
@foreach(var (stt, perm) in pagedUserPerms){<tr><td><strong>@stt</strong></td><td><strong>@perm.Area</strong></td><td><strong>@perm.Feature</strong> / @perm.Label <small class="permission-key">Hạng mục #@perm.ExcelRow</small>
 @if(!perm.Implemented){<span class="chip orange-chip">Chưa triển khai</span>}</td>
 <td>@(Permissions.IsFixedSystemLogPermission(perm.Key) ? (IsEditingAdmin ? "Có (Admin)" : "Khóa cố định") : (inheritedPermissions.Contains(perm.Key) ? "Có" : "Không"))</td>
 <td>
 @if(Permissions.IsFixedSystemLogPermission(perm.Key))
 {
   <span class="chip blue-chip" title="Tính năng cố định chỉ dành cho Main, Owner và Admin — không thể tùy chỉnh">🔒 Cố định: Main / Owner / Admin</span>
 }
 else
 {
   <select class="search-input" value="@OverrideMode(perm.Key)" disabled="@(IsEditingAdmin || !perm.Implemented)" @onchange="e => ChangeOverride(perm.Key,e)">
     <option value="INHERIT">Theo vai trò</option><option value="ALLOW">Cho phép riêng</option><option value="DENY">Từ chối riêng</option>
   </select>
 }
 </td>
 <td><span class="chip @(HasEffective(perm.Key)?"green-chip":"orange-chip")">@(HasEffective(perm.Key)?"Được truy cập":perm.Implemented?"Không truy cập":"Chưa có chức năng")</span></td></tr>}
</tbody></table></div>
<TablePager Pager="userPermPager" TotalCount="totalUserPerms" OnChange="StateHasChanged" />
} else if(!canUserPermissions){<div class="panel-note">Tài khoản này không có quyền chỉnh quyền trực tiếp cho người dùng.</div>}
<div class="form-actions">
@if(canManageUsers){<button class="btn" @onclick="SaveUser">@(editUserId.HasValue ? "Lưu tài khoản và phân quyền" : "Tạo tài khoản và cấp quyền")</button>}
@if(editUserId.HasValue && canUserPermissions && !canManageUsers){<button class="btn" @onclick="SaveDirectPermissions">Lưu quyền riêng</button>}
<span class="feedback">@userMessage</span></div>
<div class="panel-note">Sau khi lưu: phiên đăng nhập cũ của người bị đổi quyền hết hiệu lực; đăng nhập lại để cập nhật giao diện và quyền truy cập. Mọi thao tác ghi dữ liệu tiếp tục xác minh quyền trực tiếp với cơ sở dữ liệu phía máy chủ.</div>
</section>}
@if(canManageRoles){<button type="button" class="btn secondary" data-confirm="none" @onclick="()=>showRoleEditor=!showRoleEditor">@(showRoleEditor?"Đóng quyền vai trò":"Chỉnh sửa quyền vai trò")</button><section class="panel edit-panel" hidden="@(!showRoleEditor)">
<div class="panel-head"><div><h2>Ma trận quyền theo vai trò (mẫu chung)</h2><p>Chỉnh sửa vai trò sẽ áp dụng cho toàn bộ tài khoản kế thừa vai trò này, trừ những quyền đã cho phép/từ chối riêng.</p></div>
<select class="search-input" @bind="selectedRoleId" @bind:after="RefreshRoleMatrix">@foreach(var r in roles){<option value="@r.Id">@VnLabels.RoleName(r.Code)</option>}</select></div>
@{ var pagedRolePerms = rolePermPager.Slice(Permissions.Definitions, out var totalRolePerms); }
<div class="panel-note" style="margin-bottom:10px">🔒 Các hạng mục <strong>Lịch sử / Lưu vết / Nhật ký / Log</strong> thuộc tính năng cố định cho <strong>Main / Owner / Admin</strong>, không tùy chỉnh trên các vai trò khác.</div>
<div class="table-wrap"><table><thead><tr><th>STT</th><th>PHÂN HỆ</th><th>QUYỀN HẠN</th><th>CHO PHÉP</th></tr></thead><tbody>
@foreach(var (stt, perm) in pagedRolePerms){<tr><td><strong>@stt</strong></td><td>@perm.Area / @perm.Feature</td><td>@perm.Label <small class="permission-key">Hạng mục #@perm.ExcelRow</small>@if(!perm.Implemented){<span class="chip orange-chip">Chưa triển khai</span>}</td><td>@if(Permissions.IsFixedSystemLogPermission(perm.Key)){<span class="chip blue-chip">🔒 Cố định: Main / Owner / Admin</span>}else{<input type="checkbox" checked="@rolePermissionKeys.Contains(perm.Key)" disabled="@(IsAdminRole || !perm.Implemented)" @onchange="e => ToggleRolePermission(perm.Key,e.Value is bool b && b)" />}</td></tr>}
</tbody></table></div>
<TablePager Pager="rolePermPager" TotalCount="totalRolePerms" OnChange="StateHasChanged" />
<div class="form-actions"><button class="btn" disabled="@IsAdminRole" @onclick="SaveRoleMatrix">Lưu quyền vai trò</button><span class="feedback">@roleMessage</span></div>
</section>}
@if(canViewLog)
{
    <SystemLogModal IsOpen="showLogModal"
                    OnClose="() => showLogModal = false"
                    Title="Lịch sử &amp; Lưu vết — Tài khoản &amp; Phân quyền"
                    ScopedTables="@adminLogTables"
                    ScopedAuditEntities="@adminAuditEntities"
                    InitialTable="@logInitialTable"
                    InitialRecordId="@logInitialRecordId" />
}
@code {
    private bool showUserEditor,showRoleEditor;
    private readonly PagerState userPager = new();
    private readonly PagerState userPermPager = new();
    private readonly PagerState rolePermPager = new();
    private List<ManagedUser> users=[];
    private List<RoleInfo> roles=[];
    private HashSet<long> assignedRoles=[];
    private HashSet<string> rolePermissionKeys=new(StringComparer.Ordinal);
    private HashSet<string> inheritedPermissions=new(StringComparer.Ordinal);
    private Dictionary<string,string> directOverrides=new(StringComparer.Ordinal);
    private long? editUserId;
    private long selectedRoleId,myId;
    private string username="",displayName="",password="",userMessage="",roleMessage="",permissionSearch="",areaFilter="ALL",userSearch="";
    private List<ManagedUser> FilteredUsers => users.Where(u =>
        string.IsNullOrWhiteSpace(userSearch) ||
        ($"{u.Username} {u.DisplayName} {string.Join(" ", roles.Where(r => u.RoleIds.Contains(r.Id)).Select(r => VnLabels.RoleName(r.Code)))}")
            .Contains(userSearch.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
    private async Task ExportUsersExcel()
    {
        var list = FilteredUsers;
        var headers = new[] { "STT", "Tên đăng nhập", "Họ tên nhân viên", "Vai trò mẫu", "Số quyền hiệu lực", "Trạng thái" };
        var rows = list.Select((u, idx) => new object?[]
        {
            idx + 1,
            u.Username,
            u.DisplayName,
            u.RoleIds.Count == 0 ? "Cấp quyền trực tiếp" : string.Join(", ", roles.Where(r => u.RoleIds.Contains(r.Id)).Select(x => VnLabels.RoleName(x.Code))),
            u.IsActive ? Accounts.AllowedPermissions(u.Id).Count : 0,
            u.IsActive ? "Hoạt động" : "Đã khóa"
        });
        await ExcelExporter.DownloadAsync(JS, "danh-sach-tai-khoan-nguoi-dung", "Tài khoản người dùng", headers, rows);
    }
    private IEnumerable<PermissionDefinition> FilteredPermissions => Permissions.Definitions.Where(p=>
        (areaFilter=="ALL"||p.Area==areaFilter) &&
        (string.IsNullOrWhiteSpace(permissionSearch) || (p.Area+" "+p.Feature+" "+p.Label+" "+p.Key).Contains(permissionSearch,StringComparison.OrdinalIgnoreCase)));
    private bool canManageUsers,canManageRoles,canUserPermissions,canViewLog,canViewRowLog,showLogModal;
    private string? logInitialTable;
    private long? logInitialRecordId;
    private static readonly string[] adminLogTables = ["app_users", "roles", "user_roles", "role_permissions", "user_permission_overrides", "user_scope_settings", "user_warehouse_scopes"];
    private static readonly string[] adminAuditEntities = ["APP_USER", "ROLE", "USER_SCOPE"];
    private void OpenModuleLog() { logInitialTable = null; logInitialRecordId = null; showLogModal = true; }
    private void OpenUserRecordLog(long id) { if (!canViewRowLog) return; logInitialTable = "app_users"; logInitialRecordId = id; showLogModal = true; }
    private string activeMode="ACTIVE";
    private bool active { get => activeMode=="ACTIVE"; set => activeMode = value ? "ACTIVE" : "LOCKED"; }
    private bool IsAdminRole => roles.Any(x=>x.Id==selectedRoleId && x.Code=="ADMIN");
    private bool IsEditingAdmin => roles.Any(x=>x.Code=="ADMIN" && assignedRoles.Contains(x.Id));
    private int EffectiveCount => Permissions.Definitions.Count(p=>p.Implemented && HasEffective(p.Key));
    private int DirectDenyCount => directOverrides.Count(x=>x.Value=="DENY");
    private string OverrideMode(string key) => directOverrides.TryGetValue(key,out var effect)?effect:"INHERIT";
    private bool HasEffective(string key)
    {
        if(!Permissions.IsImplemented(key))return false;
        if(Permissions.IsFixedSystemLogPermission(key))return IsEditingAdmin;
        if(IsEditingAdmin)return true;
        var grant=directOverrides.TryGetValue(key,out var effect) ? effect=="ALLOW" : inheritedPermissions.Contains(key);
        return grant && (!Permissions.RequiredView.TryGetValue(key,out var parent) || HasEffective(parent));
    }
    protected override async Task OnInitializedAsync()
    {
        myId=await Gate.RequireAsync(Permissions.UsersView);
        canManageUsers=await Gate.CanAsync(Permissions.UsersManage);
        canManageRoles=await Gate.CanAsync(Permissions.RolesManage);
        canUserPermissions=await Gate.CanAsync(Permissions.UsersPermissions);
        canViewLog=await Gate.CanViewSystemLogsAsync();
        canViewRowLog=await Gate.CanViewRowLogsAsync();
        Reload();
        selectedRoleId=roles.FirstOrDefault(x=>x.Code=="WAREHOUSE")?.Id ?? roles.FirstOrDefault()?.Id ?? 0;
        RefreshRoleMatrix();ResetForm();showUserEditor=false;
    }
    private void Reload(){users=Accounts.AllUsers().ToList();roles=Accounts.AllRoles().ToList();}
    private void RecalculateInherited() => inheritedPermissions=Accounts.InheritedPermissions(assignedRoles).ToHashSet(StringComparer.Ordinal);
    private void ToggleAssignedRole(long id,bool value){if(value)assignedRoles.Add(id);else assignedRoles.Remove(id);if(IsEditingAdmin)directOverrides.Clear();RecalculateInherited();}
    private void ChangeOverride(string key,ChangeEventArgs e)
    {
        if(IsEditingAdmin || !Permissions.IsImplemented(key) || Permissions.IsFixedSystemLogPermission(key)) return;
        var effect=e.Value?.ToString() ?? "INHERIT";
        if(effect=="INHERIT")directOverrides.Remove(key);
        else if(effect=="ALLOW"||effect=="DENY") directOverrides[key]=effect;
    }
    private void ToggleRolePermission(string key,bool value){if(IsAdminRole || Permissions.IsFixedSystemLogPermission(key))return;if(value)rolePermissionKeys.Add(key);else rolePermissionKeys.Remove(key);}
    private void RefreshRoleMatrix(){rolePermissionKeys=Accounts.RolePermissions(selectedRoleId).Where(k => Permissions.IsImplemented(k) && (!Permissions.IsFixedSystemLogPermission(k) || IsAdminRole)).ToHashSet(StringComparer.Ordinal);roleMessage="";}
    private void EditUser(ManagedUser u)
    {showUserEditor=true;
        if(u.Id==myId || u.IsOwner)return;
        editUserId=u.Id;username=u.Username;displayName=u.DisplayName;active=u.IsActive;password="";
        assignedRoles=u.RoleIds.ToHashSet();
        directOverrides=Accounts.UserOverrides(u.Id).Where(x => !Permissions.IsFixedSystemLogPermission(x.Key)).ToDictionary(x=>x.Key,x=>x.Value,StringComparer.Ordinal);
        RecalculateInherited();userMessage="Đang phân quyền tài khoản "+u.Username;
    }
    private void ResetForm(){showUserEditor=true;editUserId=null;username="";displayName="";password="";active=true;assignedRoles=[];directOverrides=new(StringComparer.Ordinal);RecalculateInherited();userMessage="";}
    private async Task SaveUser()
    {
        try
        {
            var actor=await Gate.RequireAsync(Permissions.UsersManage);
            IReadOnlyDictionary<string,string>? rights=canUserPermissions?directOverrides:null;
            if(editUserId.HasValue) Accounts.UpdateUser(actor,editUserId.Value,displayName,active,password,assignedRoles,rights);
            else Accounts.CreateUser(actor,username,displayName,password,assignedRoles,rights);
            ResetForm();Reload();showUserEditor=false;userMessage="Đã lưu tài khoản và phân quyền. Người dùng cần đăng nhập lại.";
        }
        catch(Exception ex){userMessage="Lỗi: "+ex.Message;}
    }
    private async Task SaveDirectPermissions()
    {
        try
        {
            if(!editUserId.HasValue)return;
            var actor=await Gate.RequireAsync(Permissions.UsersPermissions);
            Accounts.SaveUserPermissions(actor,editUserId.Value,directOverrides);
            Reload();showUserEditor=false;userMessage="Đã cập nhật quyền riêng; phiên đăng nhập trước đã bị thu hồi.";
        }
        catch(Exception ex){userMessage="Lỗi: "+ex.Message;}
    }
    private async Task SaveRoleMatrix()
    {
        try
        {
            var actor=await Gate.RequireAsync(Permissions.RolesManage);
            Accounts.SaveRolePermissions(actor,selectedRoleId,rolePermissionKeys);
            RecalculateInherited();roleMessage="Đã lưu vai trò; các phiên đăng nhập liên quan đã được cập nhật.";
        }
        catch(Exception ex){roleMessage="Lỗi: "+ex.Message;}
    }
}
