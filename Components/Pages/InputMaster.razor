@page "/input-catalog"
@page "/catalog/{Section}"
@attribute [Authorize]
@inject InputCatalog Catalog
@inject PermissionGate Gate
@inject IJSRuntime JS
@inject AuditTrail Trail
@inject NavigationManager Nav
<PageTitle>@Title · TNM.Management</PageTitle>
<div class="page-head">
    <div>
        <div class="eyebrow">KINH DOANH / DANH MỤC</div>
        <h1>@Title</h1>
        <p>@Description</p>
    </div>
    <div class="button-group">
        @if(CurrentSection=="installers")
        {
            <a class="btn secondary" href="/sales-orders">Đơn hàng &amp; Điều phối →</a>
            <a class="btn secondary" href="/catalog/installer-rates">Bảng tổng hợp đơn giá lắp →</a>
        }
        @if(canCreate && IsValidSection)
        {
            <button type="button" class="btn" @onclick="Create">@(CurrentSection=="installers" ? "+ Khai báo người lắp đặt" : "+ Thêm mới")</button>
        }
    </div>
</div>
@if(!string.IsNullOrWhiteSpace(message)){<p class="feedback" role="status">@message</p>}
@if(!IsValidSection)
{
    <section class="panel"><p>Không tìm thấy danh mục này. <a href="/catalog/product-groups">Chọn nhóm sản phẩm</a>.</p></section>
}
else if(!canView)
{
    <section class="panel"><p>Bạn không có quyền truy cập danh mục này.</p></section>
}
else
{
    @if(CurrentSection=="installers")
    {
        <div class="stats-grid three">
            <div class="stat">
                <small>Tổng người lắp đặt</small>
                <strong>@installers.Count</strong>
                <span>Kỹ thuật viên nội bộ &amp; đối tác lắp đặt</span>
            </div>
            <div class="stat">
                <small>Đã cấu hình đơn giá lắp</small>
                <strong class="orange">@installers.Count(x => (x.RateChips?.Count ?? 0) > 0)</strong>
                <span>Người lắp đặt đã có định mức công lắp theo SP</span>
            </div>
            <div class="stat">
                <small>Sản phẩm áp dụng</small>
                <strong>@products.Count</strong>
                <span>Mã sản phẩm đang kinh doanh có thể gán công lắp</span>
            </div>
        </div>
    }
    @if(showEditor && (editingId.HasValue?canUpdate:canCreate))
    {
        <section class="panel edit-panel catalog-editor" id="catalog-editor">
            <div class="panel-head">
                <div>
                    <h2>@(editingId.HasValue ? "Cập nhật" : "Khai báo mới") — @Title</h2>
                    <p>@(CurrentSection=="installers" ? "Khai báo hồ sơ người lắp đặt và thiết lập bảng định mức tiền công đi lắp theo từng sản phẩm." : "Thông tin được dùng chung ở các luồng PO, SO, kho và thanh toán.")</p>
                </div>
                <button type="button" class="btn secondary" @onclick="CloseEditor">Đóng</button>
            </div>
            <div class="form-grid">
                @if(IsGroup)
                {
                    <label>@(Section=="areas"?"Mã khu vực":"Mã nhóm") *<input @bind="code" placeholder="@CodeExample" maxlength="32" /></label>
                    <label>@(Section=="areas"?"Tên khu vực":"Tên nhóm") *<input @bind="name" placeholder="@NameExample" maxlength="160" /></label>
                }
                else if(Section is "suppliers" or "customers" or "warehouses")
                {
                    <label>@(Section=="suppliers"?"Nhóm nhà cung cấp":Section=="customers"?"Nhóm khách hàng":"Khu vực") *
                        <select @bind="groupId"><option value="0">— Chọn —</option>@foreach(var g in GroupChoices){<option value="@g.Id">@g.Name</option>}</select></label>
                    @if(CurrentSection=="customers")
                    {
                        <label>Mã khách hàng (tự động)
                            <input value="@(string.IsNullOrWhiteSpace(code) ? Catalog.PeekNextCustomerCode() : code)" readonly disabled style="background:#f1f5f9;color:#475569;cursor:not-allowed;font-weight:600" />
                        </label>
                    }
                    else
                    {
                        <label>Mã *<input @bind="code" placeholder="@CodeExample" maxlength="32" /></label>
                    }
                    <label>@(Section=="customers" ? "Tên khách hàng / Đơn vị *" : "Tên *")<input @bind="name" placeholder="@NameExample" maxlength="160" /></label>
                    @if(Section=="suppliers")
                    {
                        <label>Số điện thoại<input @bind="phone" placeholder="0901234567" /></label>
                        <label>Mã số thuế<input @bind="tax" placeholder="Nếu có" /></label>
                    }
                    else if(Section=="customers")
                    {
                        <label>Người đại diện (B2B)<input @bind="representativeName" placeholder="Để trống nếu khách lẻ; nhập người đại diện nếu đơn vị B2B" maxlength="160" /></label>
                        <label>Số điện thoại<input @bind="phone" placeholder="0901234567" /></label>
                        <label>Nguồn KH / Tên Sale<input @bind="sourceName" placeholder="VD: Sale Nguyễn Văn A / Đại lý..." /></label>
                        <label>Địa chỉ<input @bind="address" placeholder="Địa chỉ liên hệ" /></label>
                    }
                    else
                    {
                        <label>Vị trí / Địa chỉ kho<input @bind="address" placeholder="Số nhà, đường, phường/xã..." /></label>
                    }
                }
                else if(Section=="installers")
                {
                    <label>Mã người lắp đặt (tự động cấp hoặc nhập mã riêng)
                        <input @bind="code" placeholder="@Catalog.PeekNextInstallerCode()" maxlength="32" style="font-weight:700;color:#c94833;background:#fffaf8" />
                    </label>
                    <label>Họ tên người lắp đặt / Đội kỹ thuật *
                        <input @bind="name" placeholder="VD: Trần Quốc Bảo / Đội lắp đặt Khu vực HCM" maxlength="160" />
                    </label>
                    <label>Số điện thoại liên hệ *
                        <input @bind="phone" placeholder="VD: 0901234567" />
                    </label>
                    <label>Phân loại / Bộ phận *
                        <select @bind="department">
                            <option value="Kỹ thuật">Kỹ thuật nội bộ (Kỹ thuật)</option>
                            <option value="Cộng tác viên lắp đặt">Cộng tác viên lắp đặt</option>
                            <option value="Đại lý / Đối tác lắp đặt">Đại lý / Đối tác lắp đặt</option>
                            <option value="Kỹ thuật bảo hành & lắp đặt">Kỹ thuật bảo hành &amp; lắp đặt</option>
                        </select>
                    </label>
                }
                else if(Section=="installer-rates")
                {
                    <label>Người lắp đặt *
                        <select @bind="groupId"><option value="0">— Chọn người lắp đặt —</option>@foreach(var e in installerChoices){<option value="@e.Id">@e.Code — @e.Name</option>}</select></label>
                    <label>Sản phẩm *<select @bind="productId"><option value="0">— Chọn sản phẩm —</option>@foreach(var p in products){<option value="@p.Id">@p.Code — @p.Name</option>}</select></label>
                    <label>Đơn giá đi lắp (VND) *<input type="number" min="0" @bind="buyPrice" /></label>
                    <label>Ngày áp dụng *<input type="date" @bind="effective" @bind:format="yyyy-MM-dd" /></label>
                }
                else if(Section is "buy-prices" or "sale-prices")
                {
                    <label>@(Section=="buy-prices"?"Nhóm NCC":"Nhóm khách hàng") *
                        <select @bind="groupId"><option value="0">— Chọn nhóm —</option>@foreach(var g in GroupChoices){<option value="@g.Id">@g.Name</option>}</select></label>
                    <label>Sản phẩm *<select @bind="productId"><option value="0">— Chọn sản phẩm —</option>@foreach(var p in products){<option value="@p.Id">@p.Code — @p.Name</option>}</select></label>
                    <label>Ngày bắt đầu áp dụng *<input type="date" @bind="effective" @bind:format="yyyy-MM-dd" /></label>
                    @if(Section=="buy-prices")
                    {
                        <label>Giá nhập (VND) *<input type="number" min="0" @bind="buyPrice" /></label>
                    }
                    else
                    {
                        <label>Giá chưa lắp (VND) *<input type="number" min="0" @bind="standard" /></label>
                        <label>Giá có lắp (VND) *<input type="number" min="0" @bind="installed" /></label>
                        <label>Giá gia hạn (VND) *<input type="number" min="0" @bind="renewal" /></label>
                    }
                }
                else if(Section=="campaigns")
                {
                    <label>Nhóm khách hàng *<select @bind="groupId"><option value="0">— Chọn nhóm —</option>@foreach(var g in customerGroups){<option value="@g.Id">@g.Name</option>}</select></label>
                    <label>Tên chương trình *<input @bind="name" placeholder="Ưu đãi đại lý" /></label>
                    <label>Chiết khấu (%) *<input type="number" min="0" max="100" @bind="discount" /></label>
                    <label>Ngày bắt đầu *<input type="date" @bind="effective" @bind:format="yyyy-MM-dd" /></label>
                    <label>Ngày kết thúc *<input type="date" @bind="until" @bind:format="yyyy-MM-dd" /></label>
                }
            </div>
            @if(Section=="installers" && products.Count>0)
            {
                <div style="margin-top:1.25rem;border-top:1px solid var(--line,#eaeaf0);padding-top:1rem">
                    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem;margin-bottom:0.85rem">
                        <div>
                            <h3 style="font-size:0.95rem;margin:0;color:#252637">Bảng định mức đơn giá công lắp theo sản phẩm (VND)</h3>
                            <small style="color:#747782">Đã thiết lập đơn giá cho <strong>@installerProductRates.Count(kv => kv.Value > 0) / @products.Count</strong> sản phẩm · Tự động tính công lắp khi điều phối đơn hàng SO.</small>
                        </div>
                        <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;background:#faf9f8;padding:0.5rem 0.75rem;border:1px solid #eeeef1;border-radius:9px">
                            <span style="font-size:11.5px;font-weight:650;color:#575866">Áp dụng nhanh tất cả SP:</span>
                            <input type="number" min="0" step="10000" @bind="bulkInstallerRate" placeholder="VD: 150000" style="width:125px;min-height:32px;padding:4px 8px;border:1px solid #e2e3e9;border-radius:6px" />
                            <button type="button" class="btn secondary btn-sm" @onclick="() => ApplyBulkInstallerRate(bulkInstallerRate)">Áp dụng</button>
                            <button type="button" class="btn secondary btn-sm" @onclick="() => ApplyBulkInstallerRate(100000)">100k</button>
                            <button type="button" class="btn secondary btn-sm" @onclick="() => ApplyBulkInstallerRate(150000)">150k</button>
                            <button type="button" class="btn secondary btn-sm" @onclick="() => ApplyBulkInstallerRate(200000)">200k</button>
                            <button type="button" class="btn secondary btn-sm" @onclick="() => ApplyBulkInstallerRate(0)">Đặt lại 0 ₫</button>
                        </div>
                    </div>
                    <div style="margin-bottom:0.65rem;display:flex;gap:0.6rem;align-items:center">
                        <input class="search-input" @bind="installerProdSearch" @bind:event="oninput" placeholder="Lọc nhanh mã DX hoặc tên sản phẩm..." style="max-width:320px;min-height:34px" />
                        @if(!string.IsNullOrWhiteSpace(installerProdSearch))
                        {
                            <button type="button" class="btn secondary btn-sm" @onclick="() => installerProdSearch = string.Empty">Xóa lọc SP</button>
                        }
                    </div>
                    <div class="table-wrap" style="max-height:360px;overflow-y:auto">
                        <table>
                            <thead>
                                <tr>
                                    <th style="width:110px">Mã SP</th>
                                    <th>Tên sản phẩm</th>
                                    <th>Nhóm sản phẩm</th>
                                    <th style="width:200px">Đơn giá công lắp (VND)</th>
                                    <th style="width:220px">Mức chọn nhanh</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var p in FilteredInstallerProducts)
                                {
                                    var pid = p.Id;
                                    var curRate = GetInstallerRateInput(pid);
                                    <tr>
                                        <td><strong>@p.Code</strong></td>
                                        <td class="name-cell"><strong>@p.Name</strong></td>
                                        <td><span class="chip">@p.Group</span></td>
                                        <td>
                                            <div style="display:flex;align-items:center;gap:0.45rem">
                                                <input type="number" min="0" step="10000" value="@curRate" @onchange="e => SetInstallerRateInput(pid, e.Value)" placeholder="0" style="width:125px;min-height:32px;padding:4px 8px;border:1px solid @(curRate > 0 ? "#208464" : "#e2e3e9");border-radius:6px;font-weight:@(curRate > 0 ? "700" : "400")" />
                                                @if(curRate > 0)
                                                {
                                                    <span class="chip green-chip">@curRate.ToString("N0") ₫</span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="button-group" style="gap:4px">
                                                <button type="button" class="btn secondary btn-sm" @onclick="() => SetInstallerRateDirect(pid, 100000)">100k</button>
                                                <button type="button" class="btn secondary btn-sm" @onclick="() => SetInstallerRateDirect(pid, 150000)">150k</button>
                                                <button type="button" class="btn secondary btn-sm" @onclick="() => SetInstallerRateDirect(pid, 200000)">200k</button>
                                                @if(curRate > 0)
                                                {
                                                    <button type="button" class="btn secondary btn-sm" @onclick="() => SetInstallerRateDirect(pid, 0)">Xóa</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            <div class="form-actions"><button type="button" class="btn" @onclick="Save">@(CurrentSection=="installers" ? "Lưu người lắp đặt & đơn giá" : "Lưu dữ liệu")</button><button type="button" class="btn secondary" @onclick="CloseEditor">Hủy</button></div>
        </section>
    }
    <section class="panel">
        <div class="catalog-toolbar">
            <div class="catalog-toolbar-search">
                <label class="sr-only" for="catalog-search">Tìm kiếm trong danh mục</label>
                <input id="catalog-search" class="search-input" @bind="query" @bind:event="oninput" @onkeydown="OnSearchKeyDown" placeholder="@(CurrentSection=="installers" ? "Tìm mã KT, họ tên, SĐT, bộ phận hoặc mã SP..." : "Tìm mã, tên, nhóm, thông tin...")" />
                <button type="button" class="btn secondary" @onclick="ApplySearch">Tìm kiếm</button>
                <button type="button" class="btn secondary" @onclick="ClearSearch">Xóa lọc</button>
            </div>
            <div class="button-group">
                @if(canExport){<button type="button" class="btn secondary" @onclick="ExportCsv">@(selected.Count>0 ? $"Xuất đã chọn ({selected.Count})" : "Xuất dữ liệu")</button>}
                <label class="catalog-page-size">Số dòng
                    <select @bind="pageSize" @bind:after="ResetPage">
                        <option value="10">10</option><option value="25">25</option><option value="50">50</option>
                    </select>
                </label>
            </div>
        </div>
        <p class="catalog-table-summary">@FilteredRows.Count bản ghi phù hợp · Trang @CurrentPage/@PageCount · @(selected.Count>0?$"Đã chọn {selected.Count} bản ghi để xuất":"Chưa chọn dòng: xuất toàn bộ dữ liệu phù hợp bộ lọc")</p>
        <div class="table-wrap">
            @if(CurrentSection=="installers")
            {
                <table>
                    <thead><tr>
                        <th><input type="checkbox" aria-label="Chọn tất cả dòng đang hiển thị" checked="@PageAllSelected" @onchange="TogglePage" /></th>
                        <th>Mã KT</th>
                        <th>Họ tên Người lắp đặt</th>
                        <th>Số điện thoại</th>
                        <th>Phân loại / Bộ phận</th>
                        <th>Định mức công lắp theo sản phẩm</th>
                        @if(canUpdate || canAudit){<th>Thao tác</th>}
                    </tr></thead>
                    <tbody>
                        @foreach(var row in PageRows)
                        {
                            var inst = installers.FirstOrDefault(x => x.Id == row.Id);
                            <tr @key="row.Id">
                                <td><input type="checkbox" aria-label="@($"Chọn {row.Name}")" checked="@selected.Contains(row.Id)" @onchange="e => ToggleRow(row.Id,e.Value is bool b && b)" /></td>
                                <td><span class="chip orange-chip">@row.Code</span></td>
                                <td class="name-cell"><strong>@row.Name</strong></td>
                                <td>
                                    @if(!string.IsNullOrWhiteSpace(inst?.Phone))
                                    {
                                        <strong>@inst.Phone</strong>
                                    }
                                    else
                                    {
                                        <span style="color:#999ca7">Chưa cập nhật</span>
                                    }
                                </td>
                                <td><span class="chip blue-chip">@row.Group</span></td>
                                <td style="white-space:normal;max-width:480px">
                                    @if(inst?.RateChips is { Count: > 0 } chips)
                                    {
                                        <div style="display:flex;flex-wrap:wrap;gap:4px">
                                            @foreach(var c in chips)
                                            {
                                                <span class="chip green-chip" title="@c.ProductName">@c.Sku: @c.Rate.ToString("N0") ₫</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="chip">Chưa đặt đơn giá SP</span>
                                    }
                                </td>
                                @if(canUpdate || canAudit)
                                {
                                    <td class="catalog-row-actions">
                                        @if(canAudit){<a class="btn secondary btn-sm" href="@($"/activity/{ActivityTable}/{row.Id}")">Lịch sử</a>}
                                        @if(canUpdate)
                                        {
                                            <button type="button" class="btn secondary btn-sm" @onclick="() => EditRow(row)">Cấu hình &amp; Sửa</button>
                                            @if(pendingDelete==row.Id)
                                            {
                                                <button type="button" class="btn btn-sm" @onclick="() => DeleteRow(row)">Xác nhận xóa</button>
                                                <button type="button" class="btn secondary btn-sm" @onclick="() => pendingDelete=null">Hủy</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn secondary btn-sm" @onclick="() => pendingDelete=row.Id">Xóa</button>
                                            }
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        @if(PageRows.Count==0)
                        {
                            <tr><td colspan="@(canUpdate||canAudit?7:6)">Chưa có người lắp đặt nào. Bấm <strong>“+ Khai báo người lắp đặt”</strong> ở góc phải để thêm kỹ thuật viên hoặc đối tác lắp đặt.</td></tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <table>
                    <thead><tr>
                        <th><input type="checkbox" aria-label="Chọn tất cả dòng đang hiển thị" checked="@PageAllSelected" @onchange="TogglePage" /></th>
                        <th>Mã / ID</th><th>Tên / đối tượng</th><th>Nhóm / khu vực</th><th>Thông tin</th>
                        @if(canUpdate || canAudit){<th>Thao tác</th>}
                    </tr></thead>
                    <tbody>
                        @foreach(var row in PageRows)
                        {
                            <tr @key="row.Id">
                                <td><input type="checkbox" aria-label="@($"Chọn {row.Name}")" checked="@selected.Contains(row.Id)" @onchange="e => ToggleRow(row.Id,e.Value is bool b && b)" /></td>
                                <td><strong>@row.Code</strong></td><td class="name-cell">@row.Name</td><td>@row.Group</td><td>@row.Details</td>
                                @if(canUpdate || canAudit)
                                {
                                    <td class="catalog-row-actions">
                                        @if(canAudit){<a class="btn secondary btn-sm" href="@($"/activity/{ActivityTable}/{row.Id}")">Lịch sử</a>}
                                        @if(canUpdate)
                                        {
                                        <button type="button" class="btn secondary btn-sm" @onclick="() => EditRow(row)">Sửa</button>
                                        @if(pendingDelete==row.Id)
                                        {
                                            <button type="button" class="btn btn-sm" @onclick="() => DeleteRow(row)">Xác nhận xóa</button>
                                            <button type="button" class="btn secondary btn-sm" @onclick="() => pendingDelete=null">Hủy</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn secondary btn-sm" @onclick="() => pendingDelete=row.Id">Xóa</button>
                                        }
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        @if(PageRows.Count==0)
                        {
                            <tr><td colspan="@(canUpdate||canAudit?6:5)">Không có dữ liệu phù hợp. Bấm “Thêm mới” để khai báo.</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <div class="catalog-pagination">
            <span>Hiển thị @(FilteredRows.Count==0?0:(CurrentPage-1)*pageSize+1)–@Math.Min(FilteredRows.Count,CurrentPage*pageSize) / @FilteredRows.Count</span>
            <div class="button-group">
                <button type="button" class="btn secondary btn-sm" disabled="@(CurrentPage==1)" @onclick="() => GoPage(1)">Đầu</button>
                <button type="button" class="btn secondary btn-sm" disabled="@(CurrentPage==1)" @onclick="() => GoPage(CurrentPage-1)">Trước</button>
                <span class="catalog-page-label">@CurrentPage / @PageCount</span>
                <button type="button" class="btn secondary btn-sm" disabled="@(CurrentPage==PageCount)" @onclick="() => GoPage(CurrentPage+1)">Sau</button>
                <button type="button" class="btn secondary btn-sm" disabled="@(CurrentPage==PageCount)" @onclick="() => GoPage(PageCount)">Cuối</button>
            </div>
        </div>
    </section>

}
@code {
    [Parameter] public string? Section { get; set; }
    private const int MaxPageSize=50;
    private sealed record CatalogRow(long Id,string Code,string Name,string Group,string Details);
    private readonly HashSet<long> selected=[];
    private long? editingId,pendingDelete;
    private bool showEditor,canView,canCreate,canUpdate,canExport,canAudit,scrollEditorPending;
    private string query="",search="",message="",code="",name="",phone="",address="",tax="",sourceName="",representativeName="",department="Kỹ thuật",installerProdSearch="";
    private long groupId,productId,buyPrice,standard,installed,renewal,bulkInstallerRate=150000;
