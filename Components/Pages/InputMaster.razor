    private void ResetFields(){editingId=null;code=name=phone=tax=address=sourceName=representativeName=installerProdSearch=quickSubGroupName="";showQuickSubGroup=false;department=CurrentSection=="sellers"?"Sale Nội bộ (Kinh doanh)":"Kỹ thuật";groupId=parentGroupId=subGroupId=productId=buyPrice=standard=installed=renewal=selectedSellerId=0;if(CurrentSection=="sellers"){standard=100000;renewal=50000;}bulkInstallerRate=150000;discount=0;effective=DateTime.Today;until=DateTime.Today.AddDays(30);installerProductRates.Clear();pendingDelete=null;}
    private void OnCustomerMainGroupChanged()
    {
        if (subGroupId > 0 && !customerGroups.Any(x => x.Id == subGroupId && x.ParentId == groupId))
        {
            subGroupId = 0;
        }
    }
    private void AddChildGroup(long parentId)
    {
        ResetFields();
        parentGroupId = parentId;
        var parentName = customerGroups.FirstOrDefault(x => x.Id == parentId)?.Name ?? "Đại lý";
        var nextIndex = customerGroups.Count(x => x.ParentId == parentId) + 1;
        name = $"{parentName} — Nhóm giá {nextIndex}";
        showEditor = true;
        scrollEditorPending = true;
        message = "";
    }
    private async Task QuickCreateSubGroupInline()
    {
        try
        {
            if (groupId <= 0)
            {
                message = "Vui lòng chọn Bước 1 (Nhóm khách hàng) trước khi tạo nhóm con.";
                return;
            }
            var trimmed = (quickSubGroupName ?? "").Trim();
            if (string.IsNullOrWhiteSpace(trimmed))
            {
                message = "Vui lòng nhập tên nhóm con cần tạo.";
                return;
            }
            var actor = await Gate.RequireAsync(Permissions.CustomersCreate);
            var createdSubId = Catalog.SaveGroup(actor, "CUSTOMER", null, "", trimmed, groupId);
            customerGroups = Catalog.CustomerGroupChoices();
            subGroupId = createdSubId;
            quickSubGroupName = "";
            showQuickSubGroup = false;
            message = $"Đã tạo và chọn ngay nhóm con \"{trimmed}\".";
        }
        catch (Exception ex)
        {
            message = "Không thể tạo nhóm con: " + ex.Message;
        }
    }
