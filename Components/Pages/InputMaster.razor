    private long GetInstallerRateInput(long prodId)=>installerProductRates.TryGetValue(prodId,out var v)?v:0;
    private void SetInstallerRateInput(long prodId,object? val){if(long.TryParse(val?.ToString(),out var v)&&v>=0)installerProductRates[prodId]=v;else installerProductRates.Remove(prodId);}
    private void SetInstallerRateDirect(long prodId,long rate){if(rate>=0)installerProductRates[prodId]=rate;}
    private void ApplyBulkInstallerRate(long rate)
    {
        var validRate = Math.Max(0, rate);
        foreach(var p in FilteredInstallerProducts)
        {
            installerProductRates[p.Id] = validRate;
        }
    }
    private void Create(){ResetFields();if(CurrentSection=="customers")code=Catalog.PeekNextCustomerCode();else if(CurrentSection=="installers")code=Catalog.PeekNextInstallerCode();else if(CurrentSection=="sellers")code=Catalog.PeekNextSellerCode();showEditor=true;scrollEditorPending=true;message="";}
    private void CloseEditor(){showEditor=false;scrollEditorPending=false;ResetFields();}
    private void EditRow(CatalogRow row)
    {
        ResetFields();editingId=row.Id;showEditor=true;scrollEditorPending=true;message="";
        switch(CurrentSection)
        {
            case "supplier-groups":case "product-groups":case "areas":
                code=row.Code;name=row.Name;break;
            case "customer-groups":
            {
                var cg = customerGroups.FirstOrDefault(g => g.Id == row.Id);
                code = cg?.Code ?? row.Code;
                name = cg?.Name ?? row.Name;
                parentGroupId = cg?.ParentId ?? 0;
                break;
            }
            case "suppliers":{var x=suppliers.First(s=>s.Id==row.Id);code=x.Code;name=x.Name;phone=x.Phone;tax=x.TaxCode;groupId=x.GroupId??0;break;}
            case "customers":
            {
                var x=customers.First(c=>c.Id==row.Id);
                code=x.Code;name=x.Name;representativeName=x.RepresentativeName;phone=x.Phone;address=x.Address;sourceName=x.SourceName;
                groupId=x.GroupId??0;subGroupId=x.SubGroupId??0;selectedSellerId=x.SellerId??0;
                var cg = customerGroups.FirstOrDefault(g => g.Id == groupId);
                if (cg?.ParentId is > 0)
                {
                    subGroupId = cg.Id;
                    groupId = cg.ParentId.Value;
                }
                break;
            }
            case "sellers":{var x=sellers.First(s=>s.Id==row.Id);code=x.Code;name=x.Name;phone=x.Phone;department=x.Department;standard=x.OrderCommissionVnd;renewal=x.RenewalCommissionVnd;address=x.Notes;break;}
            case "installers":{var x=installers.First(i=>i.Id==row.Id);code=x.Code;name=x.Name;phone=x.Phone;department=x.Department;foreach(var kv in Catalog.InstallerRatesForEmployee(x.Id))installerProductRates[kv.Key]=kv.Value;break;}
            case "installer-rates":{var x=installerRates.First(r=>r.Id==row.Id);groupId=x.EmployeeId;productId=x.ProductId;buyPrice=x.InstallRate;effective=DateTime.ParseExact(x.EffectiveFrom,"yyyy-MM-dd",CultureInfo.InvariantCulture);break;}
            case "warehouses":{var x=warehouses.First(w=>w.Id==row.Id);code=x.Code;name=x.Name;address=x.Address;groupId=x.AreaId??0;break;}
            case "buy-prices":{var x=purchasePrices.First(p=>p.Id==row.Id);groupId=x.GroupId;productId=x.ProductId;buyPrice=x.UnitCost;effective=DateTime.ParseExact(x.EffectiveFrom,"yyyy-MM-dd",CultureInfo.InvariantCulture);break;}
            case "sale-prices":
            {
                var x=salePrices.First(p=>p.Id==row.Id);
                var cg = customerGroups.FirstOrDefault(g => g.Id == x.GroupId);
                if (cg?.ParentId is > 0) { groupId = cg.ParentId.Value; subGroupId = cg.Id; }
                else { groupId = x.GroupId; subGroupId = 0; }
                productId=x.ProductId;standard=x.Standard;installed=x.Installed;renewal=x.Renewal;
                effective=DateTime.ParseExact(x.EffectiveFrom,"yyyy-MM-dd",CultureInfo.InvariantCulture);
                break;
            }
            case "campaigns":
            {
                var x=campaigns.First(c=>c.Id==row.Id);
                var cg = customerGroups.FirstOrDefault(g => g.Id == x.GroupId);
                if (cg?.ParentId is > 0) { groupId = cg.ParentId.Value; subGroupId = cg.Id; }
                else { groupId = x.GroupId; subGroupId = 0; }
                name=x.Name;discount=x.Discount;
                effective=DateTime.ParseExact(x.From,"yyyy-MM-dd",CultureInfo.InvariantCulture);
                until=DateTime.ParseExact(x.To,"yyyy-MM-dd",CultureInfo.InvariantCulture);
                break;
            }
        }
    }
    private async Task Save()
    {
        try
        {
            var actor=await Gate.RequireAsync(editingId.HasValue?UpdatePermission:CreatePermission);
            var targetCustomerGroupId = subGroupId > 0 ? subGroupId : groupId;
            switch(CurrentSection)
            {
                case "supplier-groups":case "product-groups":case "customer-groups":case "areas": Catalog.SaveGroup(actor,GroupType,editingId,code,name,parentGroupId>0?parentGroupId:null);break;
                case "suppliers":Catalog.SaveSupplier(actor,editingId,code,name,groupId,phone,tax);break;
                case "customers":Catalog.SaveCustomer(actor,editingId,code,name,groupId,phone,address,sourceName,representativeName,selectedSellerId>0?selectedSellerId:null,subGroupId>0?subGroupId:null);break;
                case "sellers":Catalog.SaveSeller(actor,editingId,code,name,phone,department,standard,renewal,address);break;
                case "installers":Catalog.SaveInstaller(actor,editingId,code,name,phone,department,installerProductRates);break;
                case "installer-rates":if(editingId.HasValue)Catalog.UpdateInstallerRate(actor,editingId.Value,groupId,productId,buyPrice,effective);else Catalog.SetInstallerRate(actor,groupId,productId,buyPrice,effective);break;
                case "warehouses":Catalog.SaveWarehouse(actor,editingId,code,name,groupId,address);break;
                case "buy-prices":if(editingId.HasValue)Catalog.UpdateSupplierGroupPrice(actor,editingId.Value,groupId,productId,buyPrice,effective);else Catalog.SetSupplierGroupPrice(actor,groupId,productId,buyPrice,effective);break;
                case "sale-prices":if(editingId.HasValue)Catalog.UpdateCustomerGroupPrice(actor,editingId.Value,targetCustomerGroupId,productId,standard,installed,renewal,effective);else Catalog.SetCustomerGroupPrice(actor,targetCustomerGroupId,productId,standard,installed,renewal,effective);break;
                case "campaigns":Catalog.SaveCampaign(actor,editingId,targetCustomerGroupId,name,discount,effective,until);break;
            }
            CloseEditor();Reload();selected.Clear();message="Đã lưu dữ liệu thành công.";
        }
        catch(Exception ex){message="Không thể lưu: "+ex.Message;}
    }
    private async Task DeleteRow(CatalogRow row)
    {
        try
        {
            var actor=await Gate.RequireAsync(UpdatePermission);
            if(IsGroup)Catalog.DeleteGroup(actor,GroupType,row.Id);
            else if(CurrentSection=="suppliers")Catalog.DeleteEntity(actor,"SUPPLIER",row.Id);
            else if(CurrentSection=="customers")Catalog.DeleteEntity(actor,"CUSTOMER",row.Id);
            else if(CurrentSection=="sellers")Catalog.DeleteEntity(actor,"SELLER",row.Id);
            else if(CurrentSection=="installers")Catalog.DeleteEntity(actor,"INSTALLER",row.Id);
            else if(CurrentSection=="installer-rates")Catalog.DeletePrice(actor,"INSTALLER_RATE",row.Id);
            else if(CurrentSection=="warehouses")Catalog.DeleteEntity(actor,"WAREHOUSE",row.Id);
            else if(CurrentSection=="buy-prices")Catalog.DeletePrice(actor,"BUY",row.Id);
            else if(CurrentSection=="sale-prices")Catalog.DeletePrice(actor,"SALE",row.Id);
            else if(CurrentSection=="campaigns")Catalog.DeleteCampaign(actor,row.Id);
            pendingDelete=null;selected.Remove(row.Id);Reload();message="Đã xóa bản ghi. Các khóa ngoại chứng từ vẫn được bảo vệ.";
        }
        catch(Exception ex){pendingDelete=null;message="Không thể xóa: "+ex.Message;}
    }
    private async Task ExportCsv()
    {
        if(!canExport)return;
        var rows=(selected.Count>0?Rows.Where(r=>selected.Contains(r.Id)):FilteredRows.AsEnumerable()).ToList();
        var rowIds = rows.Select(r => r.Id).ToHashSet();
        string[] headers;
        IEnumerable<object?[]> dataRows;

        switch (CurrentSection)
        {
            case "customers":
            {
                headers = ["STT", "Mã KH", "Tên Đơn vị / Khách hàng", "Người đại diện", "Số điện thoại", "Nhóm khách hàng", "Nhóm con của nhóm", "Nhân viên bán hàng", "Địa chỉ"];
                var items = customers.Where(c => rowIds.Contains(c.Id)).ToList();
                dataRows = items.Select((x, idx) => new object?[]
                {
                    idx + 1, x.Code, x.Name, x.RepresentativeName, x.Phone, x.Group, x.SubGroupName, x.SourceName, x.Address
                });
                break;
            }
            case "sellers":
            {
                headers = ["STT", "Mã NV", "Họ tên Nhân viên bán hàng", "Số điện thoại", "Bộ phận", "Số KH phụ trách", "Đơn hoàn thành", "Số thiết bị hoàn thành", "Doanh thu bán mới (VND)", "Lượt gia hạn", "Doanh thu gia hạn (VND)", "Định mức HH đơn (VND)", "Định mức HH gia hạn (VND)", "Hoa hồng dự kiến (VND)", "Ghi chú"];
                var items = sellers.Where(s => rowIds.Contains(s.Id)).ToList();
                dataRows = items.Select((x, idx) => new object?[]
                {
                    idx + 1, x.Code, x.Name, x.Phone, x.Department, x.CustomerCount, x.CompletedOrders, x.CompletedDevices, x.SalesRevenueVnd, x.RenewalCount, x.RenewalRevenueVnd, x.OrderCommissionVnd, x.RenewalCommissionVnd, x.EstimatedCommissionVnd, x.Notes
                });
                break;
            }
            case "installers":
            {
                headers = ["STT", "Mã KT", "Họ tên Người lắp đặt", "Số điện thoại", "Bộ phận / Phân loại", "Định mức công lắp theo sản phẩm"];
                var items = installers.Where(i => rowIds.Contains(i.Id)).ToList();
                dataRows = items.Select((x, idx) => new object?[]
                {
                    idx + 1, x.Code, x.Name, x.Phone, x.Department, x.RateSummary
                });
                break;
            }
            case "suppliers":
            {
                headers = ["STT", "Mã NCC", "Tên Nhà cung cấp", "Nhóm NCC", "Số điện thoại", "Mã số thuế"];
                var items = suppliers.Where(s => rowIds.Contains(s.Id)).ToList();
                dataRows = items.Select((x, idx) => new object?[]
                {
                    idx + 1, x.Code, x.Name, x.Group, x.Phone, x.TaxCode
                });
                break;
            }
            case "warehouses":
            {
                headers = ["STT", "Mã Kho", "Tên Kho", "Khu vực", "Tổng IMEI", "IMEI trong kho", "IMEI đã kích hoạt", "Địa chỉ"];
                var items = warehouses.Where(w => rowIds.Contains(w.Id)).ToList();
                dataRows = items.Select((x, idx) => new object?[]
                {
                    idx + 1, x.Code, x.Name, x.Area, x.ImeiCount, x.InStockCount, x.InstalledCount, x.Address
                });
                break;
            }
            case "sale-prices":
            {
                headers = ["STT", "Sản phẩm", "Nhóm khách hàng / Nhóm con", "Giá bán chuẩn (VND)", "Giá lắp đặt (VND)", "Giá gia hạn (VND)", "Ngày hiệu lực"];
                var items = salePrices.Where(p => rowIds.Contains(p.Id)).ToList();
                dataRows = items.Select((x, idx) => new object?[]
                {
                    idx + 1, x.Product, x.Group, x.Standard, x.Installed, x.Renewal, x.EffectiveFrom
                });
                break;
            }
            case "buy-prices":
            {
                headers = ["STT", "Sản phẩm", "Nhóm Nhà cung cấp", "Đơn giá nhập (VND)", "Ngày hiệu lực"];
                var items = purchasePrices.Where(p => rowIds.Contains(p.Id)).ToList();
                dataRows = items.Select((x, idx) => new object?[]
                {
                    idx + 1, x.Product, x.Group, x.UnitCost, x.EffectiveFrom
                });
                break;
            }
            case "campaigns":
            {
                headers = ["STT", "Tên chương trình ưu đãi", "Nhóm khách hàng / Nhóm con", "Mức giảm (%)", "Từ ngày", "Đến ngày", "Trạng thái"];
                var items = campaigns.Where(c => rowIds.Contains(c.Id)).ToList();
                dataRows = items.Select((x, idx) => new object?[]
                {
                    idx + 1, x.Name, x.Group, x.Discount, x.From, x.To, x.Active ? "Đang bật" : "Đã tắt"
                });
                break;
            }
            default:
            {
                headers = ["STT", "Mã / ID", "Tên / Đối tượng", "Nhóm / Khu vực", "Thông tin chi tiết"];
                dataRows = rows.Select((x, idx) => new object?[]
                {
                    idx + 1, x.Code, x.Name, x.Group, x.Details
                });
                break;
            }
        }

        Trail.RecordAction(await Gate.RequireAsync(ReadPermission),"EXPORT","catalog/"+CurrentSection,$"{rows.Count} bản ghi");
        await ExcelExporter.DownloadAsync(JS, CurrentSection, Title, headers, dataRows);
        message=$"Đã xuất file Excel (.xlsx) gồm {rows.Count} bản ghi {(selected.Count>0?"đã chọn":"phù hợp bộ lọc")}.";
    }
    private static string Money(long value)=>value.ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))+" đ";
}
