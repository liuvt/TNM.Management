@page "/input-catalog"
@page "/catalog/{Section}"
@attribute [Authorize]
@inject InputCatalog Catalog
@inject PermissionGate Gate
@inject IJSRuntime JS
@inject AuditTrail Trail
@inject NavigationManager Nav
<PageTitle>@Title · TNM.Management</PageTitle>
<div class="page-head">
    <div>
        <div class="eyebrow">@(CurrentSection is "warehouses" or "areas" ? "KHO & THIẾT BỊ / DANH SÁCH KHO" : "KINH DOANH / DANH MỤC")</div>
        <h1>@Title</h1>
        <p>@Description</p>
    </div>
    <div class="button-group">
        @if(CurrentSection is "installers" or "installer-rates")
        {
            <a class="btn secondary" href="/sales-orders">Đơn hàng &amp; Điều phối →</a>
        }
        else if(CurrentSection=="sellers")
        {
            <a class="btn secondary" href="/sales-orders">Đơn hàng lắp đặt (SO) →</a>
            <a class="btn secondary" href="/devices">Gia hạn thiết bị →</a>
            <a class="btn secondary" href="/finance">Kế toán &amp; Thống kê cuối kỳ →</a>
        }
        @if(canCreate && IsValidSection)
        {
            <button type="button" class="btn" @onclick="Create">@(CurrentSection=="installers" ? "+ Khai báo người lắp đặt" : CurrentSection=="sellers" ? "+ Khai báo nhân viên bán hàng" : CurrentSection=="warehouses" ? "+ Thêm Kho mới" : CurrentSection=="areas" ? "+ Thêm Khu vực" : "+ Thêm mới")</button>
        }
    </div>
</div>

@if(CurrentSection == "product-groups")
{
    <div class="crud-actionbar" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px">
        <a class="btn secondary" href="/products">
            Chi tiết Sản phẩm (@products.Count)
        </a>
        <a class="btn" href="/catalog/product-groups">
            Nhóm sản phẩm (@productGroups.Count)
        </a>
    </div>
}
else if(CurrentSection is "suppliers" or "supplier-groups")
{
    <div class="crud-actionbar" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px">
        <a class="btn @(CurrentSection == "suppliers" ? "" : "secondary")" href="/catalog/suppliers">
            Chi tiết / Đơn vị NCC (@suppliers.Count)
        </a>
        <a class="btn @(CurrentSection == "supplier-groups" ? "" : "secondary")" href="/catalog/supplier-groups">
            Nhóm NCC (@supplierGroups.Count)
        </a>
    </div>
}
else if(CurrentSection is "customers" or "customer-groups")
{
    <div class="crud-actionbar" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px">
        <a class="btn @(CurrentSection == "customers" ? "" : "secondary")" href="/catalog/customers">
            Chi tiết Khách hàng (@customers.Count)
        </a>
        <a class="btn @(CurrentSection == "customer-groups" ? "" : "secondary")" href="/catalog/customer-groups">
            Nhóm khách hàng (@customerGroups.Count)
        </a>
    </div>
}
else if(CurrentSection is "installers" or "installer-rates")
{
    <div class="crud-actionbar" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px">
        <a class="btn @(CurrentSection == "installers" ? "" : "secondary")" href="/catalog/installers">
            Chi tiết Người lắp đặt (@installers.Count)
        </a>
        <a class="btn @(CurrentSection == "installer-rates" ? "" : "secondary")" href="/catalog/installer-rates">
            Đơn giá theo sản phẩm (@installerRates.Count)
        </a>
    </div>
}
else if(CurrentSection is "buy-prices" or "sale-prices" or "campaigns")
{
    <div class="crud-actionbar" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px">
        <a class="btn @(CurrentSection == "buy-prices" ? "" : "secondary")" href="/catalog/buy-prices">
            Bảng giá nhập NCC (@purchasePrices.Count)
        </a>
        <a class="btn @(CurrentSection == "sale-prices" ? "" : "secondary")" href="/catalog/sale-prices">
            Bảng giá khách hàng (@salePrices.Count)
        </a>
        <a class="btn @(CurrentSection == "campaigns" ? "" : "secondary")" href="/catalog/campaigns">
            Chương trình ưu đãi (@campaigns.Count)
        </a>
    </div>
}
else if(CurrentSection is "warehouses" or "areas")
{
    <div class="crud-actionbar" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px">
        <a class="btn @(CurrentSection == "warehouses" ? "" : "secondary")" href="/catalog/warehouses">
            Chi tiết Kho (@warehouses.Count)
        </a>
        <a class="btn @(CurrentSection == "areas" ? "" : "secondary")" href="/catalog/areas">
            Khu vực (@areas.Count)
        </a>
    </div>
}
@if(!string.IsNullOrWhiteSpace(message)){<p class="feedback" role="status">@message</p>}
@if(!IsValidSection)
{
    <section class="panel"><p>Không tìm thấy danh mục này. <a href="/catalog/product-groups">Chọn nhóm sản phẩm</a>.</p></section>
}
else if(!canView)
{
    <section class="panel"><p>Bạn không có quyền truy cập danh mục này.</p></section>
}
else
{
    @if(CurrentSection=="installers")
    {
        <div class="stats-grid three">
            <div class="stat">
                <small>Tổng người lắp đặt</small>
                <strong>@installers.Count</strong>
                <span>Kỹ thuật viên nội bộ &amp; đối tác lắp đặt</span>
            </div>
            <div class="stat">
                <small>Đã cấu hình đơn giá lắp</small>
                <strong class="orange">@installers.Count(x => (x.RateChips?.Count ?? 0) > 0)</strong>
                <span>Người lắp đặt đã có định mức công lắp theo SP</span>
            </div>
            <div class="stat">
                <small>Sản phẩm áp dụng</small>
                <strong>@products.Count</strong>
                <span>Mã sản phẩm đang kinh doanh có thể gán công lắp</span>
            </div>
        </div>
    }
    else if(CurrentSection=="sellers")
    {
        <div class="stats-grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-bottom:16px">
            <div class="stat">
                <small>Tổng nhân viên bán hàng</small>
                <strong>@sellers.Count</strong>
                <span>Phụ trách @sellers.Sum(x => x.CustomerCount) khách hàng / đơn vị</span>
            </div>
            <div class="stat">
                <small>Đơn hàng hoàn thành</small>
                <strong style="color:#0284c7">@sellers.Sum(x => x.CompletedOrders) đơn · @sellers.Sum(x => x.CompletedDevices) TB</strong>
                <span>Doanh thu bán mới: @Money(sellers.Sum(x => x.SalesRevenueVnd))</span>
            </div>
            <div class="stat">
                <small>Thống kê Gia hạn thiết bị</small>
                <strong style="color:#15803d">@sellers.Sum(x => x.RenewalCount) lượt gia hạn</strong>
                <span>Doanh thu gia hạn: @Money(sellers.Sum(x => x.RenewalRevenueVnd))</span>
            </div>
            <div class="stat">
                <small>Hoa hồng dự kiến cuối kỳ</small>
                <strong class="orange">@Money(sellers.Sum(x => x.EstimatedCommissionVnd))</strong>
                <span>Tổng hợp bán mới + gia hạn thiết bị</span>
            </div>
        </div>
    }
    @if(showEditor && (editingId.HasValue?canUpdate:canCreate))
    {
        <section class="panel edit-panel catalog-editor" id="catalog-editor">
            <div class="panel-head">
                <div>
                    <h2>@(editingId.HasValue ? "Cập nhật" : "Khai báo mới") — @Title</h2>
                    <p>@(CurrentSection=="installers" ? "Khai báo hồ sơ người lắp đặt và thiết lập bảng định mức tiền công đi lắp theo từng sản phẩm." : CurrentSection=="sellers" ? "Khai báo nhân viên bán hàng của công ty để đồng bộ Khách hàng, Đơn hàng SO, Gia hạn thiết bị và thống kê hoa hồng cuối kỳ." : "Thông tin được dùng chung ở các luồng PO, SO, kho và thanh toán.")</p>
                </div>
                <button type="button" class="btn secondary" @onclick="CloseEditor">Đóng</button>
            </div>
            <div class="form-grid">
                @if(IsGroup)
                {
                    @if(CurrentSection=="customer-groups")
                    {
                        <label>Thuộc Nhóm khách hàng (Để trống nếu là Nhóm chính, chọn nếu là Nhóm con)
                            <select @bind="parentGroupId">
                                <option value="0">— Đây là Nhóm khách hàng chính (VD: Đại lý, Hợp tác xã, Khách lẻ) —</option>
                                @foreach(var pg in RootCustomerGroups.Where(x => x.Id != editingId))
                                {
                                    <option value="@pg.Id">↳ Nhóm con trực thuộc: @pg.Name (@pg.Code)</option>
                                }
                            </select>
                        </label>
                    }
                    <label>@(Section=="areas"?"Mã khu vực *":CurrentSection=="customer-groups" ? "Mã nhóm (Để trống tự động tạo mã)" : "Mã nhóm *")<input @bind="code" placeholder="@(CurrentSection=="customer-groups" ? "Tự động tạo nếu để trống (VD: DL-NHOM-1)" : CodeExample)" maxlength="32" /></label>
                    <label>@(Section=="areas"?"Tên khu vực *":CurrentSection=="customer-groups" && parentGroupId>0 ? "Tên nhóm con *" : "Tên nhóm *")<input @bind="name" placeholder="@(CurrentSection=="customer-groups" && parentGroupId>0 ? "VD: Đại lý — Nhóm giá 1 / Đại lý Miền Tây" : NameExample)" maxlength="160" /></label>
                }
                else if(Section is "suppliers" or "customers" or "warehouses")
                {
                    @if(CurrentSection=="customers")
                    {
                        <div style="grid-column:1 / -1;padding:0.85rem 1rem;background:#f0f9ff;border:1px solid #bae6fd;border-radius:10px;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:0.85rem;align-items:start">
                            <label style="margin:0">
                                <span style="font-weight:700;color:#0369a1">1. Chọn Nhóm khách hàng *</span>
                                <select @bind="groupId" @bind:after="OnCustomerMainGroupChanged" style="border-color:#7dd3fc;font-weight:600;background:#fff">
                                    <option value="0">— Bấm chọn Nhóm (Đại lý / HTX / Khách lẻ...) —</option>
                                    @foreach(var g in RootCustomerGroups)
                                    {
                                        <option value="@g.Id">@g.Name (@g.Code)</option>
                                    }
                                </select>
                            </label>
                            <div style="display:flex;flex-direction:column;gap:0.4rem">
                                <label style="margin:0">
                                    <span style="font-weight:700;color:#0f766e">2. Chọn Nhóm con của nhóm @(SelectedMainGroupName is { Length: > 0 } mgn ? $"({mgn})" : "")</span>
                                    <div style="display:flex;gap:0.4rem;align-items:center">
                                        <select @bind="subGroupId" disabled="@(groupId <= 0)" style="flex:1;border-color:#5eead4;font-weight:600;background:@(groupId <= 0 ? "#f1f5f9" : "#fff")">
                                            <option value="0">@(groupId <= 0 ? "— Chọn Bước 1 (Nhóm khách hàng) trước —" : $"— Giá chuẩn mặc định của {SelectedMainGroupName} —")</option>
                                            @foreach(var sg in SubGroupsForSelectedMainGroup)
                                            {
                                                <option value="@sg.Id">↳ @sg.Name</option>
                                            }
                                        </select>
                                        @if(groupId > 0)
                                        {
                                            <button type="button" class="btn secondary btn-sm" style="white-space:nowrap;border-color:#0d9488;color:#0f766e" @onclick="() => showQuickSubGroup = !showQuickSubGroup">
                                                @(showQuickSubGroup ? "Đóng" : "+ Tạo nhóm con")
                                            </button>
                                        }
                                    </div>
                                </label>
                                @if(showQuickSubGroup && groupId > 0)
                                {
                                    <div style="display:flex;gap:0.4rem;align-items:center;background:#fff;padding:0.45rem;border:1px dashed #0d9488;border-radius:8px">
                                        <input @bind="quickSubGroupName" placeholder="@($"Tên nhóm con mới thuộc {SelectedMainGroupName} (VD: Nhóm giá VIP)...")" style="flex:1;min-height:32px;padding:4px 8px" />
                                        <button type="button" class="btn btn-sm" @onclick="QuickCreateSubGroupInline">Tạo &amp; Chọn ngay</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <label>@(Section=="suppliers"?"Nhóm nhà cung cấp":"Khu vực") *
                            <select @bind="groupId"><option value="0">— Chọn —</option>@foreach(var g in GroupChoices){<option value="@g.Id">@g.Name</option>}</select></label>
                    }
                    @if(CurrentSection=="customers")
                    {
                        <label>Mã khách hàng (tự động)
                            <input value="@(string.IsNullOrWhiteSpace(code) ? Catalog.PeekNextCustomerCode() : code)" readonly disabled style="background:#f1f5f9;color:#475569;cursor:not-allowed;font-weight:600" />
                        </label>
                    }
                    else
                    {
                        <label>Mã *<input @bind="code" placeholder="@CodeExample" maxlength="32" /></label>
                    }
                    <label>@(Section=="customers" ? "Tên khách hàng / Đơn vị *" : "Tên *")<input @bind="name" placeholder="@NameExample" maxlength="160" /></label>
                    @if(Section=="suppliers")
                    {
                        <label>Số điện thoại<input @bind="phone" placeholder="0901234567" /></label>
                        <label>Mã số thuế<input @bind="tax" placeholder="Nếu có" /></label>
                    }
                    else if(Section=="customers")
                    {
                        <label>Người đại diện (B2B)<input @bind="representativeName" placeholder="Để trống nếu khách lẻ; nhập người đại diện nếu đơn vị B2B" maxlength="160" /></label>
                        <label>Số điện thoại<input @bind="phone" placeholder="0901234567" /></label>
                        <label>Nhân viên bán hàng phụ trách *
                            <select @bind="selectedSellerId" @bind:after="OnCustomerSellerSelected">
                                <option value="0">— Chọn nhân viên bán hàng phụ trách —</option>
                                @foreach(var s in sellerChoices)
                                {
                                    <option value="@s.Id">@s.Code — @s.Name</option>
                                }
                            </select>
                        </label>
                        <label>Nguồn KH / Ghi chú NV bán hàng<input @bind="sourceName" placeholder="Tự động điền theo nhân viên bán hàng hoặc ghi chú thêm..." /></label>
                        <label>Địa chỉ<input @bind="address" placeholder="Địa chỉ liên hệ" /></label>
                    }
                    else
                    {
                        <label>Vị trí / Địa chỉ kho<input @bind="address" placeholder="Số nhà, đường, phường/xã..." /></label>
                    }
                }
                else if(Section=="sellers")
                {
                    <label>Mã nhân viên bán hàng (tự động cấp hoặc nhập mã riêng)
                        <input @bind="code" placeholder="@Catalog.PeekNextSellerCode()" maxlength="32" style="font-weight:700;color:#0284c7;background:#f0f9ff" />
                    </label>
                    <label>Họ tên nhân viên bán hàng *
                        <input @bind="name" placeholder="VD: Nguyễn Minh Anh" maxlength="160" />
                    </label>
                    <label>Số điện thoại liên hệ *
                        <input @bind="phone" placeholder="VD: 0909112233" />
                    </label>
                    <label>Bộ phận / Khối Kinh doanh *
                        <select @bind="department">
                            <option value="Sale Nội bộ (Kinh doanh)">Sale Nội bộ (Kinh doanh)</option>
                            <option value="Sale Đại lý / HTX (B2B)">Sale Đại lý / HTX (B2B)</option>
                            <option value="Sale Nội bộ & Gia hạn">Sale Nội bộ &amp; Gia hạn</option>
                            <option value="Cộng tác viên Sale (CTV)">Cộng tác viên Sale (CTV)</option>
                            <option value="Trưởng nhóm Kinh doanh">Trưởng nhóm Kinh doanh</option>
                        </select>
                    </label>
                    <label>Định mức hoa hồng bán mới (VND / thiết bị)
                        <input type="number" min="0" step="10000" @bind="standard" />
                    </label>
                    <label>Định mức hoa hồng gia hạn (VND / lượt)
                        <input type="number" min="0" step="10000" @bind="renewal" />
                    </label>
                    <label style="grid-column:span 2">Ghi chú / Khu vực phụ trách
                        <input @bind="address" placeholder="VD: Phụ trách khối HTX khu vực Miền Nam..." />
                    </label>
                }
                else if(Section=="installers")
                {
                    <label>Mã người lắp đặt (tự động cấp hoặc nhập mã riêng)
                        <input @bind="code" placeholder="@Catalog.PeekNextInstallerCode()" maxlength="32" style="font-weight:700;color:#c94833;background:#fffaf8" />
                    </label>
                    <label>Họ tên người lắp đặt / Đội kỹ thuật *
                        <input @bind="name" placeholder="VD: Trần Quốc Bảo / Đội lắp đặt Khu vực HCM" maxlength="160" />
                    </label>
                    <label>Số điện thoại liên hệ *
                        <input @bind="phone" placeholder="VD: 0901234567" />
                    </label>
                    <label>Phân loại / Bộ phận *
                        <select @bind="department">
                            <option value="Kỹ thuật">Kỹ thuật nội bộ (Kỹ thuật)</option>
                            <option value="Cộng tác viên lắp đặt">Cộng tác viên lắp đặt</option>
                            <option value="Đại lý / Đối tác lắp đặt">Đại lý / Đối tác lắp đặt</option>
                            <option value="Kỹ thuật bảo hành & lắp đặt">Kỹ thuật bảo hành &amp; lắp đặt</option>
                        </select>
                    </label>
                }
                else if(Section=="installer-rates")
                {
                    <label>Người lắp đặt *
                        <select @bind="groupId"><option value="0">— Chọn người lắp đặt —</option>@foreach(var e in installerChoices){<option value="@e.Id">@e.Code — @e.Name</option>}</select></label>
                    <label>Sản phẩm *<select @bind="productId"><option value="0">— Chọn sản phẩm —</option>@foreach(var p in products){<option value="@p.Id">@p.Code — @p.Name</option>}</select></label>
                    <label>Đơn giá đi lắp (VND) *<input type="number" min="0" @bind="buyPrice" /></label>
                    <label>Ngày áp dụng *<input type="date" @bind="effective" @bind:format="yyyy-MM-dd" /></label>
                }
                else if(Section is "buy-prices" or "sale-prices")
                {
                    @if(Section=="buy-prices")
                    {
                        <label>Nhóm NCC *
                            <select @bind="groupId"><option value="0">— Chọn nhóm NCC —</option>@foreach(var g in GroupChoices){<option value="@g.Id">@g.Name</option>}</select>
                        </label>
                    }
                    else
                    {
                        <div style="grid-column:1 / -1;padding:0.85rem 1rem;background:#f0f9ff;border:1px solid #bae6fd;border-radius:10px;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:0.85rem;align-items:start">
                            <label style="margin:0">
                                <span style="font-weight:700;color:#0369a1">1. Chọn Nhóm khách hàng *</span>
                                <select @bind="groupId" @bind:after="OnCustomerMainGroupChanged" style="border-color:#7dd3fc;font-weight:600;background:#fff">
                                    <option value="0">— Bấm chọn Nhóm (Đại lý / HTX / Khách lẻ...) —</option>
                                    @foreach(var g in RootCustomerGroups)
                                    {
                                        <option value="@g.Id">@g.Name (@g.Code)</option>
                                    }
                                </select>
                            </label>
                            <div style="display:flex;flex-direction:column;gap:0.4rem">
                                <label style="margin:0">
                                    <span style="font-weight:700;color:#0f766e">2. Chọn Nhóm con của nhóm @(SelectedMainGroupName is { Length: > 0 } mgn ? $"({mgn})" : "")</span>
                                    <div style="display:flex;gap:0.4rem;align-items:center">
                                        <select @bind="subGroupId" disabled="@(groupId <= 0)" style="flex:1;border-color:#5eead4;font-weight:600;background:@(groupId <= 0 ? "#f1f5f9" : "#fff")">
                                            <option value="0">@(groupId <= 0 ? "— Chọn Bước 1 (Nhóm khách hàng) trước —" : $"— Giá chuẩn áp dụng chung cả nhóm {SelectedMainGroupName} —")</option>
                                            @foreach(var sg in SubGroupsForSelectedMainGroup)
                                            {
                                                <option value="@sg.Id">↳ @sg.Name</option>
                                            }
                                        </select>
                                        @if(groupId > 0)
                                        {
                                            <button type="button" class="btn secondary btn-sm" style="white-space:nowrap;border-color:#0d9488;color:#0f766e" @onclick="() => showQuickSubGroup = !showQuickSubGroup">
                                                @(showQuickSubGroup ? "Đóng" : "+ Tạo nhóm con")
                                            </button>
                                        }
                                    </div>
                                </label>
                                @if(showQuickSubGroup && groupId > 0)
                                {
                                    <div style="display:flex;gap:0.4rem;align-items:center;background:#fff;padding:0.45rem;border:1px dashed #0d9488;border-radius:8px">
                                        <input @bind="quickSubGroupName" placeholder="@($"Tên nhóm con mới thuộc {SelectedMainGroupName}...")" style="flex:1;min-height:32px;padding:4px 8px" />
                                        <button type="button" class="btn btn-sm" @onclick="QuickCreateSubGroupInline">Tạo &amp; Chọn ngay</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    <label>Sản phẩm *<select @bind="productId"><option value="0">— Chọn sản phẩm —</option>@foreach(var p in products){<option value="@p.Id">@p.Code — @p.Name</option>}</select></label>
                    <label>Ngày bắt đầu áp dụng *<input type="date" @bind="effective" @bind:format="yyyy-MM-dd" /></label>
                    @if(Section=="buy-prices")
                    {
                        <label>Giá nhập (VND) *<input type="number" min="0" @bind="buyPrice" /></label>
                    }
                    else
                    {
                        <label>Giá chưa lắp (VND) *<input type="number" min="0" @bind="standard" /></label>
                        <label>Giá có lắp (VND) *<input type="number" min="0" @bind="installed" /></label>
                        <label>Giá gia hạn (VND) *<input type="number" min="0" @bind="renewal" /></label>
                    }
                }
                else if(Section=="campaigns")
                {
                    <label>1. Chọn Nhóm khách hàng *
                        <select @bind="groupId" @bind:after="OnCustomerMainGroupChanged">
                            <option value="0">— Chọn nhóm khách hàng —</option>
                            @foreach(var g in RootCustomerGroups){<option value="@g.Id">@g.Name (@g.Code)</option>}
                        </select>
                    </label>
                    <label>2. Chọn Nhóm con của nhóm (Tùy chọn)
                        <select @bind="subGroupId" disabled="@(groupId <= 0)">
                            <option value="0">@(groupId <= 0 ? "— Chọn Nhóm khách hàng trước —" : $"— Áp dụng chung toàn nhóm {SelectedMainGroupName} —")</option>
                            @foreach(var sg in SubGroupsForSelectedMainGroup){<option value="@sg.Id">↳ @sg.Name</option>}
                        </select>
                    </label>
                    <label>Tên chương trình *<input @bind="name" placeholder="Ưu đãi đại lý" /></label>
                    <label>Chiết khấu (%) *<input type="number" min="0" max="100" @bind="discount" /></label>
                    <label>Ngày bắt đầu *<input type="date" @bind="effective" @bind:format="yyyy-MM-dd" /></label>
                    <label>Ngày kết thúc *<input type="date" @bind="until" @bind:format="yyyy-MM-dd" /></label>
                }
            </div>
            @if(Section=="installers" && products.Count>0)
            {
                <div style="margin-top:1.25rem;border-top:1px solid var(--line,#eaeaf0);padding-top:1rem">
                    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem;margin-bottom:0.85rem">
                        <div>
                            <h3 style="font-size:0.95rem;margin:0;color:#252637">Bảng định mức đơn giá công lắp theo sản phẩm (VND)</h3>
                            <small style="color:#747782">Đã thiết lập đơn giá cho <strong>@installerProductRates.Count(kv => kv.Value > 0) / @products.Count</strong> sản phẩm · Tự động tính công lắp khi điều phối đơn hàng SO.</small>
                        </div>
                        <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;background:#faf9f8;padding:0.5rem 0.75rem;border:1px solid #eeeef1;border-radius:9px">
                            <span style="font-size:11.5px;font-weight:650;color:#575866">Áp dụng nhanh tất cả SP:</span>
                            <input type="number" min="0" step="10000" @bind="bulkInstallerRate" placeholder="VD: 150000" style="width:125px;min-height:32px;padding:4px 8px;border:1px solid #e2e3e9;border-radius:6px" />
                            <button type="button" class="btn secondary btn-sm" @onclick="() => ApplyBulkInstallerRate(bulkInstallerRate)">Áp dụng</button>
                            <button type="button" class="btn secondary btn-sm" @onclick="() => ApplyBulkInstallerRate(100000)">100k</button>
                            <button type="button" class="btn secondary btn-sm" @onclick="() => ApplyBulkInstallerRate(150000)">150k</button>
                            <button type="button" class="btn secondary btn-sm" @onclick="() => ApplyBulkInstallerRate(200000)">200k</button>
                            <button type="button" class="btn secondary btn-sm" @onclick="() => ApplyBulkInstallerRate(0)">Đặt lại 0 ₫</button>
                        </div>
                    </div>
                    <div style="margin-bottom:0.65rem;display:flex;gap:0.6rem;align-items:center">
                        <input class="search-input" @bind="installerProdSearch" @bind:event="oninput" placeholder="Lọc nhanh mã DX hoặc tên sản phẩm..." style="max-width:320px;min-height:34px" />
                        @if(!string.IsNullOrWhiteSpace(installerProdSearch))
                        {
                            <button type="button" class="btn secondary btn-sm" @onclick="() => installerProdSearch = string.Empty">Xóa lọc SP</button>
                        }
                    </div>
                    @{ var pagedInstProds = instProdPager.Slice(FilteredInstallerProducts, out var totalInstProds); }
                    <div class="table-wrap" style="max-height:360px;overflow-y:auto">
                        <table>
                            <thead>
                                <tr>
                                    <th style="width:60px">STT</th>
                                    <th style="width:110px">Mã SP</th>
                                    <th>Tên sản phẩm</th>
                                    <th>Nhóm sản phẩm</th>
                                    <th style="width:200px">Đơn giá công lắp (VND)</th>
                                    <th style="width:220px">Mức chọn nhanh</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var (stt, p) in pagedInstProds)
                                {
                                    var pid = p.Id;
                                    var curRate = GetInstallerRateInput(pid);
                                    <tr>
                                        <td><strong>@stt</strong></td>
                                        <td><strong>@p.Code</strong></td>
                                        <td class="name-cell"><strong>@p.Name</strong></td>
                                        <td><span class="chip">@p.Group</span></td>
                                        <td>
                                            <div style="display:flex;align-items:center;gap:0.45rem">
                                                <input type="number" min="0" step="10000" value="@curRate" @onchange="e => SetInstallerRateInput(pid, e.Value)" placeholder="0" style="width:125px;min-height:32px;padding:4px 8px;border:1px solid @(curRate > 0 ? "#208464" : "#e2e3e9");border-radius:6px;font-weight:@(curRate > 0 ? "700" : "400")" />
                                                @if(curRate > 0)
                                                {
                                                    <span class="chip green-chip">@curRate.ToString("N0") ₫</span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="button-group" style="gap:4px">
                                                <button type="button" class="btn secondary btn-sm" @onclick="() => SetInstallerRateDirect(pid, 100000)">100k</button>
                                                <button type="button" class="btn secondary btn-sm" @onclick="() => SetInstallerRateDirect(pid, 150000)">150k</button>
                                                <button type="button" class="btn secondary btn-sm" @onclick="() => SetInstallerRateDirect(pid, 200000)">200k</button>
                                                @if(curRate > 0)
                                                {
                                                    <button type="button" class="btn secondary btn-sm" @onclick="() => SetInstallerRateDirect(pid, 0)">Xóa</button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <TablePager Pager="instProdPager" TotalCount="totalInstProds" />
                </div>
            }
            <div class="form-actions"><button type="button" class="btn" data-confirm="@(editingId.HasValue ? "edit" : "add")" data-confirm-msg="@(editingId.HasValue ? $"Bạn có chắc chắn muốn lưu cập nhật thông tin ({Title}) không?" : $"Bạn có chắc chắn muốn thêm mới dữ liệu vào ({Title}) không?")" @onclick="Save">@(CurrentSection=="installers" ? "Lưu người lắp đặt & đơn giá" : "Lưu dữ liệu")</button><button type="button" class="btn secondary" @onclick="CloseEditor">Hủy</button></div>
        </section>
    }
    <section class="panel">
        <div class="catalog-toolbar">
            <div class="catalog-toolbar-search">
                <label class="sr-only" for="catalog-search">Tìm kiếm trong danh mục</label>
                <input id="catalog-search" class="search-input" @bind="query" @bind:event="oninput" @onkeydown="OnSearchKeyDown" placeholder="@(CurrentSection=="installers" ? "Tìm mã KT, họ tên, SĐT, bộ phận hoặc mã SP..." : "Tìm mã, tên, nhóm, thông tin...")" />
                <button type="button" class="btn secondary" @onclick="ApplySearch">Tìm kiếm</button>
                <button type="button" class="btn secondary" @onclick="ClearSearch">Xóa lọc</button>
            </div>
            <div class="button-group">
                @if(canExport){<button type="button" class="btn secondary" data-confirm="none" @onclick="ExportCsv">📥 @(selected.Count>0 ? $"Xuất Excel đã chọn ({selected.Count})" : $"Xuất Excel ({FilteredRows.Count})")</button>}
                <label class="catalog-page-size">Số dòng
                    <select @bind="catalogPager.PageSize" @bind:after="ResetPage">
                        <option value="20">20</option><option value="50">50</option><option value="100">100</option>
                    </select>
                </label>
            </div>
        </div>
        <p class="catalog-table-summary">@FilteredRows.Count bản ghi phù hợp · Trang @CurrentPage/@PageCount · @(selected.Count>0?$"Đã chọn {selected.Count} bản ghi để xuất":"Chưa chọn dòng: xuất toàn bộ dữ liệu phù hợp bộ lọc")</p>
        @{ var pagedCatalogRows = catalogPager.Slice(FilteredRows, out var totalCatalogRows); }
        <div class="table-wrap">
            @if(CurrentSection=="installers")
            {
                <table>
                    <thead><tr>
                        <th>STT</th>
                        <th><input type="checkbox" aria-label="Chọn tất cả dòng đang hiển thị" checked="@PageAllSelected" @onchange="TogglePage" /></th>
                        <th>Mã KT</th>
                        <th>Họ tên Người lắp đặt</th>
                        <th>Số điện thoại</th>
                        <th>Phân loại / Bộ phận</th>
                        <th>Định mức công lắp theo sản phẩm</th>
                        @if(canUpdate || canAudit){<th>Thao tác</th>}
                    </tr></thead>
                    <tbody>
                        @foreach(var (stt, row) in pagedCatalogRows)
                        {
                            var inst = installers.FirstOrDefault(x => x.Id == row.Id);
                            <tr @key="row.Id">
                                <td><strong>@stt</strong></td>
                                <td><input type="checkbox" aria-label="@($"Chọn {row.Name}")" checked="@selected.Contains(row.Id)" @onchange="e => ToggleRow(row.Id,e.Value is bool b && b)" /></td>
                                <td><span class="chip orange-chip">@row.Code</span></td>
                                <td class="name-cell"><strong>@row.Name</strong></td>
                                <td>
                                    @if(!string.IsNullOrWhiteSpace(inst?.Phone))
                                    {
                                        <strong>@inst.Phone</strong>
                                    }
                                    else
                                    {
                                        <span style="color:#999ca7">Chưa cập nhật</span>
                                    }
                                </td>
                                <td><span class="chip blue-chip">@row.Group</span></td>
                                <td style="white-space:normal;max-width:480px">
                                    @if(inst?.RateChips is { Count: > 0 } chips)
                                    {
                                        <div style="display:flex;flex-wrap:wrap;gap:4px">
                                            @foreach(var c in chips)
                                            {
                                                <span class="chip green-chip" title="@c.ProductName">@c.Sku: @c.Rate.ToString("N0") ₫</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="chip">Chưa đặt đơn giá SP</span>
                                    }
                                </td>
                                @if(canUpdate || canAudit)
                                {
                                    <td class="catalog-row-actions">
                                        @if(canAudit){<a class="btn secondary btn-sm" href="@($"/activity/{ActivityTable}/{row.Id}")">Lịch sử</a>}
                                        @if(canUpdate)
                                        {
                                            <button type="button" class="btn secondary btn-sm" @onclick="() => EditRow(row)">Cấu hình &amp; Sửa</button>
                                            <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fca5a5" data-confirm="delete" data-confirm-msg="@($"Bạn có chắc chắn muốn xóa \"{row.Name}\" ({row.Code}) không?")" @onclick="() => DeleteRow(row)">Xóa</button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        @if(PageRows.Count==0)
                        {
                            <tr><td colspan="@(canUpdate||canAudit?8:7)">Chưa có người lắp đặt nào. Bấm <strong>“+ Khai báo người lắp đặt”</strong> ở góc phải để thêm kỹ thuật viên hoặc đối tác lắp đặt.</td></tr>
                        }
                    </tbody>
                </table>
            }
            else if(CurrentSection=="sellers")
            {
                <table>
                    <thead><tr>
                        <th>STT</th>
                        <th><input type="checkbox" aria-label="Chọn tất cả dòng đang hiển thị" checked="@PageAllSelected" @onchange="TogglePage" /></th>
                        <th>Mã NV bán hàng</th>
                        <th>Họ tên Nhân viên bán hàng</th>
                        <th>SĐT &amp; Bộ phận</th>
                        <th>KH phụ trách</th>
                        <th>Đơn hoàn thành (SL lắp)</th>
                        <th>Doanh thu bán mới</th>
                        <th>Gia hạn thiết bị (Doanh thu)</th>
                        <th>Định mức &amp; Hoa hồng dự kiến</th>
                        @if(canUpdate || canAudit){<th>Thao tác</th>}
                    </tr></thead>
                    <tbody>
                        @foreach(var (stt, row) in pagedCatalogRows)
                        {
                            var sl = sellers.FirstOrDefault(x => x.Id == row.Id);
                            <tr @key="row.Id">
                                <td><strong>@stt</strong></td>
                                <td><input type="checkbox" aria-label="@($"Chọn {row.Name}")" checked="@selected.Contains(row.Id)" @onchange="e => ToggleRow(row.Id,e.Value is bool b && b)" /></td>
                                <td><span class="chip blue-chip">@row.Code</span></td>
                                <td class="name-cell">
                                    <div><strong>@row.Name</strong></div>
                                    @if(!string.IsNullOrWhiteSpace(sl?.Notes))
                                    {
                                        <small style="color:#64748b">@sl.Notes</small>
                                    }
                                </td>
                                <td>
                                    <div><strong>@(string.IsNullOrWhiteSpace(sl?.Phone) ? "—" : sl.Phone)</strong></div>
                                    <span class="chip">@row.Group</span>
                                </td>
                                <td><strong>@(sl?.CustomerCount ?? 0)</strong> KH</td>
                                <td>
                                    <div><strong>@(sl?.CompletedOrders ?? 0)</strong> / @(sl?.TotalOrders ?? 0) đơn</div>
                                    <span class="chip green-chip">@(sl?.CompletedDevices ?? 0) thiết bị</span>
                                </td>
                                <td><strong style="color:#0284c7">@Money(sl?.SalesRevenueVnd ?? 0)</strong></td>
                                <td>
                                    <div><strong>@(sl?.RenewalCount ?? 0)</strong> lượt gia hạn</div>
                                    <small style="color:#15803d;font-weight:600">@Money(sl?.RenewalRevenueVnd ?? 0)</small>
                                </td>
                                <td>
                                    <div><strong style="color:#d97706">@Money(sl?.EstimatedCommissionVnd ?? 0)</strong></div>
                                    <small style="color:#64748b">Bán: @Money(sl?.OrderCommissionVnd ?? 0)/TB · GH: @Money(sl?.RenewalCommissionVnd ?? 0)/lượt</small>
                                </td>
                                @if(canUpdate || canAudit)
                                {
                                    <td class="catalog-row-actions">
                                        @if(canAudit){<a class="btn secondary btn-sm" href="@($"/activity/{ActivityTable}/{row.Id}")">Lịch sử</a>}
                                        @if(canUpdate)
                                        {
                                            <button type="button" class="btn secondary btn-sm" @onclick="() => EditRow(row)">Sửa</button>
                                            <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fca5a5" data-confirm="delete" data-confirm-msg="@($"Bạn có chắc chắn muốn xóa \"{row.Name}\" ({row.Code}) không?")" @onclick="() => DeleteRow(row)">Xóa</button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        @if(PageRows.Count==0)
                        {
                            <tr><td colspan="@(canUpdate||canAudit?11:10)">Chưa có nhân viên bán hàng nào. Bấm <strong>“+ Khai báo nhân viên bán hàng”</strong> ở góc phải để thêm nhân viên bán hàng.</td></tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <table>
                    <thead><tr>
                        <th>STT</th>
                        <th><input type="checkbox" aria-label="Chọn tất cả dòng đang hiển thị" checked="@PageAllSelected" @onchange="TogglePage" /></th>
                        <th>Mã / ID</th><th>Tên / đối tượng</th><th>Nhóm / khu vực</th><th>Thông tin</th>
                        @if(canUpdate || canAudit){<th>Thao tác</th>}
                    </tr></thead>
                    <tbody>
                        @foreach(var (stt, row) in pagedCatalogRows)
                        {
                            <tr @key="row.Id">
                                <td><strong>@stt</strong></td>
                                <td><input type="checkbox" aria-label="@($"Chọn {row.Name}")" checked="@selected.Contains(row.Id)" @onchange="e => ToggleRow(row.Id,e.Value is bool b && b)" /></td>
                                <td><strong>@row.Code</strong></td><td class="name-cell">@row.Name</td><td>@row.Group</td><td class="wrap-cell">@row.Details</td>
                                @if(canUpdate || canAudit)
                                {
                                    <td class="catalog-row-actions">
                                        @if(canAudit){<a class="btn secondary btn-sm" href="@($"/activity/{ActivityTable}/{row.Id}")">Lịch sử</a>}
                                        @if(canCreate && CurrentSection=="customer-groups" && customerGroups.FirstOrDefault(g => g.Id == row.Id)?.ParentId is null)
                                        {
                                            <button type="button" class="btn secondary btn-sm" style="color:#0f766e;border-color:#5eead4" @onclick="() => AddChildGroup(row.Id)">+ Thêm nhóm con</button>
                                        }
                                        @if(canUpdate)
                                        {
                                        <button type="button" class="btn secondary btn-sm" @onclick="() => EditRow(row)">Sửa</button>
                                        <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fca5a5" data-confirm="delete" data-confirm-msg="@($"Bạn có chắc chắn muốn xóa \"{row.Name}\" ({row.Code}) không?")" @onclick="() => DeleteRow(row)">Xóa</button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        @if(PageRows.Count==0)
                        {
                            <tr><td colspan="@(canUpdate||canAudit?7:6)">Không có dữ liệu phù hợp. Bấm “Thêm mới” để khai báo.</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <TablePager Pager="catalogPager" TotalCount="totalCatalogRows" OnChange="() => pendingDelete = null" />
    </section>

}
@code {
    [Parameter] public string? Section { get; set; }
    private const int MaxPageSize=100;
    private sealed record CatalogRow(long Id,string Code,string Name,string Group,string Details);
    private readonly HashSet<long> selected=[];
    private readonly PagerState instProdPager = new();
    private readonly PagerState catalogPager = new();
    private long? editingId,pendingDelete;
    private bool showEditor,canView,canCreate,canUpdate,canExport,canAudit,scrollEditorPending,showQuickSubGroup;
    private string query="",search="",message="",code="",name="",phone="",address="",tax="",sourceName="",representativeName="",department="Kỹ thuật",installerProdSearch="",quickSubGroupName="";
    private long groupId,parentGroupId,subGroupId,productId,buyPrice,standard,installed,renewal,bulkInstallerRate=150000,selectedSellerId;
    private int discount;
    private DateTime effective=DateTime.Today,until=DateTime.Today.AddDays(30);
    private readonly Dictionary<long, long> installerProductRates=[];
    private List<InputCatalog.SupplierGroup> supplierGroups=[];
    private List<InputCatalog.Choice> productGroups=[],customerGroups=[],supplierGroupChoices=[],installerChoices=[],sellerChoices=[];
    private List<InputCatalog.Supplier> suppliers=[];
    private List<InputCatalog.Customer> customers=[];
    private List<InputCatalog.Seller> sellers=[];
    private List<InputCatalog.Installer> installers=[];
    private List<InputCatalog.InstallerRate> installerRates=[];
    private List<InputCatalog.Warehouse> warehouses=[];
    private List<InputCatalog.Area> areas=[];
    private List<InputCatalog.Product> products=[];
    private List<InputCatalog.PurchasePrice> purchasePrices=[];
    private List<InputCatalog.SalePrice> salePrices=[];
    private List<InputCatalog.Campaign> campaigns=[];
    private IEnumerable<InputCatalog.Product> FilteredInstallerProducts => products.Where(p =>
        string.IsNullOrWhiteSpace(installerProdSearch) ||
        ($"{p.Code} {p.Name} {p.Group}").Contains(installerProdSearch.Trim(), StringComparison.OrdinalIgnoreCase));
    private string CurrentSection => Section ?? "product-groups";
    private string ActivityTable => CurrentSection switch {
        "supplier-groups"=>"supplier_groups","product-groups"=>"product_groups","customer-groups"=>"customer_groups",
        "areas"=>"warehouse_areas","suppliers"=>"suppliers","customers"=>"customers","sellers"=>"v7_sellers","warehouses"=>"warehouses",
        "installers"=>"employees","installer-rates"=>"v7_installer_product_rates",
        "buy-prices"=>"v7_supplier_group_prices","sale-prices"=>"v7_group_prices","campaigns"=>"v7_group_campaigns",_=>"products"};

    private bool IsValidSection => CurrentSection is "supplier-groups" or "suppliers" or "product-groups" or "customer-groups" or "customers" or "sellers" or "installers" or "installer-rates" or "areas" or "warehouses" or "buy-prices" or "sale-prices" or "campaigns";
    private bool IsGroup => CurrentSection is "supplier-groups" or "product-groups" or "customer-groups" or "areas";
    private string GroupType => CurrentSection switch {"supplier-groups"=>"SUPPLIER","product-groups"=>"PRODUCT","customer-groups"=>"CUSTOMER",_=>"AREA"};
    private string Title => CurrentSection switch {
        "supplier-groups"=>"Nhà cung cấp — Nhóm NCC", "suppliers"=>"Nhà cung cấp — Chi tiết / Đơn vị NCC", "product-groups"=>"Sản phẩm — Nhóm sản phẩm",
        "customer-groups"=>"Khách hàng — Nhóm khách hàng", "customers"=>"Khách hàng — Chi tiết Khách hàng",
        "sellers"=>"Nhân viên bán hàng",
        "installers"=>"Người lắp đặt — Chi tiết Người lắp đặt", "installer-rates"=>"Người lắp đặt — Đơn giá theo sản phẩm",
        "areas"=>"Danh sách Kho — Khu vực", "warehouses"=>"Danh sách Kho — Chi tiết Kho",
        "buy-prices"=>"Giá & Chương trình — Bảng giá nhập NCC", "sale-prices"=>"Giá & Chương trình — Bảng giá khách hàng", "campaigns"=>"Giá & Chương trình — Chương trình ưu đãi",_=>"Danh mục đầu vào"};
    private string Description => CurrentSection switch {
        "supplier-groups"=>"Phân loại các nhà cung cấp để thiết lập giá nhập riêng cho từng nhóm.",
