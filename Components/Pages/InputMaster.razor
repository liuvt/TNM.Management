    private List<CatalogRow> FilteredRows => Rows.Where(r=>string.IsNullOrWhiteSpace(search) || ($"{r.Code} {r.Name} {r.Group} {r.Details}").Contains(search.Trim(),StringComparison.OrdinalIgnoreCase)).ToList();
    private int PageCount=>catalogPager.PageCount(FilteredRows.Count);
    private int CurrentPage=>catalogPager.CurrentPage(FilteredRows.Count);
    private List<CatalogRow> PageRows=>FilteredRows.Skip((CurrentPage-1)*catalogPager.PageSize).Take(Math.Clamp(catalogPager.PageSize,1,MaxPageSize)).ToList();
    private bool PageAllSelected=>PageRows.Count>0 && PageRows.All(r=>selected.Contains(r.Id));
    protected override async Task OnParametersSetAsync()
    {
        if(Section is null && Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/')=="input-catalog")
        {
            Nav.NavigateTo("/catalog/product-groups",replace:true);
            return;
        }
        canView=await Gate.CanAsync(ReadPermission);
        canCreate=await Gate.CanAsync(CreatePermission);
        canUpdate=await Gate.CanAsync(UpdatePermission);
        canAudit=await Gate.CanAsync(Permissions.ReportsAuditView);
        canExport=canView;
        selected.Clear();catalogPager.Reset();instProdPager.Reset();search=query="";CloseEditor();message="";
        if(canView && IsValidSection)Reload();
    }
    private void Reload()
    {
        // Only query the master data needed by this route; never load price or supplier
        // records into a product-only / customer-only page.
        switch(CurrentSection)
        {
            case "supplier-groups":supplierGroups=Catalog.SupplierGroups();suppliers=Catalog.Suppliers();break;
            case "product-groups":productGroups=Catalog.ProductGroupChoices();products=Catalog.Products();break;
            case "customer-groups":customerGroups=Catalog.CustomerGroupChoices();customers=Catalog.Customers();break;
            case "areas":areas=Catalog.Areas();warehouses=Catalog.Warehouses();break;
            case "suppliers":suppliers=Catalog.Suppliers();supplierGroups=Catalog.SupplierGroups();supplierGroupChoices=Catalog.SupplierGroupChoices();break;
            case "customers":customers=Catalog.Customers();customerGroups=Catalog.CustomerGroupChoices();sellerChoices=Catalog.SellerChoices();break;
            case "sellers":sellers=Catalog.Sellers();break;
            case "installers":installers=Catalog.Installers();installerRates=Catalog.InstallerRates();products=Catalog.Products();break;
            case "installer-rates":installerRates=Catalog.InstallerRates();installers=Catalog.Installers();installerChoices=Catalog.InstallerChoices();products=Catalog.Products();break;
            case "warehouses":warehouses=Catalog.Warehouses();areas=Catalog.Areas();break;
            case "buy-prices":purchasePrices=Catalog.PurchasePrices();salePrices=Catalog.SalePrices();campaigns=Catalog.Campaigns();supplierGroupChoices=Catalog.SupplierGroupChoices();products=Catalog.Products();break;
            case "sale-prices":salePrices=Catalog.SalePrices();purchasePrices=Catalog.PurchasePrices();campaigns=Catalog.Campaigns();customerGroups=Catalog.CustomerGroupChoices();products=Catalog.Products();break;
            case "campaigns":campaigns=Catalog.Campaigns();purchasePrices=Catalog.PurchasePrices();salePrices=Catalog.SalePrices();customerGroups=Catalog.CustomerGroupChoices();break;
        }
    }
