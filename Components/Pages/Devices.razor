 private async Task ToggleRenewalLock(RenewalVm r){
  try{
   Db.ActorId = await Gate.RequireAsync(Permissions.DevicesView);
   var nextLock = !r.IsLocked;
   Db.SetRenewalLock(r.Id, nextLock);
   if (nextLock && editingRenewalId == r.Id) CancelEditRenewal();
   Reload();
   historyMessage = nextLock
    ? $"Đã chốt số / khóa số Kế toán cho đợt gia hạn #{r.Id} (IMEI {r.Imei}). Từ thời điểm này không thể chỉnh sửa hoặc xóa."
    : $"Đã mở khóa đợt gia hạn #{r.Id} (IMEI {r.Imei}).";
  }catch(Exception ex){historyMessage="Lỗi: "+ex.Message;}
 }
 private int DaysToExpiry(DeviceVm x) => DateTime.TryParse(x.ExpiresAt, out var dt) ? (dt.Date - DateTime.Today).Days : -9999;
 private static bool IsLocked(DeviceVm x) => !x.IsPreDeclared && string.Equals(x.Status, "DISABLED", StringComparison.OrdinalIgnoreCase);
 private void SetFilter(string nextFilter)
 {
  filter = nextFilter;
  devicePager.Reset();
 }
 private bool MatchSearch(DeviceVm x)
 {
  if (string.IsNullOrWhiteSpace(search)) return true;
  return (x.DisplayImei + " " + x.Sku + " " + x.DeviceTypeLabel + " " + x.Customer + " " + x.AgencyName + " " + x.OwnerName + " " + x.OwnerPhone + " " + x.Plate + " " + x.ContactName + " " + x.VinNo + " " + x.SellerName + " " + x.OrderCode + " " + x.LastRenewalOrderCode).Contains(search, StringComparison.OrdinalIgnoreCase);
 }
 private bool MatchFilter(DeviceVm x)
 {
  var days = DaysToExpiry(x);
  var locked = IsLocked(x);
  return filter switch {
   "ALL" => true,
   "PRE_DECLARE" => x.IsPreDeclared,
   "ACTIVE" => canActive && !x.IsPreDeclared && !locked && days >= 0,
   "DUE10" => canDue10 && !x.IsPreDeclared && !locked && days >= 0 && days <= 10,
   "DUE30" => canDue30 && !x.IsPreDeclared && !locked && days >= 0 && days <= 30,
   "DUE60" => canDue60 && !x.IsPreDeclared && !locked && days >= 0 && days <= 60,
   "OVERDUE" => canOverdue && !x.IsPreDeclared && days < 0,
   "LOCKED" => locked,
   _ => true
  };
 }
 private async Task ToggleDeviceLock(DeviceVm x){
  try{
   Db.ActorId = canUpdateDevice ? await Gate.RequireAsync(Permissions.DevicesView) : await Gate.RequireAsync(Permissions.DevicesRenew);
   var nextLock = !IsLocked(x);
   Db.SetDeviceLock(x.ActivationId, nextLock);
   Reload();
   listMessage = nextLock
    ? $"Đã tạm khóa thiết bị {x.DisplayImei} {(string.IsNullOrWhiteSpace(x.Plate) ? "" : $"({x.Plate})") }."
    : $"Đã mở khóa thiết bị {x.DisplayImei} {(string.IsNullOrWhiteSpace(x.Plate) ? "" : $"({x.Plate})") } — có thể thực hiện gia hạn ngay.";
  }catch(Exception ex){listMessage="Lỗi: "+ex.Message;}
 }
