 private async Task SaveNewManualDevice(){
  try
  {
   createMessage = "";
   Db.ActorId = canUpdateDevice ? await Gate.RequireAsync(Permissions.DevicesView) : await Gate.RequireAsync(Permissions.DevicesRenew);
   var isPre = createDeviceMode == "PRE_DECLARE";
   var normImei = isPre ? "" : (createImei ?? "").Trim();
   if (isPre && string.IsNullOrWhiteSpace(createPlate) && string.IsNullOrWhiteSpace(createVin) && string.IsNullOrWhiteSpace(createOwnerName))
    throw new InvalidOperationException("Vui lòng nhập ít nhất Biển số xe, Số khung hoặc Tên chủ xe khi khai báo xe chờ lắp đặt.");
   Db.CreateManualDeviceActivation(
    createCustomerId,
    createProductId,
    normImei,
    createPlate,
    createOwnerName,
    createOwnerPhone,
    createActivatedDate.ToString("yyyy-MM-dd"),
    createExpiresDate.ToString("yyyy-MM-dd"),
    createSellerId > 0 ? createSellerId : null,
    createDeviceTypeLabel,
    isPre ? "PENDING_INSTALL" : createDeviceStatus,
    createVin);
   var savedPlate = createPlate;
   createImei = "";
   pickedStockImei = "";
   createPlate = "";
   createVin = "";
   Reload();
   if (isPre)
   {
    filter = "PRE_DECLARE";
    createMessage = $"Đã khai báo sẵn hồ sơ xe {(string.IsNullOrWhiteSpace(savedPlate) ? "mới" : savedPlate)} chờ lên Đơn lắp đặt. Bạn có thể bấm '+ Tạo đơn lắp' ngay trên danh sách.";
   }
   else
   {
    createMessage = $"Đã thêm thành công thiết bị IMEI {normImei.ToUpperInvariant()} ({createDeviceTypeLabel}) · Hạn: {createActivatedDate:yyyy-MM-dd} → {createExpiresDate:yyyy-MM-dd}.";
   }
  }
  catch (Exception ex)
  {
   createMessage = "Lỗi: " + ex.Message;
  }
