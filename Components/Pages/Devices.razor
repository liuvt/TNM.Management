@attribute [Authorize(Policy = Permissions.DevicesView)]
@page "/devices"
@inject DemoDb Db
@inject PermissionGate Gate
<PageTitle>Thiết bị · TNM</PageTitle>
<div class="page-head"><div><div class="eyebrow">SUBSCRIPTIONS / RENEWAL</div><h1>Thiết bị đang hoạt động</h1><p>Theo dõi IMEI, biển số, ngày kích hoạt, hạn gia hạn và toàn bộ các lần gia hạn.</p></div></div>
<div class="crud-actionbar">
    @if(canRenew){<button type="button" class="btn secondary" @onclick="()=>ToggleForm(nameof(showRenew))">@(showRenew?"Đóng · + Gia hạn":"+ Gia hạn")</button>}
    @if(canRenew){<button type="button" class="btn secondary" @onclick="()=>ToggleForm(nameof(showEditAct))">@(showEditAct?"Đóng · Cập nhật Ngày kích hoạt IMEI":"Cập nhật Ngày kích hoạt IMEI")</button>}
    <a class="btn secondary" href="/catalog/sellers">Quản lý &amp; Thống kê Seller →</a>
</div>

@if(canRenew){<div class="panel edit-panel" hidden="@(!showRenew)"><div class="panel-head"><div><h2>Gia hạn thiết bị</h2><p>Chọn thiết bị IMEI và nhân viên bán hàng (Seller) phụ trách gia hạn để thống kê cuối kỳ và tính hoa hồng.</p></div></div>
<div class="form-grid">
<label>Thiết bị / biển số *
    <select @bind="activationId" @bind:after="OnRenewDeviceSelected">
        @foreach(var x in devices)
        {
            <option value="@x.ActivationId">@x.Imei — @x.Customer @(string.IsNullOrWhiteSpace(x.Plate) ? "" : $"({x.Plate})") · Hết hạn: @x.ExpiresAt</option>
        }
    </select>
</label>
<label>Nhân viên Seller gia hạn (Tính hoa hồng) *
    <select @bind="renewSellerId">
        <option value="0">— Chọn Seller phụ trách gia hạn —</option>
        @foreach(var sl in sellerChoices)
        {
            <option value="@sl.Id">@sl.Code — @sl.Name @(string.IsNullOrWhiteSpace(sl.Department) ? "" : $"({sl.Department})") [HH gia hạn: @sl.RenewalCommissionVnd.ToString("N0") ₫]</option>
        }
    </select>
</label>
<label>Nguồn gia hạn
    <select @bind="source">
        <option value="TNM">TNM</option>
        <option value="NCC">Nhà cung cấp</option>
        <option value="HTX">Hợp tác xã</option>
        <option value="B2C">Khách lẻ B2C</option>
    </select>
</label>
<label>Thanh toán
    <select @bind="method">
        <option value="DEBT">Ghi công nợ</option>
        <option value="CASH">Thanh toán ngay</option>
    </select>
</label>
</div>
<div class="form-actions"><button class="btn" @onclick="Renew">+ Gia hạn 12 tháng</button><span class="feedback">@message</span></div>
</div>}

@if(canRenew){<div class="panel edit-panel" hidden="@(!showEditAct)"><div class="panel-head"><div><h2>Bổ sung / Cập nhật Ngày kích hoạt IMEI &amp; Thông tin phụ</h2><p>Chọn thiết bị IMEI để bổ sung hoặc điều chỉnh Ngày kích hoạt, Thời hạn, Biển số xe và Thông tin phụ.</p></div></div>
<div class="form-grid">
<label>Chọn thiết bị IMEI
    <select @bind="editActivationId" @bind:after="OnEditDeviceSelected">
        @foreach(var x in devices)
        {
            <option value="@x.ActivationId">@x.Imei — @x.Customer @(string.IsNullOrWhiteSpace(x.Plate) ? "" : $"({x.Plate})")</option>
        }
    </select>
</label>
<label>Ngày kích hoạt IMEI *
    <input type="date" @bind="editActivatedDate" />
</label>
<label>Thời hạn kích hoạt
    <select @bind="editDurationMonths">
        <option value="12">1 năm (12 tháng)</option>
        <option value="24">2 năm (24 tháng)</option>
        <option value="36">3 năm (36 tháng)</option>
        <option value="6">6 tháng</option>
    </select>
</label>
<label>Biển số xe<input @bind="editPlate" placeholder="VD: 51H-123.45" /></label>
<label>Thông tin phụ / Số khung<input @bind="editVin" placeholder="Thông tin phụ, số khung, chủ xe..." /></label>
</div>
<div class="form-actions"><button class="btn" @onclick="SaveActivationUpdate">Lưu Ngày kích hoạt &amp; Thông tin</button><span class="feedback">@editMessage</span></div>
</div>}

<section class="panel"><div class="panel-head"><div><h2>Danh sách kích hoạt</h2><p>Đặt hạn thực tế sau cùng, không ghi đè lịch sử gia hạn.</p></div>
<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
<input class="search-input" @bind="search" @bind:event="oninput" placeholder="Tìm IMEI, biển số, KH, Seller..." />
<div class="tabs">
@if(canActive){<button class="@(filter=="ACTIVE"?"selected":"")" @onclick='() => filter = "ACTIVE"'>Còn hạn</button>}
@if(canDue10){<button class="@(filter=="DUE10"?"selected":"")" @onclick='() => filter = "DUE10"'>D+10</button>}
@if(canDue30){<button class="@(filter=="DUE30"?"selected":"")" @onclick='() => filter = "DUE30"'>D+30</button>}
@if(canDue60){<button class="@(filter=="DUE60"?"selected":"")" @onclick='() => filter = "DUE60"'>D+60</button>}
@if(canOverdue){<button class="@(filter=="OVERDUE"?"selected":"")" @onclick='() => filter = "OVERDUE"'>Quá hạn</button>}
</div></div></div>
@{ var pagedDevices = devicePager.Slice(devices.Where(Match), out var totalDevices); }
<div class="table-wrap"><table><thead><tr><th>STT</th><th>IMEI</th><th>SKU</th><th>KHÁCH HÀNG / CHỦ XE</th><th>SELLER PHỤ TRÁCH</th><th>BIỂN SỐ &amp; THÔNG TIN PHỤ</th><th>NGÀY KÍCH HOẠT</th><th>NGÀY HẾT HẠN</th><th>TRẠNG THÁI</th><th>THAO TÁC</th></tr></thead><tbody>
@foreach(var (stt, x) in pagedDevices){<tr><td><strong>@stt</strong></td><td><strong>@x.Imei</strong></td><td>@x.Sku</td><td class="wrap-cell"><div><strong>@x.Customer</strong></div>@if(!string.IsNullOrWhiteSpace(x.ContactName)){<small>Khách lắp: @x.ContactName</small>}</td><td><span class="chip blue-chip">@(string.IsNullOrWhiteSpace(x.SellerName) ? "—" : x.SellerName)</span></td><td class="wrap-cell"><div>@(string.IsNullOrWhiteSpace(x.Plate) ? "—" : x.Plate)</div>@if(!string.IsNullOrWhiteSpace(x.VinNo)){<small>@x.VinNo</small>}</td><td><strong>@x.ActivatedAt</strong></td><td>@x.ExpiresAt</td><td><span class="chip @(DaysToExpiry(x)<0?"orange-chip":DaysToExpiry(x)<=30?"purple-chip":"green-chip")">@(DaysToExpiry(x)<0?"Quá hạn":DaysToExpiry(x)<=30?$"Còn {DaysToExpiry(x)} ngày":"Còn hạn")</span></td><td>@if(canRenew){<div style="display:flex;gap:4px;flex-wrap:wrap"><button type="button" class="btn btn-sm" @onclick="() => OpenRenewFor(x)">+ Gia hạn</button><button type="button" class="btn secondary btn-sm" @onclick="() => OpenEditFor(x)">Sửa ngày KH</button></div>}</td></tr>}
</tbody></table></div>
<TablePager Pager="devicePager" TotalCount="totalDevices" />
</section>
@if(canHistory){<section class="panel"><div class="panel-head"><div><h2>Lịch sử các lần gia hạn &amp; Thống kê theo Seller</h2><p>Ghi nhận chi phí tại thời điểm gia hạn và nhân viên Seller phụ trách để chi hoa hồng.</p></div>
<select class="search-input" style="min-width:220px" @bind="historySellerFilter">
    <option value="">— Tất cả Seller gia hạn —</option>
    @foreach(var sl in sellerChoices)
    {
        <option value="@sl.Name">@sl.Code — @sl.Name</option>
    }
</select>
</div>
@if(renewals.Count > 0)
{
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px">
        @foreach(var grp in renewals.GroupBy(r => string.IsNullOrWhiteSpace(r.SellerName) ? "Chưa gán Seller" : r.SellerName))
        {
            <div style="padding:8px 12px;border-radius:8px;background:#f8fafc;border:1px solid #cbd5e1;font-size:12.5px">
                <strong>@grp.Key:</strong> <span class="chip blue-chip">@grp.Count() lượt gia hạn</span> · Tổng tiền gia hạn: <strong style="color:#0284c7">@grp.Sum(x => x.Price).ToString("N0") ₫</strong>
            </div>
        }
    </div>
}
@{ var pagedRenewals = renewalPager.Slice(FilteredRenewals, out var totalRenewals); }
<div class="table-wrap"><table><thead><tr><th>STT</th><th>IMEI</th><th>KHÁCH HÀNG / BIỂN SỐ</th><th>SELLER GIA HẠN</th><th>NGUỒN</th><th>NGÀY GIA HẠN</th><th>HẠN MỚI</th><th>SỐ TIỀN GIA HẠN</th><th>THANH TOÁN</th></tr></thead><tbody>
@foreach(var (stt, x) in pagedRenewals){<tr><td><strong>@stt</strong></td><td><strong>@x.Imei</strong></td><td class="wrap-cell"><div><strong>@(string.IsNullOrWhiteSpace(x.CustomerName) ? "—" : x.CustomerName)</strong></div>@if(!string.IsNullOrWhiteSpace(x.PlateNo)){<small>Biển số: @x.PlateNo</small>}</td><td><span class="chip green-chip">@(string.IsNullOrWhiteSpace(x.SellerName) ? "—" : x.SellerName)</span></td><td>@x.Source</td><td>@x.StartDate</td><td>@x.EndDate</td><td><strong>@x.Price.ToString("N0") ₫</strong></td><td>@(x.PaymentMethod=="DEBT"?"Công nợ":"Thanh toán ngay")</td></tr>}
</tbody></table></div>
<TablePager Pager="renewalPager" TotalCount="totalRenewals" />
</section>}
@code {
 private bool showRenew, showEditAct;
 private readonly PagerState devicePager = new();
 private readonly PagerState renewalPager = new();
 private void ToggleForm(string form){
  showRenew = form=="showRenew" && !showRenew;
  showEditAct = form=="showEditAct" && !showEditAct;
 }

 private List<DeviceVm> devices=[];
 private List<RenewalVm> renewals=[];
 private List<SellerChoiceVm> sellerChoices=[];
 private long activationId=1, editActivationId=1, renewSellerId;
 private int editDurationMonths=12;
 private DateTime editActivatedDate = DateTime.Today;
 private string source="TNM",method="DEBT",message="",editMessage="",editPlate="",editVin="",search="",filter="ACTIVE",historySellerFilter="";
 private bool canRenew,canHistory,canActive,canOverdue,canDue10,canDue30,canDue60;
 private IEnumerable<RenewalVm> FilteredRenewals => renewals.Where(r => string.IsNullOrWhiteSpace(historySellerFilter) || r.SellerName.Equals(historySellerFilter, StringComparison.OrdinalIgnoreCase));
 protected override async Task OnInitializedAsync(){
  canRenew=await Gate.CanAsync(Permissions.DevicesRenew);
  canHistory=await Gate.CanAsync(Permissions.DevicesRenewalsView);
  canActive=await Gate.CanAsync(Permissions.DevicesActiveView);
  canOverdue=await Gate.CanAsync(Permissions.DevicesOverdueView);
  canDue10=await Gate.CanAsync(Permissions.DevicesDue10View);
  canDue30=await Gate.CanAsync(Permissions.DevicesDue30View);
  canDue60=await Gate.CanAsync(Permissions.DevicesDue60View);
  Reload();filter=canActive?"ACTIVE":canDue10?"DUE10":canDue30?"DUE30":canDue60?"DUE60":"OVERDUE";
 }
 private void Reload(){
  sellerChoices=Db.SellerChoices();
  devices=Db.Devices();
  if(devices.Count > 0)
  {
   if(!devices.Any(x => x.ActivationId == activationId)) activationId = devices[0].ActivationId;
   OnRenewDeviceSelected();
   if(!devices.Any(x => x.ActivationId == editActivationId)) { editActivationId = devices[0].ActivationId; OnEditDeviceSelected(); }
  }
  if(canHistory)renewals=Db.Renewals();
 }
 private void OnRenewDeviceSelected(){
  var d = devices.FirstOrDefault(x => x.ActivationId == activationId);
  if (d is not null && d.SellerId is > 0)
  {
   renewSellerId = d.SellerId.Value;
  }
  else if (renewSellerId <= 0 && sellerChoices.Count > 0)
  {
   renewSellerId = sellerChoices[0].Id;
  }
 }
 private void OpenRenewFor(DeviceVm d){
  activationId = d.ActivationId;
  OnRenewDeviceSelected();
  showRenew = true;
  showEditAct = false;
 }
 private void OnEditDeviceSelected(){
  var d = devices.FirstOrDefault(x => x.ActivationId == editActivationId);
  if (d is not null)
  {
   if (DateTime.TryParse(d.ActivatedAt, out var dt)) editActivatedDate = dt.Date;
   editPlate = d.Plate ?? "";
   editVin = d.VinNo ?? "";
  }
 }
 private void OpenEditFor(DeviceVm d){
  editActivationId = d.ActivationId;
  OnEditDeviceSelected();
  showEditAct = true;
  showRenew = false;
 }
 private int DaysToExpiry(DeviceVm x)=> (DateTime.Parse(x.ExpiresAt).Date-DateTime.Today).Days;
 private bool Match(DeviceVm x)
 {
  if (!string.IsNullOrWhiteSpace(search) && !(x.Imei + " " + x.Sku + " " + x.Customer + " " + x.Plate + " " + x.ContactName + " " + x.VinNo + " " + x.SellerName).Contains(search, StringComparison.OrdinalIgnoreCase))
   return false;
  var days=DaysToExpiry(x);
  return filter switch {
  "ACTIVE"=>canActive && days>=0,
  "DUE10"=>canDue10 && days>=0 && days<=10,
  "DUE30"=>canDue30 && days>=0 && days<=30,
  "DUE60"=>canDue60 && days>=0 && days<=60,
  "OVERDUE"=>canOverdue && days<0,
  _=>false};
 }
 private async Task Renew(){
  try{
   Db.ActorId=await Gate.RequireAsync(Permissions.DevicesRenew);
   var pickedSeller = sellerChoices.FirstOrDefault(s => s.Id == renewSellerId);
   Db.Renew(activationId, source, method, pickedSeller?.Id, pickedSeller?.Name);
   Reload();
   message = $"Đã gia hạn 12 tháng và ghi nhận Seller phụ trách: {(pickedSeller is not null ? pickedSeller.Name : "Mặc định")}.";
  }catch(Exception ex){message="Lỗi: "+ex.Message;}
 }
 private async Task SaveActivationUpdate(){try{Db.ActorId=await Gate.RequireAsync(Permissions.DevicesRenew);Db.UpdateDeviceActivation(editActivationId, editActivatedDate.ToString("yyyy-MM-dd"), editDurationMonths, editPlate, editVin);Reload();editMessage="Đã cập nhật Ngày kích hoạt IMEI & thông tin phụ.";}catch(Exception ex){editMessage="Lỗi: "+ex.Message;}}
}
