  canDue10=await Gate.CanAsync(Permissions.DevicesDue10View);
  canDue30=await Gate.CanAsync(Permissions.DevicesDue30View);
  canDue60=await Gate.CanAsync(Permissions.DevicesDue60View);
  Reload();filter=canActive?"ACTIVE":canDue10?"DUE10":canDue30?"DUE30":canDue60?"DUE60":"OVERDUE";
 }
 private void Reload(){
  sellerChoices=Db.SellerChoices();
  customers=Db.Customers().OrderBy(x => x.Code, StringComparer.OrdinalIgnoreCase).ToList();
  hardwareProducts=Db.Products().Where(p => p.IsSerialized || string.Equals(p.Kind, "GOODS", StringComparison.OrdinalIgnoreCase)).OrderBy(p => p.Sku, StringComparer.OrdinalIgnoreCase).ToList();
  devices=Db.Devices();
  if(customers.Count > 0 && !customers.Any(c => c.Id == createCustomerId))
  {
   createCustomerId = customers[0].Id;
   OnCreateCustomerChanged();
  }
  else
  {
   RebuildAgencyOwners();
  }
  if(hardwareProducts.Count > 0 && !hardwareProducts.Any(p => p.Id == createProductId))
  {
   var defaultXanh = hardwareProducts.FirstOrDefault(p => string.Equals(p.Sku, "SP000001", StringComparison.OrdinalIgnoreCase));
   createProductId = defaultXanh?.Id ?? hardwareProducts[0].Id;
   OnCreateProductChanged();
  }
  else if(createProductId > 0)
  {
   availStockImeis = Db.AvailableStockImeis(createProductId);
   RefreshCreatePreviewPrice();
  }
  var firstEditable = devices.FirstOrDefault(x => !x.IsPreDeclared);
  if(firstEditable is not null)
  {
   if(!devices.Any(x => !x.IsPreDeclared && x.ActivationId == editActivationId)) { editActivationId = firstEditable.ActivationId; OnEditDeviceSelected(); }
  }
  if(detailDevice is not null)
  {
   detailDevice = devices.FirstOrDefault(x => x.ActivationId == detailDevice.ActivationId);
   if(detailDevice is not null)
    detailDeviceRenewals = Db.Renewals().Where(r => r.ActivationId == detailDevice.ActivationId).ToList();
  }
  if(canViewLog){renewals=Db.Renewals();deletedDevices=Db.DeletedDevices();}
 }
 private void RebuildAgencyOwners(){
  var list = new List<(string Key, string Name, string Phone)>();
  var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
  var curCust = customers.FirstOrDefault(c => c.Id == createCustomerId);
  if(curCust is not null && !string.IsNullOrWhiteSpace(curCust.RepresentativeName))
  {
   var repKey = $"{curCust.RepresentativeName.Trim()}|{curCust.Phone?.Trim() ?? ""}";
   if(seen.Add(repKey)) list.Add((repKey, curCust.RepresentativeName.Trim(), curCust.Phone?.Trim() ?? ""));
  }
  foreach(var dv in devices.Where(d => d.CustomerId == createCustomerId))
  {
   var nm = !string.IsNullOrWhiteSpace(dv.OwnerName) ? dv.OwnerName.Trim() : (dv.ContactName ?? "").Trim();
   var ph = (dv.OwnerPhone ?? "").Trim();
   if(string.IsNullOrWhiteSpace(nm)) continue;
   var key = $"{nm}|{ph}";
   if(seen.Add(key)) list.Add((key, nm, ph));
  }
  agencyOwners = list.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase).ToList();
 }
 private void OnCreateCustomerChanged(){
  pickedAgencyOwnerKey = "";
  var curCust = customers.FirstOrDefault(c => c.Id == createCustomerId);
  if(curCust?.SellerId is > 0) createSellerId = curCust.SellerId.Value;
  RebuildAgencyOwners();
  RefreshCreatePreviewPrice();
 }
 private void OnCreateProductChanged(){
  pickedStockImei = "";
  var pr = hardwareProducts.FirstOrDefault(p => p.Id == createProductId);
  if(pr is not null)
  {
   createDeviceTypeLabel = pr.Sku.ToUpperInvariant() switch
   {
    "SP000001" => "XANHGPS",
    "DX00002" or "SP000019" => "NASAGPS",
    "SP000005" => "TDCGPS",
    "SP000012" => "AICAM",
    "SP000006" => "mGPS",
    _ => pr.Sku
   };
  }
  availStockImeis = createProductId > 0 ? Db.AvailableStockImeis(createProductId) : [];
  RefreshCreatePreviewPrice();
 }
 private void RefreshCreatePreviewPrice(){
  createPreviewRenewalVnd = (createCustomerId > 0 && createProductId > 0)
   ? Db.PreviewRenewalPrice(createCustomerId, createProductId)
   : 0;
