   Reload();
   editMessage=$"Đã cập nhật Ngày kích hoạt ({editActivatedDate:yyyy-MM-dd}), Thời gian gia hạn / Hết hạn ({editExpiresDate:yyyy-MM-dd}), Trạng thái ({(editDeviceStatus == "DISABLED" ? "Đã khóa" : "Hoạt động")}) & thông tin thiết bị.";
  }catch(Exception ex){editMessage="Lỗi: "+ex.Message;}
 }
