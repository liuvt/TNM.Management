   return new object?[]
   {
    idx + 1,
    x.Plate,
    x.Imei,
    string.IsNullOrWhiteSpace(x.DeviceTypeLabel) ? x.Sku : x.DeviceTypeLabel,
    x.Sku,
    string.IsNullOrWhiteSpace(x.AgencyName) ? x.Customer : x.AgencyName,
    string.IsNullOrWhiteSpace(x.OwnerName) ? x.ContactName : x.OwnerName,
    x.OwnerPhone,
    x.SellerName,
    stText,
    x.ActivatedAt,
    x.ExpiresAt,
    d == -9999 ? 0 : d,
    x.LastRenewedAt,
    x.RenewalCount,
    x.RenewalPriceVnd
   };
  });
  await ExcelExporter.DownloadAsync(JS, $"thiet-bi-kich-hoat-{filter.ToLowerInvariant()}", "Thiết bị kích hoạt", headers, rows);
 }

