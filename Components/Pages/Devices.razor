@attribute [Authorize(Policy = Permissions.DevicesView)]
@page "/devices"
@inject DemoDb Db
@inject DeviceImportService DeviceImporter
@inject PermissionGate Gate
@inject NavigationManager Nav
@inject IJSRuntime JS
<PageTitle>Thiết bị · TNM</PageTitle>
<div class="page-head">
    <div>
        <div class="eyebrow">KHO &amp; THIẾT BỊ / QUẢN LÝ HỒ SƠ PHƯƠNG TIỆN &amp; THIẾT BỊ</div>
        <h1>Thiết bị</h1>
        <p>Khai báo hồ sơ xe / thiết bị từ đầu (kể cả trước khi có đơn lắp đặt), theo dõi trạng thái đơn hàng, lịch sử các đợt gia hạn và cảnh báo hết hạn.</p>
    </div>
    <div class="button-group">
        @if(canViewLog)
        {
            <button type="button" class="btn secondary" data-confirm="none" @onclick="OpenModuleLog">📋 Xem log</button>
        }
        <button type="button" class="btn" data-confirm="none" @onclick='() => Nav.NavigateTo("/sales-orders?create=RENEWAL")'>
            🔄 Lập Đơn gia hạn
        </button>
    </div>
</div>
<div class="crud-actionbar">
    @if(canRenew || canUpdateDevice){<button type="button" class="btn" data-confirm="none" @onclick="OpenCreateDeviceModal">+ Thêm thiết bị / Khai báo xe</button>}
    @if(canRenew || canUpdateDevice){<button type="button" class="btn @(showImportPanel?"":"secondary")" data-confirm="none" @onclick="()=>ToggleForm(nameof(showImportPanel))">@(showImportPanel?"Đóng · Import Excel/CSV":"📤 Import Excel / CSV (12 cột)")</button>}
    <button type="button" class="btn secondary" data-confirm="none" @onclick="ExportDevicesExcel">📥 Xuất Excel Thiết bị (@FilteredDevicesList.Count)</button>
</div>

@if(canRenew || canUpdateDevice){
<div class="panel edit-panel" hidden="@(!showImportPanel)">
    <div class="panel-head">
        <div>
            <h2>📤 Import Hồ sơ Thiết bị &amp; Phương tiện Chuẩn 12 Cột (.xlsx / .csv)</h2>
            <p>Kiểm định nghiêm ngặt dữ liệu đầu vào trước khi ghi — Đảm bảo đồng nhất 100% thông luồng <strong>Thiết bị ↔ Đơn hàng (SO7/TM7/GH7) ↔ Kho ↔ Kế toán</strong> (không trừ kho trùng, không ghi đè đơn gia hạn ERP, không sinh công nợ ảo).</p>
        </div>
        <div>
            <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="DownloadStandardImportTemplate">📄 Tải file mẫu chuẩn 12 cột (.xlsx)</button>
        </div>
    </div>

    <div class="panel-note" style="margin-bottom:12px;padding:12px 14px;border-radius:8px;background:#f8fafc;border:1px solid #cbd5e1;color:#334155;font-size:13px;line-height:1.55">
        <div><strong>📌 Ràng buộc bắt buộc đối với dữ liệu đầu vào (12 cột theo đúng thứ tự):</strong></div>
        <div><code>1. STT</code> · <code>2. Biển số xe/Số khung</code> · <code>3. Số EMEI Thiết bị</code> · <code>4. Tên Thiết bị</code> (chỉ nhận: <strong>XANHGPS, NASAGPS, TDCGPS, AICAM, mGPS, CAM4CH</strong>) · <code>5. Tên Đại lý</code> · <code>6. Tên Khách hàng</code> · <code>7. SĐT Khách hàng</code> · <code>8. Trạng thái thiết bị</code> · <code>9. Ngày kích hoạt</code> (<code>dd/MM/yyyy</code>) · <code>10. Ngày hết hạn</code> (<code>dd/MM/yyyy</code>) · <code>11. Ngày gia hạn gần nhất (nếu có)</code> · <code>12. Số lần gia hạn</code>.</div>
        <div style="margin-top:4px;color:#0f766e">✅ Hỗ trợ đọc đa Sheet (VD: <em>Tổng hợp thiết bị</em> + <em>Update</em>), tự động khôi phục biển số chữ E bị lỗi số mũ Excel (<code>6.8E+259</code> → <code>68E00258</code>), gỡ dấu phẩy IMEI, chống đảo tháng/ngày US-locale và tự động khớp vào Đơn hoàn thành chờ IMEI.</div>
    </div>

    <div class="form-grid">
        <label>Chọn file Excel (.xlsx) hoặc CSV (.csv) chuẩn 12 cột
            <InputFile OnChange="OnImportFileSelected" accept=".xlsx,.csv,.tsv" />
        </label>
        <label>Hoặc dán trực tiếp dữ liệu CSV (bao gồm dòng tiêu đề 12 cột)
            <textarea rows="3" @bind="importCsvPaste" placeholder="STT,Biển số xe/Số khung,Số EMEI Thiết bị,Tên Thiết bị,Tên Đại lý,Tên Khách hàng,SĐT Khách hàng,Trạng thái thiết bị,Ngày kích hoạt,Ngày hết hạn,Ngày gia hạn gần nhất (nếu có),Số lần gia hạn"></textarea>
        </label>
    </div>

    <div class="form-actions" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        @if(!string.IsNullOrWhiteSpace(importCsvPaste))
        {
            <button type="button" class="btn secondary" data-confirm="none" disabled="@importBusy" @onclick="RunPasteDryRun">🔍 Bước 1: Kiểm tra dữ liệu dán (Dry-Run)</button>
        }
        @if(importReport is not null && importReport.DryRun && importReport.RejectedErrorCount == 0 && importReport.ValidUniqueDevices > 0)
        {
            <button type="button" class="btn"
                    disabled="@importBusy"
                    data-confirm="edit"
                    data-confirm-title="Xác nhận Import Hồ sơ Thiết bị vào Hệ thống"
                    data-confirm-msg="@($"Bạn có chắc chắn muốn thực thi Import '{importSourceName}' ({importReport.ValidUniqueDevices:N0} IMEI hợp lệ: Thêm mới {importReport.InsertedNewCount:N0}, Khớp Đơn hoàn thành {importReport.LinkedCompletedOrderCount:N0}, Cập nhật {importReport.UpdatedExistingCount:N0}, Bảo vệ tồn kho {importReport.ProtectedInStockCount:N0}) vào hệ thống không?")"
                    @onclick="CommitValidatedImport">
                ✅ Bước 2: Xác nhận Import vào Hệ thống (@(importReport.InsertedNewCount + importReport.LinkedCompletedOrderCount + importReport.UpdatedExistingCount) thay đổi)
            </button>
        }
        @if(importReport is not null)
        {
            <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="ClearImportState">Làm mới</button>
        }
        @if(!string.IsNullOrWhiteSpace(importStatusMsg))
        {
            <span class="feedback">@importStatusMsg</span>
        }
    </div>

    @if(importReport is not null)
    {
        <div class="panel-note" style="margin-top:12px;padding:12px 14px;border-radius:8px;background:@(importReport.RejectedErrorCount > 0 ? "#fef2f2" : importReport.Committed ? "#f0fdf4" : "#eff6ff");border:1px solid @(importReport.RejectedErrorCount > 0 ? "#fca5a5" : importReport.Committed ? "#86efac" : "#93c5fd");color:@(importReport.RejectedErrorCount > 0 ? "#991b1b" : importReport.Committed ? "#166534" : "#1e3a8a");font-weight:600">
            @importReport.SummaryMessage
        </div>

        <div class="device-summary-bar" style="margin-top:10px">
            <div class="device-summary-item"><span>Tổng dòng đọc (@importReport.SheetsRead sheet):</span><strong>@importReport.TotalRowsRead.ToString("N0")</strong></div>
            <div class="device-summary-item"><span>IMEI hợp lệ duy nhất:</span><strong class="text-blue">@importReport.ValidUniqueDevices.ToString("N0")</strong></div>
            <div class="device-summary-item"><span>➕ Thêm mới:</span><strong class="text-green">@importReport.InsertedNewCount.ToString("N0")</strong></div>
            <div class="device-summary-item"><span>🔗 Khớp Đơn hoàn thành:</span><strong class="text-purple">@importReport.LinkedCompletedOrderCount.ToString("N0")</strong></div>
            <div class="device-summary-item"><span>🔄 Cập nhật có sẵn:</span><strong class="text-blue">@importReport.UpdatedExistingCount.ToString("N0")</strong></div>
            <div class="device-summary-item"><span>🛡️ Bảo vệ Tồn kho / Đơn mở:</span><strong class="text-orange">@importReport.ProtectedInStockCount.ToString("N0")</strong></div>
            <div class="device-summary-item"><span>🧹 Tự sửa định dạng Excel:</span><strong>@importReport.AutoCleanedCount.ToString("N0")</strong></div>
            <div class="device-summary-item"><span>❌ Dòng lỗi bị chặn:</span><strong class="text-red">@importReport.RejectedErrorCount.ToString("N0")</strong></div>
        </div>

        @if(importReport.Errors.Count > 0)
        {
            <div class="table-wrap" style="margin-top:10px;max-height:260px;overflow:auto">
                <table>
                    <thead><tr><th>SHEET</th><th>DÒNG</th><th>IMEI ĐẦU VÀO</th><th>BIỂN SỐ ĐẦU VÀO</th><th>NGUYÊN NHÂN CHẶN (VI PHẠM RÀNG BUỘC)</th></tr></thead>
                    <tbody>
                    @foreach(var err in importReport.Errors.Take(100))
                    {
                        <tr>
                            <td><strong>@err.SheetName</strong></td>
                            <td>@err.RowNumber</td>
                            <td><code>@(string.IsNullOrWhiteSpace(err.RawImei) ? "—" : err.RawImei)</code></td>
                            <td>@(string.IsNullOrWhiteSpace(err.RawPlate) ? "—" : err.RawPlate)</td>
                            <td style="color:#dc2626;font-weight:600">@err.Reason</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @if(importReport.PreviewItems.Count > 0)
        {
            <div style="margin-top:12px;font-weight:600;color:#334155">Xem trước các dòng Thêm mới / Khớp Đơn hàng / Cập nhật / Bảo vệ Kho (hiển thị tối đa 50 dòng tiêu biểu):</div>
            <div class="table-wrap" style="margin-top:6px;max-height:300px;overflow:auto">
                <table>
                    <thead><tr><th>SHEET · DÒNG</th><th>THAO TÁC</th><th>SỐ IMEI</th><th>BIỂN SỐ / SK</th><th>DÒNG TB</th><th>KHÁCH HÀNG / ĐV MAP</th><th>KÍCH HOẠT → HẾT HẠN</th><th>GHI CHÚ ĐỐI SOÁT</th></tr></thead>
                    <tbody>
                    @foreach(var pv in importReport.PreviewItems.Take(50))
                    {
                        <tr>
                            <td><small>@pv.SheetName · #@pv.RowNumber</small></td>
                            <td>
                                @if(pv.Action == "INSERT_NEW"){<span class="chip green-chip">+ Thêm mới</span>}
                                else if(pv.Action == "LINK_COMPLETED_ORDER"){<span class="chip purple-chip">🔗 Khớp Đơn HT</span>}
                                else if(pv.Action == "SKIP_IN_STOCK"){<span class="chip orange-chip">🛡️ Giữ Tồn kho</span>}
                                else {<span class="chip blue-chip">🔄 Cập nhật</span>}
                            </td>
                            <td><strong>@pv.Imei</strong></td>
                            <td><strong>@(string.IsNullOrWhiteSpace(pv.PlateNo) ? "—" : pv.PlateNo)</strong>@if(!string.IsNullOrWhiteSpace(pv.VinNo) && pv.VinNo != pv.Imei){<div><small>SK: @pv.VinNo</small></div>}</td>
                            <td>@pv.DeviceType (@pv.ProductSku)</td>
                            <td><strong>@pv.ResolvedCustomerName</strong>@if(!string.IsNullOrWhiteSpace(pv.OwnerName)){<div><small>Chủ xe: @pv.OwnerName</small></div>}</td>
                            <td>@pv.ActivatedAt → <strong>@pv.ExpiresAt</strong></td>
                            <td><small>@pv.Note</small></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
}

@if(showCreateDevice && (canRenew || canUpdateDevice))
{
    <div class="so-modal-overlay" @onclick="CloseCreateDeviceModal">
        <div class="so-modal-dialog" style="max-width:920px" @onclick:stopPropagation="true">
            <div class="so-modal-header">
                <div>
                    <div class="eyebrow">KHAI BÁO HỒ SƠ PHƯƠNG TIỆN &amp; THIẾT BỊ</div>
                    <h2>+ Khai báo Xe / Thiết bị (Hỗ trợ tạo sẵn trước khi có Đơn lắp đặt)</h2>
                    <p>Chọn <strong>HTX / Đại lý / Khách lẻ</strong> từ danh mục Khách hàng, nhập <strong>Biển số | Số khung | Chủ xe</strong>. Nếu xe chưa đi lắp đặt, chọn chế độ <strong>Khai báo sẵn chờ lắp đặt</strong> (chưa cần mã IMEI).</p>
                </div>
                <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="CloseCreateDeviceModal">✕ Đóng</button>
            </div>
            <div class="so-modal-body">
                <div class="form-grid">
                    <label>Chế độ khai báo *
                        <select @bind="createDeviceMode">
                            <option value="PRE_DECLARE">🆕 Khai báo sẵn xe chờ lắp đặt (Chưa gắn IMEI — Tạo đơn lắp sau)</option>
                            <option value="ACTIVATED">✅ Thiết bị đã lắp đặt / Đang hoạt động (Đã có mã IMEI)</option>
                        </select>
                    </label>
                    <label>Thuộc HTX / Đại lý / Khách lẻ (Chọn từ Khách hàng) *
                        <select @bind="createCustomerId" @bind:after="OnCreateCustomerChanged">
                            @foreach(var cu in customers)
                            {
                                <option value="@cu.Id">@cu.Code — @cu.B2BDisplayName @(string.IsNullOrWhiteSpace(cu.Group) || cu.Group == "-" ? "" : $"[{cu.Group}]")</option>
                            }
                        </select>
                    </label>
                    <label>Biển số xe @(createDeviceMode == "PRE_DECLARE" ? "*" : "")
                        <input @bind="createPlate" placeholder="VD: 51H-123.45..." />
                    </label>
                    <label>Số khung (VIN)
                        <input @bind="createVin" placeholder="Nhập số khung phương tiện (nếu có)..." />
                    </label>
                    <label>Chọn nhanh Khách hàng / Chủ xe có sẵn (thuộc HTX / Đại lý)
                        <select @bind="pickedAgencyOwnerKey" @bind:after="OnPickAgencyOwner">
                            <option value="">— Nhập chủ xe mới hoặc chọn từ danh sách có sẵn (@agencyOwners.Count) —</option>
                            @foreach(var ow in agencyOwners)
                            {
                                <option value="@ow.Key">@ow.Name @(string.IsNullOrWhiteSpace(ow.Phone) ? "" : $"· 📞 {ow.Phone}")</option>
                            }
                        </select>
                    </label>
                    <label>Tên khách hàng / Chủ xe sử dụng
                        <input @bind="createOwnerName" list="create-owners-datalist" placeholder="Nhập tên chủ xe / khách sử dụng..." />
                        <datalist id="create-owners-datalist">
                            @foreach(var ow in agencyOwners)
                            {
                                <option value="@ow.Name">@ow.Phone</option>
                            }
                        </datalist>
                    </label>
                    <label>Số điện thoại khách hàng / Chủ xe
                        <input @bind="createOwnerPhone" placeholder="VD: 0909123456..." />
                    </label>
                    <label>Sản phẩm / Dòng thiết bị @(createDeviceMode == "PRE_DECLARE" ? "(Dự kiến lắp)" : "*")
                        <select @bind="createProductId" @bind:after="OnCreateProductChanged">
                            @foreach(var pr in hardwareProducts)
                            {
                                <option value="@pr.Id">@pr.Sku — @pr.Name @(pr.StockInHand > 0 ? $"[Tồn kho: {pr.StockInHand:N0}]" : "")</option>
                            }
                        </select>
                    </label>
                    <label>Tên / Nhãn thiết bị hiển thị *
                        <select @bind="createDeviceTypeLabel">
                            @foreach(var lbl in AvailableDeviceTypeLabels)
                            {
                                <option value="@lbl">@lbl</option>
                            }
                        </select>
                    </label>
                    <label>Nhân viên bán hàng phụ trách
                        <select @bind="createSellerId">
                            <option value="0">— Chưa gán / Theo mặc định Đại lý —</option>
                            @foreach(var sl in sellerChoices)
                            {
                                <option value="@sl.Id">@sl.Code — @sl.Name @(string.IsNullOrWhiteSpace(sl.Department) ? "" : $"({sl.Department})")</option>
                            }
                        </select>
                    </label>
                    @if(createDeviceMode != "PRE_DECLARE")
                    {
                    <label>Chọn nhanh IMEI từ Tồn kho khả dụng (tùy chọn)
                        <select @bind="pickedStockImei" @bind:after="OnPickStockImei">
                            <option value="">— Nhập tay mã IMEI bên cạnh @(availStockImeis.Count > 0 ? $"(hoặc chọn trong {availStockImeis.Count} IMEI tồn kho)" : "(không có IMEI tồn kho SP này)") —</option>
                            @foreach(var st in availStockImeis)
                            {
                                <option value="@st.Imei">@st.Imei (@st.WarehouseName)</option>
                            }
                        </select>
                    </label>
                    <label>Số IMEI thiết bị *
                        <input @bind="createImei" list="create-avail-imeis" placeholder="Nhập mã IMEI thiết bị (VD: 0958C6245X)..." />
                        <datalist id="create-avail-imeis">
                            @foreach(var st in availStockImeis)
                            {
                                <option value="@st.Imei">@st.WarehouseName</option>
                            }
                        </datalist>
                    </label>
                    <label>Ngày kích hoạt *
                        <input type="date" @bind="createActivatedDate" @bind:after="OnCreateActivatedOrDurationChanged" />
                    </label>
                    <label>Thời hạn kích hoạt
                        <select @bind="createDurationMonths" @bind:after="OnCreateActivatedOrDurationChanged">
                            <option value="12">1 năm (12 tháng)</option>
                            <option value="24">2 năm (24 tháng)</option>
                            <option value="36">3 năm (36 tháng)</option>
                            <option value="6">6 tháng</option>
                        </select>
                    </label>
                    <label>Ngày hết hạn *
                        <input type="date" @bind="createExpiresDate" />
                    </label>
                    <label>Trạng thái thiết bị *
                        <select @bind="createDeviceStatus">
                            <option value="ACTIVE">Hoạt động (Cho phép gia hạn)</option>
                            <option value="DISABLED">Tạm khóa thiết bị</option>
                        </select>
                    </label>
                    }
                    <label>Giá gia hạn chuẩn 12 tháng (theo Nhóm KH)
                        <input readonly value="@($"{createPreviewRenewalVnd:N0} ₫")" style="background:#f1f5f9;font-weight:700;color:#15803d" />
                    </label>
                </div>
                @if (!string.IsNullOrWhiteSpace(createMessage))
                {
                    <div class="panel-note" style="margin-top:12px;padding:10px 14px;border-radius:8px;background:#fef2f2;border:1px solid #fca5a5;color:#991b1b;font-weight:600">
                        @createMessage
                    </div>
                }
            </div>
            <div class="so-modal-footer">
                <span style="font-size:12px;color:#64748b">Các trường có dấu (*) là bắt buộc theo chế độ khai báo đã chọn.</span>
                <div style="display:flex;gap:8px;align-items:center">
                    <button type="button" class="btn secondary" data-confirm="none" @onclick="CloseCreateDeviceModal">Hủy</button>
                    <button type="button" class="btn" data-confirm="add" data-confirm-title="Xác nhận Lưu hồ sơ Thiết bị / Xe" data-confirm-msg="@(createDeviceMode == "PRE_DECLARE" ? $"Bạn có chắc chắn muốn khai báo sẵn xe {(string.IsNullOrWhiteSpace(createPlate) ? createOwnerName : createPlate)} chờ lên Đơn lắp đặt không?" : $"Bạn có chắc chắn muốn thêm thiết bị IMEI {(string.IsNullOrWhiteSpace(createImei) ? "—" : createImei.Trim())} ({createDeviceTypeLabel}) vào danh sách quản lý không?")" @onclick="SaveNewManualDevice">
                        @(createDeviceMode == "PRE_DECLARE" ? "+ Lưu khai báo xe (Chờ tạo Đơn lắp đặt)" : "+ Lưu thêm thiết bị")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if(showEditAct && (canRenew || canUpdateDevice))
{
    var selectedEditDevice = devices.FirstOrDefault(x => x.ActivationId == editActivationId);
    var selectedEditDeviceName = selectedEditDevice is null ? "—" : (string.IsNullOrWhiteSpace(selectedEditDevice.DeviceTypeLabel) ? selectedEditDevice.Sku : selectedEditDevice.DeviceTypeLabel);
    var selectedEditTargetCust = customers.FirstOrDefault(c => c.Id == editCustomerId);
    var isChangingCustomerMethod1 = canTransferMethod1 && selectedEditDevice is not null && editCustomerId > 0 && editCustomerId != selectedEditDevice.CustomerId;
    var isEditingPreDeclared = selectedEditDevice?.IsPreDeclared == true;
    <div class="so-modal-overlay" @onclick="CloseEditDeviceModal">
        <div class="so-modal-dialog" style="max-width:940px" @onclick:stopPropagation="true">
            <div class="so-modal-header">
                <div>
                    <div class="eyebrow">CẬP NHẬT ĐẠI LÝ / HTX / KHÁCH LẺ · THỜI GIAN GIA HẠN &amp; THÔNG TIN THIẾT BỊ</div>
                    <h2>@(selectedEditDevice is null ? "Sửa thông tin thiết bị" : $"{(string.IsNullOrWhiteSpace(selectedEditDevice.Plate) ? selectedEditDevice.DisplayImei : $"{selectedEditDevice.Plate} · {selectedEditDevice.DisplayImei}")} [{selectedEditDeviceName}]")</h2>
                    <p>Cho phép nhân viên (CSKH, Kế toán, Quản lý, Admin, Owner) chuyển đổi <strong>Đại lý / HTX / Khách lẻ</strong> (tự động áp ngay Bảng giá bán &amp; gia hạn của Nhóm KH mới), cập nhật <strong>Ngày hết hạn</strong> và thông tin xe — có ghi Log Trước → Sau.</p>
                </div>
                <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="CloseEditDeviceModal">✕ Đóng</button>
            </div>
            <div class="so-modal-body">
                <div class="form-grid">
                    <label>Số IMEI &amp; Tên thiết bị
                        <input readonly value="@(selectedEditDevice is null ? "—" : $"{selectedEditDevice.DisplayImei} — {selectedEditDeviceName} ({selectedEditDevice.Sku})")" style="background:#f1f5f9;font-weight:700;color:#0284c7" />
                    </label>
                    @if(canTransferMethod1)
                    {
                    <label>Đại lý / HTX / Khách lẻ quản lý (Cho phép đổi đơn vị &amp; Cập nhật lại giá) *
                        <select @bind="editCustomerId" @bind:after="OnEditCustomerChanged" style="@(isChangingCustomerMethod1 ? "border-color:#0284c7;font-weight:700;background:#f0f9ff" : "")">
                            @foreach(var cu in customers)
                            {
                                <option value="@cu.Id">@cu.Code — @cu.B2BDisplayName @(string.IsNullOrWhiteSpace(cu.Group) || cu.Group == "-" ? "" : $"[{cu.Group}]")</option>
                            }
                        </select>
                    </label>
                    <label>Bảng giá chuẩn theo Nhóm KH đã chọn (Lắp đặt · Thương mại · Gia hạn 12T)
                        <input readonly value="@($"Lắp: {editPreviewInstalledVnd:N0} ₫ · TM: {editPreviewStandardVnd:N0} ₫ · GH: {editPreviewRenewalVnd:N0} ₫")" style="background:#f0fdf4;font-weight:700;color:#15803d" />
                    </label>
                    }
                    else
                    {
                    <label>Đại lý / HTX / Khách hàng đang quản lý
                        <input readonly value="@(selectedEditDevice is null ? "—" : (string.IsNullOrWhiteSpace(selectedEditDevice.AgencyName) ? selectedEditDevice.Customer : selectedEditDevice.AgencyName))" style="background:#f1f5f9" />
                    </label>
                    }
                    @if(!isEditingPreDeclared)
                    {
                    <label>Ngày hết hạn / Thời gian gia hạn thiết bị * <small style="color:#0284c7;font-weight:600">(Hiện tại: @(selectedEditDevice?.ExpiresAt ?? "—"))</small>
                        <input type="date" @bind="editExpiresDate" style="border-color:#0284c7;font-weight:700" />
                        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px">
                            <button type="button" class="btn secondary btn-sm" style="padding:3px 8px;font-size:11.5px" data-confirm="none" @onclick="() => QuickExtendEditExpiry(1)">+1 tháng</button>
                            <button type="button" class="btn secondary btn-sm" style="padding:3px 8px;font-size:11.5px" data-confirm="none" @onclick="() => QuickExtendEditExpiry(3)">+3 tháng</button>
                            <button type="button" class="btn secondary btn-sm" style="padding:3px 8px;font-size:11.5px" data-confirm="none" @onclick="() => QuickExtendEditExpiry(6)">+6 tháng</button>
                            <button type="button" class="btn secondary btn-sm" style="padding:3px 8px;font-size:11.5px" data-confirm="none" @onclick="() => QuickExtendEditExpiry(12)">+12 tháng</button>
                            <button type="button" class="btn secondary btn-sm" style="padding:3px 8px;font-size:11.5px" data-confirm="none" @onclick="OnEditActivatedOrDurationChanged">Tính từ Ngày kích hoạt</button>
                        </div>
                    </label>
                    <label>Ngày kích hoạt IMEI *
                        <input type="date" @bind="editActivatedDate" />
                    </label>
                    <label>Gói tính hạn từ Ngày kích hoạt
                        <select @bind="editDurationMonths" @bind:after="OnEditActivatedOrDurationChanged">
                            <option value="12">1 năm (12 tháng từ Ngày kích hoạt)</option>
                            <option value="24">2 năm (24 tháng từ Ngày kích hoạt)</option>
                            <option value="36">3 năm (36 tháng từ Ngày kích hoạt)</option>
                            <option value="6">6 tháng từ Ngày kích hoạt</option>
                        </select>
                    </label>
                    }
                    <label>Nhân viên bán hàng phụ trách
                        <select @bind="editDeviceSellerId">
                            <option value="0">@(isChangingCustomerMethod1 ? "— Theo mặc định Đại lý mới / Chưa gán —" : "— Giữ nguyên nhân viên bán hàng hiện tại —")</option>
                            @foreach(var sl in sellerChoices)
                            {
                                <option value="@sl.Id">@sl.Code — @sl.Name</option>
                            }
                        </select>
                    </label>
                    <label>Biển số xe<input @bind="editPlate" placeholder="VD: 51H-123.45" /></label>
                    <label>Tên khách hàng / Chủ xe<input @bind="editOwnerName" placeholder="Tên chủ xe / khách sử dụng..." /></label>
                    <label>SĐT khách hàng / Chủ xe<input @bind="editOwnerPhone" placeholder="VD: 0909123456..." /></label>
                    <label>Thông tin phụ / Số khung<input @bind="editVin" placeholder="Thông tin phụ, số khung..." /></label>
                    @if(!isEditingPreDeclared)
                    {
                    <label>Trạng thái thiết bị *
                        <select @bind="editDeviceStatus">
                            <option value="ACTIVE">Hoạt động (Mở khóa — Cho phép gia hạn)</option>
                            <option value="DISABLED">Tạm khóa thiết bị</option>
                        </select>
                    </label>
                    }
                </div>
                @if(isChangingCustomerMethod1 && selectedEditDevice is not null)
                {
                    <div class="panel-note" style="margin-top:12px;padding:12px 14px;border-radius:8px;background:#f0fdf4;border:1px solid #86efac;color:#14532d;font-size:12.5px;line-height:1.55">
                        <div><strong>🔄 Chuyển đổi Đại lý / HTX / Khách lẻ &amp; Áp ngay Bảng giá mới:</strong> Thiết bị <strong>@selectedEditDevice.DisplayImei</strong> @(string.IsNullOrWhiteSpace(selectedEditDevice.Plate) ? "" : $"({selectedEditDevice.Plate})") sẽ chuyển từ <strong>[@selectedEditDevice.Customer]</strong> sang <strong>[@(selectedEditTargetCust?.Name ?? "Đơn vị mới")]</strong>.</div>
                        <div style="margin-top:4px">📊 <strong>Đối chiếu Bảng giá chuẩn Cũ → Mới:</strong> Giá có lắp: <strong>@editOldInstalledVnd.ToString("N0") ₫ → @editPreviewInstalledVnd.ToString("N0") ₫</strong> · Giá thương mại: <strong>@editOldStandardVnd.ToString("N0") ₫ → @editPreviewStandardVnd.ToString("N0") ₫</strong> · Giá gia hạn 12T: <strong>@editOldRenewalVnd.ToString("N0") ₫ → @editPreviewRenewalVnd.ToString("N0") ₫</strong>.</div>
                        <label class="checkbox-row" style="margin-top:8px;padding:6px 10px;background:#fff;border:1px solid #bbf7d0;border-radius:6px;cursor:pointer">
                            <input type="checkbox" @bind="editSyncTransferOrders" />
                            <span><strong>Đồng bộ &amp; tính lại toàn bộ giá trên Đơn hàng / Hóa đơn công nợ chưa thu (OPEN)</strong> của xe này sang Khách hàng mới (các chứng từ lịch sử đã thu tiền / đã chốt sổ tự động được giữ nguyên an toàn).</span>
                        </label>
                    </div>
                }
                @if(!string.IsNullOrWhiteSpace(editMessage))
                {
                    <div class="panel-note" style="margin-top:12px;padding:10px 14px;border-radius:8px;background:#fef2f2;border:1px solid #fca5a5;color:#991b1b;font-weight:600">
                        @editMessage
                    </div>
                }
            </div>
            <div class="so-modal-footer">
                <span style="font-size:12px;color:#475569">📋 Hệ thống tự động ghi Log người thực hiện &amp; chi tiết Trước → Sau cho mọi thay đổi.</span>
                <div style="display:flex;gap:8px;align-items:center">
                    <button type="button" class="btn secondary" data-confirm="none" @onclick="CloseEditDeviceModal">Hủy</button>
                    <button type="button" class="btn"
                            data-confirm="edit"
                            data-confirm-title="@(isChangingCustomerMethod1 ? "Xác nhận Chuyển đơn vị & Đồng bộ Công nợ Kế toán" : "Xác nhận Cập nhật Thời hạn & Thông tin thiết bị")"
                            data-confirm-msg="@(isChangingCustomerMethod1 && selectedEditDevice is not null
                                ? $"Bạn có chắc chắn muốn chuyển thiết bị {selectedEditDevice.Imei} ({selectedEditDeviceName}) từ [{selectedEditDevice.Customer}] sang [{(selectedEditTargetCust?.Name ?? "Đơn vị mới")}] và cập nhật đồng bộ lại Hóa đơn / Công nợ tương ứng bên Kế toán (/finance) theo giá nhóm KH mới không?"
                                : isEditingPreDeclared
                                    ? $"Bạn có chắc chắn muốn lưu cập nhật thông tin hồ sơ xe chờ lắp {(string.IsNullOrWhiteSpace(editPlate) ? selectedEditDevice?.Plate : editPlate)} không?"
                                    : $"Bạn có chắc chắn muốn lưu cập nhật Thời gian gia hạn / Ngày hết hạn ({(selectedEditDevice?.ExpiresAt ?? "—")} → {editExpiresDate:yyyy-MM-dd}), Ngày kích hoạt ({editActivatedDate:yyyy-MM-dd}) và thông tin thiết bị {(selectedEditDevice is null ? "" : $"{selectedEditDevice.DisplayImei} ({selectedEditDeviceName})")} không?")"
                            @onclick="SaveActivationUpdate">
                        @(isChangingCustomerMethod1 ? "🔄 Lưu Chuyển đơn vị & Đồng bộ Công nợ" : "💾 Lưu Thời gian gia hạn & Thông tin thiết bị")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@{
    var searchedDevices = devices.Where(MatchSearch).ToList();
    var countAll = searchedDevices.Count;
    var countPreDeclared = searchedDevices.Count(x => x.IsPreDeclared);
    var countActive = searchedDevices.Count(x => !x.IsPreDeclared && !IsLocked(x) && DaysToExpiry(x) >= 0);
    var countDue10 = searchedDevices.Count(x => { var d = DaysToExpiry(x); return !x.IsPreDeclared && !IsLocked(x) && d >= 0 && d <= 10; });
    var countDue30 = searchedDevices.Count(x => { var d = DaysToExpiry(x); return !x.IsPreDeclared && !IsLocked(x) && d >= 0 && d <= 30; });
    var countDue60 = searchedDevices.Count(x => { var d = DaysToExpiry(x); return !x.IsPreDeclared && !IsLocked(x) && d >= 0 && d <= 60; });
    var countOverdue = searchedDevices.Count(x => !x.IsPreDeclared && DaysToExpiry(x) < 0);
    var countLocked = searchedDevices.Count(IsLocked);
    var pagedDevices = devicePager.Slice(searchedDevices.Where(MatchFilter), out var totalDevices);
}

<section class="panel"><div class="panel-head"><div><h2>Danh sách Thiết bị &amp; Phương tiện</h2><p>Theo dõi hồ sơ xe, liên kết Đơn lắp đặt, số lần &amp; mốc thời gian Đơn gia hạn và cảnh báo hết hạn.</p></div>
<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
<input class="search-input" @bind="search" @bind:event="oninput" @bind:after="() => devicePager.Reset()" placeholder="Tìm Biển số, Số khung, IMEI, HTX/KH, Chủ xe..." />
<div class="tabs">
<button class="@(filter=="ALL"?"selected":"")" @onclick='() => SetFilter("ALL")'>Tất cả (@countAll)</button>
@if(countPreDeclared > 0 || filter == "PRE_DECLARE"){<button class="@(filter=="PRE_DECLARE"?"selected":"")" @onclick='() => SetFilter("PRE_DECLARE")'>Chờ lắp (@countPreDeclared)</button>}
@if(canActive){<button class="@(filter=="ACTIVE"?"selected":"")" @onclick='() => SetFilter("ACTIVE")'>Còn hạn (@countActive)</button>}
@if(canDue10){<button class="@(filter=="DUE10"?"selected":"")" @onclick='() => SetFilter("DUE10")'>D+10 (@countDue10)</button>}
@if(canDue30){<button class="@(filter=="DUE30"?"selected":"")" @onclick='() => SetFilter("DUE30")'>D+30 (@countDue30)</button>}
@if(canDue60){<button class="@(filter=="DUE60"?"selected":"")" @onclick='() => SetFilter("DUE60")'>D+60 (@countDue60)</button>}
@if(canOverdue){<button class="@(filter=="OVERDUE"?"selected":"")" @onclick='() => SetFilter("OVERDUE")'>Quá hạn (@countOverdue)</button>}
<button class="@(filter=="LOCKED"?"selected":"")" @onclick='() => SetFilter("LOCKED")'>Khoá (@countLocked)</button>
</div>
@if (countLocked > 0 && (canRenew || canUpdateDevice))
{
    <button type="button" class="btn btn-sm" data-confirm="edit" data-confirm-title="Mở khóa toàn bộ thiết bị" data-confirm-msg="@($"Bạn có chắc chắn muốn mở khóa toàn bộ {countLocked} thiết bị đang khóa để cho phép gia hạn bình thường không?")" @onclick="UnlockAllDevices">🔓 Mở khóa tất cả (@countLocked)</button>
}
<button type="button" class="btn secondary" data-confirm="none" @onclick="ExportDevicesExcel">📥 Xuất Excel (@totalDevices)</button>
</div></div>

@if (!string.IsNullOrWhiteSpace(listMessage))
{
    <div class="panel-note" style="margin-bottom:12px;padding:10px 14px;border-radius:8px;background:#f0fdf4;border:1px solid #86efac;color:#166534;font-weight:600">
        @listMessage
    </div>
}

<div class="device-summary-bar">
    <button type="button" class="device-summary-item total @(filter == "ALL" ? "active" : "")" @onclick='() => SetFilter("ALL")'>
        <span>Tổng số thiết bị / xe:</span>
        <strong>@countAll</strong>
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <small>/ @devices.Count</small>
        }
    </button>
    @if (countPreDeclared > 0)
    {
        <button type="button" class="device-summary-item @(filter == "PRE_DECLARE" ? "active" : "")" @onclick='() => SetFilter("PRE_DECLARE")'>
            <span>🆕 Mới khai báo (Chờ lắp):</span>
            <strong class="text-blue">@countPreDeclared</strong>
        </button>
    }
    @if (canActive)
    {
        <button type="button" class="device-summary-item @(filter == "ACTIVE" ? "active" : "")" @onclick='() => SetFilter("ACTIVE")'>
            <span>Hoạt động còn hạn:</span>
            <strong class="text-green">@countActive</strong>
        </button>
    }
    @if (canDue10)
    {
        <button type="button" class="device-summary-item warn @(filter == "DUE10" ? "active" : "")" @onclick='() => SetFilter("DUE10")'>
            <span>⚠️ Cảnh báo ≤ 10 ngày (D+10):</span>
            <strong class="text-red">@countDue10</strong>
        </button>
    }
    @if (canDue30)
    {
        <button type="button" class="device-summary-item @(filter == "DUE30" ? "active" : "")" @onclick='() => SetFilter("DUE30")'>
            <span>Hạn ≤ 30 ngày (D+30):</span>
            <strong class="text-purple">@countDue30</strong>
        </button>
    }
    @if (canDue60)
    {
        <button type="button" class="device-summary-item @(filter == "DUE60" ? "active" : "")" @onclick='() => SetFilter("DUE60")'>
            <span>Hạn ≤ 60 ngày (D+60):</span>
            <strong class="text-blue">@countDue60</strong>
        </button>
    }
    @if (canOverdue)
    {
        <button type="button" class="device-summary-item muted @(filter == "OVERDUE" ? "active" : "")" title="Thiết bị đã quá hạn (đã loại bỏ khỏi danh sách cảnh báo ≤ 10 ngày)" @onclick='() => SetFilter("OVERDUE")'>
            <span>Đã hết hạn (Cần lập Đơn gia hạn):</span>
            <strong class="text-orange">@countOverdue</strong>
        </button>
    }
    <button type="button" class="device-summary-item muted @(filter == "LOCKED" ? "active" : "")" @onclick='() => SetFilter("LOCKED")'>
        <span>Trạng thái Khoá:</span>
        <strong>@countLocked</strong>
    </button>
    <div class="device-summary-item showing">
        <span>Đang hiển thị:</span>
        <strong>@totalDevices xe</strong>
    </div>
</div>

<div class="table-wrap"><table><thead><tr><th>STT</th><th>BIỂN SỐ / SỐ KHUNG</th><th>SỐ IMEI &amp; ĐƠN LẮP</th><th>TÊN THIẾT BỊ</th><th>THUỘC HTX / KHÁCH HÀNG</th><th>CHỦ XE &amp; SĐT</th><th>NGÀY KÍCH HOẠT</th><th>NGÀY HẾT HẠN</th><th>LỊCH SỬ &amp; ĐƠN GIA HẠN</th><th>GIÁ GIA HẠN (12T)</th><th>TRẠNG THÁI</th><th>THAO TÁC</th></tr></thead><tbody>
@foreach(var (stt, x) in pagedDevices){
    var d = DaysToExpiry(x);
    var locked = IsLocked(x);
    <tr @key="x.ActivationId" class="@(!x.IsPreDeclared && !locked && d >= 0 && d <= 10 ? "row-due10-warn" : "")">
        <td><strong>@stt</strong></td>
        <td class="wrap-cell">
            <div><strong>@(string.IsNullOrWhiteSpace(x.Plate) ? "—" : x.Plate)</strong></div>
            @if(!string.IsNullOrWhiteSpace(x.VinNo) && !string.Equals(x.VinNo, x.Imei, StringComparison.OrdinalIgnoreCase) && !string.Equals(x.VinNo, x.OwnerName, StringComparison.OrdinalIgnoreCase))
            {
                <small style="color:#64748b">SK: @x.VinNo</small>
            }
        </td>
        <td>
            @if(x.IsPreDeclared)
            {
                <span class="chip blue-chip">🆕 Chưa gắn IMEI</span>
                <div><small style="color:#0369a1;font-weight:600">Chờ tạo Đơn lắp đặt</small></div>
            }
            else
            {
                <strong>@x.DisplayImei</strong>
                <div>
                    @if(x.HasInstallOrder)
                    {
                        <small style="color:#15803d;font-weight:600">Đơn lắp: @x.OrderCode</small>
                    }
                    else
                    {
                        <small style="color:#64748b">Chưa gắn đơn lắp gốc</small>
                    }
                </div>
            }
        </td>
        <td><span class="chip blue-chip">@(string.IsNullOrWhiteSpace(x.DeviceTypeLabel) ? x.Sku : x.DeviceTypeLabel)</span><div><small style="color:#64748b">@x.Sku</small></div></td>
        <td class="wrap-cell"><div><strong>@(string.IsNullOrWhiteSpace(x.AgencyName) ? x.Customer : x.AgencyName)</strong></div>@if(!string.IsNullOrWhiteSpace(x.SellerName)){<small style="color:#64748b">NV: @x.SellerName</small>}</td>
        <td class="wrap-cell">
            <div>@(string.IsNullOrWhiteSpace(x.OwnerName) ? (string.IsNullOrWhiteSpace(x.ContactName) ? "—" : x.ContactName) : x.OwnerName)</div>
            @if(!string.IsNullOrWhiteSpace(x.OwnerPhone)){<small>📞 @x.OwnerPhone</small>}
        </td>
        <td><strong>@(x.IsPreDeclared || string.IsNullOrWhiteSpace(x.ActivatedAt) ? "—" : x.ActivatedAt)</strong></td>
        <td><strong>@(x.IsPreDeclared || string.IsNullOrWhiteSpace(x.ExpiresAt) ? "—" : x.ExpiresAt)</strong></td>
        <td>
            <div>@(string.IsNullOrWhiteSpace(x.LastRenewedAt) ? "Chưa gia hạn" : $"Mốc GH: {x.LastRenewedAt}")</div>
            <small style="color:#64748b">Số lần GH: <strong>@x.RenewalCount</strong>@(string.IsNullOrWhiteSpace(x.LastRenewalOrderCode) ? "" : $" · {x.LastRenewalOrderCode}")</small>
        </td>
        <td><strong style="color:#0284c7">@x.RenewalPriceVnd.ToString("N0") ₫</strong></td>
        <td>
            @if (x.IsPreDeclared)
            {
                <span class="chip blue-chip">🆕 Chờ lắp đặt</span>
            }
            else if (locked)
            {
                <span class="chip orange-chip">🔒 Khoá</span>
                <div><small style="color:#64748b">@(d < 0 ? $"Quá hạn {Math.Abs(d)} ngày" : $"Còn {d} ngày")</small></div>
            }
            else if (d < 0)
            {
                <span class="chip orange-chip" title="Thiết bị đã hết hạn (đã loại bỏ khỏi cảnh báo 10 ngày)">Hết hạn (@Math.Abs(d) ngày)</span>
            }
            else if (d <= 10)
            {
                <div style="display:flex;flex-direction:column;align-items:flex-start;gap:2px">
                    <span class="chip red-warn-chip">⚠️ Còn @d ngày</span>
                    <small style="font-size:10px;color:#c92a2a;font-weight:700">Lưu ý: Cảnh báo ≤ 10 ngày</small>
                </div>
            }
            else if (d <= 30)
            {
                <span class="chip purple-chip">Hoạt động · Còn @d ngày</span>
            }
            else
            {
                <span class="chip green-chip">Hoạt động (@d ngày)</span>
            }
        </td>
        <td>
            <div style="display:flex;gap:4px;flex-wrap:wrap">
                <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => OpenDeviceDetailModal(x)">👁 Chi tiết</button>
                @if(x.IsPreDeclared)
                {
                    <button type="button" class="btn btn-sm" data-confirm="none" @onclick='() => Nav.NavigateTo($"/sales-orders?create=INSTALL&deviceId={x.ActivationId}")'>+ Tạo đơn lắp</button>
                }
                else
                {
                    @if(locked && (canRenew || canUpdateDevice))
                    {
                        <button type="button" class="btn btn-sm" style="background:#15803d;border-color:#15803d" data-confirm="none" @onclick="() => ToggleDeviceLock(x)">🔓 Mở khóa</button>
                    }
                    @if(canRenew)
                    {
                        <button type="button" class="btn btn-sm" data-confirm="none" @onclick='() => Nav.NavigateTo($"/sales-orders?create=RENEWAL&deviceId={x.ActivationId}")'>+ Đơn gia hạn</button>
                    }
                }
                @if(canRenew || canUpdateDevice)
                {
                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => OpenEditFor(x)">✏️ Sửa hạn / TT</button>
                }
                @if(canSoftDeleteDevice || isMainRole)
                {
                    <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fca5a5"
                        data-confirm="delete"
                        data-confirm-title="@(isMainRole ? "Xác nhận xóa vĩnh viễn thiết bị & toàn bộ luồng liên quan" : "Xác nhận xóa thiết bị & loại bỏ công nợ liên quan")"
                        data-confirm-msg="@(isMainRole
                            ? $"Bạn có chắc chắn muốn xóa vĩnh viễn thiết bị {x.DisplayImei} ({(string.IsNullOrWhiteSpace(x.Plate) ? "—" : x.Plate)}) cùng toàn bộ lịch sử gia hạn, đơn hàng và chứng từ kế toán công nợ liên quan phía sau khỏi hệ thống không?"
                            : $"Bạn có chắc chắn muốn xóa thiết bị {x.DisplayImei} ({(string.IsNullOrWhiteSpace(x.Plate) ? "Chưa có biển số" : x.Plate)} · Đại lý/KH: {(string.IsNullOrWhiteSpace(x.AgencyName) ? x.Customer : x.AgencyName)}) không? Các đợt gia hạn và chứng từ kế toán công nợ liên quan phía sau (chưa khóa sổ) sẽ tự động bị loại bỏ và ghi nhận vào Lưu vết hệ thống.")"
                        @onclick="() => DeleteDevice(x)">Xóa</button>
                }
                @if(canViewRowLog)
                {
                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => OpenDeviceRecordLog(x.ActivationId)">Xem log</button>
                }
            </div>
        </td>
    </tr>
}
</tbody></table></div>
<TablePager Pager="devicePager" TotalCount="totalDevices" OnChange="StateHasChanged" />
</section>

@if(detailDevice is not null)
{
    var dDev = detailDevice;
    var dRens = detailDeviceRenewals;
    <div class="so-modal-overlay" @onclick="CloseDeviceDetailModal">
        <div class="so-modal-dialog" style="max-width:980px" @onclick:stopPropagation="true">
            <div class="so-modal-header">
                <div>
                    <div class="eyebrow">CHI TIẾT HỒ SƠ PHƯƠNG TIỆN · ĐƠN GIA HẠN &amp; NHẬT KÝ CẬP NHẬT</div>
                    <h2>@(string.IsNullOrWhiteSpace(dDev.Plate) ? dDev.DisplayImei : $"{dDev.Plate} · {dDev.DisplayImei}")</h2>
                </div>
                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                    @if(canRenew || canUpdateDevice)
                    {
                        <button type="button" class="btn secondary btn-sm" style="border-color:#0284c7;color:#0369a1;font-weight:700" data-confirm="none" @onclick="() => OpenEditFromDetail(dDev)">✏️ Sửa Ngày hết hạn / TT</button>
                    }
                    @if(dDev.IsPreDeclared)
                    {
                        <button type="button" class="btn btn-sm" data-confirm="none" @onclick='() => Nav.NavigateTo($"/sales-orders?create=INSTALL&deviceId={dDev.ActivationId}")'>+ Tạo Đơn lắp đặt</button>
                    }
                    else if(canRenew)
                    {
                        <button type="button" class="btn btn-sm" data-confirm="none" @onclick='() => Nav.NavigateTo($"/sales-orders?create=RENEWAL&deviceId={dDev.ActivationId}")'>+ Tạo Đơn gia hạn</button>
                    }
                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="CloseDeviceDetailModal">✕ Đóng</button>
                </div>
            </div>
            <div class="so-modal-body">
                @if(!string.IsNullOrWhiteSpace(historyMessage))
                {
                    <div class="panel-note" style="margin-bottom:12px;padding:10px 14px;border-radius:8px;background:@(historyMessage.StartsWith("Lỗi:") ? "#fef2f2" : "#f0fdf4");border:1px solid @(historyMessage.StartsWith("Lỗi:") ? "#fca5a5" : "#86efac");color:@(historyMessage.StartsWith("Lỗi:") ? "#991b1b" : "#166534");font-weight:600">
                        @historyMessage
                    </div>
                }

                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;padding:12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;margin-bottom:14px">
                    <div><small style="color:#64748b">Biển số xe</small><div><strong>@(string.IsNullOrWhiteSpace(dDev.Plate) ? "—" : dDev.Plate)</strong></div></div>
                    <div><small style="color:#64748b">Số khung / Thông tin phụ</small><div><strong>@(string.IsNullOrWhiteSpace(dDev.VinNo) ? "—" : dDev.VinNo)</strong></div></div>
                    <div><small style="color:#64748b">Thuộc HTX / Khách hàng</small><div><strong>@(string.IsNullOrWhiteSpace(dDev.AgencyName) ? dDev.Customer : dDev.AgencyName)</strong></div></div>
                    <div><small style="color:#64748b">Chủ xe &amp; SĐT</small><div><strong>@(string.IsNullOrWhiteSpace(dDev.OwnerName) ? "—" : dDev.OwnerName) @(string.IsNullOrWhiteSpace(dDev.OwnerPhone) ? "" : $"· {dDev.OwnerPhone}")</strong></div></div>
                    <div><small style="color:#64748b">Dòng thiết bị &amp; Số IMEI</small><div><strong>@(string.IsNullOrWhiteSpace(dDev.DeviceTypeLabel) ? dDev.Sku : dDev.DeviceTypeLabel) (@dDev.DisplayImei)</strong></div></div>
                    <div><small style="color:#64748b">Liên kết Đơn lắp đặt</small><div><strong>@(dDev.IsPreDeclared ? "🆕 Chưa tạo đơn lắp đặt" : dDev.HasInstallOrder ? $"✅ Đã có đơn lắp ({dDev.OrderCode})" : "Hồ sơ có sẵn (Chưa gắn đơn lắp)")</strong></div></div>
                    <div><small style="color:#64748b">Ngày kích hoạt → Ngày hết hạn</small><div><strong style="color:#0284c7">@(dDev.IsPreDeclared ? "Chờ kích hoạt" : $"{dDev.ActivatedAt} → {dDev.ExpiresAt}")</strong></div></div>
                    <div><small style="color:#64748b">Giá gia hạn chuẩn 12T (Nhóm KH)</small><div><strong style="color:#15803d">@dDev.RenewalPriceVnd.ToString("N0") ₫</strong></div></div>
                </div>

                @if(editingRenewalId > 0 && dRens.Any(x => x.Id == editingRenewalId))
                {
                    <div style="margin-bottom:14px;padding:12px 14px;background:#eff6ff;border:1px solid #93c5fd;border-radius:10px">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                            <strong style="color:#1e3a8a">✏️ Cập nhật Mốc thời gian gia hạn (Ngày hết hạn) &amp; Thông tin đợt gia hạn #@editingRenewalId</strong>
                            <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="CancelEditRenewal">Hủy sửa</button>
                        </div>
                        <div class="form-grid">
                            <label>Ngày thực hiện gia hạn *
                                <input type="date" @bind="editRenewalStartDate" />
                            </label>
                            <label>Hạn cũ *
                                <input type="date" @bind="editRenewalPrevExpiry" />
                            </label>
                            <label>Mốc hạn mới (Ngày hết hạn mới) *
                                <input type="date" @bind="editRenewalEndDate" style="border-color:#0284c7;font-weight:700" />
                                <div style="display:flex;gap:5px;flex-wrap:wrap;margin-top:4px">
                                    <button type="button" class="btn secondary btn-sm" style="padding:2px 7px;font-size:11px" data-confirm="none" @onclick="() => editRenewalEndDate = editRenewalPrevExpiry.AddMonths(1)">+1T</button>
                                    <button type="button" class="btn secondary btn-sm" style="padding:2px 7px;font-size:11px" data-confirm="none" @onclick="() => editRenewalEndDate = editRenewalPrevExpiry.AddMonths(3)">+3T</button>
                                    <button type="button" class="btn secondary btn-sm" style="padding:2px 7px;font-size:11px" data-confirm="none" @onclick="() => editRenewalEndDate = editRenewalPrevExpiry.AddMonths(6)">+6T</button>
                                    <button type="button" class="btn secondary btn-sm" style="padding:2px 7px;font-size:11px" data-confirm="none" @onclick="() => editRenewalEndDate = editRenewalPrevExpiry.AddMonths(12)">+12T</button>
                                </div>
                            </label>
                            <label>Số tiền gia hạn (VND) *
                                <input type="number" min="0" step="10000" @bind="editRenewalPrice" />
                            </label>
                            <label>Nhân viên bán hàng
                                <select @bind="editRenewalSellerId">
                                    <option value="0">— Chưa chọn / Giữ nguyên —</option>
                                    @foreach(var sl in sellerChoices)
                                    {
                                        <option value="@sl.Id">@sl.Code — @sl.Name</option>
                                    }
                                </select>
                            </label>
                            <label>Hình thức thanh toán
                                <select @bind="editRenewalPayMethod">
                                    <option value="DEBT">Ghi công nợ Kế toán</option>
                                    <option value="CASH">Thanh toán tiền mặt</option>
                                </select>
                            </label>
                        </div>
                        <div class="form-actions" style="margin-top:10px;display:flex;gap:8px;justify-content:flex-end">
                            <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="CancelEditRenewal">Hủy</button>
                            <button type="button" class="btn btn-sm" data-confirm="edit" data-confirm-title="Xác nhận Cập nhật Đợt gia hạn &amp; Ngày hết hạn" data-confirm-msg="@($"Lưu cập nhật Mốc hạn mới ({editRenewalPrevExpiry:yyyy-MM-dd} → {editRenewalEndDate:yyyy-MM-dd}) và đồng bộ sang Thiết bị, Đơn gia hạn GH7 & Kế toán?")" @onclick="SaveRenewalEdit">💾 Lưu cập nhật Đợt gia hạn</button>
                        </div>
                    </div>
                }

                <h3 style="font-size:0.96rem;margin:0 0 8px 0">Lịch sử các lần Gia hạn &amp; Mốc thời gian (Map theo Đơn gia hạn: @dRens.Count lần)</h3>
                @if(dRens.Count == 0)
                {
                    <div class="panel-note">Thiết bị này chưa phát sinh Đơn gia hạn nào. Bạn có thể bấm <strong>✏️ Sửa Ngày hết hạn / TT</strong> ở góc trên để cập nhật trực tiếp Ngày hết hạn ban đầu hoặc bấm <strong>+ Tạo Đơn gia hạn</strong>.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Lần</th>
                                    <th>Mã Đơn gia hạn</th>
                                    <th>Ngày gia hạn</th>
                                    <th>Gói hạn</th>
                                    <th>Hạn cũ → Mốc hạn mới</th>
                                    <th>Số tiền</th>
                                    <th>NV bán hàng</th>
                                    <th>Hóa đơn KT</th>
                                    @if(canRenew || canUpdateDevice)
                                    {
                                        <th>Thao tác</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for(int idx = 0; idx < dRens.Count; idx++)
                                {
                                    var r = dRens[idx];
                                    <tr>
                                        <td><strong>#@(dRens.Count - idx)</strong></td>
                                        <td><span class="chip blue-chip">@(string.IsNullOrWhiteSpace(r.OrderCode) ? $"GH#{r.Id}" : r.OrderCode)</span></td>
                                        <td>@r.StartDate</td>
                                        <td>@(r.DurationMonths == 12 ? "12 tháng (1 năm)" : $"{r.DurationMonths} tháng")</td>
                                        <td><strong>@r.PreviousExpiry → <span style="color:#15803d">@r.EndDate</span></strong></td>
                                        <td><strong>@r.Price.ToString("N0") ₫</strong></td>
                                        <td>@r.SellerName</td>
                                        <td>@(string.IsNullOrWhiteSpace(r.InvoiceNo) ? "—" : r.InvoiceNo)</td>
                                        @if(canRenew || canUpdateDevice)
                                        {
                                            <td>
                                                @if(r.IsLocked)
                                                {
                                                    <span class="chip orange-chip">🔒 Đã chốt KT</span>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => StartEditRenewal(r)">✏️ Sửa hạn</button>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <h3 style="font-size:0.96rem;margin:16px 0 8px 0">📋 Nhật ký cập nhật Thời hạn (Ngày hết hạn) &amp; Thông tin thiết bị (@detailDeviceLogs.Count bản ghi)</h3>
                @if(detailDeviceLogs.Count == 0)
                {
                    <div class="panel-note">Chưa có lịch sử chỉnh sửa thủ công trên thiết bị này.</div>
                }
                else
                {
                    <div class="table-wrap" style="max-height:220px;overflow-y:auto">
                        <table>
                            <thead>
                                <tr>
                                    <th>Thời gian</th>
                                    <th>Nhân viên thực hiện</th>
                                    <th>Thao tác</th>
                                    <th>Chi tiết thay đổi (Trước → Sau)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var lg in detailDeviceLogs)
                                {
                                    <tr>
                                        <td><small><strong>@lg.At</strong></small></td>
                                        <td><strong>@lg.Actor</strong></td>
                                        <td><span class="chip blue-chip">@VnLabels.AuditAction(lg.Action)</span></td>
                                        <td class="wrap-cell" style="max-width:460px"><small>@lg.Details</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}
@if(canViewLog)
{
    <SystemLogModal IsOpen="showLogModal"
                    OnClose="() => showLogModal = false"
                    Title="Lịch sử &amp; Lưu vết — Thiết bị &amp; Gia hạn"
                    ScopedTables="@deviceLogTables"
                    ScopedAuditEntities="@deviceAuditEntities"
                    InitialTable="@logInitialTable"
                    InitialRecordId="@logInitialRecordId"
                    CustomTab1Label="@($"Lưu vết xóa mềm ({deletedDevices.Count})")"
                    CustomTab2Label="@($"Lịch sử gia hạn ({renewals.Count})")">
        <CustomTab1Content>
            @{ var pagedDeleted = deletedDevicePager.Slice(FilteredDeletedDevices, out var totalDeletedDevices); }
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between;margin-bottom:12px">
                <div style="font-size:13px;color:#475569">Lưu vết đầy đủ các thiết bị đã thực hiện xóa mềm (thời gian xóa, người thực hiện và chi tiết các luồng gia hạn / công nợ kế toán phía sau đã tự động loại bỏ).</div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                    <input class="search-input" style="min-width:220px" @bind="deletedSearch" @bind:event="oninput" @bind:after="() => deletedDevicePager.Reset()" placeholder="Tìm IMEI, biển số, KH, người xóa..." />
                    <span class="chip orange-chip">Đã xóa mềm: @totalDeletedDevices thiết bị</span>
                </div>
            </div>
            @if(!string.IsNullOrWhiteSpace(deletedHistoryMessage))
            {
                <div class="panel-note" style="margin-bottom:12px;padding:10px 14px;border-radius:8px;background:#f0fdf4;border:1px solid #86efac;color:#166534;font-weight:600">
                    @deletedHistoryMessage
                </div>
            }
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>BIỂN SỐ</th>
                            <th>SỐ IMEI</th>
                            <th>TÊN THIẾT BỊ</th>
                            <th>ĐẠI LÝ / KHÁCH HÀNG</th>
                            <th>CHỦ XE &amp; SĐT</th>
                            <th>KÍCH HOẠT → HẾT HẠN</th>
                            <th>THỜI GIAN &amp; NGƯỜI XÓA</th>
                            <th>LUỒNG KẾ TOÁN / GIA HẠN ĐÃ LOẠI BỎ</th>
                            @if(isMainRole)
                            {
                                <th>THAO TÁC</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if(pagedDeleted.Count == 0)
                        {
                            <tr>
                                <td colspan="@(isMainRole ? 10 : 9)" style="text-align:center;padding:18px;color:#64748b">
                                    Chưa có thiết bị nào trong danh sách lưu vết xóa mềm.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach(var (stt, dx) in pagedDeleted)
                            {
                                <tr @key="dx.ActivationId" style="background:#fffaf5">
                                    <td><strong>@stt</strong></td>
                                    <td><strong>@(string.IsNullOrWhiteSpace(dx.Plate) ? "—" : dx.Plate)</strong></td>
                                    <td><strong style="text-decoration:line-through;color:#64748b">@dx.Imei</strong></td>
                                    <td>
                                        <span class="chip orange-chip">@dx.DeviceTypeLabel</span>
                                        <div><small style="color:#64748b">@dx.Sku</small></div>
                                    </td>
                                    <td class="wrap-cell"><strong>@dx.CustomerName</strong></td>
                                    <td class="wrap-cell">
                                        <div>@(string.IsNullOrWhiteSpace(dx.OwnerName) ? "—" : dx.OwnerName)</div>
                                        @if(!string.IsNullOrWhiteSpace(dx.OwnerPhone))
                                        {
                                            <small>📞 @dx.OwnerPhone</small>
                                        }
                                    </td>
                                    <td>
                                        <div><small style="color:#64748b">@dx.ActivatedAt</small> → <strong>@dx.ExpiresAt</strong></div>
                                    </td>
                                    <td class="wrap-cell">
                                        <div><strong>@dx.DeletedAt</strong></div>
                                        <small style="color:#b45309;font-weight:600">Bởi: @dx.DeletedByName</small>
                                    </td>
                                    <td class="wrap-cell">
                                        <span style="font-size:12.5px;color:#334155">@dx.DeletedSummary</span>
                                    </td>
                                    @if(isMainRole)
                                    {
                                        <td>
                                            <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fca5a5"
                                                data-confirm="delete"
                                                data-confirm-title="Xác nhận xóa vĩnh viễn bản ghi lưu vết"
                                                data-confirm-msg="@($"Bạn có chắc chắn muốn xóa vĩnh viễn thiết bị IMEI {dx.Imei} ({(string.IsNullOrWhiteSpace(dx.Plate) ? "—" : dx.Plate)}) cùng toàn bộ dữ liệu liên quan khỏi hệ thống không?")"
                                                @onclick="() => HardDeleteFromHistory(dx.ActivationId)">Xóa</button>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <TablePager Pager="deletedDevicePager" TotalCount="totalDeletedDevices" OnChange="StateHasChanged" />
        </CustomTab1Content>
        <CustomTab2Content>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between;margin-bottom:12px">
                <div style="font-size:13px;color:#475569">Khi cập nhật hoặc xóa lịch sử gia hạn (trước khi Kế toán chốt số / khóa số), hạn thiết bị, doanh thu kế toán, sổ quỹ và hoa hồng nhân viên bán hàng sẽ tự động cập nhật đồng bộ.</div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                    <input class="search-input" style="min-width:210px" @bind="historySearch" @bind:event="oninput" @bind:after="() => renewalPager.Reset()" placeholder="Tìm IMEI, thiết bị, KH, biển số..." />
                    <select class="search-input" style="min-width:220px" @bind="historySellerFilter" @bind:after="() => renewalPager.Reset()">
                        <option value="">— Tất cả NV bán hàng gia hạn —</option>
                        @foreach(var sl in sellerChoices)
                        {
                            <option value="@sl.Name">@sl.Code — @sl.Name</option>
                        }
                    </select>
                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="ExportRenewalsExcel">📥 Xuất Excel (@FilteredRenewals.Count())</button>
                </div>
            </div>

            @if(!string.IsNullOrWhiteSpace(historyMessage))
            {
                <div class="panel-note" style="margin-bottom:12px;padding:10px 14px;border-radius:8px;background:#f0fdf4;border:1px solid #86efac;color:#166534;font-weight:600">
                    @historyMessage
                </div>
            }

            @if(editingRenewalId > 0 && (canUpdateDevice || canRenew))
            {
                <div class="panel edit-panel" style="margin-bottom:14px;background:#f8fafc;border:1px solid #93c5fd">
                    <div class="panel-head">
                        <div>
                            <h2>Cập nhật Lịch sử gia hạn #@editingRenewalId (IMEI: @editingRenewalImei · Thiết bị: @editingRenewalDeviceName)</h2>
                            <p>Thay đổi thời gian gia hạn, số tiền, hình thức thanh toán hoặc nhân viên bán hàng sẽ tự động cập nhật lại hạn thiết bị và các luồng Kế toán.</p>
                        </div>
                        <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="CancelEditRenewal">Đóng</button>
                    </div>
                    <div class="form-grid">
                        <label>Tên thiết bị (Mã sản phẩm)
                            <input readonly value="@editingRenewalDeviceName" style="background:#f1f5f9;font-weight:700;color:#0284c7" />
                        </label>
                        <label>Nhân viên bán hàng gia hạn (Tính hoa hồng) *
                            <select @bind="editRenewalSellerId">
                                <option value="0">— Chưa gán nhân viên bán hàng —</option>
                                @foreach(var sl in sellerChoices)
                                {
                                    <option value="@sl.Id">@sl.Code — @sl.Name [HH gia hạn: @sl.RenewalCommissionVnd.ToString("N0") ₫]</option>
                                }
                            </select>
                        </label>
                        <label>Nguồn gia hạn *
                            <select @bind="editRenewalSource">
                                <option value="TNM">Trường Nhật Minh</option>
                                <option value="NCC">Nhà cung cấp</option>
                                <option value="HTX">Hợp tác xã / Đại lý</option>
                                <option value="B2C">Khách lẻ trực tiếp</option>
                            </select>
                        </label>
                        <label>Ngày thực hiện gia hạn *
                            <input type="date" @bind="editRenewalStartDate" />
                        </label>
                        <label>Hạn cũ (Trước khi gia hạn) *
