                            {
                                <th>THAO TÁC</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if(pagedDeleted.Count == 0)
                        {
                            <tr>
                                <td colspan="@(isMainRole ? 10 : 9)" style="text-align:center;padding:18px;color:#64748b">
                                    Chưa có thiết bị nào trong danh sách lưu vết xóa mềm.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach(var (stt, dx) in pagedDeleted)
                            {
                                <tr @key="dx.ActivationId" style="background:#fffaf5">
                                    <td><strong>@stt</strong></td>
                                    <td><strong>@(string.IsNullOrWhiteSpace(dx.Plate) ? "—" : dx.Plate)</strong></td>
                                    <td><strong style="text-decoration:line-through;color:#64748b">@dx.Imei</strong></td>
                                    <td>
                                        <span class="chip orange-chip">@dx.DeviceTypeLabel</span>
                                        <div><small style="color:#64748b">@dx.Sku</small></div>
                                    </td>
                                    <td class="wrap-cell"><strong>@dx.CustomerName</strong></td>
                                    <td class="wrap-cell">
                                        <div>@(string.IsNullOrWhiteSpace(dx.OwnerName) ? "—" : dx.OwnerName)</div>
                                        @if(!string.IsNullOrWhiteSpace(dx.OwnerPhone))
                                        {
                                            <small>📞 @dx.OwnerPhone</small>
                                        }
                                    </td>
                                    <td>
                                        <div><small style="color:#64748b">@dx.ActivatedAt</small> → <strong>@dx.ExpiresAt</strong></div>
                                    </td>
                                    <td class="wrap-cell">
                                        <div><strong>@dx.DeletedAt</strong></div>
                                        <small style="color:#b45309;font-weight:600">Bởi: @dx.DeletedByName</small>
                                    </td>
                                    <td class="wrap-cell">
                                        <span style="font-size:12.5px;color:#334155">@dx.DeletedSummary</span>
                                    </td>
                                    @if(isMainRole)
                                    {
                                        <td>
                                            <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fca5a5"
                                                data-confirm="delete"
                                                data-confirm-title="Xác nhận xóa vĩnh viễn bản ghi lưu vết"
                                                data-confirm-msg="@($"Bạn có chắc chắn muốn xóa vĩnh viễn thiết bị IMEI {dx.Imei} ({(string.IsNullOrWhiteSpace(dx.Plate) ? "—" : dx.Plate)}) cùng toàn bộ dữ liệu liên quan khỏi hệ thống không?")"
                                                @onclick="() => HardDeleteFromHistory(dx.ActivationId)">Xóa</button>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <TablePager Pager="deletedDevicePager" TotalCount="totalDeletedDevices" OnChange="StateHasChanged" />
        </CustomTab1Content>
        <CustomTab2Content>
            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between;margin-bottom:12px">
                <div style="font-size:13px;color:#475569">Khi cập nhật hoặc xóa lịch sử gia hạn (trước khi Kế toán chốt số / khóa số), hạn thiết bị, doanh thu kế toán, sổ quỹ và hoa hồng nhân viên bán hàng sẽ tự động cập nhật đồng bộ.</div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                    <input class="search-input" style="min-width:210px" @bind="historySearch" @bind:event="oninput" @bind:after="() => renewalPager.Reset()" placeholder="Tìm IMEI, thiết bị, KH, biển số..." />
                    <select class="search-input" style="min-width:220px" @bind="historySellerFilter" @bind:after="() => renewalPager.Reset()">
                        <option value="">— Tất cả NV bán hàng gia hạn —</option>
                        @foreach(var sl in sellerChoices)
                        {
                            <option value="@sl.Name">@sl.Code — @sl.Name</option>
                        }
                    </select>
                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="ExportRenewalsExcel">📥 Xuất Excel (@FilteredRenewals.Count())</button>
                </div>
            </div>

            @if(!string.IsNullOrWhiteSpace(historyMessage))
            {
                <div class="panel-note" style="margin-bottom:12px;padding:10px 14px;border-radius:8px;background:#f0fdf4;border:1px solid #86efac;color:#166534;font-weight:600">
                    @historyMessage
                </div>
            }

            @if(editingRenewalId > 0 && (canUpdateDevice || canRenew))
            {
                <div class="panel edit-panel" style="margin-bottom:14px;background:#f8fafc;border:1px solid #93c5fd">
                    <div class="panel-head">
                        <div>
                            <h2>Cập nhật Lịch sử gia hạn #@editingRenewalId (IMEI: @editingRenewalImei · Thiết bị: @editingRenewalDeviceName)</h2>
                            <p>Thay đổi thời gian gia hạn, số tiền, hình thức thanh toán hoặc nhân viên bán hàng sẽ tự động cập nhật lại hạn thiết bị và các luồng Kế toán.</p>
                        </div>
                        <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="CancelEditRenewal">Đóng</button>
                    </div>
                    <div class="form-grid">
                        <label>Tên thiết bị (Mã sản phẩm)
                            <input readonly value="@editingRenewalDeviceName" style="background:#f1f5f9;font-weight:700;color:#0284c7" />
                        </label>
                        <label>Nhân viên bán hàng gia hạn (Tính hoa hồng) *
                            <select @bind="editRenewalSellerId">
                                <option value="0">— Chưa gán nhân viên bán hàng —</option>
                                @foreach(var sl in sellerChoices)
                                {
                                    <option value="@sl.Id">@sl.Code — @sl.Name [HH gia hạn: @sl.RenewalCommissionVnd.ToString("N0") ₫]</option>
                                }
                            </select>
                        </label>
                        <label>Nguồn gia hạn *
                            <select @bind="editRenewalSource">
                                <option value="TNM">Trường Nhật Minh</option>
                                <option value="NCC">Nhà cung cấp</option>
                                <option value="HTX">Hợp tác xã / Đại lý</option>
                                <option value="B2C">Khách lẻ trực tiếp</option>
                            </select>
                        </label>
                        <label>Ngày thực hiện gia hạn *
                            <input type="date" @bind="editRenewalStartDate" />
                        </label>
                        <label>Hạn cũ (Trước khi gia hạn) *
                            <input type="date" @bind="editRenewalPrevExpiry" />
                        </label>
                        <label>Hạn mới (Thời gian gia hạn mới của TB) *
                            <input type="date" @bind="editRenewalEndDate" />
                        </label>
                        <label>Số tiền gia hạn / Doanh thu (VND) *
                            <input type="number" min="0" step="10000" @bind="editRenewalPrice" />
                        </label>
                        <label>Hình thức thanh toán *
                            <select @bind="editRenewalPayMethod">
                                <option value="DEBT">Ghi công nợ (Chưa thanh toán)</option>
                                <option value="CASH">Thanh toán ngay (Thu tiền mặt)</option>
                            </select>
                        </label>
                    </div>
                    <div class="form-actions" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                        <button type="button" class="btn" data-confirm="edit" data-confirm-title="Xác nhận Cập nhật Lịch sử gia hạn" data-confirm-msg="@($"Bạn có chắc chắn muốn lưu cập nhật lịch sử gia hạn #{editingRenewalId} (IMEI: {editingRenewalImei} · Thiết bị: {editingRenewalDeviceName}) và đồng bộ lại Kế toán không?")" @onclick="SaveRenewalEdit">Lưu cập nhật &amp; Đồng bộ Kế toán</button>
                        <button type="button" class="btn secondary" data-confirm="none" @onclick="CancelEditRenewal">Hủy</button>
                    </div>
                </div>
            }

            @if(renewals.Count > 0)
            {
                <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px">
                    @foreach(var grp in renewals.GroupBy(r => string.IsNullOrWhiteSpace(r.SellerName) ? "Chưa gán NV bán hàng" : r.SellerName))
                    {
                        <div style="padding:8px 12px;border-radius:8px;background:#f8fafc;border:1px solid #cbd5e1;font-size:12.5px">
                            <strong>@grp.Key:</strong> <span class="chip blue-chip">@grp.Count() lượt gia hạn</span> · Tổng doanh thu gia hạn: <strong style="color:#0284c7">@grp.Sum(x => x.Price).ToString("N0") ₫</strong>
                        </div>
                    }
                </div>
            }

            @{ var pagedRenewals = renewalPager.Slice(FilteredRenewals, out var totalRenewals); }
            <div class="table-wrap"><table><thead><tr><th>STT</th><th>IMEI</th><th>TÊN THIẾT BỊ</th><th>KHÁCH HÀNG / BIỂN SỐ</th><th>NV BÁN HÀNG GIA HẠN</th><th>NGUỒN</th><th>NGÀY GIA HẠN</th><th>HẠN CŨ → HẠN MỚI</th><th>SỐ TIỀN GIA HẠN</th><th>THANH TOÁN</th><th>TRẠNG THÁI KT</th><th>THAO TÁC</th></tr></thead><tbody>
            @foreach(var (stt, x) in pagedRenewals){<tr @key="x.Id">
                <td><strong>@stt</strong></td>
                <td><strong>@x.Imei</strong></td>
                <td>
                    <span class="chip blue-chip">@(string.IsNullOrWhiteSpace(x.DeviceName) ? (string.IsNullOrWhiteSpace(x.ProductSku) ? "—" : x.ProductSku) : x.DeviceName)</span>
                    @if(!string.IsNullOrWhiteSpace(x.ProductSku))
                    {
                        <div><small style="color:#64748b">@x.ProductSku</small></div>
                    }
                </td>
                <td class="wrap-cell"><div><strong>@(string.IsNullOrWhiteSpace(x.CustomerName) ? "—" : x.CustomerName)</strong></div>@if(!string.IsNullOrWhiteSpace(x.PlateNo)){<small>Biển số: @x.PlateNo</small>}</td>
                <td><span class="chip green-chip">@(string.IsNullOrWhiteSpace(x.SellerName) ? "—" : x.SellerName)</span></td>
                <td>@VnLabels.RenewalSource(x.Source)</td>
                <td>@x.StartDate</td>
                <td>
                    <div><small style="color:#64748b">@(string.IsNullOrWhiteSpace(x.PreviousExpiry) ? "—" : x.PreviousExpiry)</small> → <strong>@x.EndDate</strong></div>
                </td>
                <td><strong>@x.Price.ToString("N0") ₫</strong></td>
                <td>@(x.PaymentMethod=="DEBT"?"Công nợ":"Thanh toán ngay")</td>
                <td>
                    @if(x.IsLocked)
                    {
                        <span class="chip orange-chip" title="Đã chốt số lúc @x.LockedAt">🔒 Đã chốt số KT</span>
                    }
                    else
                    {
                        <span class="chip blue-chip">Chưa chốt số</span>
                    }
                </td>
                <td>
                    <div style="display:flex;gap:4px;flex-wrap:wrap;align-items:center">
                        @if(!x.IsLocked && (canUpdateDevice || canRenew))
                        {
                            <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => StartEditRenewal(x)">Sửa</button>
                            <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fca5a5" data-confirm="delete" data-confirm-msg="@($"Bạn có chắc chắn muốn xóa lịch sử gia hạn của IMEI {x.Imei} (Thiết bị: {(string.IsNullOrWhiteSpace(x.DeviceName) ? x.ProductSku : x.DeviceName)} · Hạn {x.PreviousExpiry} → {x.EndDate}, số tiền {x.Price:N0} ₫) và đồng bộ lại Kế toán không?")" @onclick="() => ConfirmDeleteRenewal(x.Id)">Xóa</button>
                        }
                        else if(x.IsLocked)
                        {
                            <small style="color:#b45309;font-weight:600">Đã khóa sổ</small>
                        }
                        @if(canFinanceLock)
                        {
                            <button type="button" class="btn secondary btn-sm" data-confirm="edit" data-confirm-title="@(x.IsLocked ? "Xác nhận Mở khóa chốt số Kế toán" : "Xác nhận Chốt số / Khóa sổ Kế toán")" data-confirm-msg="@(x.IsLocked ? $"Bạn có chắc chắn muốn mở khóa chốt số Kế toán cho đợt gia hạn IMEI {x.Imei} ({(string.IsNullOrWhiteSpace(x.DeviceName) ? x.ProductSku : x.DeviceName)}) không?" : $"Bạn có chắc chắn muốn Chốt số / Khóa sổ Kế toán cho đợt gia hạn IMEI {x.Imei} (Thiết bị: {(string.IsNullOrWhiteSpace(x.DeviceName) ? x.ProductSku : x.DeviceName)} · Số tiền: {x.Price:N0} ₫) không?")" title="@(x.IsLocked ? "Mở khóa chốt số Kế toán" : "Kế toán chốt số / khóa số đợt gia hạn này")" @onclick="() => ToggleRenewalLock(x)">
                                @(x.IsLocked ? "🔓 Mở khóa" : "🔒 Chốt số")
                            </button>
                        }
                    </div>
                </td>
            </tr>}
            </tbody></table></div>
            <TablePager Pager="renewalPager" TotalCount="totalRenewals" OnChange="StateHasChanged" />
        </CustomTab2Content>
    </SystemLogModal>
}
@code {
 private bool showRenew, showEditAct, showCreateDevice;
 private readonly PagerState devicePager = new();
 private readonly PagerState renewalPager = new();
 private readonly PagerState deletedDevicePager = new();
 private void ToggleForm(string form){
  showRenew = form=="showRenew" && !showRenew;
  showEditAct = form=="showEditAct" && !showEditAct;
  showCreateDevice = form=="showCreateDevice" && !showCreateDevice;
 }

 private List<DeviceVm> devices=[];
 private List<RenewalVm> renewals=[];
 private List<DeletedDeviceVm> deletedDevices=[];
 private List<SellerChoiceVm> sellerChoices=[];
 private List<CustomerVm> customers=[];
 private List<ProductVm> hardwareProducts=[];
 private List<(long Id, string Imei, string WarehouseName)> availStockImeis=[];
 private List<(string Key, string Name, string Phone)> agencyOwners=[];

 // State thêm thiết bị mới (nhập tay & chọn từ data)
 private long createCustomerId, createProductId, createSellerId, createPreviewRenewalVnd;
 private int createDurationMonths = 12;
 private DateTime createActivatedDate = DateTime.Today;
 private DateTime createExpiresDate = DateTime.Today.AddYears(1);
 private string createDeviceTypeLabel = "XANHGPS", createImei = "", pickedStockImei = "", createPlate = "", pickedAgencyOwnerKey = "", createOwnerName = "", createOwnerPhone = "", createDeviceStatus = "ACTIVE", createMessage = "";

 private long activationId=1, editActivationId=1, renewSellerId, editDeviceSellerId, currentActorId;
 private int editDurationMonths=12;
 private DateTime editActivatedDate = DateTime.Today;
 private DateTime editExpiresDate = DateTime.Today.AddYears(1);
 private string source="TNM",method="DEBT",message="",editMessage="",listMessage="",historyMessage="",deletedHistoryMessage="",deletedSearch="",editPlate="",editVin="",editDeviceStatus="ACTIVE",search="",filter="ACTIVE",historySellerFilter="",historySearch="";
 private bool canRenew,canUpdateDevice,canFinanceLock,canViewLog,canActive,canOverdue,canDue10,canDue30,canDue60,canSoftDeleteDevice,isMainRole,showLogModal;
 private string? logInitialTable;
 private long? logInitialRecordId;
 private static readonly string[] deviceLogTables = ["activations", "renewals", "stock_units"];
 private static readonly string[] deviceAuditEntities = ["ACTIVATION", "RENEWAL", "DEVICE", "STOCK_UNIT"];
 private void OpenModuleLog() { logInitialTable = null; logInitialRecordId = null; showLogModal = true; }
 private void OpenDeviceRecordLog(long actId) { logInitialTable = "activations"; logInitialRecordId = actId; showLogModal = true; }

 private IEnumerable<string> AvailableDeviceTypeLabels =>
  new[] { "XANHGPS", "NASAGPS", "TDCGPS", "mGPS", "AICAM", "CAM4CH", "TG2000" }
   .Concat(devices.Select(d => d.DeviceTypeLabel).Where(s => !string.IsNullOrWhiteSpace(s)))
   .Distinct(StringComparer.OrdinalIgnoreCase);

 private IEnumerable<DeletedDeviceVm> FilteredDeletedDevices => deletedDevices.Where(dx =>
  string.IsNullOrWhiteSpace(deletedSearch) ||
