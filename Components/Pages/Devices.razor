   var oldPrices = Db.PreviewCustomerGroupPrices(d.CustomerId, d.ProductId);
   editOldStandardVnd = editPreviewStandardVnd = oldPrices.StandardPriceVnd;
   editOldInstalledVnd = editPreviewInstalledVnd = oldPrices.InstalledPriceVnd;
   editOldRenewalVnd = editPreviewRenewalVnd = oldPrices.RenewalPriceVnd;
   if (DateTime.TryParse(d.ActivatedAt, out var dt)) editActivatedDate = dt.Date;
   if (DateTime.TryParse(d.ExpiresAt, out var expDt)) editExpiresDate = expDt.Date;
   else editExpiresDate = editActivatedDate.AddMonths(editDurationMonths);
   editDeviceSellerId = d.SellerId ?? 0;
   editPlate = d.Plate ?? "";
   editOwnerName = !string.IsNullOrWhiteSpace(d.OwnerName) ? d.OwnerName : (d.ContactName ?? "");
   editOwnerPhone = d.OwnerPhone ?? "";
   editVin = d.VinNo ?? "";
   editDeviceStatus = IsLocked(d) ? "DISABLED" : "ACTIVE";
  }
