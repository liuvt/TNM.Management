 private void OnEditCustomerChanged(){
  var d = devices.FirstOrDefault(x => x.ActivationId == editActivationId);
  if (d is null) return;
  var effCust = editCustomerId > 0 ? editCustomerId : d.CustomerId;
  var nextPrices = Db.PreviewCustomerGroupPrices(effCust, d.ProductId);
  editPreviewStandardVnd = nextPrices.StandardPriceVnd;
  editPreviewInstalledVnd = nextPrices.InstalledPriceVnd;
  editPreviewRenewalVnd = nextPrices.RenewalPriceVnd;
  if (effCust != d.CustomerId)
  {
   var targetCust = customers.FirstOrDefault(c => c.Id == effCust);
   editDeviceSellerId = targetCust?.SellerId ?? 0;
  }
  else
