 private async Task OnImportFileSelected(InputFileChangeEventArgs e)
 {
  var file = e.File;
  if (file is null) return;
  importBusy = true;
  importStatusMsg = $"Đang đọc & kiểm định ràng buộc file '{file.Name}'...";
  StateHasChanged();
  try
  {
   using var stream = file.OpenReadStream(maxAllowedSize: 30 * 1024 * 1024);
   using var ms = new MemoryStream();
   await stream.CopyToAsync(ms);
   pendingImportBytes = ms.ToArray();
   importSourceName = file.Name;
   importCsvPaste = "";
   using var checkStream = new MemoryStream(pendingImportBytes);
   importReport = DeviceImporter.ImportFromStream(checkStream, importSourceName, dryRun: true, actorId: currentActorId);
   importStatusMsg = importReport.RejectedErrorCount == 0
    ? "✅ Đã kiểm tra xong dữ liệu (Hợp lệ 100%). Bấm 'Bước 2: Xác nhận Import vào Hệ thống' để ghi dữ liệu."
    : $"❌ Phát hiện {importReport.RejectedErrorCount} dòng vi phạm ràng buộc — Vui lòng kiểm tra bảng lỗi bên dưới.";
  }
  catch (Exception ex)
  {
   importStatusMsg = $"Lỗi đọc file: {ex.Message}";
   importReport = null;
  }
  finally
  {
   importBusy = false;
  }
 }

 private void RunPasteDryRun()
 {
  if (string.IsNullOrWhiteSpace(importCsvPaste)) return;
  importBusy = true;
  try
  {
   pendingImportBytes = System.Text.Encoding.UTF8.GetBytes(importCsvPaste);
   importSourceName = "du-lieu-dan-truc-tiep.csv";
   using var ms = new MemoryStream(pendingImportBytes);
   importReport = DeviceImporter.ImportFromStream(ms, importSourceName, dryRun: true, actorId: currentActorId);
   importStatusMsg = importReport.RejectedErrorCount == 0
    ? "✅ Đã kiểm tra xong dữ liệu dán (Hợp lệ 100%). Bấm 'Bước 2: Xác nhận Import vào Hệ thống' để ghi dữ liệu."
    : $"❌ Phát hiện {importReport.RejectedErrorCount} dòng vi phạm ràng buộc.";
  }
  catch (Exception ex)
  {
   importStatusMsg = $"Lỗi kiểm tra dữ liệu: {ex.Message}";
  }
  finally
  {
   importBusy = false;
  }
 }

 private void CommitValidatedImport()
 {
  if (pendingImportBytes is null || pendingImportBytes.Length == 0) return;
  importBusy = true;
  try
  {
   using var ms = new MemoryStream(pendingImportBytes);
   importReport = DeviceImporter.ImportFromStream(ms, importSourceName, dryRun: false, actorId: currentActorId);
   if (importReport.Committed)
   {
    listMessage = importReport.SummaryMessage;
    importStatusMsg = "✅ Đã thực thi Import & đồng bộ thành công!";
    Reload();
   }
  }
  catch (Exception ex)
  {
   importStatusMsg = $"Lỗi khi ghi dữ liệu Import: {ex.Message}";
  }
  finally
  {
   importBusy = false;
  }
 }

 private void ClearImportState()
 {
  pendingImportBytes = null;
  importSourceName = "";
  importCsvPaste = "";
  importStatusMsg = "";
  importReport = null;
 }

