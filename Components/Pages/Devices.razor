@attribute [Authorize(Policy = Permissions.DevicesView)]
@page "/devices"
@inject DemoDb Db
@inject PermissionGate Gate
@inject IJSRuntime JS
<PageTitle>Thiết bị · TNM</PageTitle>
<div class="page-head"><div><div class="eyebrow">SUBSCRIPTIONS / RENEWAL</div><h1>Thiết bị đang hoạt động</h1><p>Theo dõi IMEI, biển số, ngày kích hoạt, hạn gia hạn và toàn bộ các lần gia hạn.</p></div></div>
<div class="crud-actionbar">
    @if(canRenew){<button type="button" class="btn secondary" @onclick="()=>ToggleForm(nameof(showRenew))">@(showRenew?"Đóng · + Gia hạn":"+ Gia hạn")</button>}
    @if(canRenew || canUpdateDevice){<button type="button" class="btn secondary" @onclick="()=>ToggleForm(nameof(showEditAct))">@(showEditAct?"Đóng · Cập nhật Thời gian gia hạn & Ngày KH":"Cập nhật Thời gian gia hạn & Ngày kích hoạt")</button>}
    @if(canRenew || canUpdateDevice){<button type="button" class="btn @(showImportPanel?"":"secondary")" @onclick="()=>ToggleForm(nameof(showImportPanel))">@(showImportPanel?"Đóng · 📥 Import / Quản lý File Thiết bị":"📥 Import / Quản lý File Thiết bị (12 cột)")</button>}
    <button type="button" class="btn secondary" data-confirm="none" @onclick="ExportDevicesExcel">📥 Xuất Excel Thiết bị (@FilteredDevicesList.Count)</button>
    <a class="btn secondary" href="/templates/DATA_TB_TNM.xlsx" download="DATA_TB_TNM.xlsx">⬇ Tải File Chuẩn (.xlsx)</a>
</div>

@if(canRenew || canUpdateDevice){
<div class="panel edit-panel" hidden="@(!showImportPanel)">
    <div class="panel-head">
        <div>
            <h2>📥 Import &amp; Quản lý Danh sách Thiết bị theo Format chuẩn (12 cột)</h2>
            <p>Hệ thống tự động kiểm tra theo <strong>Số EMEI Thiết bị</strong>: nếu trùng dữ liệu cũ sẽ <strong>cập nhật lại theo danh sách mới</strong>, nếu chưa có sẽ <strong>thêm mới</strong> vào danh sách quản lý.</p>
        </div>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
        <a class="btn secondary btn-sm" href="/templates/DATA_TB_TNM.xlsx" download="DATA_TB_TNM.xlsx">⬇ Tải File Import Chuẩn Gốc (DATA_TB_TNM.xlsx · 3.021 dòng)</a>
        <a class="btn secondary btn-sm" href="/templates/danh-sach-thiet-bi-import.csv" download="danh-sach-thiet-bi-import.csv">⬇ Tải File Import Chuẩn (CSV UTF-8 · 3.021 dòng)</a>
        <a class="btn secondary btn-sm" href="/templates/mau-import-thiet-bi.csv" download="mau-import-thiet-bi.csv">⬇ Tải File Mẫu Import (10 dòng mẫu)</a>
        <a class="btn btn-sm" href="/export/devices-import-format.csv" target="_blank">⬇ Xuất Toàn Bộ Thiết Bị Đang Quản Lý Theo Format Này (.csv)</a>
    </div>
    <div style="font-size:12px;color:#334155;background:#f8fafc;border:1px dashed #cbd5e1;border-radius:8px;padding:8px 12px;margin-bottom:12px">
        <strong>Cấu trúc 12 cột chuẩn:</strong>
        <code>1. STT | 2. Biển số xe/Số khung | 3. Số EMEI Thiết bị | 4. Tên Thiết bị | 5. Tên Đại lý | 6. Tên Khách hàng | 7. SĐT Khách hàng | 8. Trạng thái thiết bị (Hoạt động / Khoá) | 9. Ngày kích hoạt | 10. Ngày hết hạn | 11. Ngày gia hạn gần nhất (nếu có) | 12. Số lần gia hạn</code>
    </div>
    <div class="form-grid">
        <label>Chọn file Excel (<code>.xlsx</code>) hoặc CSV (<code>.csv</code>) theo mẫu 12 cột
            <InputFile OnChange="OnImportFileSelected" accept=".xlsx,.csv,.txt" />
        </label>
        <label>Hoặc dán trực tiếp nội dung từ Excel / CSV (tùy chọn)
            <textarea rows="3" @bind="importCsvPaste" placeholder="Dán các dòng dữ liệu từ Excel hoặc CSV (12 cột) vào đây..."></textarea>
        </label>
    </div>
    <div class="form-actions" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <button type="button" class="btn" disabled="@isImporting" data-confirm="edit" data-confirm-title="Xác nhận Import &amp; Cập nhật Thiết bị" data-confirm-msg="Bạn có chắc chắn muốn thực hiện Import và cập nhật trùng dữ liệu thiết bị theo danh sách đã chọn không?" @onclick="ExecuteImportDevices">
            @(isImporting ? "Đang kiểm tra trùng & cập nhật..." : "Thực hiện Import & Cập nhật trùng dữ liệu")
        </button>
        @if (!string.IsNullOrWhiteSpace(selectedImportFileName))
        {
            <span class="chip blue-chip">File đã chọn: @selectedImportFileName</span>
        }
        @if (!string.IsNullOrWhiteSpace(importFeedback))
        {
            <span class="feedback" style="font-weight:700">@importFeedback</span>
        }
    </div>
</div>
}

@if(canRenew){
    var selectedRenewDevice = devices.FirstOrDefault(x => x.ActivationId == activationId);
    var selectedRenewDeviceName = selectedRenewDevice is null ? "—" : (string.IsNullOrWhiteSpace(selectedRenewDevice.DeviceTypeLabel) ? selectedRenewDevice.Sku : selectedRenewDevice.DeviceTypeLabel);
    <div class="panel edit-panel" hidden="@(!showRenew)"><div class="panel-head"><div><h2>Gia hạn thiết bị</h2><p>Chọn thiết bị IMEI và nhân viên bán hàng phụ trách gia hạn để thống kê cuối kỳ và tính hoa hồng.</p></div></div>
<div class="form-grid">
<label>Thiết bị / biển số *
    <select @bind="activationId" @bind:after="OnRenewDeviceSelected">
        @foreach(var x in devices)
        {
            var devLabel = string.IsNullOrWhiteSpace(x.DeviceTypeLabel) ? x.Sku : x.DeviceTypeLabel;
            <option value="@x.ActivationId">@x.Imei — [@devLabel] · @x.Customer @(string.IsNullOrWhiteSpace(x.Plate) ? "" : $"({x.Plate})") · Hết hạn: @x.ExpiresAt</option>
        }
    </select>
</label>
<label>Tên thiết bị (Mã SKU)
    <input readonly value="@(selectedRenewDevice is null ? "—" : $"{selectedRenewDeviceName} ({selectedRenewDevice.Sku})")" style="background:#f1f5f9;font-weight:700;color:#0284c7" />
</label>
<label>Giá gia hạn áp dụng (12 tháng)
    <input readonly value="@(selectedRenewDevice is null ? "—" : $"{selectedRenewDevice.RenewalPriceVnd:N0} ₫")" style="background:#f1f5f9;font-weight:700;color:#15803d" />
</label>
<label>Nhân viên bán hàng gia hạn (Tính hoa hồng) *
    <select @bind="renewSellerId">
        <option value="0">— Chọn nhân viên bán hàng phụ trách gia hạn —</option>
        @foreach(var sl in sellerChoices)
        {
            <option value="@sl.Id">@sl.Code — @sl.Name @(string.IsNullOrWhiteSpace(sl.Department) ? "" : $"({sl.Department})") [HH gia hạn: @sl.RenewalCommissionVnd.ToString("N0") ₫]</option>
        }
    </select>
</label>
<label>Nguồn gia hạn
    <select @bind="source">
        <option value="TNM">TNM</option>
        <option value="NCC">Nhà cung cấp</option>
        <option value="HTX">Hợp tác xã</option>
        <option value="B2C">Khách lẻ B2C</option>
    </select>
</label>
<label>Thanh toán
    <select @bind="method">
        <option value="DEBT">Ghi công nợ</option>
        <option value="CASH">Thanh toán ngay</option>
    </select>
</label>
</div>
<div class="form-actions"><button class="btn" data-confirm="add" data-confirm-title="Xác nhận Gia hạn thiết bị 12 tháng" data-confirm-msg="@($"Bạn có chắc chắn muốn gia hạn 12 tháng cho thiết bị {(selectedRenewDevice is null ? "" : $"{selectedRenewDevice.Imei} ({selectedRenewDeviceName})")} và đồng bộ doanh thu sang Kế toán không?")" @onclick="Renew">+ Gia hạn 12 tháng</button><span class="feedback">@message</span></div>
</div>}

@if(canRenew || canUpdateDevice){
    var selectedEditDevice = devices.FirstOrDefault(x => x.ActivationId == editActivationId);
    var selectedEditDeviceName = selectedEditDevice is null ? "—" : (string.IsNullOrWhiteSpace(selectedEditDevice.DeviceTypeLabel) ? selectedEditDevice.Sku : selectedEditDevice.DeviceTypeLabel);
    <div class="panel edit-panel" hidden="@(!showEditAct)"><div class="panel-head"><div><h2>Cập nhật Thời gian gia hạn (Ngày hết hạn), Ngày kích hoạt IMEI &amp; Thông tin thiết bị</h2><p>Cho phép điều chỉnh Ngày kích hoạt, Ngày hết hạn (thời gian gia hạn), nhân viên bán hàng phụ trách, Biển số xe và Thông tin phụ cho đến khi Kế toán chốt số / khóa số.</p></div></div>
<div class="form-grid">
<label>Chọn thiết bị IMEI
    <select @bind="editActivationId" @bind:after="OnEditDeviceSelected">
        @foreach(var x in devices)
        {
            var devLabel = string.IsNullOrWhiteSpace(x.DeviceTypeLabel) ? x.Sku : x.DeviceTypeLabel;
            <option value="@x.ActivationId">@x.Imei — [@devLabel] · @x.Customer @(string.IsNullOrWhiteSpace(x.Plate) ? "" : $"({x.Plate})") · Hạn: @x.ExpiresAt</option>
        }
    </select>
</label>
<label>Tên thiết bị (Mã SKU)
    <input readonly value="@(selectedEditDevice is null ? "—" : $"{selectedEditDeviceName} ({selectedEditDevice.Sku})")" style="background:#f1f5f9;font-weight:700;color:#0284c7" />
</label>
<label>Ngày kích hoạt IMEI *
    <input type="date" @bind="editActivatedDate" @bind:after="OnEditActivatedOrDurationChanged" />
</label>
<label>Tính nhanh theo thời hạn
    <select @bind="editDurationMonths" @bind:after="OnEditActivatedOrDurationChanged">
        <option value="12">1 năm (12 tháng)</option>
        <option value="24">2 năm (24 tháng)</option>
        <option value="36">3 năm (36 tháng)</option>
        <option value="6">6 tháng</option>
    </select>
</label>
<label>Ngày hết hạn / Thời gian gia hạn thiết bị *
    <input type="date" @bind="editExpiresDate" />
</label>
<label>Nhân viên bán hàng phụ trách
    <select @bind="editDeviceSellerId">
        <option value="0">— Giữ nguyên nhân viên bán hàng hiện tại —</option>
        @foreach(var sl in sellerChoices)
        {
            <option value="@sl.Id">@sl.Code — @sl.Name</option>
        }
    </select>
</label>
<label>Biển số xe<input @bind="editPlate" placeholder="VD: 51H-123.45" /></label>
<label>Thông tin phụ / Số khung<input @bind="editVin" placeholder="Thông tin phụ, số khung, chủ xe..." /></label>
</div>
<div class="form-actions"><button class="btn" data-confirm="edit" data-confirm-title="Xác nhận Cập nhật thông tin thiết bị" data-confirm-msg="@($"Bạn có chắc chắn muốn lưu cập nhật Ngày kích hoạt ({editActivatedDate:yyyy-MM-dd}), Ngày hết hạn ({editExpiresDate:yyyy-MM-dd}) và thông tin thiết bị {(selectedEditDevice is null ? "" : $"{selectedEditDevice.Imei} ({selectedEditDeviceName})")} không?")" @onclick="SaveActivationUpdate">Lưu Thời gian gia hạn &amp; Thông tin thiết bị</button><span class="feedback">@editMessage</span></div>
</div>}

@{
    var searchedDevices = devices.Where(MatchSearch).ToList();
    var countAll = searchedDevices.Count;
    var countActive = searchedDevices.Count(x => !IsLocked(x) && DaysToExpiry(x) >= 0);
    var countDue10 = searchedDevices.Count(x => { var d = DaysToExpiry(x); return !IsLocked(x) && d >= 0 && d <= 10; });
    var countDue30 = searchedDevices.Count(x => { var d = DaysToExpiry(x); return !IsLocked(x) && d >= 0 && d <= 30; });
    var countDue60 = searchedDevices.Count(x => { var d = DaysToExpiry(x); return !IsLocked(x) && d >= 0 && d <= 60; });
    var countOverdue = searchedDevices.Count(x => DaysToExpiry(x) < 0);
    var countLocked = searchedDevices.Count(IsLocked);

    var due10WarningDevices = devices.Where(x => { var d = DaysToExpiry(x); return !IsLocked(x) && d >= 0 && d <= 10; }).OrderBy(DaysToExpiry).ToList();
    var due0AllCount = due10WarningDevices.Count(x => DaysToExpiry(x) == 0);
    var due1To10AllCount = due10WarningDevices.Count - due0AllCount;
    var overdueAllCount = devices.Count(x => DaysToExpiry(x) < 0);
    var pagedDevices = devicePager.Slice(searchedDevices.Where(MatchFilter), out var totalDevices);
}

@if (canDue10)
{
    <div class="device-due10-note @(due10WarningDevices.Count > 0 ? "has-warning" : "no-warning")">
        <div class="device-due10-note-head">
            <div class="device-due10-note-title">
                <span class="device-due10-badge-icon">🔔</span>
                <div>
                    <strong>Note cảnh báo gia hạn (Còn hạn 10 ngày trở xuống): <span>@due10WarningDevices.Count thiết bị</span></strong>
                    <p>
                        @if (due10WarningDevices.Count > 0)
                        {
                            <span>Có <strong>@due10WarningDevices.Count thiết bị</strong> còn hạn từ 0 đến 10 ngày cần ưu tiên gia hạn (trong đó <strong>@due0AllCount</strong> thiết bị hết hạn hôm nay, <strong>@due1To10AllCount</strong> thiết bị còn 1–10 ngày). <em>Đã tự động loại bỏ @overdueAllCount thiết bị đã hết hạn ra khỏi danh sách cảnh báo này.</em></span>
                        }
                        else
                        {
                            <span>Hiện không có thiết bị nào còn hạn từ 10 ngày trở xuống. <em>(Đã loại bỏ @overdueAllCount thiết bị đã hết hạn).</em></span>
                        }
                    </p>
                </div>
            </div>
            @if (due10WarningDevices.Count > 0)
            {
                <button type="button" class="btn btn-sm @(filter == "DUE10" ? "secondary" : "")" @onclick='() => SetFilter("DUE10")'>
                    @(filter == "DUE10" ? $"Đang xem cảnh báo ≤ 10 ngày ({countDue10})" : $"Xem ngay DS cảnh báo ≤ 10 ngày ({due10WarningDevices.Count})")
                </button>
            }
        </div>
        @if (due10WarningDevices.Count > 0)
        {
            <div class="device-due10-preview-list">
                @foreach (var w in due10WarningDevices.Take(6))
                {
                    var wd = DaysToExpiry(w);
                    <button type="button" class="device-due10-pill" title="Bấm để gia hạn nhanh thiết bị @w.Imei" @onclick="() => OpenRenewFor(w)">
                        <strong>@w.Imei</strong>
                        <span>@(string.IsNullOrWhiteSpace(w.Plate) ? w.Customer : $"{w.Plate} · {w.Customer}")</span>
                        <b class="@(wd == 0 ? "urgent" : "")">@(wd == 0 ? "Còn 0 ngày (Hôm nay)" : $"Còn {wd} ngày")</b>
                    </button>
                }
                @if (due10WarningDevices.Count > 6)
                {
                    <button type="button" class="device-due10-pill more" @onclick='() => SetFilter("DUE10")'>
                        +@((due10WarningDevices.Count - 6)) thiết bị khác →
                    </button>
                }
            </div>
        }
    </div>
}

<section class="panel"><div class="panel-head"><div><h2>Danh sách kích hoạt</h2><p>Đặt hạn thực tế sau cùng, không ghi đè lịch sử gia hạn.</p></div>
<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
<input class="search-input" @bind="search" @bind:event="oninput" @bind:after="() => devicePager.Reset()" placeholder="Tìm IMEI, biển số, KH, NV bán hàng..." />
<div class="tabs">
<button class="@(filter=="ALL"?"selected":"")" @onclick='() => SetFilter("ALL")'>Tất cả (@countAll)</button>
@if(canActive){<button class="@(filter=="ACTIVE"?"selected":"")" @onclick='() => SetFilter("ACTIVE")'>Còn hạn (@countActive)</button>}
@if(canDue10){<button class="@(filter=="DUE10"?"selected":"")" @onclick='() => SetFilter("DUE10")'>D+10 (@countDue10)</button>}
@if(canDue30){<button class="@(filter=="DUE30"?"selected":"")" @onclick='() => SetFilter("DUE30")'>D+30 (@countDue30)</button>}
@if(canDue60){<button class="@(filter=="DUE60"?"selected":"")" @onclick='() => SetFilter("DUE60")'>D+60 (@countDue60)</button>}
@if(canOverdue){<button class="@(filter=="OVERDUE"?"selected":"")" @onclick='() => SetFilter("OVERDUE")'>Quá hạn (@countOverdue)</button>}
<button class="@(filter=="LOCKED"?"selected":"")" @onclick='() => SetFilter("LOCKED")'>Khoá (@countLocked)</button>
</div>
<button type="button" class="btn secondary" data-confirm="none" @onclick="ExportDevicesExcel">📥 Xuất Excel (@totalDevices)</button>
</div></div>

<div class="device-summary-bar">
    <button type="button" class="device-summary-item total @(filter == "ALL" ? "active" : "")" @onclick='() => SetFilter("ALL")'>
        <span>Tổng số thiết bị:</span>
        <strong>@countAll</strong>
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <small>/ @devices.Count</small>
        }
    </button>
    @if (canActive)
    {
        <button type="button" class="device-summary-item @(filter == "ACTIVE" ? "active" : "")" @onclick='() => SetFilter("ACTIVE")'>
            <span>Hoạt động còn hạn:</span>
            <strong class="text-green">@countActive</strong>
        </button>
    }
    @if (canDue10)
    {
        <button type="button" class="device-summary-item warn @(filter == "DUE10" ? "active" : "")" @onclick='() => SetFilter("DUE10")'>
            <span>⚠️ Cảnh báo ≤ 10 ngày (D+10):</span>
            <strong class="text-red">@countDue10</strong>
        </button>
    }
    @if (canDue30)
    {
        <button type="button" class="device-summary-item @(filter == "DUE30" ? "active" : "")" @onclick='() => SetFilter("DUE30")'>
            <span>Hạn ≤ 30 ngày (D+30):</span>
            <strong class="text-purple">@countDue30</strong>
        </button>
    }
    @if (canDue60)
    {
        <button type="button" class="device-summary-item @(filter == "DUE60" ? "active" : "")" @onclick='() => SetFilter("DUE60")'>
            <span>Hạn ≤ 60 ngày (D+60):</span>
            <strong class="text-blue">@countDue60</strong>
        </button>
    }
    @if (canOverdue)
    {
        <button type="button" class="device-summary-item muted @(filter == "OVERDUE" ? "active" : "")" title="Thiết bị đã quá hạn (đã loại bỏ khỏi Note cảnh báo ≤ 10 ngày)" @onclick='() => SetFilter("OVERDUE")'>
            <span>Đã hết hạn (Loại bỏ cảnh báo):</span>
            <strong class="text-orange">@countOverdue</strong>
        </button>
    }
    <button type="button" class="device-summary-item muted @(filter == "LOCKED" ? "active" : "")" @onclick='() => SetFilter("LOCKED")'>
        <span>Trạng thái Khoá:</span>
        <strong>@countLocked</strong>
    </button>
    <div class="device-summary-item showing">
        <span>Đang hiển thị trên bảng:</span>
        <strong>@totalDevices thiết bị</strong>
    </div>
</div>

<div class="table-wrap"><table><thead><tr><th>STT</th><th>BIỂN SỐ / SỐ KHUNG</th><th>SỐ IMEI</th><th>TÊN THIẾT BỊ</th><th>TÊN ĐẠI LÝ</th><th>KHÁCH HÀNG &amp; SĐT</th><th>NGÀY KÍCH HOẠT</th><th>NGÀY HẾT HẠN</th><th>GIA HẠN GẦN NHẤT / SỐ LẦN</th><th>GIÁ GIA HẠN</th><th>TRẠNG THÁI</th><th>THAO TÁC</th></tr></thead><tbody>
@foreach(var (stt, x) in pagedDevices){
    var d = DaysToExpiry(x);
    var locked = IsLocked(x);
    <tr class="@(!locked && d >= 0 && d <= 10 ? "row-due10-warn" : "")">
        <td><strong>@stt</strong></td>
        <td class="wrap-cell"><div><strong>@(string.IsNullOrWhiteSpace(x.Plate) ? "—" : x.Plate)</strong></div></td>
        <td><strong>@x.Imei</strong></td>
        <td><span class="chip blue-chip">@(string.IsNullOrWhiteSpace(x.DeviceTypeLabel) ? x.Sku : x.DeviceTypeLabel)</span><div><small style="color:#64748b">@x.Sku</small></div></td>
        <td class="wrap-cell"><div><strong>@(string.IsNullOrWhiteSpace(x.AgencyName) ? x.Customer : x.AgencyName)</strong></div>@if(!string.IsNullOrWhiteSpace(x.SellerName)){<small style="color:#64748b">NV: @x.SellerName</small>}</td>
        <td class="wrap-cell">
            <div>@(string.IsNullOrWhiteSpace(x.OwnerName) ? (string.IsNullOrWhiteSpace(x.ContactName) ? "—" : x.ContactName) : x.OwnerName)</div>
            @if(!string.IsNullOrWhiteSpace(x.OwnerPhone)){<small>📞 @x.OwnerPhone</small>}
        </td>
        <td><strong>@x.ActivatedAt</strong></td>
        <td><strong>@x.ExpiresAt</strong></td>
        <td>
            <div>@(string.IsNullOrWhiteSpace(x.LastRenewedAt) ? "—" : x.LastRenewedAt)</div>
            <small style="color:#64748b">Số lần GH: <strong>@x.RenewalCount</strong></small>
        </td>
        <td><strong style="color:#0284c7">@x.RenewalPriceVnd.ToString("N0") ₫</strong></td>
        <td>
            @if (locked)
            {
                <span class="chip orange-chip">🔒 Khoá</span>
                <div><small style="color:#64748b">@(d < 0 ? $"Quá hạn {Math.Abs(d)} ngày" : $"Còn {d} ngày")</small></div>
            }
            else if (d < 0)
            {
                <span class="chip orange-chip" title="Thiết bị đã hết hạn (đã loại bỏ khỏi cảnh báo 10 ngày)">Hết hạn (@Math.Abs(d) ngày)</span>
            }
            else if (d <= 10)
            {
                <div style="display:flex;flex-direction:column;align-items:flex-start;gap:2px">
                    <span class="chip red-warn-chip">⚠️ Còn @d ngày</span>
                    <small style="font-size:10px;color:#c92a2a;font-weight:700">Note: Cảnh báo ≤ 10 ngày</small>
                </div>
            }
            else if (d <= 30)
            {
                <span class="chip purple-chip">Hoạt động · Còn @d ngày</span>
            }
            else
            {
                <span class="chip green-chip">Hoạt động (@d ngày)</span>
            }
        </td>
        <td>@if(canRenew || canUpdateDevice){<div style="display:flex;gap:4px;flex-wrap:wrap">@if(canRenew){<button type="button" class="btn btn-sm" @onclick="() => OpenRenewFor(x)">+ Gia hạn</button>}<button type="button" class="btn secondary btn-sm" @onclick="() => OpenEditFor(x)">Sửa hạn / TT</button></div>}</td>
    </tr>
}
</tbody></table></div>
<TablePager Pager="devicePager" TotalCount="totalDevices" />
</section>
@if(canHistory){<section class="panel"><div class="panel-head"><div><h2>Lịch sử các lần gia hạn &amp; Thống kê theo Nhân viên bán hàng</h2><p>Khi cập nhật hoặc xóa lịch sử gia hạn (trước khi Kế toán chốt số / khóa số), hạn thiết bị, doanh thu kế toán, sổ quỹ và hoa hồng nhân viên bán hàng sẽ tự động cập nhật đồng bộ.</p></div>
