@page "/activity"
@page "/activity/{TableName}/{RecordId:long}"
@attribute [Authorize]
@inject PermissionGate Gate

<PageTitle>Nhật ký &amp; Lưu vết hệ thống · TNM.Management</PageTitle>

@if (!checkedAccess)
{
    <section class="panel"><p style="margin:0;color:#64748b">Đang kiểm tra quyền truy cập...</p></section>
}
else if (!canViewLog)
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow" style="color:#dc2626">TRUY CẬP BỊ TỪ CHỐI</div>
                <h2>Không có quyền xem Lịch sử / Lưu vết hệ thống</h2>
                <p>Tính năng xem Lịch sử / Lưu vết / Log là tính năng chung cố định chỉ áp dụng cho các vai trò <strong>Main</strong>, <strong>Chủ sở hữu (Owner)</strong> và <strong>Quản trị viên (Admin)</strong>.</p>
            </div>
            <a class="btn secondary" href="/">← Về trang chủ</a>
        </div>
    </section>
}
else
{
    <div class="page-head">
        <div>
            <div class="eyebrow">HỆ THỐNG / TRUY VẾT CỐ ĐỊNH (MAIN · OWNER · ADMIN)</div>
            <h1>Nhật ký &amp; Lưu vết hệ thống</h1>
            <p>Toàn bộ lịch sử thay đổi dữ liệu Trước/Sau, nhật ký kiểm toán nghiệp vụ, sổ xuất nhập IMEI và nhật ký truy cập được mở qua hộp thoại tra cứu tập trung.</p>
        </div>
        <div class="button-group">
            <button type="button" class="btn" data-confirm="none" @onclick="() => showLogModal = true">📋 Xem log</button>
        </div>
    </div>

    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>Tra cứu Lịch sử &amp; Lưu vết hệ thống</h2>
                <p>Bấm nút <strong>📋 Xem log</strong> để mở hộp thoại tra cứu thay đổi dữ liệu, nhật ký kiểm toán, sổ xuất nhập IMEI và lịch sử truy cập hệ thống.</p>
            </div>
            <button type="button" class="btn secondary" data-confirm="none" @onclick="() => showLogModal = true">📋 Xem log</button>
        </div>
    </section>

    <SystemLogModal IsOpen="showLogModal"
                    OnClose="() => showLogModal = false"
                    Title="Nhật ký &amp; Lưu vết toàn hệ thống"
                    InitialTable="@TableName"
                    InitialRecordId="@(RecordId > 0 ? RecordId : null)"
                    ShowImeiLedgerTab="true"
                    ShowAccessLogsTab="true" />
}

@code {
    [Parameter] public string? TableName { get; set; }
    [Parameter] public long RecordId { get; set; }

    private bool checkedAccess;
    private bool canViewLog;
    private bool showLogModal;

    protected override async Task OnParametersSetAsync()
    {
        canViewLog = await Gate.CanViewSystemLogsAsync();
        checkedAccess = true;
        if (canViewLog && (!string.IsNullOrWhiteSpace(TableName) || RecordId > 0))
        {
            showLogModal = true;
        }
    }
}
