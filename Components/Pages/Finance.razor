  private void QuickPay(InvoiceVm inv)
  {
    payDirection = inv.IsReceivable ? "IN" : "OUT";
    payCategory = inv.Type switch
    {
      "SALE" => "CUSTOMER_DEBT",
      "RENEWAL" => "RENEWAL_DEBT",
      "PURCHASE" or "SUPPLIER" => "SUPPLIER_PURCHASE",
      "COMMISSION" => "SELLER_COMMISSION",
      _ => "TECH_SERVICE"
    };
    invoiceId = inv.Id;
    amount = inv.Balance;
    showPay = true;
    showCreate = false;
  }

  private bool CanSeeType(string type) => type switch
  {
    "SALE" => canCustomer,
    "RENEWAL" => canRenewal,
    "PURCHASE" or "SUPPLIER" => canSupplier,
    _ => canOther
  };

  private bool CanSeePartnerCategory(string catCode) => catCode switch
  {
    "SUPPLIER" => canSupplier,
    "CUSTOMER" => canCustomer || canRenewal,
    _ => canOther
  };

  private static string PermissionForType(string type) => type switch
  {
    "SALE" => Permissions.FinanceCustomerView,
    "RENEWAL" => Permissions.FinanceRenewView,
    "PURCHASE" or "SUPPLIER" => Permissions.FinanceSupplierView,
    _ => Permissions.FinanceOtherView
  };

  private async Task Pay()
  {
    try
    {
      Db.ActorId = await Gate.RequireAsync(Permissions.FinancePay);
      if (invoiceId > 0)
      {
        var item = Db.Invoices().FirstOrDefault(x => x.Id == invoiceId)
          ?? throw new InvalidOperationException("Chứng từ công nợ không tồn tại.");
        await Gate.RequireAsync(PermissionForType(item.Type));
        Db.PayInvoice(invoiceId, amount, method);
        Reload();
        message = $"Đã ghi Sổ quỹ ({(method == "CASH" ? "Tiền mặt" : "Ngân hàng")}) — {(item.IsReceivable ? "Khoản Thu khách/công nợ" : "Khoản Chi")} {Money(amount)} cho chứng từ {item.Code}.";
      }
      else
      {
        var catType = payCategory == "SUPPLIER_PURCHASE" ? "PURCHASE" : "OTHER";
        Db.RecordDirectCashBookEntry(payDirection, method, catType, amount, directPartnerName, directPayNote, null);
        directPartnerName = "";
        directPayNote = "";
        Reload();
        message = $"Đã ghi trực tiếp vào Sổ quỹ ({(method == "CASH" ? "Tiền mặt" : "Ngân hàng")}): {(payDirection == "IN" ? "Khoản Thu" : "Khoản Chi")} {Money(amount)}.";
      }
    }
    catch (Exception ex)
    {
      message = "Lỗi: " + ex.Message;
    }
  }

  private async Task CreateInvoice()
  {
    try
    {
      Db.ActorId = await Gate.RequireAsync(Permissions.FinancePay);
      await Gate.RequireAsync(PermissionForType(newType));
      long? custId = newType == "SALE" ? newCustomerId : null;
      long? supId = newType == "PURCHASE" ? newSupplierId : null;
      if (newType == "PURCHASE" && (supId is null or <= 0))
        throw new InvalidOperationException("Vui lòng chọn Nhà cung cấp.");
      if (newType == "SALE" && (custId is null or <= 0))
        throw new InvalidOperationException("Vui lòng chọn Khách hàng.");
      if (newType is "SERVICE" or "COMMISSION" && string.IsNullOrWhiteSpace(newPartnerLabel))
        throw new InvalidOperationException("Vui lòng nhập tên Kỹ thuật / Nhân viên bán hàng thụ hưởng.");
      if (!string.IsNullOrWhiteSpace(newIssuedText) && !VnDateTimeHelper.TryParseUserFilterInput(newIssuedText, false, out _, out _))
        throw new InvalidOperationException("Thời điểm phát sinh phải đúng định dạng dd/MM/yyyy HH:mm:ss (hoặc dd/MM/yyyy).");

      var createdId = Db.CreateCustomInvoice(
        newType,
        custId,
        supId,
        newPartnerLabel,
        newDescription,
        newProductId > 0 ? newProductId : null,
        newQty,
        newUnitPrice,
        newDueDate.ToString("yyyy-MM-dd"),
        newIssuedText);

      newDescription = "";
      showCreate = false;
      Reload();
      var created = invoices.FirstOrDefault(x => x.Id == createdId);
      if (created != null) OpenInvoiceDetail(created);
      message = $"Đã lập chứng từ công nợ {created?.Code} thành công.";
    }
    catch (Exception ex)
    {
      message = "Lỗi: " + ex.Message;
    }
  }

  private async Task ToggleInvoiceLock(InvoiceVm inv)
  {
    try
    {
      Db.ActorId = await Gate.RequireAsync(Permissions.FinancePay);
      var nextLock = !inv.IsLocked;
      Db.SetInvoiceLock(inv.Id, nextLock);
      Reload();
      message = nextLock
        ? $"Đã chốt số / khóa sổ Kế toán cho chứng từ {inv.Code}. Đợt gia hạn gắn liền sẽ không thể chỉnh sửa hoặc xóa."
        : $"Đã mở khóa chứng từ {inv.Code}.";
    }
    catch (Exception ex)
    {
      message = "Lỗi: " + ex.Message;
    }
  }

  private async Task LockFilteredInvoices()
  {
    try
    {
      Db.ActorId = await Gate.RequireAsync(Permissions.FinancePay);
      var ids = FilteredInvoices.Where(x => !x.IsLocked && x.Status != "VOID").Select(x => x.Id).ToList();
      var count = Db.LockInvoicesBatch(ids, true);
      Reload();
      message = $"Đã chốt số / khóa sổ Kế toán cho {count} chứng từ.";
    }
    catch (Exception ex)
    {
      message = "Lỗi: " + ex.Message;
    }
  }

  private async Task SettleSingleInvoice(InvoiceVm inv)
  {
    try
    {
      Db.ActorId = await Gate.RequireAsync(Permissions.FinancePay);
      await Gate.RequireAsync(PermissionForType(inv.Type));
      Db.SettleAndLockInvoicesBatch([inv.Id]);
      Reload();
      message = $"Đã hoàn thành tất toán, chốt số Kế toán và đưa công nợ chứng từ {inv.Code} ({inv.Customer}) về 0 ₫.";
    }
    catch (Exception ex)
    {
      message = "Lỗi: " + ex.Message;
    }
  }

  private async Task SettleAndLockFilteredInvoices()
  {
    try
    {
      Db.ActorId = await Gate.RequireAsync(Permissions.FinancePay);
      var ids = FilteredInvoices.Where(x => x.Balance > 0 && x.Status != "VOID").Select(x => x.Id).ToList();
      var count = Db.SettleAndLockInvoicesBatch(ids);
      Reload();
      message = $"Đã hoàn thành tất toán, chốt số Kế toán và đưa công nợ về 0 ₫ cho {count} chứng từ.";
    }
    catch (Exception ex)
    {
      message = "Lỗi: " + ex.Message;
    }
  }

