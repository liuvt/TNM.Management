    <DateTimeRangeBar From="rangeFrom"
                      To="rangeTo"
                      AvailableYears="AvailableYears"
                      OnRangeChanged="OnGlobalRangeChanged"
                      MatchedCount="@FilteredInvoices.Count()"
                      TotalCount="@TabScopedInvoicesCount"
                      UnitLabel="chứng từ">
      @if (activeTab == "SALE")
      {
        <select class="search-input" style="min-width:195px" @bind="customerSubTypeFilter" @bind:after="() => invoicePager.Reset()">
          <option value="">— Đơn lắp đặt &amp; Gia hạn —</option>
          <option value="SALE">Công nợ Đơn lắp đặt</option>
          <option value="RENEWAL">Công nợ Gia hạn thuê bao</option>
        </select>
      }
      <select class="search-input" style="min-width:180px" @bind="statusFilter" @bind:after="() => invoicePager.Reset()">
        <option value="">— Mọi trạng thái —</option>
        <option value="UNPAID">Đang còn nợ</option>
        <option value="OPEN">Chưa thanh toán</option>
        <option value="PARTIAL">Thanh toán 1 phần</option>
        <option value="PAID">Đã tất toán</option>
      </select>
