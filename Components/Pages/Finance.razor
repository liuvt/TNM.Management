  private void PrepareSellerCommissionInvoice(SellerPeriodStatVm s)
  {
    newType = "COMMISSION";
    newSellerId = s.SellerId;
    newPartnerLabel = $"{s.SellerName} ({s.SellerCode})";
    newQty = 1;
    newUnitPrice = s.TotalEstimatedCommissionVnd > 0 ? s.TotalEstimatedCommissionVnd : Math.Max(100_000, s.OrderCommissionRateVnd);
    newIssuedText = VnDateTimeHelper.FormatDisplay(VnDateTimeHelper.NowVn);
    newDescription = $"Chi hoa hồng cuối kỳ cho NV bán hàng {s.SellerName} ({s.SellerCode}): {s.CompletedDeviceQty} thiết bị hoàn thành + {s.RenewalCount} lượt gia hạn.";
    showCreate = true;
    showPay = false;
  }

