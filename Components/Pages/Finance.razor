              <td>
                <span class="chip @(p.Direction == "IN" ? "green-chip" : "orange-chip")">
                  @(p.Direction == "IN" ? "Khoản Thu (PT)" : "Khoản Chi (PC)")
                </span>
              </td>
              <td>
                <span class="chip @(p.Method == "CASH" ? "green-chip" : "blue-chip")">
