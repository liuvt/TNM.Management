      <table>
        <thead>
          <tr>
            <th>STT</th>
            <th>KỲ THÁNG / THỜI GIAN LẬP</th>
            <th>SỐ CHỨNG TỪ</th>
            <th>PHÂN MỤC CÔNG NỢ</th>
            <th>ĐỐI TÁC (NCC / KHÁCH HÀNG / NV BÁN HÀNG)</th>
            <th>CHI TIẾT MẶT HÀNG / THAM CHIẾU</th>
            <th>PHÁT SINH</th>
            <th>ĐÃ THU / ĐÃ CHI</th>
            <th>CÒN NỢ</th>
            <th>ĐẾN HẠN</th>
            <th>TRẠNG THÁI</th>
            <th>THAO TÁC</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var (stt, x) in pagedInvoices)
          {
            var isCurrentMonth = x.PeriodKey == CurrentPeriodKey;
            if (x.PeriodKey != lastInvPeriod)
            {
              lastInvPeriod = x.PeriodKey;
              var grpList = FilteredInvoices.Where(i => i.PeriodKey == x.PeriodKey && i.Status != "VOID").ToList();
              <tr style="background:@(isCurrentMonth ? "#ecfdf5" : "#fff7ed");border-top:2px solid @(isCurrentMonth ? "#10b981" : "#f97316")">
                <td colspan="12" style="padding:8px 12px;font-weight:700;color:@(isCurrentMonth ? "#065f46" : "#9a3412")">
                  @(isCurrentMonth ? "🆕" : "⏳") KỲ CÔNG NỢ @x.PeriodLabel.ToUpperInvariant() — @(isCurrentMonth ? "CÔNG NỢ MỚI (THÁNG HIỆN TẠI)" : "CÔNG NỢ CŨ (KỲ TRƯỚC)")
                  <span style="font-weight:600;margin-left:10px;font-size:12px;color:#334155">
                    (@grpList.Count chứng từ · Tổng phát sinh: <strong>@Money(grpList.Sum(i => i.Total))</strong> · Đã thu/chi: <strong style="color:#15803d">@Money(grpList.Sum(i => i.Paid))</strong> · Còn nợ kỳ này: <strong style="color:#d97706">@Money(grpList.Sum(i => i.Balance))</strong>)
                  </span>
                </td>
              </tr>
