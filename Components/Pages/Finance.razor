@attribute [Authorize(Policy = Permissions.FinanceView)]
@page "/finance"
@inject DemoDb Db
@inject PermissionGate Gate
<PageTitle>Báo cáo Công nợ &amp; Sổ quỹ · TNM</PageTitle>

<div class="page-head">
  <div>
    <div class="eyebrow">FINANCE / DEBT &amp; CASHBOOK REPORT</div>
    <h1>Báo cáo Công nợ &amp; Thanh toán — Sổ quỹ</h1>
    <p>
      <strong>1. Báo cáo Công nợ:</strong> Nhà cung cấp (Nhập hàng) · Khách hàng (Đơn lắp &amp; Gia hạn) · Sell (Hoa hồng NV bán hàng &amp; Kỹ thuật) &nbsp;|&nbsp;
      <strong>2. Sổ quỹ (Thu / Chi / Tồn):</strong> Khoản thu (Thu khách / Công nợ) · Khoản chi (Nhập hàng / Chi trả) · Quỹ Tiền mặt &amp; Ngân hàng.
    </p>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
    <button type="button" class="btn secondary" @onclick="SyncAccounting">
      ↻ Đồng bộ dữ liệu Kế toán
    </button>
    @if (canExport)
    {
      <a href="/export/invoices.csv?type=@(activeTab is "PAYMENTS" or "SNAPSHOT_STATS" or "DEBT_REPORT" ? "ALL" : activeTab)" class="btn secondary">
        ↓ Xuất Báo cáo Công nợ CSV
      </a>
      <a href="/export/cashbook.csv" class="btn secondary">
        ↓ Xuất Sổ quỹ (Thu/Chi/Tồn) CSV
      </a>
    }
  </div>
</div>

@* ==================== KHỐI TỔNG HỢP CÔNG NỢ & SỔ QUỸ ==================== *@
<div class="two-column" style="margin-bottom:16px">
  <section class="panel" style="margin-bottom:0">
    <div class="panel-head" style="margin-bottom:10px">
      <div>
        <h2>A. Tổng hợp Công nợ (Nhà cung cấp · Khách hàng · Sell)</h2>
        <p>Theo dõi phát sinh, đã thanh toán và số dư còn nợ theo 3 nhóm đối tượng chính.</p>
      </div>
    </div>
    <div class="stats-grid" style="grid-template-columns:repeat(auto-fit,minmax(175px,1fr));gap:10px">
      <div class="stat" style="cursor:pointer;border-left:4px solid #d97706" @onclick='() => SetTab("PURCHASE")'>
        <small>1. Công nợ Nhà cung cấp</small>
        <strong class="orange">@Money(SupplierInvoices.Sum(x => x.Balance))</strong>
        <span>Đã chi: @Money(SupplierInvoices.Sum(x => x.Paid)) / Tổng nhập: @Money(SupplierInvoices.Sum(x => x.Total))</span>
      </div>
      <div class="stat" style="cursor:pointer;border-left:4px solid #0284c7" @onclick='() => SetTab("SALE")'>
        <small>2. Công nợ Khách hàng</small>
        <strong style="color:#0284c7">@Money(Receivables.Sum(x => x.Balance))</strong>
        <span>Đã thu: @Money(Receivables.Sum(x => x.Paid)) / Phải thu: @Money(Receivables.Sum(x => x.Total))</span>
      </div>
      <div class="stat" style="cursor:pointer;border-left:4px solid #7c3aed" @onclick='() => SetTab("OTHER")'>
        <small>3. Công nợ Sell &amp; Kỹ thuật</small>
        <strong style="color:#7c3aed">@Money(SellerAndTechRemainingVnd)</strong>
        <span>Đã chi: @Money(OtherInvoices.Sum(x => x.Paid)) / Phát sinh: @Money(SellerAndTechIncurredVnd)</span>
      </div>
    </div>
  </section>

  <section class="panel" style="margin-bottom:0">
    <div class="panel-head" style="margin-bottom:10px">
      <div>
        <h2>B. Sổ quỹ: Khoản Thu / Khoản Chi / Tồn quỹ</h2>
        <p>Tách biệt rõ nguồn <strong>Tiền mặt (CASH)</strong> và <strong>Ngân hàng (BANK)</strong>.</p>
      </div>
      <button type="button" class="btn secondary btn-sm" @onclick='() => SetTab("PAYMENTS")'>Xem Sổ quỹ chi tiết →</button>
    </div>
    <div class="stats-grid" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px">
      <div class="stat" style="border-left:4px solid #15803d">
        <small>Khoản Thu (Thu khách / Công nợ)</small>
        <strong style="color:#15803d">+@Money(cashBook.TotalInVnd)</strong>
        <span>TM: @Money(cashBook.CashInVnd) · NH: @Money(cashBook.BankInVnd)</span>
      </div>
      <div class="stat" style="border-left:4px solid #dc2626">
        <small>Khoản Chi (Nhập hàng / Chi trả)</small>
        <strong style="color:#dc2626">-@Money(cashBook.TotalOutVnd)</strong>
        <span>Nhập hàng: @Money(cashBook.SupplierPaidVnd) · Khác: @Money(cashBook.OtherPaidVnd)</span>
      </div>
      <div class="stat" style="border-left:4px solid #0f766e;background:#f0fdfa">
        <small>Tồn Sổ quỹ (Thu − Chi)</small>
        <strong style="color:@(cashBook.TotalBalanceVnd >= 0 ? "#0f766e" : "#dc2626")">@Money(cashBook.TotalBalanceVnd)</strong>
        <span><strong>Tiền mặt:</strong> @Money(cashBook.CashBalanceVnd) · <strong>Ngân hàng:</strong> @Money(cashBook.BankBalanceVnd)</span>
      </div>
    </div>
  </section>
</div>

@* ==================== THANH ĐIỀU HƯỚNG TAB & THAO TÁC ==================== *@
<div class="crud-actionbar" style="display:flex;gap:8px;flex-wrap:wrap;justify-content:space-between;align-items:center">
  <div style="display:flex;gap:6px;flex-wrap:wrap">
    <button type="button" class="btn @(activeTab == "DEBT_REPORT" ? "" : "secondary")" @onclick='() => SetTab("DEBT_REPORT")'>
      📊 Tổng hợp Công nợ (NCC / KH / Sell)
    </button>
    @if (canSupplier)
    {
      <button type="button" class="btn @(activeTab == "PURCHASE" ? "" : "secondary")" @onclick='() => SetTab("PURCHASE")'>
        1. Công nợ Nhà cung cấp (@SupplierInvoices.Count())
      </button>
    }
    @if (canCustomer)
    {
      <button type="button" class="btn @(activeTab == "SALE" ? "" : "secondary")" @onclick='() => SetTab("SALE")'>
        2. Công nợ Khách hàng (@Receivables.Count())
      </button>
    }
    @if (canOther)
    {
      <button type="button" class="btn @(activeTab == "OTHER" ? "" : "secondary")" @onclick='() => SetTab("OTHER")'>
        3. Công nợ Sell &amp; Kỹ thuật (@OtherInvoices.Count() CT · @sellerStats.Count Sell)
      </button>
    }
    <button type="button" class="btn @(activeTab == "PAYMENTS" ? "" : "secondary")" @onclick='() => SetTab("PAYMENTS")'>
      4. Sổ quỹ: Thu / Chi / Tồn (@payments.Count phiếu)
    </button>
    <button type="button" class="btn @(activeTab == "ALL" ? "" : "secondary")" @onclick='() => SetTab("ALL")'>
      5. Tất cả Chứng từ (@invoices.Count)
    </button>
    <button type="button" class="btn @(activeTab == "SNAPSHOT_STATS" ? "" : "secondary")" @onclick='() => SetTab("SNAPSHOT_STATS")'>
      6. Chi tiết Đơn hàng &amp; Lợi nhuận (@completedSnapshots.Count)
    </button>
  </div>

  <div style="display:flex;gap:8px;flex-wrap:wrap">
    @if (canPay)
    {
      <button type="button" class="btn" @onclick="() => ToggleForm(nameof(showPay))">
        @(showPay ? "Đóng · Phiếu Thu / Phiếu Chi" : "+ Lập Phiếu Thu / Chi (Sổ quỹ)")
      </button>
      <button type="button" class="btn secondary" @onclick="() => ToggleForm(nameof(showCreate))">
        @(showCreate ? "Đóng · Lập chứng từ" : "+ Lập chứng từ Công nợ")
      </button>
    }
  </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
  <div class="panel-note" style="margin-bottom:14px;padding:10px 14px;border-radius:8px;background:#f0fdf4;border:1px solid #86efac;color:#166534;font-weight:600">
    @message
  </div>
}

@* ==================== FORM LẬP PHIẾU THU / PHIẾU CHI (SỔ QUỸ) ==================== *@
@if (canPay)
{
  <section class="panel edit-panel" hidden="@(!showPay)">
    <div class="panel-head">
      <div>
        <h2>Lập Phiếu Thu / Phiếu Chi vào Sổ quỹ (Tiền mặt / Ngân hàng)</h2>
        <p>
          <strong>Khoản thu (IN):</strong> Thu tiền khách hàng / thu công nợ &nbsp;|&nbsp;
          <strong>Khoản chi (OUT):</strong> Chi trả tiền nhập hàng Nhà cung cấp, chi hoa hồng Sell hoặc công kỹ thuật.
        </p>
      </div>
    </div>
    <div class="form-grid">
      <label>1. Loại giao dịch Sổ quỹ *
        <select @bind="payDirection" @bind:after="OnPayDirectionChanged">
          <option value="IN">Khoản Thu (+): Thu khách / Thu công nợ (Phiếu Thu PT)</option>
          <option value="OUT">Khoản Chi (-): Chi nhập hàng NCC / Chi Sell &amp; Kỹ thuật (Phiếu Chi PC)</option>
        </select>
      </label>

      <label>2. Hạng mục Thu / Chi *
        <select @bind="payCategory" @bind:after="OnPayCategoryChanged">
          @if (payDirection == "IN")
          {
            <option value="CUSTOMER_DEBT">Thu khách / Thu công nợ đơn lắp đặt (SALE)</option>
            <option value="RENEWAL_DEBT">Thu khách / Thu công nợ gia hạn (RENEWAL)</option>
          }
          else
          {
            <option value="SUPPLIER_PURCHASE">Chi: Nhập hàng Nhà cung cấp (PURCHASE)</option>
            <option value="SELLER_COMMISSION">Chi: Hoa hồng Sell / Nhân viên bán hàng (COMMISSION)</option>
            <option value="TECH_SERVICE">Chi: Phụ cấp / Công kỹ thuật lắp đặt (SERVICE)</option>
          }
        </select>
      </label>

      <label>3. Sổ quỹ thanh toán (Tiền mặt / Ngân hàng) *
        <select @bind="method">
          <option value="CASH">Quỹ Tiền mặt (CASH)</option>
          <option value="BANK">Quỹ Ngân hàng / Chuyển khoản (BANK)</option>
        </select>
      </label>

      <label>4. Chọn chứng từ công nợ để phân bổ *
        <select @bind="invoiceId" @bind:after="OnInvoicePicked">
          @foreach (var x in FilteredOpenInvoicesForPayment)
          {
            <option value="@x.Id">[@TypeLabel(x.Type)] @x.Code — @x.Customer (Còn nợ: @Money(x.Balance))</option>
          }
          @if (!FilteredOpenInvoicesForPayment.Any())
          {
            <option value="0">— Không có chứng từ còn nợ trong nhóm này (Ghi phiếu Sổ quỹ trực tiếp) —</option>
          }
        </select>
      </label>

      @if (invoiceId <= 0)
      {
        <label>Đối tác (Khách hàng / Nhà cung cấp / Sell) *
          <input @bind="directPartnerName" placeholder="Nhập tên Khách hàng, Nhà cung cấp hoặc Sell..." />
        </label>
        <label>Diễn giải khoản Thu / Chi *
          <input @bind="directPayNote" placeholder="VD: Thu công nợ khách / Chi thanh toán tiền nhập hàng..." />
        </label>
      }

      <label>5. Số tiền @(payDirection == "IN" ? "Thu" : "Chi") (VND) *
        <input type="number" min="1" step="10000" @bind="amount" />
      </label>
    </div>
    <div class="form-actions" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <button type="button" class="btn" @onclick="Pay">
        @(payDirection == "IN" ? "+ Ghi nhận Khoản Thu vào Sổ quỹ" : "+ Ghi nhận Khoản Chi vào Sổ quỹ")
      </button>
      @if (SelectedPayInvoice is not null)
      {
        <button type="button" class="btn secondary" @onclick="() => amount = SelectedPayInvoice.Balance">
          Tất toán 100% (@Money(SelectedPayInvoice.Balance))
        </button>
        <span style="font-size:12px;color:#475569">
          Loại phiếu: <strong>@(SelectedPayInvoice.IsReceivable ? "Khoản Thu — Thu khách/công nợ (PT)" : "Khoản Chi — Nhập hàng/Chi trả (PC)")</strong>
          · Quỹ: <strong>@(method == "CASH" ? "Tiền mặt" : "Ngân hàng")</strong>
          · Đối tác: <strong>@SelectedPayInvoice.Customer</strong>
        </span>
      }
    </div>
  </section>

  <section class="panel edit-panel" hidden="@(!showCreate)">
    <div class="panel-head">
      <div>
        <h2>Lập chứng từ Công nợ mới (Nhà cung cấp · Khách hàng · Sell)</h2>
        <p>Dùng để ghi nhận công nợ nhập hàng Nhà cung cấp, công nợ Khách hàng hoặc công nợ hoa hồng Sell / kỹ thuật.</p>
      </div>
    </div>
    <div class="form-grid">
      <label>Nhóm chứng từ công nợ *
        <select @bind="newType">
          @if (canSupplier)
          {
            <option value="PURCHASE">1. Công nợ Nhà cung cấp — Nhập hàng (PURCHASE - Phải trả)</option>
          }
          @if (canCustomer)
          {
            <option value="SALE">2. Công nợ Khách hàng — Đơn lắp đặt (SALE - Phải thu)</option>
          }
          @if (canOther)
          {
            <option value="COMMISSION">3a. Công nợ Sell — Hoa hồng nhân viên bán hàng (COMMISSION - Phải trả)</option>
            <option value="SERVICE">3b. Công nợ Kỹ thuật — Công lắp đặt (SERVICE - Phải trả)</option>
          }
        </select>
      </label>

      @if (newType == "PURCHASE")
      {
        <label>Nhà cung cấp *
          <select @bind="newSupplierId">
            <option value="0">— Chọn Nhà cung cấp —</option>
            @foreach (var s in suppliers)
            {
              <option value="@s.Id">@s.Name</option>
            }
          </select>
        </label>
      }
      else if (newType == "SALE")
      {
        <label>Khách hàng *
          <select @bind="newCustomerId">
            <option value="0">— Chọn Khách hàng —</option>
            @foreach (var c in customers)
            {
              <option value="@c.Id">@c.Code — @c.B2BDisplayName</option>
            }
          </select>
        </label>
      }
      else if (newType == "COMMISSION")
      {
        <label>Chọn Sell (Nhân viên bán hàng) *
          <select @bind="newSellerId" @bind:after="OnNewSellerPicked">
            <option value="0">— Chọn Sell trong danh sách hoặc nhập bên cạnh —</option>
            @foreach (var sl in sellerChoices)
            {
              <option value="@sl.Id">@sl.Code — @sl.Name [HH Đơn: @Money(sl.OrderCommissionVnd) · HH Gia hạn: @Money(sl.RenewalCommissionVnd)]</option>
            }
          </select>
        </label>
        <label>Tên người thụ hưởng (Sell) *
          <input @bind="newPartnerLabel" placeholder="VD: Nguyễn Minh Anh (SL001)..." />
        </label>
      }
      else
      {
        <label>Người thụ hưởng (Kỹ thuật / Đối tác) *
          <input @bind="newPartnerLabel" placeholder="VD: Kỹ thuật Trần Chí Thức..." />
        </label>
      }

      <label>Sản phẩm liên quan (Tùy chọn)
        <select @bind="newProductId">
          <option value="0">— Không gắn mã SP cụ thể —</option>
          @foreach (var p in products)
          {
            <option value="@p.Id">@p.Sku — @p.Name</option>
          }
        </select>
      </label>

      <label>Số lượng *
        <input type="number" min="1" @bind="newQty" />
      </label>

      <label>Đơn giá (VND) *
        <input type="number" min="1000" step="10000" @bind="newUnitPrice" />
      </label>

      <label>Hạn thanh toán *
        <input type="date" @bind="newDueDate" />
      </label>

      <label style="grid-column:1 / -1">Nội dung / Diễn giải chi tiết *
        <input @bind="newDescription" placeholder="VD: Nhập hàng lô thiết bị GPS / Hoa hồng Sell tháng 11/2026..." />
      </label>
    </div>
    <div class="form-actions">
      <button type="button" class="btn" @onclick="CreateInvoice">
        + Tạo chứng từ Công nợ (@Money(newQty * newUnitPrice))
      </button>
    </div>
  </section>
}

@* ==================== CHI TIẾT CHỨNG TỪ KHI BẤM XEM ==================== *@
@if (selectedInvoice is not null)
{
  <section class="panel" style="border:2px solid #0284c7;background:#f8fafc;margin-bottom:16px">
    <div class="panel-head">
      <div>
        <div class="eyebrow">BIỂU MẪU CHI TIẾT CHỨNG TỪ CÔNG NỢ</div>
        <h2>@selectedInvoice.Code — @TypeLabel(selectedInvoice.Type)</h2>
        <p>
          Đối tác / Thụ hưởng: <strong>@selectedInvoice.Customer</strong>
          @if (!string.IsNullOrWhiteSpace(selectedInvoice.RefCode))
          {
            <span> · Tham chiếu: <strong>@selectedInvoice.RefCode</strong></span>
          }
          · Ngày lập: <strong>@selectedInvoice.CreatedAt</strong> · Đến hạn: <strong>@selectedInvoice.DueAt</strong>
        </p>
      </div>
      <div style="display:flex;gap:8px;align-items:center">
        @if (canPay && selectedInvoice.Balance > 0 && selectedInvoice.Status != "VOID")
        {
          <button type="button" class="btn" @onclick="() => QuickPay(selectedInvoice)">
            @(selectedInvoice.IsReceivable ? "Thu khách / Thu công nợ này" : "Chi thanh toán chứng từ này")
          </button>
        }
        <button type="button" class="btn secondary" @onclick="() => selectedInvoice = null">Đóng chi tiết</button>
      </div>
    </div>

    <div class="stats-grid three" style="margin-bottom:12px">
      <div class="stat"><small>Tổng phát sinh</small><strong>@Money(selectedInvoice.Total)</strong></div>
      <div class="stat"><small>Đã thanh toán</small><strong style="color:#15803d">@Money(selectedInvoice.Paid)</strong></div>
      <div class="stat"><small>Số dư còn nợ</small><strong class="orange">@Money(selectedInvoice.Balance)</strong></div>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>MÃ SP (SKU)</th>
            <th>DIỄN GIẢI / HẠNG MỤC CHI TIẾT</th>
            <th>SỐ LƯỢNG</th>
            <th>ĐƠN GIÁ</th>
            <th>THÀNH TIỀN</th>
          </tr>
        </thead>
        <tbody>
          @if (selectedInvoice.Lines is { Count: > 0 })
          {
            var idx = 0;
            @foreach (var line in selectedInvoice.Lines)
            {
              idx++;
              <tr>
                <td>@idx</td>
                <td>@(string.IsNullOrWhiteSpace(line.ProductSku) ? "—" : line.ProductSku)</td>
                <td class="wrap-cell">@line.Description</td>
                <td><strong>@line.Quantity</strong></td>
                <td>@Money(line.UnitPrice)</td>
                <td><strong>@Money(line.LineTotal)</strong></td>
              </tr>
            }
          }
          else
          {
            <tr>
              <td>1</td>
              <td>—</td>
              <td class="wrap-cell">@(string.IsNullOrWhiteSpace(selectedInvoice.Notes) ? TypeLabel(selectedInvoice.Type) : selectedInvoice.Notes)</td>
              <td>1</td>
              <td>@Money(selectedInvoice.Total)</td>
              <td><strong>@Money(selectedInvoice.Total)</strong></td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </section>
}

@* ==================== NỘI DUNG THEO TỪNG TAB ==================== *@
@if (activeTab == "DEBT_REPORT")
{
  <section class="panel" style="margin-bottom:16px">
    <div class="panel-head">
      <div>
        <h2>Báo cáo Tổng hợp Công nợ theo Đối tượng: Nhà cung cấp · Khách hàng · Sell</h2>
        <p>Tổng hợp công nợ phải trả Nhà cung cấp (Nhập hàng), công nợ phải thu Khách hàng và công nợ hoa hồng Sell / Kỹ thuật.</p>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <select class="search-input" style="min-width:210px" @bind="debtCategoryFilter">
          <option value="">— Tất cả nhóm công nợ —</option>
          <option value="SUPPLIER">1. Công nợ Nhà cung cấp (Nhập hàng)</option>
          <option value="CUSTOMER">2. Công nợ Khách hàng (Thu khách)</option>
          <option value="SELLER">3. Công nợ Sell (Hoa hồng NV bán hàng)</option>
          <option value="TECH">4. Công nợ Kỹ thuật lắp đặt</option>
        </select>
        <input class="search-input" style="min-width:240px" @bind="search" @bind:event="oninput" placeholder="Tìm tên NCC, Khách hàng, Sell..." />
      </div>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>NHÓM CÔNG NỢ</th>
            <th>TÍNH CHẤT</th>
            <th>ĐỐI TÁC (NHÀ CUNG CẤP / KHÁCH HÀNG / SELL)</th>
            <th>THÔNG TIN CHI TIẾT</th>
            <th>SỐ CHỨNG TỪ</th>
            <th>TỔNG PHÁT SINH</th>
            <th>ĐÃ THANH TOÁN (THU / CHI)</th>
            <th>CÒN NỢ</th>
            <th>TRẠNG THÁI</th>
            <th>THAO TÁC</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var d in FilteredPartnerDebts)
          {
