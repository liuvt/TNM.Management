  private async Task ExportInvoiceLinesExcel(InvoiceVm inv, List<InvoiceLineVm> lines)
  {
    var headers = new[]
    {
      "STT", "Số chứng từ", "Đối tác", "Thời gian phát sinh", "Mã sản phẩm",
      "Diễn giải / Hạng mục chi tiết", "Số lượng", "Đơn giá (VND)", "Thành tiền (VND)"
    };
    var rows = lines.Select((l, idx) =>
    {
      var ldt = VnDateTimeHelper.TryExtractLineTimestamp(l.Description, inv.TimestampDt);
      return new object?[]
      {
        idx + 1,
        inv.Code,
        inv.Customer,
        ldt.HasValue ? VnDateTimeHelper.FormatDisplay(ldt.Value) : inv.DisplayTimestamp,
        string.IsNullOrWhiteSpace(l.ProductSku) ? "—" : l.ProductSku,
        l.Description,
        l.Quantity,
        l.UnitPrice,
        l.LineTotal
      };
    });
    await ExcelExporter.DownloadAsync(JS, $"chi-tiet-{inv.Code.ToLowerInvariant()}", "Chi tiết chứng từ", headers, rows);
  }

