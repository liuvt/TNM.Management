      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <button type="button" class="btn secondary" data-confirm="none" @onclick="ExportInvoicesExcel">📥 Xuất Excel (@FilteredInvoices.Count())</button>
        @if (canPay && FilteredInvoices.Any(i => i.Balance > 0 && i.Status != "VOID"))
        {
          <button type="button"
                  class="btn btn-sm"
                  data-confirm="edit"
                  data-confirm-title="Hoàn thành tất toán & chốt số đưa về 0"
                  data-confirm-msg="Xác nhận đánh dấu Đã tất toán, đưa số dư Còn nợ về 0 ₫ và khóa sổ toàn bộ danh sách đang lọc (không trừ Sổ quỹ hiện tại)?"
                  @onclick="SettleAndLockFilteredInvoices"
                  title="Tất toán công nợ cũ đã thanh toán ngoài / trước kỳ, chốt số và đưa Còn nợ về 0 ₫">
            ✓ Chốt số &amp; Đưa về 0 (@FilteredInvoices.Count(i => i.Balance > 0 && i.Status != "VOID"))
          </button>
