@attribute [Authorize(Policy = Permissions.FinanceView)]
@page "/finance"
@inject DemoDb Db
@inject PermissionGate Gate
@inject IJSRuntime JS
<PageTitle>Báo cáo Công nợ &amp; Sổ quỹ · TNM</PageTitle>

<div class="page-head">
  <div>
    <div class="eyebrow">TÀI CHÍNH &amp; KẾ TOÁN / CÔNG NỢ &amp; SỔ QUỸ</div>
    <h1>Báo cáo Công nợ &amp; Thanh toán — Sổ quỹ</h1>
    <p>
      <strong>1. Báo cáo Công nợ:</strong> Nhà cung cấp (Nhập hàng) · Khách hàng (Đơn lắp &amp; Gia hạn) · Nhân viên bán hàng (Hoa hồng &amp; Kỹ thuật) &nbsp;|&nbsp;
      <strong>2. Sổ quỹ (Thu / Chi / Tồn):</strong> Khoản thu (Thu khách / Công nợ) · Khoản chi (Nhập hàng / Chi trả) · Quỹ Tiền mặt &amp; Ngân hàng.
    </p>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
    <button type="button" class="btn secondary" @onclick="SyncAccounting">
      ↻ Đồng bộ dữ liệu Kế toán
    </button>
    <button type="button" class="btn secondary" data-confirm="none" @onclick="ExportInvoicesExcel">
      📥 Xuất Excel Chứng từ Công nợ (@FilteredInvoices.Count())
    </button>
    <button type="button" class="btn secondary" data-confirm="none" @onclick="ExportPaymentsExcel">
      📥 Xuất Excel Sổ quỹ (@FilteredPayments.Count())
    </button>
  </div>
</div>

@* ==================== BỘ LỌC KỲ CÔNG NỢ CHUẨN ERP: NGÀY → NGÀY / CHỌN NĂM / THÁNG / TUỔI NỢ ==================== *@
<section class="erp-master-period">
  <div class="erp-master-top">
    <DateTimeRangeBar CompactHeader="true"
                      LabelText="📅 Kỳ Công nợ:"
                      From="rangeFrom"
                      To="rangeTo"
                      AvailableYears="AvailableYears"
                      OnRangeChanged="OnGlobalRangeChanged">
      <ExtraInlineContent>
        <select class="erp-preset-select"
                value="@periodMonth"
                @onchange="OnQuickMonthSelect"
                title="Chọn nhanh Tháng công nợ">
          <option value="0">🗓️ Mọi tháng</option>
          @for (var m = 1; m <= 12; m++)
          {
            var mm = m;
            <option value="@mm">Tháng @mm.ToString("D2")/@(periodYear > 0 ? periodYear : VnDateTimeHelper.TodayVn.Year)</option>
          }
        </select>

        <div class="erp-age-pills" title="Lọc nhanh theo tuổi công nợ">
          <button type="button" class="erp-age-btn @(string.IsNullOrWhiteSpace(debtAgeFilter) ? "active" : "")" data-confirm="none" @onclick='() => SetDebtAgeFilter("")'>Mọi tuổi nợ</button>
          <button type="button" class="erp-age-btn @(debtAgeFilter == "CURRENT" ? "active" : "")" data-confirm="none" @onclick='() => SetDebtAgeFilter("CURRENT")'>🆕 Nợ mới (@ShortPeriodCurrent)</button>
          <button type="button" class="erp-age-btn @(debtAgeFilter == "OLD" ? "active" : "")" data-confirm="none" @onclick='() => SetDebtAgeFilter("OLD")'>⏳ Nợ cũ</button>
        </div>
      </ExtraInlineContent>
    </DateTimeRangeBar>

    <div style="font-size:11.8px;color:#334155;font-variant-numeric:tabular-nums;margin-left:auto">
      Đang xem: <strong style="color:#1b653e">@ActivePeriodSummaryText</strong>
    </div>
  </div>

  @if (AvailablePeriods.Count > 0)
  {
    <div class="erp-master-QuickRow">
      <button type="button" class="erp-preset-pill @(!HasAnyTimeFilter ? "active" : "")" data-confirm="none" @onclick="ResetPeriodFilter">
        Tất cả các kỳ (@invoices.Count(x => x.Status != "VOID") CT)
      </button>
      @foreach (var yr in AvailableYears)
      {
        var yy = yr;
        var isFullYr = IsFullYearSelected(yy);
        <button type="button"
                class="erp-preset-pill @(isFullYr ? "active" : "")"
                data-confirm="none"
                @onclick="() => SelectFullYear(yy)">
          📆 Năm @yy
        </button>
      }
      <span style="color:#cbd5e1;padding:0 2px">|</span>
      @foreach (var p in AvailablePeriods)
      {
        var isSelected = IsExactPeriodSelected(p.Year, p.Month);
        var isCurrent = p.Key == CurrentPeriodKey;
        <button type="button"
                class="erp-preset-pill @(isSelected ? "active" : "")"
                data-confirm="none"
                style="@(!isSelected && !isCurrent ? "border-color:#fed7aa;color:#9a3412;background:#fff7ed" : "")"
                @onclick="() => SelectPeriod(p.Year, p.Month)">
          @(isCurrent ? "🆕" : "⏳") @p.Label · KH nợ: @Money(p.CustomerBalanceVnd)@(p.SupplierBalanceVnd > 0 ? $" · NCC nợ: {Money(p.SupplierBalanceVnd)}" : "")
        </button>
      }
    </div>
  }
</section>

@* ==================== KHỐI TỔNG HỢP CÔNG NỢ & SỔ QUỸ ==================== *@
<div class="two-column" style="margin-bottom:16px">
  <section class="panel" style="margin-bottom:0">
    <div class="panel-head" style="margin-bottom:10px">
      <div>
        <h2>A. Tổng hợp Công nợ — Tách rõ Công nợ mới &amp; Công nợ cũ (@ActivePeriodSummaryText)</h2>
        <p>Theo dõi phát sinh, đã thanh toán và số dư còn nợ theo khung thời gian / kỳ Tháng-Năm cho 3 nhóm đối tượng chính.</p>
      </div>
    </div>
    <div class="stats-grid" style="grid-template-columns:repeat(auto-fit,minmax(195px,1fr));gap:10px">
      <div class="stat" style="cursor:pointer;border-left:4px solid #d97706" @onclick='() => SetTab("PURCHASE")'>
        <small>1. Công nợ Nhà cung cấp</small>
        <strong class="orange">@Money(PeriodSupplierInvoices.Sum(x => x.Balance))</strong>
        <span>Đã chi: @Money(PeriodSupplierInvoices.Sum(x => x.Paid)) / Nhập: @Money(PeriodSupplierInvoices.Sum(x => x.Total))</span>
        <span style="font-size:11px;margin-top:2px;color:#475569">
          🆕 Mới (@ShortPeriodCurrent): <b style="color:#15803d">@Money(SupplierInvoices.Where(x => x.PeriodKey == CurrentPeriodKey).Sum(x => x.Balance))</b>
          · ⏳ Nợ cũ: <b style="color:#c2410c">@Money(SupplierInvoices.Where(x => string.CompareOrdinal(x.PeriodKey, CurrentPeriodKey) < 0).Sum(x => x.Balance))</b>
        </span>
      </div>
      <div class="stat" style="cursor:pointer;border-left:4px solid #0284c7" @onclick='() => SetTab("SALE")'>
        <small>2. Công nợ Khách hàng</small>
        <strong style="color:#0284c7">@Money(PeriodReceivables.Sum(x => x.Balance))</strong>
        <span>Đã thu: @Money(PeriodReceivables.Sum(x => x.Paid)) / Phải thu: @Money(PeriodReceivables.Sum(x => x.Total))</span>
        <span style="font-size:11px;margin-top:2px;color:#475569">
          🆕 Mới (@ShortPeriodCurrent): <b style="color:#0284c7">@Money(Receivables.Where(x => x.PeriodKey == CurrentPeriodKey).Sum(x => x.Balance))</b>
          · ⏳ Nợ cũ: <b style="color:#c2410c">@Money(Receivables.Where(x => string.CompareOrdinal(x.PeriodKey, CurrentPeriodKey) < 0).Sum(x => x.Balance))</b>
        </span>
      </div>
      <div class="stat" style="cursor:pointer;border-left:4px solid #7c3aed" @onclick='() => SetTab("OTHER")'>
        <small>3. Công nợ NV bán hàng &amp; Kỹ thuật</small>
        <strong style="color:#7c3aed">@Money(PeriodSellerAndTechRemainingVnd)</strong>
        <span>Đã chi: @Money(PeriodOtherInvoices.Sum(x => x.Paid)) / Phát sinh: @Money(PeriodSellerAndTechIncurredVnd)</span>
        <span style="font-size:11px;margin-top:2px;color:#475569">
          🆕 Mới (@ShortPeriodCurrent): <b style="color:#7c3aed">@Money(OtherInvoices.Where(x => x.PeriodKey == CurrentPeriodKey).Sum(x => x.Balance) + (MatchesCurrentPeriod ? Math.Max(0, allTimeSellerStats.Sum(x => x.TotalEstimatedCommissionVnd) - OtherInvoices.Where(x => x.Type == "COMMISSION").Sum(x => x.Total)) : 0))</b>
          · ⏳ Nợ cũ: <b style="color:#c2410c">@Money(OtherInvoices.Where(x => string.CompareOrdinal(x.PeriodKey, CurrentPeriodKey) < 0).Sum(x => x.Balance))</b>
        </span>
      </div>
    </div>
  </section>

  <section class="panel" style="margin-bottom:0">
    <div class="panel-head" style="margin-bottom:10px">
      <div>
        <h2>B. Sổ quỹ: Khoản Thu / Khoản Chi / Tồn quỹ @(HasAnyTimeFilter ? "(Theo khung lọc)" : "(Toàn hệ thống)")</h2>
        <p>Tách biệt rõ nguồn <strong>Tiền mặt</strong> và <strong>Ngân hàng</strong>.</p>
      </div>
      <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick='() => SetTab("PAYMENTS")'>Xem Sổ quỹ chi tiết →</button>
    </div>
    @{
      var activeCashSummary = HasAnyTimeFilter ? FilteredCashBook : cashBook;
    }
    <div class="stats-grid" style="grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px">
      <div class="stat" style="border-left:4px solid #15803d">
        <small>Khoản Thu @(HasAnyTimeFilter ? "(Trong kỳ)" : "(Thu khách / Công nợ)")</small>
        <strong style="color:#15803d">+@Money(activeCashSummary.TotalInVnd)</strong>
        <span>TM: <b>@Money(activeCashSummary.CashInVnd)</b> · NH: <b>@Money(activeCashSummary.BankInVnd)</b></span>
      </div>
      <div class="stat" style="border-left:4px solid #dc2626">
        <small>Khoản Chi @(HasAnyTimeFilter ? "(Trong kỳ)" : "(Nhập hàng / Chi trả)")</small>
        <strong style="color:#dc2626">-@Money(activeCashSummary.TotalOutVnd)</strong>
        <span>Nhập hàng: <b>@Money(activeCashSummary.SupplierPaidVnd)</b> · Khác: <b>@Money(activeCashSummary.OtherPaidVnd)</b></span>
      </div>
      <div class="stat" style="border-left:4px solid #0f766e;background:#f0fdfa">
        <small>Tồn Sổ quỹ lũy kế (TM + NH)</small>
        <strong style="color:@(cashBook.TotalBalanceVnd >= 0 ? "#0f766e" : "#dc2626")">@Money(cashBook.TotalBalanceVnd)</strong>
        <span>TM: <b>@Money(cashBook.CashBalanceVnd)</b> · NH: <b>@Money(cashBook.BankBalanceVnd)</b></span>
      </div>
    </div>
  </section>
</div>

@* ==================== THANH ĐIỀU HƯỚNG SEGMENTED TABS CHUẨN GITHUB / SHADCN ==================== *@
<div class="erp-nav-bar">
  <div class="erp-segmented-tabs" role="tablist">
    <button type="button" class="erp-seg-tab @(activeTab == "DEBT_REPORT" ? "active" : "")" data-confirm="none" @onclick='() => SetTab("DEBT_REPORT")'>
      <span>📊 Tổng hợp Tháng</span>
      <span class="erp-seg-badge">@FilteredPartnerDebts.Count()</span>
    </button>
    @if (canSupplier)
    {
      <button type="button" class="erp-seg-tab @(activeTab == "PURCHASE" ? "active" : "")" data-confirm="none" @onclick='() => SetTab("PURCHASE")'>
        <span>1. Nhà cung cấp</span>
        <span class="erp-seg-badge">@PeriodSupplierInvoices.Count()</span>
      </button>
    }
    @if (canCustomer)
    {
      <button type="button" class="erp-seg-tab @(activeTab == "SALE" ? "active" : "")" data-confirm="none" @onclick='() => SetTab("SALE")'>
        <span>2. Khách hàng</span>
        <span class="erp-seg-badge">@PeriodReceivables.Count()</span>
      </button>
    }
    @if (canOther)
    {
      <button type="button" class="erp-seg-tab @(activeTab == "OTHER" ? "active" : "")" data-confirm="none" @onclick='() => SetTab("OTHER")'>
        <span>3. NV bán hàng &amp; KT</span>
        <span class="erp-seg-badge">@PeriodOtherInvoices.Count()</span>
      </button>
    }
    <button type="button" class="erp-seg-tab @(activeTab == "PAYMENTS" ? "active" : "")" data-confirm="none" @onclick='() => SetTab("PAYMENTS")'>
      <span>4. Sổ quỹ Thu/Chi</span>
      <span class="erp-seg-badge">@FilteredPayments.Count()</span>
    </button>
    <button type="button" class="erp-seg-tab @(activeTab == "ALL" ? "active" : "")" data-confirm="none" @onclick='() => SetTab("ALL")'>
      <span>5. Tất cả CT</span>
      <span class="erp-seg-badge">@PeriodAllInvoices.Count()</span>
    </button>
    <button type="button" class="erp-seg-tab @(activeTab == "SNAPSHOT_STATS" ? "active" : "")" data-confirm="none" @onclick='() => SetTab("SNAPSHOT_STATS")'>
      <span>6. Đơn hàng &amp; Lãi gộp</span>
      <span class="erp-seg-badge">@FilteredSnapshots.Count()</span>
    </button>
  </div>

  <div style="display:flex;gap:8px;flex-wrap:wrap">
    @if (canPay)
    {
      <button type="button" class="btn btn-sm" data-confirm="none" @onclick="() => ToggleForm(nameof(showPay))">
        @(showPay ? "Đóng · Phiếu Thu / Chi" : "+ Lập Phiếu Thu / Chi (Sổ quỹ)")
      </button>
      <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => ToggleForm(nameof(showCreate))">
        @(showCreate ? "Đóng · Lập chứng từ" : "+ Lập chứng từ Công nợ")
      </button>
    }
  </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
  <div class="panel-note" style="margin-bottom:14px;padding:10px 14px;border-radius:8px;background:#f0fdf4;border:1px solid #86efac;color:#166534;font-weight:600">
    @message
  </div>
}

@* ==================== FORM LẬP PHIẾU THU / PHIẾU CHI (SỔ QUỸ) ==================== *@
@if (canPay)
{
  <section class="panel edit-panel" hidden="@(!showPay)">
    <div class="panel-head">
      <div>
        <h2>Lập Phiếu Thu / Phiếu Chi vào Sổ quỹ (Tiền mặt / Ngân hàng)</h2>
        <p>
          <strong>Khoản thu:</strong> Thu tiền khách hàng / thu công nợ &nbsp;|&nbsp;
          <strong>Khoản chi:</strong> Chi trả tiền nhập hàng Nhà cung cấp, chi hoa hồng nhân viên bán hàng hoặc công kỹ thuật.
        </p>
      </div>
    </div>
    <div class="form-grid">
      <label>1. Loại giao dịch Sổ quỹ *
        <select @bind="payDirection" @bind:after="OnPayDirectionChanged">
          <option value="IN">Khoản Thu (+): Thu khách / Thu công nợ (Phiếu Thu)</option>
          <option value="OUT">Khoản Chi (-): Chi nhập hàng NCC / Chi NV bán hàng &amp; Kỹ thuật (Phiếu Chi)</option>
        </select>
      </label>

      <label>2. Hạng mục Thu / Chi *
        <select @bind="payCategory" @bind:after="OnPayCategoryChanged">
          @if (payDirection == "IN")
          {
            <option value="CUSTOMER_DEBT">Thu khách / Thu công nợ đơn lắp đặt</option>
            <option value="RENEWAL_DEBT">Thu khách / Thu công nợ gia hạn</option>
          }
          else
          {
            <option value="SUPPLIER_PURCHASE">Chi: Nhập hàng Nhà cung cấp</option>
            <option value="SELLER_COMMISSION">Chi: Hoa hồng Nhân viên bán hàng</option>
            <option value="TECH_SERVICE">Chi: Phụ cấp / Công kỹ thuật lắp đặt</option>
          }
        </select>
      </label>

      <label>3. Sổ quỹ thanh toán (Tiền mặt / Ngân hàng) *
        <select @bind="method">
          <option value="CASH">Quỹ Tiền mặt</option>
          <option value="BANK">Quỹ Ngân hàng / Chuyển khoản</option>
        </select>
      </label>

      <label>4. Chọn chứng từ công nợ để phân bổ *
        <select @bind="invoiceId" @bind:after="OnInvoicePicked">
          @foreach (var x in FilteredOpenInvoicesForPayment)
          {
            <option value="@x.Id">[@TypeLabel(x.Type)] @x.Code — @x.Customer (Còn nợ: @Money(x.Balance))</option>
          }
          @if (!FilteredOpenInvoicesForPayment.Any())
          {
            <option value="0">— Không có chứng từ còn nợ trong nhóm này (Ghi phiếu Sổ quỹ trực tiếp) —</option>
          }
        </select>
      </label>

      @if (invoiceId <= 0)
      {
        <label>Đối tác (Khách hàng / Nhà cung cấp / NV bán hàng) *
          <input @bind="directPartnerName" placeholder="Nhập tên Khách hàng, Nhà cung cấp hoặc NV bán hàng..." />
        </label>
        <label>Diễn giải khoản Thu / Chi *
          <input @bind="directPayNote" placeholder="VD: Thu công nợ khách / Chi thanh toán tiền nhập hàng..." />
        </label>
      }

      <label>5. Số tiền @(payDirection == "IN" ? "Thu" : "Chi") (VND) *
        <input type="number" min="1" step="10000" @bind="amount" />
      </label>
    </div>
    <div class="form-actions" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <button type="button" class="btn" @onclick="Pay">
        @(payDirection == "IN" ? "+ Ghi nhận Khoản Thu vào Sổ quỹ" : "+ Ghi nhận Khoản Chi vào Sổ quỹ")
      </button>
      @if (SelectedPayInvoice is not null)
      {
        <button type="button" class="btn secondary" data-confirm="none" @onclick="() => amount = SelectedPayInvoice.Balance">
          Tất toán 100% (@Money(SelectedPayInvoice.Balance))
        </button>
        <span style="font-size:12px;color:#475569">
          Loại phiếu: <strong>@(SelectedPayInvoice.IsReceivable ? "Khoản Thu — Thu khách/công nợ (PT)" : "Khoản Chi — Nhập hàng/Chi trả (PC)")</strong>
          · Quỹ: <strong>@(method == "CASH" ? "Tiền mặt" : "Ngân hàng")</strong>
          · Đối tác: <strong>@SelectedPayInvoice.Customer</strong>
        </span>
      }
    </div>
  </section>

  <section class="panel edit-panel" hidden="@(!showCreate)">
    <div class="panel-head">
      <div>
        <h2>Lập chứng từ Công nợ mới (Nhà cung cấp · Khách hàng · Nhân viên bán hàng)</h2>
        <p>Dùng để ghi nhận công nợ nhập hàng Nhà cung cấp, công nợ Khách hàng hoặc công nợ hoa hồng nhân viên bán hàng / kỹ thuật.</p>
      </div>
    </div>
    <div class="form-grid">
      <label>Nhóm chứng từ công nợ *
        <select @bind="newType">
          @if (canSupplier)
          {
            <option value="PURCHASE">1. Công nợ Nhà cung cấp — Nhập hàng (Khoản phải trả)</option>
          }
          @if (canCustomer)
          {
            <option value="SALE">2. Công nợ Khách hàng — Đơn lắp đặt (Khoản phải thu)</option>
          }
          @if (canOther)
          {
            <option value="COMMISSION">3a. Công nợ Nhân viên bán hàng — Hoa hồng (Khoản phải trả)</option>
            <option value="SERVICE">3b. Công nợ Kỹ thuật — Công lắp đặt (Khoản phải trả)</option>
          }
        </select>
      </label>

      @if (newType == "PURCHASE")
      {
        <label>Nhà cung cấp *
          <select @bind="newSupplierId">
            <option value="0">— Chọn Nhà cung cấp —</option>
            @foreach (var s in suppliers)
            {
              <option value="@s.Id">@s.Name</option>
            }
          </select>
        </label>
      }
      else if (newType == "SALE")
      {
        <label>Khách hàng *
          <select @bind="newCustomerId">
            <option value="0">— Chọn Khách hàng —</option>
            @foreach (var c in customers)
            {
              <option value="@c.Id">@c.Code — @c.B2BDisplayName</option>
            }
          </select>
        </label>
      }
      else if (newType == "COMMISSION")
      {
        <label>Chọn Nhân viên bán hàng *
          <select @bind="newSellerId" @bind:after="OnNewSellerPicked">
            <option value="0">— Chọn nhân viên bán hàng trong danh sách hoặc nhập bên cạnh —</option>
            @foreach (var sl in sellerChoices)
            {
              <option value="@sl.Id">@sl.Code — @sl.Name [HH Đơn: @Money(sl.OrderCommissionVnd) · HH Gia hạn: @Money(sl.RenewalCommissionVnd)]</option>
            }
          </select>
        </label>
        <label>Tên người thụ hưởng (Nhân viên bán hàng) *
          <input @bind="newPartnerLabel" placeholder="VD: Nguyễn Minh Anh (SL001)..." />
        </label>
      }
      else
      {
        <label>Người thụ hưởng (Kỹ thuật / Đối tác) *
          <input @bind="newPartnerLabel" placeholder="VD: Kỹ thuật Trần Chí Thức..." />
        </label>
      }

      <label>Sản phẩm liên quan (Tùy chọn)
        <select @bind="newProductId">
          <option value="0">— Không gắn mã SP cụ thể —</option>
          @foreach (var p in products)
          {
            <option value="@p.Id">@p.Sku — @p.Name</option>
          }
        </select>
      </label>

      <label>Số lượng *
        <input type="number" min="1" @bind="newQty" />
      </label>

      <label>Đơn giá (VND) *
        <input type="number" min="1000" step="10000" @bind="newUnitPrice" />
      </label>

      <label>Thời điểm phát sinh (dd/MM/yyyy HH:mm:ss) *
        <input @bind="newIssuedText" placeholder="dd/MM/yyyy HH:mm:ss" />
      </label>

      <label>Hạn thanh toán *
        <input type="date" @bind="newDueDate" />
      </label>

      <label style="grid-column:1 / -1">Nội dung / Diễn giải chi tiết *
        <input @bind="newDescription" placeholder="VD: Nhập hàng lô thiết bị GPS / Hoa hồng nhân viên bán hàng tháng 11/2026..." />
      </label>
    </div>
    <div class="form-actions">
      <button type="button" class="btn" @onclick="CreateInvoice">
        + Tạo chứng từ Công nợ (@Money(newQty * newUnitPrice))
      </button>
    </div>
  </section>
}

@* ==================== CHI TIẾT CHỨNG TỪ KHI BẤM XEM ==================== *@
@if (selectedInvoice is not null)
{
  var rawInvLines = selectedInvoice.Lines is { Count: > 0 }
    ? selectedInvoice.Lines
    : new List<InvoiceLineVm> { new(0, selectedInvoice.Id, string.IsNullOrWhiteSpace(selectedInvoice.Notes) ? TypeLabel(selectedInvoice.Type) : selectedInvoice.Notes, "—", 1, selectedInvoice.Total) };
  var filteredInvLines = rawInvLines
    .Where(l =>
    {
      var ldt = VnDateTimeHelper.TryExtractLineTimestamp(l.Description, selectedInvoice.TimestampDt);
      if (!VnDateTimeHelper.InRange(ldt, lineRangeFrom, lineRangeTo)) return false;
      if (!string.IsNullOrWhiteSpace(invLineSearch) &&
          !(l.ProductSku + " " + l.Description).Contains(invLineSearch, StringComparison.OrdinalIgnoreCase))
        return false;
      return true;
    })
    .ToList();
  var pagedInvLines = invLinePager.Slice(filteredInvLines, out var totalInvLines);

  <section class="panel" style="border:2px solid #0284c7;background:#f8fafc;margin-bottom:16px">
    <div class="panel-head">
      <div>
        <div class="eyebrow">BIỂU MẪU CHI TIẾT CHỨNG TỪ CÔNG NỢ · KỲ @selectedInvoice.PeriodLabel.ToUpperInvariant()</div>
        <h2>@selectedInvoice.Code — @TypeLabel(selectedInvoice.Type)</h2>
        <p>
          Đối tác / Thụ hưởng: <strong>@selectedInvoice.Customer</strong>
          @if (!string.IsNullOrWhiteSpace(selectedInvoice.RefCode))
          {
            <span> · Tham chiếu: <strong>@selectedInvoice.RefCode</strong></span>
          }
          · Kỳ công nợ: <strong>@selectedInvoice.PeriodLabel</strong> · Thời điểm lập: <strong>@selectedInvoice.DisplayTimestamp</strong> · Đến hạn: <strong>@selectedInvoice.DisplayDueDate</strong>
        </p>
      </div>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => ExportInvoiceLinesExcel(selectedInvoice, filteredInvLines)">
          📥 Xuất Excel Chi tiết (@filteredInvLines.Count)
        </button>
        @if (canPay && selectedInvoice.Balance > 0 && selectedInvoice.Status != "VOID")
        {
          <button type="button" class="btn" data-confirm="none" @onclick="() => QuickPay(selectedInvoice)">
            @(selectedInvoice.IsReceivable ? "Thu khách / Thu công nợ này" : "Chi thanh toán chứng từ này")
          </button>
        }
        <button type="button" class="btn secondary" data-confirm="none" @onclick="() => selectedInvoice = null">Đóng chi tiết</button>
      </div>
    </div>

    <div class="stats-grid three" style="margin-bottom:12px">
      <div class="stat">
        <small>Tổng phát sinh @((lineRangeFrom.HasValue || lineRangeTo.HasValue || !string.IsNullOrWhiteSpace(invLineSearch)) ? "(Đang lọc)" : "")</small>
        <strong>@Money((lineRangeFrom.HasValue || lineRangeTo.HasValue || !string.IsNullOrWhiteSpace(invLineSearch)) ? filteredInvLines.Sum(x => x.LineTotal) : selectedInvoice.Total)</strong>
      </div>
      <div class="stat"><small>Đã thanh toán</small><strong style="color:#15803d">@Money(selectedInvoice.Paid)</strong></div>
      <div class="stat"><small>Số dư còn nợ chứng từ</small><strong class="orange">@Money(selectedInvoice.Balance)</strong></div>
    </div>

    <DateTimeRangeBar @bind-From="lineRangeFrom"
                      @bind-To="lineRangeTo"
                      AvailableYears="AvailableYears"
                      OnRangeChanged="() => invLinePager.Reset()"
                      MatchedCount="@filteredInvLines.Count"
                      TotalCount="@rawInvLines.Count"
                      UnitLabel="dòng hạng mục">
      <input class="search-input"
             style="min-width:260px;flex:1"
             @bind="invLineSearch"
             @bind:event="oninput"
             @bind:after="() => invLinePager.Reset()"
             placeholder="Tìm mã sản phẩm, số HD00..., biển số xe, chủ xe trong chứng từ..." />
    </DateTimeRangeBar>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>STT</th>
            <th>THỜI GIAN PHÁT SINH</th>
            <th>MÃ SẢN PHẨM</th>
            <th>DIỄN GIẢI / HẠNG MỤC CHI TIẾT</th>
            <th>SỐ LƯỢNG</th>
            <th>ĐƠN GIÁ</th>
            <th>THÀNH TIỀN</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var (stt, line) in pagedInvLines)
          {
            var lineDt = VnDateTimeHelper.TryExtractLineTimestamp(line.Description, selectedInvoice.TimestampDt);
            <tr>
              <td><strong>@stt</strong></td>
              <td>@(lineDt.HasValue ? VnDateTimeHelper.FormatDisplay(lineDt.Value) : selectedInvoice.DisplayTimestamp)</td>
              <td>@(string.IsNullOrWhiteSpace(line.ProductSku) ? "—" : line.ProductSku)</td>
              <td class="wrap-cell">@line.Description</td>
              <td><strong>@line.Quantity</strong></td>
              <td>@Money(line.UnitPrice)</td>
              <td><strong>@Money(line.LineTotal)</strong></td>
            </tr>
          }
          @if (filteredInvLines.Count == 0)
          {
            <tr>
              <td colspan="7">Không có dòng hạng mục nào thuộc khung thời gian / từ khóa đang chọn.</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
    <TablePager Pager="invLinePager" TotalCount="totalInvLines" OnChange="StateHasChanged" />
  </section>
}

@* ==================== NỘI DUNG THEO TỪNG TAB ==================== *@
@if (activeTab == "DEBT_REPORT")
{
  <section class="panel" style="margin-bottom:16px">
    <div class="panel-head">
      <div>
        <h2>Báo cáo Tổng hợp Công nợ tách theo Tháng / Năm (Phân biệt Nợ cũ &amp; Công nợ mới)</h2>
        <p>Mỗi tháng là một kỳ công nợ độc lập. Cột <strong>"Nợ cũ chuyển sang"</strong> tự động cộng dồn số dư chưa thanh toán trước kỳ / trước mốc Từ ngày của cùng đối tác.</p>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <button type="button" class="btn secondary" data-confirm="none" @onclick="ExportPartnerDebtsExcel">📥 Xuất Excel (@FilteredPartnerDebts.Count())</button>
      </div>
    </div>

    <DateTimeRangeBar From="rangeFrom"
                      To="rangeTo"
                      AvailableYears="AvailableYears"
                      OnRangeChanged="OnGlobalRangeChanged"
                      MatchedCount="@FilteredPartnerDebts.Count()"
                      TotalCount="@partnerDebts.Count"
                      UnitLabel="dòng đối tác">
      <select class="search-input" style="min-width:220px" @bind="debtCategoryFilter" @bind:after="() => partnerDebtPager.Reset()">
        <option value="">— Tất cả nhóm công nợ —</option>
        @if (canSupplier)
        {
          <option value="SUPPLIER">1. Công nợ Nhà cung cấp (Nhập hàng)</option>
        }
        @if (canCustomer || canRenewal)
        {
          <option value="CUSTOMER">2. Công nợ Khách hàng (Thu khách)</option>
        }
        @if (canOther)
        {
          <option value="SELLER">3. Công nợ Nhân viên bán hàng (Hoa hồng)</option>
          <option value="TECH">4. Công nợ Kỹ thuật lắp đặt</option>
        }
      </select>
      <input class="search-input"
             style="min-width:260px;flex:1"
             @bind="search"
             @bind:event="oninput"
             @bind:after="() => partnerDebtPager.Reset()"
             placeholder="Tìm tên NCC, Khách hàng, NV bán hàng, kỳ tháng..." />
      @if (!string.IsNullOrWhiteSpace(debtCategoryFilter) || !string.IsNullOrWhiteSpace(search))
      {
        <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick='() => { debtCategoryFilter = ""; search = ""; partnerDebtPager.Reset(); }'>✕ Xóa từ khóa</button>
      }
    </DateTimeRangeBar>

    @{
      var pagedPartnerDebts = partnerDebtPager.Slice(FilteredPartnerDebts, out var totalPartnerDebts);
      string lastPartnerPeriod = "";
    }
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>STT</th>
            <th>KỲ THÁNG / NĂM</th>
            <th>NHÓM CÔNG NỢ</th>
            <th>ĐỐI TÁC (NCC / KHÁCH HÀNG / NV BÁN HÀNG)</th>
            <th>NỢ CŨ CHUYỂN SANG</th>
            <th>PHÁT SINH TRONG KỲ</th>
            <th>ĐÃ THU / ĐÃ CHI</th>
            <th>CÒN NỢ TRONG KỲ</th>
            <th>LŨY KẾ CÒN NỢ (CŨ + MỚI)</th>
            <th>TRẠNG THÁI</th>
            <th>THAO TÁC</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var (stt, d) in pagedPartnerDebts)
          {
            var isRecv = d.CategoryCode == "CUSTOMER";
            var isCurrentMonth = d.PeriodKey == CurrentPeriodKey;
            if (d.PeriodKey != lastPartnerPeriod)
            {
              lastPartnerPeriod = d.PeriodKey;
              var grpRows = FilteredPartnerDebts.Where(x => x.PeriodKey == d.PeriodKey).ToList();
              var grpIncurred = grpRows.Sum(x => x.TotalIncurredVnd);
              var grpPaid = grpRows.Sum(x => x.TotalPaidVnd);
              var grpRem = grpRows.Sum(x => x.RemainingDebtVnd);
              <tr style="background:@(isCurrentMonth ? "#ecfdf5" : "#fff7ed");border-top:2px solid @(isCurrentMonth ? "#10b981" : "#f97316")">
                <td colspan="11" style="padding:8px 12px;font-weight:700;color:@(isCurrentMonth ? "#065f46" : "#9a3412")">
                  @(isCurrentMonth ? "🆕" : "⏳") KỲ CÔNG NỢ @d.PeriodLabel.ToUpperInvariant() — @(isCurrentMonth ? "CÔNG NỢ MỚI (THÁNG HIỆN TẠI)" : "CÔNG NỢ CŨ (KỲ TRƯỚC)")
                  <span style="font-weight:600;margin-left:10px;font-size:12px;color:#334155">
                    (@grpRows.Count đối tác · Tổng phát sinh kỳ này: <strong>@Money(grpIncurred)</strong> · Đã thanh toán: <strong style="color:#15803d">@Money(grpPaid)</strong> · Còn nợ riêng kỳ này: <strong style="color:#d97706">@Money(grpRem)</strong>)
                  </span>
                </td>
              </tr>
            }
            <tr>
              <td><strong>@stt</strong></td>
              <td>
                <span class="chip @(isCurrentMonth ? "green-chip" : d.RemainingDebtVnd > 0 ? "orange-chip" : "")">
                  @(isCurrentMonth ? "🆕 " : "⏳ ")@d.PeriodLabel
                </span>
                <div><small style="color:#64748b">@(isCurrentMonth ? "Công nợ mới" : "Công nợ kỳ trước")</small></div>
              </td>
              <td>
                <span class="chip @(d.CategoryCode == "SUPPLIER" ? "orange-chip" : d.CategoryCode == "CUSTOMER" ? "blue-chip" : "purple-chip")">
                  @d.CategoryLabel
                </span>
                <div><small style="color:#64748b">@(isRecv ? "Phải thu" : "Phải trả") · @d.InvoiceCount CT</small></div>
              </td>
              <td class="wrap-cell">
                <strong>@d.PartnerName</strong>
                <div style="font-size:11.5px;color:#64748b">@d.SubInfo</div>
              </td>
              <td>
                @if (d.CarryOverOldDebtVnd > 0)
                {
                  <strong style="color:#c2410c">@Money(d.CarryOverOldDebtVnd)</strong>
                  <div><small style="color:#9a3412">Đầu kỳ chuyển sang</small></div>
                }
                else
                {
                  <span style="color:#94a3b8">0 ₫</span>
                }
              </td>
              <td><strong>@Money(d.TotalIncurredVnd)</strong></td>
              <td><strong style="color:#15803d">@Money(d.TotalPaidVnd)</strong></td>
              <td>
                <strong style="color:@(d.RemainingDebtVnd > 0 ? "#d97706" : "#15803d")">
                  @Money(d.RemainingDebtVnd)
                </strong>
              </td>
              <td>
                <strong style="font-size:0.98rem;color:@(d.CumulativeRemainingVnd > 0 ? "#0284c7" : "#15803d")">
                  @Money(d.CumulativeRemainingVnd)
                </strong>
                @if (d.CarryOverOldDebtVnd > 0 && d.RemainingDebtVnd > 0)
                {
                  <div><small style="color:#475569">Cũ + Mới</small></div>
                }
              </td>
              <td>
                <span class="chip @(d.RemainingDebtVnd == 0 ? "green-chip" : d.TotalPaidVnd > 0 ? "purple-chip" : "orange-chip")">
                  @(d.RemainingDebtVnd == 0 ? "Đã tất toán" : d.TotalPaidVnd > 0 ? "Thanh toán 1 phần" : isCurrentMonth ? "Còn nợ (Mới)" : "Nợ cũ tồn đọng")
                </span>
              </td>
              <td>
                <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => JumpToPartnerInvoices(d)">
                  Xem chứng từ →
                </button>
              </td>
            </tr>
          }
          @if (!FilteredPartnerDebts.Any())
          {
            <tr>
              <td colspan="11">Không có phát sinh công nợ trong khung thời gian đang chọn.</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
    <TablePager Pager="partnerDebtPager" TotalCount="totalPartnerDebts" OnChange="StateHasChanged" />
  </section>
}
else if (activeTab == "PAYMENTS")
{
  var periodCash = FilteredCashBook;
  <section class="panel" style="margin-bottom:16px">
    <div class="panel-head">
      <div>
        <h2>4A. Bảng Tổng hợp Sổ quỹ: Tiền mặt &amp; Ngân hàng</h2>
        <p>
          Tổng hợp phát sinh Thu / Chi theo đúng khung thời gian <code>dd/MM/yyyy HH:mm:ss</code> đang chọn và đối chiếu Tồn quỹ lũy kế hiện tại.
        </p>
      </div>
    </div>

    <DateTimeRangeBar From="rangeFrom"
                      To="rangeTo"
                      AvailableYears="AvailableYears"
                      OnRangeChanged="OnGlobalRangeChanged"
                      MatchedCount="@FilteredPayments.Count()"
                      TotalCount="@payments.Count"
                      UnitLabel="phiếu Sổ quỹ" />

    <div class="table-wrap" style="margin-bottom:8px">
      <table>
        <thead>
          <tr>
            <th>STT</th>
            <th>LOẠI SỔ QUỸ</th>
            <th>TỔNG THU TRONG KỲ (+)</th>
            <th>TỔNG CHI TRONG KỲ (−)</th>
            <th>CHÊNH LỆCH TRONG KỲ</th>
            <th>TỒN QUỸ LŨY KẾ HIỆN TẠI</th>
            <th>GHI CHÚ PHÂN BỔ</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>1</strong></td>
            <td><span class="chip green-chip">1. Quỹ Tiền mặt</span></td>
            <td><strong style="color:#15803d">+@Money(periodCash.CashInVnd)</strong></td>
            <td><strong style="color:#dc2626">-@Money(periodCash.CashOutVnd)</strong></td>
            <td><strong style="color:@(periodCash.CashBalanceVnd >= 0 ? "#0f766e" : "#dc2626")">@Money(periodCash.CashBalanceVnd)</strong></td>
            <td><strong style="color:@(cashBook.CashBalanceVnd >= 0 ? "#0f766e" : "#dc2626")">@Money(cashBook.CashBalanceVnd)</strong></td>
            <td class="wrap-cell">Phiếu thu/chi bằng tiền mặt tại quỹ</td>
          </tr>
          <tr>
            <td><strong>2</strong></td>
            <td><span class="chip blue-chip">2. Quỹ Ngân hàng</span></td>
            <td><strong style="color:#15803d">+@Money(periodCash.BankInVnd)</strong></td>
            <td><strong style="color:#dc2626">-@Money(periodCash.BankOutVnd)</strong></td>
            <td><strong style="color:@(periodCash.BankBalanceVnd >= 0 ? "#0284c7" : "#dc2626")">@Money(periodCash.BankBalanceVnd)</strong></td>
            <td><strong style="color:@(cashBook.BankBalanceVnd >= 0 ? "#0284c7" : "#dc2626")">@Money(cashBook.BankBalanceVnd)</strong></td>
            <td class="wrap-cell">Phiếu thu/chi qua tài khoản ngân hàng / chuyển khoản</td>
          </tr>
          <tr style="background:#f8fafc;font-weight:700">
            <td><strong>—</strong></td>
            <td><strong>TỔNG CỘNG SỔ QUỸ (TM + NH)</strong></td>
            <td><strong style="color:#15803d">+@Money(periodCash.TotalInVnd)</strong></td>
            <td><strong style="color:#dc2626">-@Money(periodCash.TotalOutVnd)</strong></td>
            <td><strong style="color:@(periodCash.TotalBalanceVnd >= 0 ? "#0f766e" : "#dc2626")">@Money(periodCash.TotalBalanceVnd)</strong></td>
            <td><strong style="font-size:1.05rem;color:@(cashBook.TotalBalanceVnd >= 0 ? "#0f766e" : "#dc2626")">@Money(cashBook.TotalBalanceVnd)</strong></td>
            <td class="wrap-cell">Thu khách/công nợ: @Money(periodCash.CustomerReceivedVnd) · Chi nhập hàng: @Money(periodCash.SupplierPaidVnd) · Chi khác: @Money(periodCash.OtherPaidVnd)</td>
          </tr>
        </tbody>
      </table>
    </div>
    <TablePager Pager="cashFundPager" TotalCount="2" OnChange="StateHasChanged" />
  </section>

  <section class="panel" style="margin-bottom:16px">
    <div class="panel-head">
      <div>
        <h2>4B. Sổ Chi tiết Phiếu Thu / Phiếu Chi (Thu / Chi / Tồn sau giao dịch)</h2>
        <p>Tra cứu chi tiết từng giao dịch Sổ quỹ theo đúng thời gian <code>dd/MM/yyyy HH:mm:ss</code>, loại quỹ và đối tác.</p>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <button type="button" class="btn secondary" data-confirm="none" @onclick="ExportPaymentsExcel">📥 Xuất Excel (@FilteredPayments.Count())</button>
      </div>
    </div>

    <DateTimeRangeBar From="rangeFrom"
                      To="rangeTo"
                      AvailableYears="AvailableYears"
                      OnRangeChanged="OnGlobalRangeChanged"
                      MatchedCount="@FilteredPayments.Count()"
                      TotalCount="@payments.Count"
                      UnitLabel="phiếu giao dịch">
      <select class="search-input" style="min-width:175px" @bind="cashBookFundFilter" @bind:after="() => paymentPager.Reset()">
        <option value="">— Mọi Sổ quỹ (TM + NH) —</option>
        <option value="CASH">Quỹ Tiền mặt</option>
        <option value="BANK">Quỹ Ngân hàng</option>
      </select>
      <select class="search-input" style="min-width:190px" @bind="cashBookDirFilter" @bind:after="() => paymentPager.Reset()">
        <option value="">— Mọi Khoản Thu &amp; Chi —</option>
        <option value="IN">Khoản Thu (+): Thu khách / Công nợ</option>
        <option value="OUT">Khoản Chi (-): Nhập hàng / Chi trả</option>
      </select>
      <input class="search-input"
             style="min-width:240px;flex:1"
             @bind="search"
             @bind:event="oninput"
             @bind:after="() => paymentPager.Reset()"
             placeholder="Tìm số phiếu, đối tác, chứng từ..." />
      @if (!string.IsNullOrWhiteSpace(cashBookFundFilter) || !string.IsNullOrWhiteSpace(cashBookDirFilter) || !string.IsNullOrWhiteSpace(search))
      {
        <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick='() => { cashBookFundFilter = ""; cashBookDirFilter = ""; search = ""; paymentPager.Reset(); }'>✕ Xóa từ khóa</button>
      }
    </DateTimeRangeBar>

    @{ var pagedPayments = paymentPager.Slice(FilteredPayments, out var totalPayments); }
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>STT</th>
            <th>SỐ PHIẾU</th>
            <th>KHOẢN THU / KHOẢN CHI</th>
            <th>SỔ QUỸ (TM / NH)</th>
            <th>HẠNG MỤC NGHIỆP VỤ</th>
            <th>CHỨNG TỪ CÔNG NỢ</th>
            <th>ĐỐI TÁC (KHÁCH HÀNG / NCC / NV BÁN HÀNG)</th>
            <th>THU (+)</th>
            <th>CHI (−)</th>
            <th>TỒN QUỸ SAU GD</th>
            <th>THỜI GIAN GD</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var (stt, p) in pagedPayments)
          {
            <tr>
              <td><strong>@stt</strong></td>
              <td><strong>@p.PaymentNo</strong></td>
              <td>
                <span class="chip @(p.Direction == "IN" ? "green-chip" : "orange-chip")">
                  @(p.Direction == "IN" ? "Khoản Thu (PT)" : "Khoản Chi (PC)")
                </span>
              </td>
              <td>
                <span class="chip @(p.Method == "CASH" ? "green-chip" : "blue-chip")">
                  @(p.Method == "CASH" ? "Tiền mặt" : "Ngân hàng")
                </span>
              </td>
              <td class="wrap-cell">
                <strong>@CashBookCategoryLabel(p)</strong>
                @if (!string.IsNullOrWhiteSpace(p.Notes))
                {
                  <div><small style="color:#64748b">@p.Notes</small></div>
                }
              </td>
              <td><strong>@p.InvoiceNo</strong></td>
              <td class="wrap-cell"><strong>@p.Partner</strong></td>
              <td>
                @if (p.Direction == "IN")
                {
                  <strong style="color:#15803d">+@Money(p.Amount)</strong>
                }
                else
                {
                  <span>—</span>
                }
              </td>
              <td>
                @if (p.Direction == "OUT")
                {
                  <strong style="color:#dc2626">-@Money(p.Amount)</strong>
                }
                else
                {
                  <span>—</span>
                }
              </td>
              <td>
                <strong style="color:@(p.BalanceAfterTotalVnd >= 0 ? "#0f766e" : "#dc2626")">@Money(p.BalanceAfterTotalVnd)</strong>
