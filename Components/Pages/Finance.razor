             style="min-width:260px;flex:1"
             @bind="search"
             @bind:event="oninput"
             @bind:after="() => invoicePager.Reset()"
             placeholder="Tìm số CT, HD00..., BSX, NCC, khách hàng, NV bán hàng..." />
      @if (!string.IsNullOrWhiteSpace(customerSubTypeFilter) || !string.IsNullOrWhiteSpace(statusFilter) || !string.IsNullOrWhiteSpace(search))
      {
        <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick='() => { customerSubTypeFilter = ""; statusFilter = ""; search = ""; invoicePager.Reset(); }'>✕ Xóa từ khóa</button>
      }
