@code {
    private sealed class LineReportInput { public string Imei { get; set; } = ""; public string PlateNo { get; set; } = ""; public string VinNo { get; set; } = ""; }
    private readonly PagerState draftPager = new();
    private readonly PagerState orderLinePager = new();
    private readonly PagerState orderPager = new();
    private List<V7Order> orders = [];
    private List<CustomerVm> customers = [];
    private List<ProductVm> products = [];
    private List<StockVm> inStockUnits = [];
    private List<WarehousePick> warehouses = [];
    private List<InputCatalog.Installer> installers = [];
    private List<InputCatalog.Choice> sellerChoices = [];
    private List<(long Id, string Name)> suppliers = [];
    private readonly List<V7OrderLineDraft> draftLines = [];
    private readonly Dictionary<long, LineReportInput> lineReports = [];

    private bool showQuickPaste, isMainDev;
    private string sellerRawText = "";

    // Create form state
    private long customer, product, draftQty = 1, durationMonths = 12, createWarehouse, createInstallerEmpId, createSellerId;
    private bool cod, createNoDeductStock;
    private string contactName = "", customerPhone = "", saleSource = "", address = "", notes = "";
    private string installAtText = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    private string createSource = "INTERNAL", createInstallerName = "";

    // Edit / Process form state
    private long selected, warehouse, installerEmployeeId, editDurationMonths = 12, editSellerId;
    private bool noDeductStock, editCod, showOrderModal;
    private string installer = "", source = "INTERNAL", message = "";
    private string editContactName = "", editCustomerPhone = "", editInstallAt = "", editAddress = "", editNotes = "", editSaleSource = "";
    private DateTime activationDateInput = DateTime.Today;

    private CustomerVm? SelectedCustomer => customers.FirstOrDefault(x => x.Id == customer);
    private V7Order? SelectedOrder => orders.FirstOrDefault(x => x.Id == selected);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var actor = await Gate.RequireAsync(Permissions.OrdersView);
            isMainDev = Orders.IsMainDeveloperActor(actor);
        }
        catch
        {
            isMainDev = false;
        }
        customers = Db.Customers();
        warehouses = Ops.AllWarehouses();
        installers = Catalog.Installers();
        sellerChoices = Catalog.SellerChoices();
        suppliers = Db.Suppliers();
        if (warehouses.Count > 0)
        {
            createWarehouse = warehouses[0].Id;
            warehouse = warehouses[0].Id;
        }
        if (sellerChoices.Count > 0)
        {
            createSellerId = sellerChoices[0].Id;
            saleSource = sellerChoices[0].Name;
        }
        installAtText = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
        Refresh();
    }

    private void Refresh()
    {
        sellerChoices = Catalog.SellerChoices();
        products = Db.Products();
        inStockUnits = Db.Stock().Where(s => s.Status == "IN_STOCK").ToList();
        orders = Orders.List();
        SyncSelectedOrderLines();
    }

    private void FillSampleSellerText()
    {
        sellerRawText = "HTX Nam Hi\nThông tin khách \n   - Họ tên khách: Lâm Hằng ( xe Đỗ Văn Hội)\n   - Số điện thoại khách: 0886287429\nThông tin lắp đặt: \n   - Số lượng lắp: 1\n   - Thời hạn: 1 năm \n   - Địa chỉ lắp: 55 đường 30/4\n   - Thời gian lắp: 15g00 thứ 3 ( 20/10/2026)\n   - Ghi chú: không thu tiền, khi đến địa chỉ lắp liên hệ sdt: 0886287429";
        ParseSellerText();
    }

    private void ParseSellerText()
    {
        if (string.IsNullOrWhiteSpace(sellerRawText)) return;
        var lines = sellerRawText.Replace("\r", "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var rawLine in lines)
        {
            var line = rawLine.TrimStart('-', '+', '*', '•', ' ');
            var lower = line.ToLowerInvariant();
            int colonIdx = line.IndexOf(':');
            string val = colonIdx >= 0 ? line[(colonIdx + 1)..].Trim() : "";

            if (lower.StartsWith("họ tên khách") || lower.StartsWith("tên khách"))
            {
                contactName = val;
            }
            else if (lower.StartsWith("số điện thoại") || lower.StartsWith("sđt") || lower.StartsWith("sdt"))
            {
                customerPhone = val;
            }
            else if (lower.StartsWith("số lượng"))
            {
                var digits = new string(val.Where(char.IsDigit).ToArray());
                if (long.TryParse(digits, out var q) && q > 0)
                {
                    draftQty = q;
                    if (draftLines.Count == 1) draftLines[0] = draftLines[0] with { Quantity = q };
                }
            }
            else if (lower.StartsWith("thời hạn"))
            {
                var digits = new string(val.Where(char.IsDigit).ToArray());
                if (int.TryParse(digits, out var n) && n > 0)
                {
                    durationMonths = lower.Contains("tháng") ? n : n * 12;
                }
            }
            else if (lower.StartsWith("địa chỉ"))
            {
                address = val;
            }
            else if (lower.StartsWith("thời gian"))
            {
                installAtText = val;
            }
            else if (lower.StartsWith("ghi chú"))
            {
                notes = val;
                if (val.Contains("không thu tiền", StringComparison.OrdinalIgnoreCase))
                    cod = false;
                else if (val.Contains("thu hộ", StringComparison.OrdinalIgnoreCase) || val.Contains("cod", StringComparison.OrdinalIgnoreCase))
                    cod = true;
            }
            else if (colonIdx < 0 && !lower.Contains("thông tin"))
            {
                var matchedCust = customers.FirstOrDefault(c =>
                    c.Name.Contains(line, StringComparison.OrdinalIgnoreCase) ||
                    line.Contains(c.Name, StringComparison.OrdinalIgnoreCase) ||
                    c.Code.Equals(line, StringComparison.OrdinalIgnoreCase));
                if (matchedCust is not null)
                {
                    customer = matchedCust.Id;
                    if (matchedCust.SellerId is > 0)
                        createSellerId = matchedCust.SellerId.Value;
                    if (string.IsNullOrWhiteSpace(saleSource))
                        saleSource = !string.IsNullOrWhiteSpace(matchedCust.Source) ? matchedCust.Source : matchedCust.Name;
                }
            }
        }
        if (product == 0 && draftLines.Count == 0)
        {
            var firstGoods = products.FirstOrDefault(p => p.IsSerialized && p.StockInHand > 0) ?? products.FirstOrDefault(p => p.IsSerialized);
            if (firstGoods is not null) product = firstGoods.Id;
        }
        message = "Đã tự động điền thông tin từ tin nhắn nhân viên bán hàng. Vui lòng kiểm tra sản phẩm lắp đặt và bấm '+ Tạo đơn hàng (SO)'.";
    }

    private void OnCustomerChanged()
    {
        var c = customers.FirstOrDefault(x => x.Id == customer);
        if (c is not null)
        {
            if (string.IsNullOrWhiteSpace(customerPhone)) customerPhone = c.Phone;
            if (c.SellerId is > 0)
            {
                createSellerId = c.SellerId.Value;
                var sl = sellerChoices.FirstOrDefault(s => s.Id == c.SellerId.Value);
                saleSource = sl is not null ? sl.Name : c.Source;
            }
            else if (string.IsNullOrWhiteSpace(saleSource))
            {
                saleSource = c.Source;
            }
            if (string.IsNullOrWhiteSpace(address) && !string.IsNullOrWhiteSpace(c.Address)) address = c.Address;
        }
    }

    private void OnCreateSellerChanged()
    {
        var sl = sellerChoices.FirstOrDefault(x => x.Id == createSellerId);
        if (sl is not null)
        {
            saleSource = sl.Name;
        }
    }

    private void OnEditSellerChanged()
    {
        var sl = sellerChoices.FirstOrDefault(x => x.Id == editSellerId);
        if (sl is not null)
        {
            editSaleSource = sl.Name;
        }
    }

    private void OnCreateSourceChanged(ChangeEventArgs e)
    {
        createSource = e.Value?.ToString() == "PARTNER" ? "PARTNER" : "INTERNAL";
        if (createSource == "INTERNAL")
        {
            createNoDeductStock = false;
        }
    }

    private void OnCreateInstallerEmpChanged()
    {
        var emp = installers.FirstOrDefault(x => x.Id == createInstallerEmpId);
        if (emp is not null) createInstallerName = emp.Name;
    }

    private void OnCreateManufacturerPick(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(val)) createInstallerName = val;
    }

    private void OnCreateNoDeductChanged(ChangeEventArgs e)
    {
        var wantNoDeduct = e.Value is bool b && b;
        if (wantNoDeduct && createSource != "PARTNER")
        {
            createSource = "PARTNER";
            createInstallerEmpId = 0;
            message = "Lưu ý: Chế độ 'Không trừ tồn kho' yêu cầu Đơn vị lắp đặt phải là Hãng lắp đặt. Đã chuyển phân loại sang 'Hãng lắp đặt', vui lòng chọn/nhập tên Hãng.";
        }
        createNoDeductStock = wantNoDeduct;
    }

    private void OnEditSourceChanged(ChangeEventArgs e)
    {
        source = e.Value?.ToString() == "PARTNER" ? "PARTNER" : "INTERNAL";
        if (source == "INTERNAL")
        {
            noDeductStock = false;
        }
    }

    private void OnEditManufacturerPick(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(val))
        {
            installerEmployeeId = 0;
            installer = val;
        }
    }

    private void OnEditNoDeductChanged(ChangeEventArgs e)
    {
        var wantNoDeduct = e.Value is bool b && b;
        if (wantNoDeduct && source != "PARTNER")
        {
            source = "PARTNER";
            installerEmployeeId = 0;
            message = "Lưu ý: Chế độ 'Không trừ tồn kho' bắt buộc Đơn vị lắp đặt phải là Hãng lắp đặt. Vui lòng chọn/nhập tên Hãng lắp đặt.";
        }
        noDeductStock = wantNoDeduct;
    }

    private void SetInstallAtNow()
    {
        installAtText = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    }

    private void OnInstallAtChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString()?.Trim() ?? "";
        installAtText = string.IsNullOrWhiteSpace(val)
            ? DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
            : V7Orders.FormatInstallDateTime(val);
    }

    private void AddDraftLine()
    {
        if (product <= 0 || draftQty <= 0) { message = "Hãy chọn sản phẩm và số lượng hợp lệ."; return; }
        var existingIdx = draftLines.FindIndex(x => x.ProductId == product);
        if (existingIdx >= 0)
            draftLines[existingIdx] = new V7OrderLineDraft(product, draftLines[existingIdx].Quantity + draftQty);
        else
            draftLines.Add(new V7OrderLineDraft(product, draftQty));
        product = 0;
        draftQty = 1;
        message = "";
    }

    private void UpdateDraftQty(int index, object? val)
    {
        if (index >= 0 && index < draftLines.Count && long.TryParse(val?.ToString(), out var q) && q > 0)
            draftLines[index] = draftLines[index] with { Quantity = Math.Min(100, q) };
    }

    private void RemoveDraftLine(int index)
    {
        if (index >= 0 && index < draftLines.Count) draftLines.RemoveAt(index);
    }

    private void SelectOrderRow(long id)
    {
        selected = id;
        OnOrderSelected();
    }

    private void OpenOrderModal(long id)
    {
        selected = id;
        message = "";
        OnOrderSelected();
        showOrderModal = true;
    }

    private void CloseOrderModal()
    {
        showOrderModal = false;
    }

    private Task QuickCancelOrder(long id) => Act(actor =>
    {
        selected = id;
        var curOrder = orders.FirstOrDefault(x => x.Id == id);
        var wasHardDelete = curOrder?.Status == "COMPLETED" || (curOrder?.Status == "CANCELLED" && isMainDev);
        Orders.Cancel(actor, id);
        showOrderModal = false;
        if (wasHardDelete)
        {
            selected = 0;
            return $"Đã hủy & xóa cứng hoàn toàn đơn SO7-{id:000000}: Đã hoàn trả tồn kho, gỡ kích hoạt thiết bị và xóa toàn bộ chứng từ công nợ / kế toán liên quan.";
        }
        return $"Đã hủy đơn SO7-{id:000000}.";
    });

    private void OnOrderSelected()
    {
        var o = SelectedOrder;
        if (o is not null)
        {
            warehouse = o.WarehouseId ?? (warehouses.FirstOrDefault()?.Id ?? 0);
            installerEmployeeId = o.InstallerEmployeeId ?? 0;
            installer = o.Installer ?? "";
            source = o.Source;
            noDeductStock = !o.DeductStock;
            editSellerId = o.SellerRecordId ?? 0;
            editSaleSource = o.SaleSource;
            editContactName = o.ContactName;
            editCustomerPhone = o.CustomerPhone;
            editDurationMonths = o.DurationMonths > 0 ? o.DurationMonths : 12;
            editInstallAt = o.InstallAt;
            editAddress = o.InstallAddress;
            editNotes = o.Notes;
            editCod = o.Cod;
            if (!string.IsNullOrWhiteSpace(o.ActivatedAt) && DateTime.TryParse(o.ActivatedAt, out var actDt))
                activationDateInput = actDt.Date;
            else
                activationDateInput = DateTime.Today;
            SyncSelectedOrderLines();
        }
    }

    private void SyncSelectedOrderLines()
    {
        lineReports.Clear();
        var o = SelectedOrder;
        if (o is null) return;
        foreach (var ln in o.Lines)
        {
            var defaultVin = !string.IsNullOrWhiteSpace(ln.VinNo) ? ln.VinNo : o.ContactName;
            lineReports[ln.Id] = new LineReportInput { Imei = ln.Imei ?? "", PlateNo = ln.PlateNo ?? "", VinNo = defaultVin ?? "" };
        }
    }

    private LineReportInput GetOrCreateLineReport(V7OrderLine ln)
    {
        if (!lineReports.TryGetValue(ln.Id, out var r))
        {
            r = new LineReportInput { Imei = ln.Imei ?? "", PlateNo = ln.PlateNo ?? "", VinNo = ln.VinNo ?? "" };
            lineReports[ln.Id] = r;
        }
        return r;
    }

    private void SetLineReport(long lineId, string? imeiVal, string? plateVal, string? vinVal)
    {
        if (!lineReports.TryGetValue(lineId, out var r))
        {
            r = new LineReportInput();
            lineReports[lineId] = r;
        }
        if (imeiVal is not null) r.Imei = imeiVal;
        if (plateVal is not null) r.PlateNo = plateVal;
        if (vinVal is not null) r.VinNo = vinVal;
    }

    private void OnInstallerEmployeeChanged()
    {
        var emp = installers.FirstOrDefault(x => x.Id == installerEmployeeId);
        if (emp is not null) installer = emp.Name;
    }

    private string GetRateLabel(long empId)
    {
        var o = SelectedOrder;
        if (o is not null && o.Lines.Count > 0)
        {
            var total = o.Lines.Sum(l => Catalog.QuoteInstallerRate(empId, l.ProductId) * l.Quantity);
            return $"Tổng công lắp đơn này: {total:N0} ₫";
        }
        return installers.FirstOrDefault(x => x.Id == empId)?.RateSummary ?? "";
    }

    private async Task Act(Func<long, string> fn)
    {
        try
        {
            var actor = await Gate.RequireAsync(Permissions.OrdersView);
            var msg = fn(actor);
            Refresh();
            message = string.IsNullOrWhiteSpace(msg) ? "Thao tác thành công." : msg;
        }
        catch (Exception ex)
        {
            message = "Lỗi: " + ex.Message;
        }
    }

    private Task Create() => Act(actor =>
    {
        var items = draftLines.ToList();
        if (product > 0 && draftQty > 0)
        {
            var existingIdx = items.FindIndex(x => x.ProductId == product);
            if (existingIdx >= 0)
                items[existingIdx] = new V7OrderLineDraft(product, items[existingIdx].Quantity + Math.Max(1, draftQty));
            else
                items.Add(new V7OrderLineDraft(product, Math.Max(1, draftQty)));
        }
        var formattedWhen = V7Orders.FormatInstallDateTime(installAtText);
        if (string.IsNullOrWhiteSpace(formattedWhen)) formattedWhen = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
        var isPartner = createSource == "PARTNER";
        var deduct = !createNoDeductStock;
        var createdId = Orders.CreateMulti(
            actor,
            customer,
            items,
            address,
            notes,
            cod,
            customerPhone,
            formattedWhen,
            saleSource,
            contactName,
            durationMonths,
            createWarehouse > 0 ? createWarehouse : null,
            isPartner,
            createInstallerName,
            createInstallerEmpId > 0 ? createInstallerEmpId : null,
            deduct,
            createSellerId > 0 ? createSellerId : null);
        draftLines.Clear();
        product = 0;
        draftQty = 1;
        selected = createdId;
        OnOrderSelected();
        return $"Đã tạo đơn SO7-{createdId:000000} (chưa trừ tồn kho). Khi ĐV lắp đặt gửi IMEI về, hãy nhập IMEI, chọn Ngày kích hoạt và bấm '3. Hoàn thành đơn & Kích hoạt IMEI'.";
    });

    private Task SaveOrderAndDispatch() => Act(actor =>
    {
        if (selected <= 0) throw new InvalidOperationException("Vui lòng chọn đơn hàng.");
        Orders.UpdateOrderInfo(
            actor,
            selected,
            editContactName,
            editCustomerPhone,
            editAddress,
            editInstallAt,
            editDurationMonths,
            editNotes,
            editCod,
            warehouse > 0 ? warehouse : null,
            source == "PARTNER",
            installer,
            installerEmployeeId > 0 ? installerEmployeeId : null,
            !noDeductStock,
            editSellerId > 0 ? editSellerId : null,
            editSaleSource);
        return $"Đã cập nhật thông tin & điều phối đơn SO7-{selected:000000} (Tồn kho chỉ trừ khi bấm Hoàn thành đơn).";
    });

    private Task Report() => Act(actor =>
    {
        if (selected <= 0) throw new InvalidOperationException("Vui lòng chọn đơn hàng.");
        var o = SelectedOrder;
        if (o is not null && o.Status is "PENDING" or "APPROVED")
        {
            if (warehouse > 0) Orders.Approve(actor, selected, warehouse);
            var effInstaller = !string.IsNullOrWhiteSpace(installer) ? installer : "ĐV lắp đặt";
            Orders.Dispatch(actor, selected, source == "PARTNER", effInstaller, installerEmployeeId > 0 ? installerEmployeeId : null, !noDeductStock, warehouse > 0 ? warehouse : null);
        }
        var payload = lineReports.Select(kv => new V7OrderLineReport(kv.Key, kv.Value.Imei, kv.Value.PlateNo, kv.Value.VinNo)).ToList();
        Orders.ReportLines(actor, selected, payload, allowMissingImei: true);
        return $"Đã lưu thông tin Số IMEI & Thông tin phụ từ ĐV lắp đặt gửi về cho đơn SO7-{selected:000000}.";
    });

    private Task SaveCompletedOrderImeis() => Act(actor =>
    {
        if (selected <= 0) throw new InvalidOperationException("Vui lòng chọn đơn hàng.");
        var o = SelectedOrder ?? throw new InvalidOperationException("Không tìm thấy đơn hàng.");
        var payload = lineReports.Select(kv => new V7OrderLineReport(kv.Key, kv.Value.Imei, kv.Value.PlateNo, kv.Value.VinNo)).ToList();
        if (payload.All(x => string.IsNullOrWhiteSpace(x.Imei)))
            throw new InvalidOperationException("Vui lòng nhập ít nhất 1 mã IMEI để lưu và kích hoạt.");
        var actDateStr = activationDateInput.ToString("yyyy-MM-dd");
        var newlyActivated = Orders.SupplementCompletedOrderImeis(actor, selected, payload, actDateStr);
        showOrderModal = false;
        var expDateStr = activationDateInput.AddMonths((int)(editDurationMonths > 0 ? editDurationMonths : 12)).ToString("dd/MM/yyyy");
        return newlyActivated > 0
            ? $"Đã bổ sung & kích hoạt {newlyActivated} IMEI cho đơn {o.Code} (Ngày kích hoạt: {activationDateInput:dd/MM/yyyy} → Hết hạn: {expDateStr}, không trừ tồn kho lần 2)."
            : $"Đã cập nhật thông tin IMEI / Biển số / Ngày kích hoạt cho đơn {o.Code}.";
    });

    private Task Complete() => Act(actor =>
    {
        if (selected <= 0) throw new InvalidOperationException("Vui lòng chọn đơn hàng.");
        var o = SelectedOrder ?? throw new InvalidOperationException("Không tìm thấy đơn hàng.");

        // Lưu thông tin cập nhật & điều phối nếu CSKH vừa sửa trên form
        var effInstaller = !string.IsNullOrWhiteSpace(installer)
            ? installer
            : (source == "PARTNER" ? "" : "ĐV lắp đặt nội bộ");
        Orders.UpdateOrderInfo(
            actor,
            selected,
            editContactName,
            editCustomerPhone,
            editAddress,
            editInstallAt,
            editDurationMonths,
            editNotes,
            editCod,
            warehouse > 0 ? warehouse : (warehouses.FirstOrDefault()?.Id ?? null),
            source == "PARTNER",
            effInstaller,
            installerEmployeeId > 0 ? installerEmployeeId : null,
            !noDeductStock,
            editSellerId > 0 ? editSellerId : null,
            editSaleSource);

        var payload = lineReports.Select(kv => new V7OrderLineReport(kv.Key, kv.Value.Imei, kv.Value.PlateNo, kv.Value.VinNo)).ToList();
        if (o.Lines.Any(x => x.IsSerialized))
        {
            Orders.ReportLines(actor, selected, payload, allowMissingImei: true);
        }

        var actDateStr = activationDateInput.ToString("yyyy-MM-dd");
        Orders.Complete(actor, selected, actDateStr);
        showOrderModal = false;
        var expDateStr = activationDateInput.AddMonths((int)(editDurationMonths > 0 ? editDurationMonths : 12)).ToString("dd/MM/yyyy");
        var stockMsg = noDeductStock
            ? $"Không trừ tồn kho (Hãng lắp đặt: {effInstaller})"
            : "Đã trừ số lượng sản phẩm tồn kho ngay lập tức";
        var missingCount = o.Lines.Count(l => l.IsSerialized && (!lineReports.TryGetValue(l.Id, out var r) || string.IsNullOrWhiteSpace(r.Imei)));
        if (missingCount > 0)
        {
            return $"Hoàn thành đơn {o.Code}! {stockMsg} · Hiện còn {missingCount} thiết bị chờ bổ sung IMEI (bấm nút '📝 Bổ sung IMEI' khi ĐV lắp đặt gửi mã về).";
        }
        return $"Hoàn thành đơn {o.Code}! {stockMsg} · Đã kích hoạt IMEI (Ngày kích hoạt: {activationDateInput:dd/MM/yyyy} → Hết hạn: {expDateStr}).";
    });

    private Task Cancel() => Act(actor =>
    {
        var targetId = selected;
        var wasHardDelete = SelectedOrder?.Status == "COMPLETED" || (SelectedOrder?.Status == "CANCELLED" && isMainDev);
        Orders.Cancel(actor, targetId);
        showOrderModal = false;
        if (wasHardDelete)
        {
            selected = 0;
            return $"Đã hủy & xóa cứng hoàn toàn đơn SO7-{targetId:000000}: Đã hoàn trả tồn kho, gỡ kích hoạt thiết bị và xóa toàn bộ chứng từ công nợ / kế toán liên quan.";
        }
        return $"Đã hủy đơn SO7-{targetId:000000}.";
    });
}
