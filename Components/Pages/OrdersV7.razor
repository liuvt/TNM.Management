    private void SetRenewDeviceChecked(DeviceVm dv, bool check)
    {
        if (check)
        {
            if (renewTargetCustomerId <= 0 && selectedRenewIds.Count > 0)
            {
                var firstSelected = ActiveDevicesForRenew.FirstOrDefault(x => selectedRenewIds.Contains(x.ActivationId));
                if (firstSelected is not null && firstSelected.CustomerId != dv.CustomerId)
                {
                    message = $"Lưu ý: Xe {dv.Plate} thuộc [{dv.Customer}] khác với [{firstSelected.Customer}]. Vui lòng chọn các xe cùng 1 HTX/Khách hàng trong 1 Đơn gia hạn (hoặc chọn Đơn vị nhận hóa đơn mới nếu chuyển đơn vị).";
                    return;
                }
            }
            selectedRenewIds.Add(dv.ActivationId);
            if (dv.SellerId is > 0) renewSellerId = dv.SellerId.Value;
            renewCustomPrices[dv.ActivationId] = QuoteSingleRenewalAutoPrice(dv);
        }
        else
        {
            selectedRenewIds.Remove(dv.ActivationId);
            renewCustomPrices.Remove(dv.ActivationId);
        }
    }

    private void SelectAllFilteredRenewDevices()
    {
        var list = FilteredRenewalDevices;
        if (list.Count == 0) return;
        var targetCust = renewTargetCustomerId > 0 ? renewTargetCustomerId : list[0].CustomerId;
        int added = 0;
        foreach (var dv in list)
        {
            if (renewTargetCustomerId <= 0 && dv.CustomerId != targetCust) continue;
            selectedRenewIds.Add(dv.ActivationId);
            if (!renewCustomPrices.ContainsKey(dv.ActivationId))
                renewCustomPrices[dv.ActivationId] = QuoteSingleRenewalAutoPrice(dv);
            added++;
            if (added >= 50) break;
        }
        var custObj = customers.FirstOrDefault(c => c.Id == targetCust);
        if (custObj?.SellerId is > 0) renewSellerId = custObj.SellerId.Value;
        message = $"Đã chọn {selectedRenewIds.Count} xe thuộc {(custObj?.Name ?? "đơn vị đã lọc")} vào Đơn gia hạn.";
    }

