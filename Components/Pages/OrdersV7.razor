    private void AddDraftLine()
    {
        if (product <= 0 || draftQty <= 0) { message = "Hãy chọn sản phẩm và số lượng hợp lệ."; return; }
        var existingIdx = draftLines.FindIndex(x => x.ProductId == product && x.TargetActivationId is null && x.CustomUnitPrice == pendingDraftCustomPrice);
        if (existingIdx >= 0)
            draftLines[existingIdx] = draftLines[existingIdx] with { Quantity = draftLines[existingIdx].Quantity + draftQty };
        else
            draftLines.Add(new V7OrderLineDraft(product, draftQty, CustomUnitPrice: pendingDraftCustomPrice));
        product = 0;
        draftQty = 1;
        pendingDraftCustomPrice = null;
        message = "";
    }

    private void UpdateDraftQty(int index, object? val)
    {
        if (index >= 0 && index < draftLines.Count && long.TryParse(val?.ToString(), out var q) && q > 0)
            draftLines[index] = draftLines[index] with { Quantity = Math.Min(100, q) };
    }

