            "Số lượng", "Thời hạn", "Chế độ giá", "Tổng tiền (VND)", "Giá vốn (VND)", "Công lắp (VND)",
            "Thời gian", "Địa chỉ", "Số IMEI", "Biển số xe",
            "Kho xuất", "Chế độ tồn kho", "Đơn vị / Hãng lắp đặt", "Ngày kích hoạt / GH", "Ghi chú"
        };
        var rows = list.Select((o, idx) =>
        {
            var totalQty = o.Lines.Count > 0 ? o.Lines.Sum(l => l.Quantity) : 1L;
            var imeis = o.Lines.Count > 0 ? string.Join(", ", o.Lines.Where(l => !string.IsNullOrWhiteSpace(l.Imei)).Select(l => l.Imei)) : (o.Imei ?? "");
            var plates = o.Lines.Count > 0 ? string.Join(", ", o.Lines.Where(l => !string.IsNullOrWhiteSpace(l.PlateNo)).Select(l => l.PlateNo).Distinct()) : (o.PlateNo ?? "");
            return new object?[]
            {
                idx + 1, o.Code, o.OrderKindDisplay, o.StatusDisplay, o.CustomerCode, o.CustomerB2BDisplay, o.CustomerGroup,
                o.ContactName, o.CustomerPhone, o.SaleSource, o.Product,
                totalQty, o.DurationDisplay, o.InstallPriceModeDisplay, o.Price, o.CostSnapshot, o.InstallerFee,
                o.InstallAt, o.InstallAddress, imeis, plates,
                o.Warehouse ?? "—", o.StockEffectDisplay, o.Installer ?? "", o.ActivatedAt, o.Notes
            };
        });
        await ExcelExporter.DownloadAsync(JS, "danh-sach-don-hang", "Đơn hàng", headers, rows);
        message = $"Đã xuất file Excel (.xlsx) gồm {list.Count} đơn hàng.";
    }

    private void OpenOrderModal(long id)
    {
        selected = id;
        message = "";
        OnOrderSelected();
        showOrderModal = true;
    }

    private void CloseOrderModal() => showOrderModal = false;

    private Task QuickCancelOrder(long id) => Act(actor =>
    {
        selected = id;
        var curOrder = orders.FirstOrDefault(x => x.Id == id);
