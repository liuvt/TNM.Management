    private Task CreateRenewalSubmit() => Act(actor =>
    {
        var selectedDevs = SelectedRenewalDevicesList;
        if (selectedDevs.Count == 0)
            throw new InvalidOperationException("Vui lòng chọn ít nhất 1 thiết bị để lập Đơn gia hạn.");

        var drafts = selectedDevs.Select(sd =>
        {
            var autoP = QuoteSingleRenewalAutoPrice(sd);
            var curP = GetRenewCustomPrice(sd.ActivationId, autoP);
            return new V7RenewalLineDraft(
                sd.ActivationId,
                CustomPriceVnd: curP,
                CustomNewExpiry: renewExpiryMode == "MILESTONE" ? renewMilestoneDate.ToString("yyyy-MM-dd") : null);
        }).ToList();

        var pickedSeller = sellerChoices.FirstOrDefault(s => s.Id == renewSellerId);
        var (ordId, ordCode, renewedCnt, totalAmt) = Orders.CreateRenewalOrder(
            actor,
            renewTargetCustomerId > 0 ? renewTargetCustomerId : null,
            drafts,
            durationMonths: renewDurationMonths,
            milestoneExpiryDate: renewExpiryMode == "MILESTONE" ? renewMilestoneDate.ToString("yyyy-MM-dd") : null,
            sourceType: renewSourceType,
            paymentMethod: renewPaymentMethod,
            sellerRecordId: renewSellerId > 0 ? renewSellerId : null,
            saleSource: pickedSeller?.Name,
            renewedDate: renewOrderDate.ToString("yyyy-MM-dd"),
            notes: renewNotes);

        selectedRenewIds.Clear();
        renewCustomPrices.Clear();
        renewNotes = "";
        selected = ordId;
        showCreateModal = false;
        OnOrderSelected();
        return $"Đã hoàn thành Đơn gia hạn {ordCode} ({renewedCnt} thiết bị · Tổng {totalAmt:N0} ₫) — Đã cập nhật mốc hạn mới sang mục Thiết bị và sinh hóa đơn công nợ bên Kế toán.";
    });

