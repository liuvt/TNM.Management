@page "/sales-orders"
@page "/orders-v7"
@attribute [Authorize(Policy = Permissions.OrdersView)]
@inject V7Orders Orders
@inject InputCatalog Catalog
@inject DemoDb Db
@inject V6Ops Ops
@inject PermissionGate Gate
@inject NavigationManager Nav
@inject IJSRuntime JS
<PageTitle>Đơn hàng · TNM.Management</PageTitle>
<div class="page-head">
    <div>
        <div class="eyebrow">KINH DOANH / TRUNG TÂM ĐƠN HÀNG (LẮP ĐẶT · THƯƠNG MẠI · GIA HẠN)</div>
        <div class="page-title-with-help">
            <h1 style="margin:0">Đơn hàng</h1>
            <button type="button"
                    class="help-icon-btn"
                    data-confirm="none"
                    title="Hỗ trợ · Xem quy trình 3 loại Đơn hàng (Lắp đặt · Thương mại · Gia hạn)"
                    aria-label="Hỗ trợ quy trình Đơn hàng"
                    @onclick="() => showWorkflowHelp = true">
                <AppIcon Name="help" Size="17" />
            </button>
        </div>
    </div>
    <div class="button-group">
        @if(canViewLog)
        {
            <button type="button" class="btn secondary" data-confirm="none" @onclick="OpenModuleLog">
                📋 Xem log
            </button>
        }
        <button type="button" class="btn" data-confirm="none" @onclick='() => OpenCreateModalWithKind("INSTALL")'>
            + Tạo đơn hàng
        </button>
        <button type="button" class="btn secondary" data-confirm="none" @onclick='() => OpenCreateModalWithKind("COMMERCIAL")'>
            📦 + Đơn thương mại
        </button>
        <button type="button" class="btn secondary" data-confirm="none" @onclick='() => OpenCreateModalWithKind("RENEWAL")'>
            🔄 + Đơn gia hạn
        </button>
        <button type="button" class="btn secondary" data-confirm="none" @onclick="OpenQuickPasteModal">
            📋 Dán tin nhắn NVBH
        </button>
    </div>
</div>

@if(!string.IsNullOrEmpty(message))
{
    <p class="feedback" style="font-weight:600;padding:0.75rem 1rem;border-radius:8px;background:#eff6ff;border:1px solid #93c5fd;color:#1e3a8a;margin-bottom:14px">@message</p>
}

@if(showCreateModal)
{
    <div class="so-modal-backdrop" @onclick="CloseCreateModal">
        <div class="so-modal" style="max-width:1120px" @onclick:stopPropagation="true">
            <div class="so-modal-head">
                <div>
                    <div class="eyebrow">TẠO ĐƠN HÀNG MỚI · CHỌN 1 TRONG 3 LOẠI ĐƠN NGHIỆP VỤ</div>
                    <h2 style="margin:0.15rem 0 0 0">
                        @(createOrderKind == "RENEWAL"
                            ? "3/ Tạo Đơn gia hạn thiết bị (1T / 3T / 12T / Đánh mốc thời gian)"
                            : createOrderKind == "COMMERCIAL"
                                ? "2/ Tạo Đơn bán thương mại (Giá thương mại · Không tính công lắp)"
                                : "1/ Tạo Đơn lắp đặt & Điều phối kho / ĐV lắp đặt")
                    </h2>
                </div>
                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                    @if(createOrderKind != "RENEWAL")
                    {
                        <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => showQuickPaste = !showQuickPaste">
                            @(showQuickPaste ? "Ẩn dán tin nhắn" : "📋 Dán nhanh tin nhắn NV bán hàng")
                        </button>
                    }
                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="CloseCreateModal">✕ Đóng</button>
                </div>
            </div>

            <div class="so-modal-body">
                @* Bộ chọn 3 loại đơn hàng *@
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px;margin-bottom:1rem">
                    <button type="button"
                            data-confirm="none"
                            @onclick='() => SwitchCreateOrderKind("INSTALL")'
                            style="text-align:left;padding:11px 14px;border-radius:10px;cursor:pointer;border:2px solid @(createOrderKind == "INSTALL" ? "#2563eb" : "#cbd5e1");background:@(createOrderKind == "INSTALL" ? "#eff6ff" : "#ffffff")">
                        <div style="font-weight:800;font-size:0.95rem;color:@(createOrderKind == "INSTALL" ? "#1d4ed8" : "#0f172a")">🔧 1/ Đơn lắp đặt</div>
                        <div style="font-size:0.8rem;color:#475569;margin-top:3px">Điều phối Kho &amp; ĐV lắp đặt, áp <strong>Giá có lắp</strong> theo Nhóm KH (tự tính gói nhiều năm), kích hoạt IMEI.</div>
                    </button>
                    <button type="button"
                            data-confirm="none"
                            @onclick='() => SwitchCreateOrderKind("COMMERCIAL")'
                            style="text-align:left;padding:11px 14px;border-radius:10px;cursor:pointer;border:2px solid @(createOrderKind == "COMMERCIAL" ? "#d97706" : "#cbd5e1");background:@(createOrderKind == "COMMERCIAL" ? "#fffbeb" : "#ffffff")">
                        <div style="font-weight:800;font-size:0.95rem;color:@(createOrderKind == "COMMERCIAL" ? "#b45309" : "#0f172a")">📦 2/ Đơn bán thương mại</div>
                        <div style="font-size:0.8rem;color:#475569;margin-top:3px">Bán thiết bị sỉ / NCC tự đi lắp — tự động áp <strong>Giá thương mại</strong> &amp; <code>0 ₫</code> công kỹ thuật.</div>
                    </button>
                    <button type="button"
                            data-confirm="none"
                            @onclick='() => SwitchCreateOrderKind("RENEWAL")'
                            style="text-align:left;padding:11px 14px;border-radius:10px;cursor:pointer;border:2px solid @(createOrderKind == "RENEWAL" ? "#15803d" : "#cbd5e1");background:@(createOrderKind == "RENEWAL" ? "#f0fdf4" : "#ffffff")">
                        <div style="font-weight:800;font-size:0.95rem;color:@(createOrderKind == "RENEWAL" ? "#15803d" : "#0f172a")">🔄 3/ Đơn gia hạn</div>
                        <div style="font-size:0.8rem;color:#475569;margin-top:3px">Tra ngược Thiết bị đến hạn / thiếu đơn, chọn 1 hoặc nhiều xe, gia hạn <strong>1T / 3T / 12T</strong> hoặc <strong>đánh mốc ngày</strong>.</div>
                    </button>
                </div>

                @if(!string.IsNullOrEmpty(message))
                {
                    <p class="feedback" style="font-weight:600;padding:0.65rem 0.9rem;border-radius:8px;background:@(message.StartsWith("Lỗi:") ? "#fef2f2" : "#eff6ff");border:1px solid @(message.StartsWith("Lỗi:") ? "#fecaca" : "#93c5fd");color:@(message.StartsWith("Lỗi:") ? "#b91c1c" : "#1e3a8a");margin-bottom:0.85rem">@message</p>
                }

                @if(createOrderKind == "RENEWAL")
                {
                    var preDeclaredList = PreDeclaredDevices;
                    var needRenewList = ActiveDevicesForRenew.Where(d => DaysToDeviceExpiry(d) <= 30).ToList();
                    var noOrderNeedRenewList = ActiveDevicesForRenew.Where(d => !d.HasInstallOrder && DaysToDeviceExpiry(d) <= 30).ToList();
                    var filteredRenewCandidates = FilteredRenewalDevices;

                    @* Thống kê truy vấn ngược về Thiết bị *@
                    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px">
                        <button type="button" data-confirm="none" class="btn @(renewLookupTab == "DUE" ? "" : "secondary") btn-sm" @onclick='() => SetRenewLookupTab("DUE")'>
                            ⚠️ Hết hạn &amp; Sắp hết hạn ≤ 30 ngày (@needRenewList.Count)
                        </button>
                        <button type="button" data-confirm="none" class="btn @(renewLookupTab == "NO_ORDER_DUE" ? "" : "secondary") btn-sm" @onclick='() => SetRenewLookupTab("NO_ORDER_DUE")'>
                            📋 Không có đơn lắp nhưng hết hạn / đến hạn (@noOrderNeedRenewList.Count)
                        </button>
                        <button type="button" data-confirm="none" class="btn @(renewLookupTab == "ALL_ACTIVE" ? "" : "secondary") btn-sm" @onclick='() => SetRenewLookupTab("ALL_ACTIVE")'>
                            ✅ Tất cả thiết bị hoạt động (@ActiveDevicesForRenew.Count)
                        </button>
                        <button type="button" data-confirm="none" class="btn @(renewLookupTab == "PRE_DECLARED" ? "" : "secondary") btn-sm" @onclick='() => SetRenewLookupTab("PRE_DECLARED")'>
                            🆕 Xe chưa tạo Đơn lắp đặt (@preDeclaredList.Count)
                        </button>
                    </div>

                    @if(renewLookupTab == "PRE_DECLARED")
                    {
                        <div style="padding:12px;border:1px solid #bfdbfe;background:#eff6ff;border-radius:8px;margin-bottom:12px">
                            <div style="font-weight:700;color:#1e3a8a;margin-bottom:6px">🆕 Danh sách xe đã khai báo bên mục Thiết bị nhưng chưa tạo Đơn lắp đặt (@preDeclaredList.Count xe)</div>
                            @if(preDeclaredList.Count == 0)
                            {
                                <div style="font-size:0.86rem;color:#475569">Hiện không có xe nào đang chờ tạo Đơn lắp đặt.</div>
                            }
                            else
                            {
                                <div class="table-wrap" style="max-height:220px;overflow:auto">
                                    <table>
                                        <thead><tr><th>Biển số</th><th>Số khung</th><th>HTX / Khách hàng</th><th>Chủ xe &amp; SĐT</th><th>Dòng thiết bị</th><th>Thao tác</th></tr></thead>
                                        <tbody>
                                            @foreach(var pd in preDeclaredList)
                                            {
                                                <tr>
                                                    <td><strong>@(string.IsNullOrWhiteSpace(pd.Plate) ? "—" : pd.Plate)</strong></td>
                                                    <td>@(string.IsNullOrWhiteSpace(pd.VinNo) ? "—" : pd.VinNo)</td>
                                                    <td>@(string.IsNullOrWhiteSpace(pd.AgencyName) ? pd.Customer : pd.AgencyName)</td>
                                                    <td>@pd.OwnerName @(string.IsNullOrWhiteSpace(pd.OwnerPhone) ? "" : $"({pd.OwnerPhone})")</td>
                                                    <td>@(string.IsNullOrWhiteSpace(pd.DeviceTypeLabel) ? pd.Sku : pd.DeviceTypeLabel)</td>
                                                    <td>
                                                        <button type="button" class="btn btn-sm" data-confirm="none" @onclick="() => JumpPreDeclaredToInstallOrder(pd.ActivationId)">
                                                            → Tạo Đơn lắp đặt
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="padding:10px 12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;margin-bottom:12px">
                            <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:8px">
                                <select class="search-input" style="min-width:240px" @bind="renewFilterCustomerId" @bind:after="OnRenewFilterChanged">
                                    <option value="0">— Lọc theo HTX / Đại lý / Khách hàng (Tất cả) —</option>
                                    @foreach(var cu in customers)
                                    {
                                        <option value="@cu.Id">@cu.Code — @cu.B2BDisplayName @(string.IsNullOrWhiteSpace(cu.Group) || cu.Group == "-" ? "" : $"[{cu.Group}]")</option>
                                    }
                                </select>
                                <input class="search-input" style="flex:1;min-width:240px" @bind="renewDeviceSearch" @bind:event="oninput" placeholder="🔍 Tìm Biển số, Số khung, Số IMEI, HTX, Chủ xe, SĐT..." />
                                <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="SelectAllFilteredRenewDevices">
                                    ☑ Chọn các xe đang lọc (@Math.Min(filteredRenewCandidates.Count, 50))
                                </button>
                                @if(selectedRenewIds.Count > 0)
                                {
                                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="ClearSelectedRenewDevices">
                                        ✕ Bỏ chọn (@selectedRenewIds.Count)
                                    </button>
                                }
                            </div>

                            <div class="table-wrap" style="max-height:230px;overflow:auto">
                                <table>
                                    <thead>
                                        <tr>
                                            <th style="width:40px">Chọn</th>
                                            <th>Biển số &amp; Số khung</th>
                                            <th>Số IMEI &amp; Dòng TB</th>
                                            <th>HTX / Khách hàng &amp; Chủ xe</th>
                                            <th>Đơn lắp gốc</th>
                                            <th>Ngày hết hạn</th>
                                            <th>Giá GH chuẩn (12T)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if(filteredRenewCandidates.Count == 0)
                                        {
                                            <tr><td colspan="7" style="text-align:center;color:#64748b;padding:14px">Không có thiết bị nào khớp bộ lọc hiện tại.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach(var dv in filteredRenewCandidates.Take(80))
                                            {
                                                var isChecked = selectedRenewIds.Contains(dv.ActivationId);
                                                var remDays = DaysToDeviceExpiry(dv);
                                                <tr style="cursor:pointer;background:@(isChecked ? "#f0fdf4" : "transparent")" @onclick="() => ToggleRenewDevice(dv)">
                                                    <td @onclick:stopPropagation="true">
                                                        <input type="checkbox" checked="@isChecked" @onchange="e => SetRenewDeviceChecked(dv, e.Value is bool b && b)" />
                                                    </td>
                                                    <td>
                                                        <strong>@(string.IsNullOrWhiteSpace(dv.Plate) ? "Chưa có BS" : dv.Plate)</strong>
                                                        @if(!string.IsNullOrWhiteSpace(dv.VinNo))
                                                        {
                                                            <div><small style="color:#64748b">SK: @dv.VinNo</small></div>
                                                        }
                                                    </td>
                                                    <td>
                                                        <strong style="color:#0f766e">@dv.DisplayImei</strong>
                                                        <div><small>@(string.IsNullOrWhiteSpace(dv.DeviceTypeLabel) ? dv.Sku : dv.DeviceTypeLabel)</small></div>
                                                    </td>
                                                    <td class="wrap-cell">
                                                        <strong>@(string.IsNullOrWhiteSpace(dv.AgencyName) ? dv.Customer : dv.AgencyName)</strong>
                                                        @if(!string.IsNullOrWhiteSpace(dv.OwnerName))
                                                        {
                                                            <div><small>Chủ xe: @dv.OwnerName @(string.IsNullOrWhiteSpace(dv.OwnerPhone) ? "" : $"· {dv.OwnerPhone}")</small></div>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if(dv.HasInstallOrder)
                                                        {
                                                            <span class="chip blue-chip">@dv.OrderCode</span>
                                                        }
                                                        else
                                                        {
                                                            <small style="color:#64748b">Không có đơn lắp</small>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div><strong>@dv.ExpiresAt</strong></div>
                                                        <span class="chip @(remDays < 0 ? "orange-chip" : remDays <= 30 ? "purple-chip" : "green-chip")">
                                                            @(remDays < 0 ? $"Quá hạn {Math.Abs(remDays)} ngày" : $"Còn {remDays} ngày")
                                                        </span>
                                                    </td>
                                                    <td><strong style="color:#15803d">@dv.RenewalPriceVnd.ToString("N0") ₫</strong></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if(filteredRenewCandidates.Count > 80)
                            {
                                <small style="display:block;margin-top:4px;color:#64748b">Đang hiển thị 80/@filteredRenewCandidates.Count xe đầu tiên. Hãy chọn HTX hoặc gõ biển số / IMEI để lọc chính xác hơn.</small>
                            }
                        </div>

                        <div class="form-grid">
                            <label>Chế độ tính kỳ hạn gia hạn *
                                <select @bind="renewExpiryMode" @bind:after="RecalculateRenewalQuotes">
                                    <option value="PACKAGE">📦 Chọn gói nâng đơn (1 tháng / 3 tháng / 6 tháng / 12 tháng / 24 tháng)</option>
                                    <option value="MILESTONE">📅 Đánh mốc thời gian gia hạn (Ấn định ngày hết hạn mới cho thiết bị)</option>
                                </select>
                            </label>
                            @if(renewExpiryMode == "PACKAGE")
                            {
                                <label>Gói thời hạn gia hạn *
                                    <select @bind="renewDurationMonths" @bind:after="RecalculateRenewalQuotes">
                                        <option value="1">1 tháng (Ngắn hạn)</option>
                                        <option value="3">3 tháng (Theo quý)</option>
                                        <option value="6">6 tháng (Nửa năm)</option>
                                        <option value="12">12 tháng (1 năm chuẩn)</option>
                                        <option value="24">24 tháng (2 năm)</option>
                                    </select>
                                </label>
                            }
                            else
                            {
                                <label>Mốc thời gian hết hạn mới (Ghi nhận vào Thiết bị) *
                                    <input type="date" @bind="renewMilestoneDate" @bind:after="RecalculateRenewalQuotes" />
                                </label>
                            }

                            @if(canTransferOnRenew)
                            {
                                <label>Đơn vị / HTX / Khách hàng nhận hóa đơn (Chuyển đơn vị nếu đổi)
                                    <select @bind="renewTargetCustomerId" @bind:after="OnRenewTargetCustomerChanged">
                                        <option value="0">— Giữ nguyên HTX / Khách hàng hiện hành của xe —</option>
                                        @foreach(var cu in customers)
                                        {
                                            <option value="@cu.Id">@cu.Code — @cu.B2BDisplayName @(string.IsNullOrWhiteSpace(cu.Group) || cu.Group == "-" ? "" : $"[{cu.Group}]")</option>
                                        }
                                    </select>
                                </label>
                            }
                            <label>Nhân viên bán hàng phụ trách gia hạn (Tính hoa hồng) *
                                <select @bind="renewSellerId">
                                    <option value="0">— Chọn nhân viên bán hàng —</option>
                                    @foreach(var sl in sellerChoices)
                                    {
                                        <option value="@sl.Id">@sl.Code — @sl.Name</option>
                                    }
                                </select>
                            </label>
                            <label>Nguồn gia hạn
                                <select @bind="renewSourceType">
                                    <option value="TNM">Trường Nhật Minh</option>
                                    <option value="HTX">Hợp tác xã / Đại lý</option>
                                    <option value="NCC">Nhà cung cấp</option>
                                    <option value="B2C">Khách lẻ trực tiếp</option>
                                </select>
                            </label>
                            <label>Hình thức thanh toán
                                <select @bind="renewPaymentMethod">
                                    <option value="DEBT">Ghi công nợ (Tạo hóa đơn phải thu)</option>
                                    <option value="CASH">Thanh toán ngay (Tự sinh phiếu thu PT)</option>
                                </select>
                            </label>
                            <label>Ngày thực hiện gia hạn
                                <input type="date" @bind="renewOrderDate" @bind:after="RecalculateRenewalQuotes" />
                            </label>
                            <label>Ghi chú Đơn gia hạn
                                <input @bind="renewNotes" placeholder="VD: Gia hạn lô xe HTX tháng 11, chốt mốc đồng bộ..." />
                            </label>
                        </div>

                        @if(selectedRenewIds.Count > 0)
                        {
                            var selectedDevs = SelectedRenewalDevicesList;
                            var totalRenewVnd = SelectedRenewalTotalVnd;
                            <div style="margin-top:12px;border-top:1px solid #e2e8f0;padding-top:10px">
                                <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:8px">
                                    <h3 style="font-size:0.95rem;margin:0">Danh sách xe trong Đơn gia hạn (@selectedDevs.Count xe) · Cho phép chỉnh linh hoạt Đơn giá thực thu</h3>
                                    <div style="padding:6px 12px;background:#f0fdf4;border:1px solid #86efac;border-radius:8px;font-weight:800;color:#15803d">
                                        Giá Tổng Đơn gia hạn: @totalRenewVnd.ToString("N0") ₫
                                    </div>
                                </div>
                                <div class="table-wrap">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th>STT</th>
                                                <th>Biển số / Số khung</th>
                                                <th>Số IMEI &amp; Thiết bị</th>
                                                <th>Đơn vị hiện tại @(renewTargetCustomerId > 0 ? "→ Chuyển sang" : "")</th>
                                                <th>Hạn cũ → Mốc hạn mới</th>
                                                <th>Đơn giá gia hạn thực thu (VND)</th>
                                                <th>Xóa</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for(var i = 0; i < selectedDevs.Count; i++)
                                            {
                                                var sd = selectedDevs[i];
                                                var nextExpPreview = PreviewDeviceNextExpiry(sd);
                                                var autoQuote = QuoteSingleRenewalAutoPrice(sd);
                                                var curPrice = GetRenewCustomPrice(sd.ActivationId, autoQuote);
                                                var targetCustObj = renewTargetCustomerId > 0 ? customers.FirstOrDefault(c => c.Id == renewTargetCustomerId) : null;
                                                <tr>
                                                    <td><strong>@(i + 1)</strong></td>
                                                    <td>
                                                        <strong>@(string.IsNullOrWhiteSpace(sd.Plate) ? "—" : sd.Plate)</strong>
                                                        @if(!string.IsNullOrWhiteSpace(sd.VinNo))
                                                        {
                                                            <div><small style="color:#64748b">@sd.VinNo</small></div>
                                                        }
                                                    </td>
                                                    <td>
                                                        <strong>@sd.DisplayImei</strong>
                                                        <div><small>@(string.IsNullOrWhiteSpace(sd.DeviceTypeLabel) ? sd.Sku : sd.DeviceTypeLabel)</small></div>
                                                    </td>
                                                    <td>
                                                        <span>@(string.IsNullOrWhiteSpace(sd.AgencyName) ? sd.Customer : sd.AgencyName)</span>
                                                        @if(targetCustObj is not null && targetCustObj.Id != sd.CustomerId)
                                                        {
                                                            <div><strong style="color:#1d4ed8">→ @targetCustObj.Name</strong></div>
                                                        }
                                                    </td>
                                                    <td>
                                                        <small style="color:#64748b">@sd.ExpiresAt</small> → <strong style="color:#15803d">@nextExpPreview</strong>
                                                    </td>
                                                    <td style="min-width:175px">
                                                        <div style="display:flex;gap:4px;align-items:center">
                                                            <input type="number" min="0" step="1000" value="@curPrice" @onchange="e => SetRenewCustomPrice(sd.ActivationId, e.Value?.ToString())" style="font-weight:700;max-width:135px" />
                                                            @if(curPrice != autoQuote)
                                                            {
                                                                <button type="button" class="btn secondary btn-sm" title="Khôi phục giá chuẩn theo Nhóm KH" data-confirm="none" @onclick="() => ResetRenewCustomPrice(sd.ActivationId)">↺</button>
                                                            }
                                                            @if(selectedDevs.Count > 1 && i == 0)
                                                            {
                                                                <button type="button" class="btn secondary btn-sm" title="Áp mức giá này cho toàn bộ xe trong đơn" data-confirm="none" @onclick="() => ApplyRenewPriceToAllSelected(curPrice)">Áp tất cả</button>
                                                            }
                                                        </div>
                                                        <small style="color:#64748b">Giá chuẩn nhóm KH: @autoQuote.ToString("N0") ₫</small>
                                                    </td>
                                                    <td>
                                                        <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => SetRenewDeviceChecked(sd, false)">✕</button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    @* LUỒNG 1 (ĐƠN LẮP ĐẶT) & LUỒNG 2 (ĐƠN BÁN THƯƠNG MẠI) *@
                    @if(showQuickPaste)
                    {
                        <div style="margin-bottom:1rem;padding:0.85rem 1rem;background:#f0f9ff;border:1px solid #bae6fd;border-left:4px solid #0284c7;border-radius:8px">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem">
                                <div>
                                    <strong style="color:#0369a1">📋 Dán nhanh thông tin đơn từ nhân viên bán hàng gửi về</strong>
                                    <div style="font-size:0.82rem;color:#475569">Dán nguyên nội dung tin nhắn của nhân viên bán hàng để tự động điền vào form tạo đơn.</div>
                                </div>
                            </div>
                            <div class="form-grid one">
                                <label>Nội dung tin nhắn nhân viên bán hàng
                                    <textarea @bind="sellerRawText" rows="5" placeholder="HTX Nam Hi&#10;Thông tin khách &#10;   - Họ tên khách: Lâm Hằng ( xe Đỗ Văn Hội)&#10;   - Số điện thoại khách: 0886287429&#10;Thông tin lắp đặt: &#10;   - Số lượng lắp: 1&#10;   - Thời hạn: 1 năm &#10;   - Địa chỉ lắp: 55 đường 30/4&#10;   - Thời gian lắp: 15g00 thứ 3 ( 20/10/2026)"></textarea>
                                </label>
                            </div>
                            <div style="display:flex;gap:8px;margin-top:0.5rem">
                                <button type="button" class="btn btn-sm" data-confirm="none" @onclick="ParseSellerText">Tự động điền vào đơn hàng</button>
                                <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="FillSampleSellerText">Điền mẫu thử nghiệm</button>
                            </div>
                        </div>
                    }

                    @if(createOrderKind == "INSTALL" && PreDeclaredDevices.Count > 0)
                    {
                        <div style="margin-bottom:0.9rem;padding:0.75rem 1rem;background:#eff6ff;border:1px solid #93c5fd;border-radius:8px">
                            <label style="margin:0;font-weight:700;color:#1e3a8a">
                                🆕 Chọn nhanh Xe đã khai báo sẵn bên Thiết bị (Chưa có đơn lắp đặt: @PreDeclaredDevices.Count xe)
                                <select value="@pickedPreDeclaredActivationId" @onchange="OnPickPreDeclaredVehicle" style="margin-top:4px;background:#fff">
                                    <option value="0">— Không chọn (Nhập xe / khách lắp mới bình thường) —</option>
                                    @foreach(var pd in PreDeclaredDevices)
                                    {
                                        <option value="@pd.ActivationId">
                                            @(string.IsNullOrWhiteSpace(pd.Plate) ? "Chưa có BS" : pd.Plate) @(string.IsNullOrWhiteSpace(pd.VinNo) ? "" : $"| SK: {pd.VinNo}") — @(string.IsNullOrWhiteSpace(pd.AgencyName) ? pd.Customer : pd.AgencyName) @(string.IsNullOrWhiteSpace(pd.OwnerName) ? "" : $"· Chủ xe: {pd.OwnerName}") [@(string.IsNullOrWhiteSpace(pd.DeviceTypeLabel) ? pd.Sku : pd.DeviceTypeLabel)]
                                        </option>
                                    }
                                </select>
                            </label>
                        </div>
                    }

                    <div class="form-grid">
                        <label>Đơn vị / Khách hàng (HTX / Đại lý / Khách lẻ) *
                            <select @bind="customer" @bind:after="OnCustomerChanged">
                                <option value="0">— Chọn Đơn vị / Khách hàng —</option>
                                @foreach(var x in customers)
                                {
                                    <option value="@x.Id">@x.Code — @x.B2BDisplayName @(string.IsNullOrWhiteSpace(x.Group) || x.Group == "-" ? "" : $"[{x.Group}]")</option>
                                }
                            </select>
                        </label>
                        <label>Tra nhanh ĐV/KH theo SĐT đăng ký
                            <select @bind="customer" @bind:after="OnCustomerChanged">
                                <option value="0">— Chọn theo SĐT ĐV/KH —</option>
                                @foreach(var x in customers)
                                {
                                    <option value="@x.Id">@(string.IsNullOrWhiteSpace(x.Phone) ? $"Chưa có SĐT ({x.Code} - {x.Name})" : $"{x.Phone} — {x.Name}")</option>
                                }
                            </select>
                        </label>
                        <label>@(createOrderKind == "COMMERCIAL" ? "Người nhận hàng / Người liên hệ" : "Họ tên khách lắp (Chủ xe / Người liên hệ) *")
                            <input @bind="contactName" placeholder="VD: Lâm Hằng (xe Đỗ Văn Hội)" />
                        </label>
                        <label>@(createOrderKind == "COMMERCIAL" ? "Số điện thoại nhận hàng" : "Số điện thoại khách lắp *")
                            <input @bind="customerPhone" placeholder="VD: 0886287429" />
                        </label>
                        @if(createOrderKind == "INSTALL")
                        {
                            <label>Thời hạn gói lắp đặt (Tự tính chuẩn Giá Tổng) *
                                <select @bind="durationMonths" @bind:after="OnInstallDurationChanged">
                                    <option value="12">1 năm (12 tháng chuẩn)</option>
                                    <option value="24">2 năm (24 tháng = Giá lắp 12T + 1 năm GH)</option>
                                    <option value="36">3 năm (36 tháng = Giá lắp 12T + 2 năm GH)</option>
                                    <option value="6">6 tháng (Ngắn hạn)</option>
                                </select>
                            </label>
                            <label>Thời gian hẹn lắp đặt *
                                <div style="display:flex;gap:0.4rem;align-items:center">
                                    <input value="@installAtText" @onchange="OnInstallAtChanged" placeholder="VD: dd/MM/yyyy HH:mm" style="flex:1;font-weight:600" />
                                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="SetInstallAtNow">Hiện tại</button>
                                </div>
                            </label>
                        }
                        else
                        {
                            <label>Thời hạn kích hoạt dịch vụ đi kèm
                                <select @bind="durationMonths">
                                    <option value="12">1 năm (12 tháng)</option>
                                    <option value="24">2 năm (24 tháng)</option>
                                    <option value="6">6 tháng</option>
                                </select>
                            </label>
                            <label>Ngày xuất bán / Kích hoạt
                                <input type="date" @bind="commercialActivatedDate" />
                            </label>
                        }
                        <label>@(createOrderKind == "COMMERCIAL" ? "Địa chỉ giao hàng" : "Địa chỉ lắp đặt *")
                            <input @bind="address" placeholder="VD: 55 đường 30/4..." />
                        </label>
                        <label>Nhân viên bán hàng *
                            <select @bind="createSellerId" @bind:after="OnCreateSellerChanged">
                                <option value="0">— Chọn nhân viên bán hàng —</option>
                                @foreach(var sl in sellerChoices)
                                {
                                    <option value="@sl.Id">@sl.Code — @sl.Name</option>
                                }
                            </select>
                        </label>
                        <label>Ghi chú đơn hàng
                            <input @bind="notes" placeholder="Ghi chú giao hàng / lắp đặt / thanh toán..." />
                        </label>
                        <label class="checkbox-row">
                            <input type="checkbox" @bind="cod" /> Thu hộ tiền mặt (COD)
                        </label>
                    </div>

                    @if(SelectedCustomer is not null)
                    {
                        <div style="margin-top:0.75rem;padding:0.65rem 0.9rem;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;display:flex;flex-wrap:wrap;gap:1rem;align-items:center;font-size:0.9rem">
                            <div><strong>Mã KH:</strong> @SelectedCustomer.Code</div>
                            <div><strong>Đơn vị / KH:</strong> @SelectedCustomer.B2BDisplayName</div>
                            <div><strong>Nhóm giá áp dụng:</strong> <span class="chip blue-chip">@SelectedCustomer.Group</span></div>
                            <div>
                                <strong>Chế độ giá:</strong>
                                <span class="chip @(EffectiveCreateNoInstallFee ? "orange-chip" : "green-chip")">
                                    @(EffectiveCreateNoInstallFee ? "Giá bán thương mại · Công lắp = 0 ₫" : $"Giá có lắp đặt ({durationMonths} tháng)")
                                </span>
                            </div>
                        </div>
                    }

                    <div style="margin-top:1rem;border-top:1px solid #e2e8f0;padding-top:0.85rem">
                        <h3 style="font-size:0.95rem;margin-bottom:0.5rem">
                            @(createOrderKind == "COMMERCIAL" ? "Kho xuất hàng hoặc Nhà cung cấp đi lắp (Không tính công lắp TNM)" : "Điều sản phẩm ở kho & Chọn ĐV lắp đặt | Hãng lắp đặt")
                        </h3>
                        <div class="form-grid">
                            <label>Kho xuất sản phẩm *
                                <select @bind="createWarehouse">
                                    <option value="0">— Chưa chọn kho (duyệt sau) —</option>
                                    @foreach(var w in warehouses)
                                    {
                                        <option value="@w.Id">@w.Name (@w.Code)</option>
                                    }
                                </select>
                            </label>
                            <label>@(createOrderKind == "COMMERCIAL" ? "Nguồn xuất thiết bị *" : "Phân loại Đơn vị lắp đặt *")
                                <select value="@createSource" @onchange="OnCreateSourceChanged">
                                    <option value="INTERNAL">@(createOrderKind == "COMMERCIAL" ? "Xuất từ Kho nội bộ TNM (Trừ tồn kho)" : "ĐV lắp đặt (Nội bộ / CTV / Đại lý — Trừ tồn kho)")</option>
                                    <option value="PARTNER">@(createOrderKind == "COMMERCIAL" ? "Nhà cung cấp / Hãng giao & đi lắp (Cho phép Không trừ kho)" : "Hãng lắp đặt (Cho phép tick Không trừ tồn kho)")</option>
                                </select>
                            </label>
                            @if(createSource == "INTERNAL" && createOrderKind == "INSTALL")
                            {
                                <label>Chọn ĐV lắp đặt (đã khai báo)
                                    <select @bind="createInstallerEmpId" @bind:after="OnCreateInstallerEmpChanged">
                                        <option value="0">— Chọn ĐV lắp đặt hoặc nhập tên bên cạnh —</option>
                                        @foreach(var emp in installers)
                                        {
                                            <option value="@emp.Id">@emp.Code — @emp.Name (@emp.Department)</option>
                                        }
                                    </select>
                                </label>
                                <label>Tên ĐV lắp đặt
                                    <input @bind="createInstallerName" placeholder="Tên kỹ thuật / ĐV lắp đặt..." />
                                </label>
                            }
                            else if(createSource == "PARTNER")
                            {
                                <label>Chọn nhanh Nhà cung cấp / Hãng
                                    <select @onchange="OnCreateManufacturerPick">
                                        <option value="">— Chọn NCC / Hãng hoặc nhập tên bên cạnh —</option>
                                        @foreach(var s in suppliers)
                                        {
                                            <option value="@s.Name">Hãng/NCC: @s.Name</option>
                                        }
                                    </select>
                                </label>
                                <label>Tên Nhà cung cấp / Hãng *
                                    <input @bind="createInstallerName" placeholder="Nhập tên NCC / Hãng..." />
                                </label>
                            }

                            @if(createOrderKind == "INSTALL")
                            {
                                <label class="checkbox-row" style="padding:0.5rem 0.75rem;background:@(createNoInstallFee ? "#fff7ed" : "#eff6ff");border:1px solid @(createNoInstallFee ? "#fdba74" : "#93c5fd");border-radius:8px">
                                    <input type="checkbox" @bind="createNoInstallFee" />
                                    <span>
                                        <strong>Không tính công lắp (Áp Giá thương mại)</strong>
                                        <small style="display:block;color:#475569">Tích nếu đơn lắp đặt này miễn tính công kỹ thuật (0 ₫).</small>
                                    </span>
                                </label>
                            }
                            <label class="checkbox-row" style="padding:0.5rem 0.75rem;background:@(createNoDeductStock ? "#fff7ed" : "#f0fdf4");border:1px solid @(createNoDeductStock ? "#fdba74" : "#86efac");border-radius:8px">
                                <input type="checkbox" checked="@createNoDeductStock" @onchange="OnCreateNoDeductChanged" />
                                <span>
                                    <strong>Không trừ tồn kho</strong>
                                    <small style="display:block;color:#475569">
                                        @(createNoDeductStock
                                            ? "Đang bật KHÔNG TRỪ TỒN KHO (Áp dụng khi Nhà cung cấp / Hãng trực tiếp xuất & lắp)."
                                            : "Mặc định: TRỪ TỒN KHO khi hoàn thành đơn.")
                                    </small>
                                </span>
                            </label>
                        </div>
                    </div>

                    <div style="margin-top:1rem;border-top:1px solid #e2e8f0;padding-top:0.85rem">
                        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:0.5rem">
                            <h3 style="font-size:0.95rem;margin:0">Danh sách sản phẩm &amp; Đơn giá bán linh hoạt</h3>
                            @if(CurrentDraftTotalVnd > 0)
                            {
                                <div style="padding:5px 12px;background:#eff6ff;border:1px solid #93c5fd;border-radius:8px;font-weight:800;color:#1d4ed8">
                                    Giá Tổng Đơn hàng: @CurrentDraftTotalVnd.ToString("N0") ₫
                                </div>
                            }
                        </div>
                        <div class="form-grid">
                            <label style="grid-column:span 2">Chọn sản phẩm thêm vào đơn *
                                <select @bind="product" @bind:after="OnDraftProductPickChanged">
                                    <option value="0">— Chọn sản phẩm —</option>
                                    @foreach(var x in products)
                                    {
                                        <option value="@x.Id">@x.Sku — @x.Name @(x.Kind == "GOODS" ? $"[Tồn kho: {x.StockInHand:N0}]" : "[Dịch vụ]") @(x.IsSerialized ? "(Có IMEI)" : "")</option>
                                    }
                                </select>
                            </label>
                            <label>Số lượng *
                                <input type="number" min="1" max="100" @bind="draftQty" />
                            </label>
                            <label>Đơn giá bán (VND · Có thể sửa)
                                <input type="number" min="0" step="1000" value="@EffectivePendingDraftPrice" @onchange="e => OnPendingDraftPriceEdited(e.Value?.ToString())" style="font-weight:700" />
                            </label>
                            <div style="display:flex;align-items:flex-end">
                                <button type="button" class="btn secondary" data-confirm="none" @onclick="AddDraftLine">+ Thêm SP vào đơn</button>
                            </div>
                        </div>

                        @if(draftLines.Count > 0)
                        {
                            var pagedDrafts = draftPager.Slice(draftLines.Select((item, idx) => (Idx: idx, Item: item)), out var totalDrafts);
                            <div class="table-wrap" style="margin-top:0.75rem">
                                <table>
                                    <thead><tr><th>STT</th><th>Mã SP</th><th>Tên sản phẩm</th><th>Tồn kho</th><th>Xe liên kết / Biển số</th><th>Đơn giá bán (Cho phép chỉnh)</th><th>Số lượng</th><th>Thành tiền</th><th>Thao tác</th></tr></thead>
                                    <tbody>
                                        @foreach(var (stt, entry) in pagedDrafts)
                                        {
                                            var idx = entry.Idx;
                                            var item = entry.Item;
                                            var p = products.FirstOrDefault(x => x.Id == item.ProductId);
                                            var autoPrice = Orders.PreviewUnitPrice(customer, item.ProductId, includeInstallPrice: !EffectiveCreateNoInstallFee, durationMonths: EffectiveCreateNoInstallFee ? 12 : durationMonths);
                                            var unitPrice = item.CustomUnitPrice ?? autoPrice;
                                            <tr>
                                                <td><strong>@stt</strong></td>
                                                <td><strong>@(p?.Sku ?? "—")</strong></td>
                                                <td>@(p?.Name ?? "—")</td>
                                                <td>
                                                    @if(p?.Kind == "GOODS")
                                                    {
                                                        <span class="chip @(p.StockInHand >= item.Quantity ? "green-chip" : "orange-chip")">Tồn: @p.StockInHand.ToString("N0")</span>
                                                    }
                                                    else
                                                    {
                                                        <span>—</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if(item.TargetActivationId is > 0)
                                                    {
                                                        <span class="chip blue-chip">🆕 Xe khai báo sẵn: @(string.IsNullOrWhiteSpace(item.PlateNo) ? $"#{item.TargetActivationId}" : item.PlateNo)</span>
                                                    }
                                                    else
                                                    {
                                                        <input value="@item.PlateNo" @onchange="e => UpdateDraftPlate(idx, e.Value?.ToString())" placeholder="Biển số (nếu có)" style="max-width:130px" />
                                                    }
                                                </td>
                                                <td style="min-width:170px">
                                                    <div style="display:flex;gap:4px;align-items:center">
                                                        <input type="number" min="0" step="1000" value="@unitPrice" @onchange="e => UpdateDraftCustomPrice(idx, e.Value?.ToString())" style="font-weight:700;max-width:135px" />
                                                        @if(item.CustomUnitPrice.HasValue && item.CustomUnitPrice.Value != autoPrice)
                                                        {
                                                            <button type="button" class="btn secondary btn-sm" title="Khôi phục đơn giá chuẩn nhóm KH" data-confirm="none" @onclick="() => ResetDraftCustomPrice(idx)">↺</button>
                                                        }
                                                    </div>
                                                    <small style="color:#64748b">Chuẩn nhóm KH: @autoPrice.ToString("N0") ₫</small>
                                                </td>
                                                <td style="max-width:95px">
                                                    <input type="number" min="1" max="100" value="@item.Quantity" disabled="@(item.TargetActivationId is > 0)" @onchange="e => UpdateDraftQty(idx, e.Value)" />
                                                </td>
                                                <td><strong style="color:#0284c7">@((unitPrice * item.Quantity).ToString("N0")) ₫</strong></td>
                                                <td>
                                                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => RemoveDraftLine(idx)">Xóa</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <TablePager Pager="draftPager" TotalCount="totalDrafts" OnChange="StateHasChanged" />
                        }
                        else
                        {
                            <p class="panel-note" style="margin-top:0.5rem">Mẹo: Chọn sản phẩm ở trên (hệ thống tự thêm khi bấm Tạo đơn, hoặc bấm <strong>“+ Thêm SP vào đơn”</strong> nếu đơn có nhiều mặt hàng).</p>
                        }
                    </div>
                }
            </div>

            <div class="so-modal-footer">
                @if(createOrderKind == "RENEWAL")
                {
                    <button class="btn"
                            disabled="@(selectedRenewIds.Count == 0)"
                            data-confirm="add"
                            data-confirm-title="Xác nhận Lập & Hoàn thành Đơn gia hạn"
                            data-confirm-msg="@($"Bạn có chắc chắn muốn lập Đơn gia hạn cho {selectedRenewIds.Count} thiết bị với tổng số tiền {SelectedRenewalTotalVnd:N0} ₫, tự động cập nhật mốc hạn mới sang Thiết bị và ghi nhận hóa đơn bên Kế toán không?")"
                            @onclick="CreateRenewalSubmit">
                        🔄 Hoàn thành Đơn gia hạn (@selectedRenewIds.Count xe · @SelectedRenewalTotalVnd.ToString("N0") ₫)
                    </button>
                }
                else if(createOrderKind == "COMMERCIAL")
                {
                    <div style="display:flex;gap:8px;flex-wrap:wrap">
                        <button class="btn"
                                data-confirm="add"
                                data-confirm-title="Xác nhận Tạo & Hoàn thành ngay Đơn thương mại"
                                data-confirm-msg="Bạn có chắc chắn muốn tạo và hoàn thành ngay Đơn bán thương mại (áp Giá thương mại, không tính công lắp, ghi nhận doanh thu ngay) không?"
                                @onclick="() => CreateOrderSubmit(completeImmediately: true)">
                            ✓ Tạo &amp; Hoàn thành Đơn thương mại ngay
                        </button>
                        <button type="button"
                                class="btn secondary"
                                data-confirm="add"
                                data-confirm-title="Xác nhận Lưu Đơn bán thương mại chờ xuất"
                                data-confirm-msg="Lưu Đơn bán thương mại ở trạng thái chờ xuất kho / chờ nhập IMEI?"
                                @onclick="() => CreateOrderSubmit(completeImmediately: false)">
                            + Lưu đơn chờ xuất hàng
                        </button>
                    </div>
                }
                else
                {
                    <button class="btn"
                            data-confirm="add"
                            data-confirm-title="Xác nhận Tạo Đơn lắp đặt"
                            data-confirm-msg="Bạn có chắc chắn muốn tạo Đơn lắp đặt mới với các thông tin và đơn giá đã kiểm tra không?"
                            @onclick="() => CreateOrderSubmit(completeImmediately: false)">
                        + Tạo Đơn lắp đặt (@CurrentDraftTotalVnd.ToString("N0") ₫)
                    </button>
                }
                <button type="button" class="btn secondary" data-confirm="none" @onclick="CloseCreateModal">Đóng</button>
            </div>
        </div>
    </div>
}

<section class="panel">
    <div class="panel-head">
        <div>
            <h2>Danh sách Đơn hàng</h2>
            <p>Đang hiển thị <strong>@FilteredOrders.Count</strong> / @orders.Count đơn hàng · Tổng doanh thu danh sách lọc: <strong style="color:#0284c7">@FilteredOrders.Where(x => x.Status != "CANCELLED").Sum(x => x.Price).ToString("N0") ₫</strong>.</p>
        </div>
        <div class="button-group">
            <button type="button" class="btn" data-confirm="none" @onclick='() => OpenCreateModalWithKind("INSTALL")'>+ Tạo đơn hàng</button>
            <button type="button" class="btn secondary" data-confirm="none" @onclick="ExportOrdersExcel">📥 Xuất Excel (@FilteredOrders.Count)</button>
        </div>
    </div>

    @* Tabs lọc nhanh 3 loại đơn hàng *@
    <div class="tabs" style="margin-bottom:10px">
        <button type="button" class="@(soKindFilter == "ALL" ? "selected" : "")" @onclick='() => SetOrderKindFilter("ALL")'>
            Tất cả đơn (@orders.Count)
        </button>
        <button type="button" class="@(soKindFilter == "INSTALL" ? "selected" : "")" @onclick='() => SetOrderKindFilter("INSTALL")'>
            🔧 1/ Đơn lắp đặt (@orders.Count(x => x.OrderKind == "INSTALL"))
        </button>
        <button type="button" class="@(soKindFilter == "COMMERCIAL" ? "selected" : "")" @onclick='() => SetOrderKindFilter("COMMERCIAL")'>
            📦 2/ Đơn bán thương mại (@orders.Count(x => x.OrderKind == "COMMERCIAL"))
        </button>
        <button type="button" class="@(soKindFilter == "RENEWAL" ? "selected" : "")" @onclick='() => SetOrderKindFilter("RENEWAL")'>
            🔄 3/ Đơn gia hạn (@orders.Count(x => x.OrderKind == "RENEWAL"))
        </button>
    </div>

    @{
        var kindScopedOrders = soKindFilter == "ALL" ? orders : orders.Where(x => x.OrderKind == soKindFilter).ToList();
    }
    <div class="device-summary-bar" style="margin-bottom:12px">
        <button type="button" class="device-summary-item total @(soStatusFilter == "ALL" ? "active" : "")" @onclick='() => SetOrderStatusFilter("ALL")'>
            <span>Tổng theo phân loại:</span>
            <strong>@kindScopedOrders.Count</strong>
        </button>
        <button type="button" class="device-summary-item @(soStatusFilter == "PROCESSING" ? "active" : "")" @onclick='() => SetOrderStatusFilter("PROCESSING")'>
            <span>Đang xử lý / Chờ xuất:</span>
            <strong class="text-blue">@kindScopedOrders.Count(x => x.Status is "PENDING" or "APPROVED" or "DISPATCHED" or "REPORTED")</strong>
        </button>
        <button type="button" class="device-summary-item @(soStatusFilter == "COMPLETED" ? "active" : "")" @onclick='() => SetOrderStatusFilter("COMPLETED")'>
            <span>Đã hoàn thành:</span>
            <strong class="text-green">@kindScopedOrders.Count(x => x.Status == "COMPLETED")</strong>
        </button>
        <button type="button" class="device-summary-item warn @(soStatusFilter == "MISSING_IMEI" ? "active" : "")" @onclick='() => SetOrderStatusFilter("MISSING_IMEI")'>
            <span>Chờ bổ sung IMEI:</span>
            <strong class="text-orange">@kindScopedOrders.Count(x => x.IsImmutable && x.HasMissingImei)</strong>
        </button>
        <button type="button" class="device-summary-item muted @(soStatusFilter == "CANCELLED" ? "active" : "")" @onclick='() => SetOrderStatusFilter("CANCELLED")'>
            <span>Đã hủy:</span>
            <strong>@kindScopedOrders.Count(x => x.Status == "CANCELLED")</strong>
        </button>
    </div>

    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px;padding:10px 12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px">
        <input class="search-input" style="flex:1;min-width:260px" @bind="soSearch" @bind:event="oninput" @bind:after="() => orderPager.Reset()" placeholder="🔍 Tìm Mã đơn (SO7 / TM7 / GH7), HTX/KH, Chủ xe, SĐT, IMEI, Biển số, Sản phẩm, NV bán hàng..." />
        <select class="search-input" style="min-width:175px" @bind="soStatusFilter" @bind:after="() => orderPager.Reset()">
            <option value="ALL">— Mọi trạng thái (@kindScopedOrders.Count) —</option>
            <option value="PROCESSING">Đang xử lý / Chờ hoàn thành</option>
            <option value="PENDING">1. Chờ điều phối / Chờ xuất</option>
            <option value="DISPATCHED">2. Đang đi lắp / Đang giao</option>
            <option value="REPORTED">3. Đã báo số IMEI</option>
            <option value="COMPLETED">4. Đã hoàn thành</option>
            <option value="MISSING_IMEI">⚠️ Đã hoàn thành (Chờ bổ sung IMEI)</option>
            <option value="CANCELLED">✕ Đã hủy đơn</option>
        </select>
        <select class="search-input" style="min-width:190px" @bind="soCustomerFilter" @bind:after="() => orderPager.Reset()">
            <option value="">— Tất cả Đơn vị / KH —</option>
            @foreach(var c in customers)
            {
                <option value="@c.Code">@c.Code — @c.B2BDisplayName</option>
            }
        </select>
        <select class="search-input" style="min-width:175px" @bind="soSellerFilter" @bind:after="() => orderPager.Reset()">
            <option value="">— Tất cả NV bán hàng —</option>
            @foreach(var sl in sellerChoices)
            {
                <option value="@sl.Name">@sl.Code — @sl.Name</option>
            }
        </select>
        <select class="search-input" style="min-width:165px" @bind="soWarehouseFilter" @bind:after="() => orderPager.Reset()">
            <option value="0">— Tất cả Kho —</option>
            @foreach(var w in warehouses)
            {
                <option value="@w.Id">@w.Name (@w.Code)</option>
            }
        </select>
        @if(HasActiveOrderFilter)
        {
            <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="ClearOrderFilters">Xóa lọc</button>
        }
    </div>

    @{ var pagedOrders = orderPager.Slice(FilteredOrders, out var totalOrders); }
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Mã &amp; Loại đơn</th>
                    <th>Đơn vị (HTX/ĐL) &amp; Khách / Chủ xe</th>
                    <th class="col-detail-only">Nhân viên bán hàng</th>
                    <th>SL &amp; Thời hạn</th>
                    <th class="col-detail-only">Chi tiết mặt hàng &amp; Danh sách IMEI / Hạn</th>
                    <th>Tổng tiền</th>
                    <th>Thời gian &amp; Địa chỉ / Ghi chú</th>
                    <th>Trạng thái</th>
                    <th>Kho &amp; Tồn kho</th>
                    <th>ĐV lắp | Nguồn</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var (stt, o) in pagedOrders)
                {
                    <tr style="@(o.Id == selected ? "background:#f0f9ff" : "")" @ondblclick="() => OpenOrderModal(o.Id)">
                        <td><strong>@stt</strong></td>
                        <td>
                            <div><strong>@o.Code</strong></div>
                            <span class="chip @(o.OrderKind == "RENEWAL" ? "green-chip" : o.OrderKind == "COMMERCIAL" ? "orange-chip" : "blue-chip")" style="margin-top:2px">
                                @o.OrderKindDisplay
                            </span>
                            @if(o.IsImmutable)
                            {
                                @if(o.HasMissingImei)
                                {
                                    <div><small style="color:#d97706;font-weight:700">Chờ nhập @o.MissingImeiCount IMEI</small></div>
                                }
                                @if(o.IsAccountingLocked)
                                {
                                    <div><small style="color:#6366f1;font-weight:600">🔒 Đã chốt số</small></div>
                                }
                            }
                        </td>
                        <td class="wrap-cell">
                            <div><strong>@o.CustomerB2BDisplay</strong> @(!string.IsNullOrWhiteSpace(o.CustomerCode) ? $"({o.CustomerCode})" : "")</div>
                            @if(!string.IsNullOrWhiteSpace(o.ContactName))
                            {
                                <div><small style="color:#0284c7;font-weight:600">Chủ xe / LH: @o.ContactName</small></div>
                            }
                            <small>SĐT: @(string.IsNullOrWhiteSpace(o.CustomerPhone) ? "—" : o.CustomerPhone)</small>
                        </td>
                        <td class="col-detail-only">
                            @if(!string.IsNullOrWhiteSpace(o.SaleSource))
                            {
                                <span class="chip blue-chip">@o.SaleSource</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>
                            <div><strong>@(o.Lines is { Count: > 0 } ? o.Lines.Sum(l => l.Quantity) : 1) @(o.OrderKind == "RENEWAL" ? "xe" : "SP")</strong></div>
                            <span class="chip">Thời hạn: @o.DurationDisplay</span>
                        </td>
                        <td class="col-detail-only">
                            @if (o.Lines is { Count: > 0 })
                            {
                                var hasOrdImei = o.Lines.Any(l => !string.IsNullOrWhiteSpace(l.Imei) || !string.IsNullOrWhiteSpace(l.PlateNo));
                                var isRenOrd = o.OrderKind == "RENEWAL";
                                <div class="tnm-mini-table-host">
                                    <table class="tnm-mini-table">
                                        <thead>
                                            <tr>
                                                <th data-col="stt" style="width:42px">STT</th>
                                                <th data-col="sku" data-col-label="Mã SP">MÃ SP</th>
                                                <th data-col="name" data-col-label="Tên sản phẩm">TÊN SẢN PHẨM</th>
                                                @if (hasOrdImei)
                                                {
                                                    <th data-col="note" data-col-label="Số IMEI &amp; Biển số">SỐ IMEI &amp; BIỂN SỐ</th>
                                                }
                                                @if (isRenOrd)
                                                {
                                                    <th data-col="exp" data-col-label="Mốc gia hạn">HẠN CŨ → HẠN MỚI</th>
                                                }
                                                <th data-col="qty" data-col-label="Số lượng" class="num">SL</th>
                                                <th data-col="price" data-col-label="Đơn giá" class="num">ĐƠN GIÁ</th>
                                                <th data-col="total" data-col-label="Thành tiền" class="num">THÀNH TIỀN</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (var li = 0; li < o.Lines.Count; li++)
                                            {
                                                var ln = o.Lines[li];
                                                <tr>
                                                    <td data-col="stt"><strong>@(li + 1)</strong></td>
                                                    <td data-col="sku"><span class="chip blue-chip">@ln.ProductSku</span></td>
                                                    <td data-col="name" class="wrap-cell"><strong>@ln.ProductName</strong></td>
                                                    @if (hasOrdImei)
                                                    {
                                                        <td data-col="note" class="wrap-cell">
                                                            @if (!string.IsNullOrWhiteSpace(ln.Imei))
                                                            {
                                                                <strong style="color:#0f766e">@ln.Imei</strong>
                                                            }
                                                            else
                                                            {
                                                                <span style="color:#94a3b8">Chưa nhập IMEI</span>
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(ln.PlateNo))
                                                            {
                                                                <span> · BS: <strong>@ln.PlateNo</strong></span>
                                                            }
                                                        </td>
                                                    }
                                                    @if (isRenOrd)
                                                    {
                                                        <td data-col="exp"><small>@ln.PrevExpiry</small> → <strong style="color:#15803d">@ln.NewExpiry</strong></td>
                                                    }
                                                    <td data-col="qty" class="num"><strong>@ln.Quantity</strong></td>
                                                    <td data-col="price" class="num">@ln.UnitPrice.ToString("N0") ₫</td>
                                                    <td data-col="total" class="num"><strong style="color:#0284c7">@((ln.Quantity * ln.UnitPrice).ToString("N0")) ₫</strong></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div>@o.Product</div>
                            }
                        </td>
                        <td>
                            <div><strong>@o.Price.ToString("N0") ₫</strong></div>
                            <span class="chip @(o.OrderKind == "RENEWAL" ? "green-chip" : o.NoInstallFee || o.OrderKind == "COMMERCIAL" ? "orange-chip" : "blue-chip")" style="margin-top:2px">@o.InstallPriceModeDisplay</span>
                            @if(o.CostSnapshot > 0)
                            {
                                <div><small style="color:#64748b">Giá vốn: @o.CostSnapshot.ToString("N0") ₫</small></div>
                            }
                        </td>
                        <td class="wrap-cell">
                            <div><strong>@(string.IsNullOrWhiteSpace(o.InstallAt) ? "—" : o.InstallAt)</strong></div>
                            <small>@(string.IsNullOrWhiteSpace(o.InstallAddress) ? "—" : o.InstallAddress)</small>
                            @if(!string.IsNullOrWhiteSpace(o.Notes))
                            {
                                <div><small style="color:#64748b">@o.Notes</small></div>
                            }
                        </td>
                        <td class="wrap-cell">
                            <span class="chip @(o.Status == "COMPLETED" ? (o.HasMissingImei ? "orange-chip" : "green-chip") : o.Status == "CANCELLED" ? "orange-chip" : "blue-chip")">@o.StatusDisplay</span>
                            @{
                                var serializedCnt = o.Lines.Count(l => l.IsSerialized);
                                var filledImeiCnt = o.Lines.Count(l => l.IsSerialized && !string.IsNullOrWhiteSpace(l.Imei));
                            }
                            @if (serializedCnt > 1)
                            {
                                <div style="margin-top:4px"><small style="color:#0f766e;font-weight:600">IMEI: @filledImeiCnt/@serializedCnt xe</small></div>
                            }
                            else if (!string.IsNullOrWhiteSpace(o.Imei) && o.Imei != "CHỜ-NHẬP-IMEI" && o.Imei != "KHÔNG-IMEI")
                            {
                                <div style="margin-top:4px"><small style="color:#0f766e;font-weight:600">IMEI: @o.Imei</small></div>
                                @if(!string.IsNullOrWhiteSpace(o.PlateNo))
                                {
                                    <div><small style="color:#475569">BS: @o.PlateNo</small></div>
                                }
                            }
                        </td>
                        <td>
                            @if(o.OrderKind == "RENEWAL")
                            {
                                <span class="chip">Gia hạn dịch vụ</span>
                            }
                            else
                            {
                                <div><strong>@(o.Warehouse ?? "Chưa chọn kho")</strong></div>
                                <span class="chip @(o.DeductStock ? "green-chip" : "orange-chip")">@o.StockEffectDisplay</span>
                            }
                        </td>
                        <td class="wrap-cell">
                            <div><span class="chip">@o.InstallerTypeDisplay</span></div>
                            <div><strong>@(string.IsNullOrWhiteSpace(o.Installer) ? "—" : o.Installer)</strong></div>
                            @if(o.OrderKind != "RENEWAL")
                            {
                                @if(o.NoInstallFee || o.OrderKind == "COMMERCIAL")
                                {
                                    <small style="color:#c2410c;font-weight:600">Không tính công lắp (0 ₫)</small>
                                }
                                else if(o.InstallerFee > 0)
                                {
                                    <small>Công lắp: @o.InstallerFee.ToString("N0") ₫</small>
                                }
                            }
                        </td>
                        <td class="catalog-row-actions">
                            @if(o.OrderKind == "RENEWAL")
                            {
                                <div style="display:flex;flex-direction:column;gap:5px;min-width:140px">
                                    <button type="button" class="btn @(!o.IsAccountingLocked || isMainDev ? "" : "secondary") btn-sm" data-confirm="none" @onclick="() => OpenOrderModal(o.Id)">
                                        @(!o.IsAccountingLocked || isMainDev ? "✏️ Xem / Sửa hạn GH" : "👁 Xem Đơn gia hạn")
                                    </button>
                                    @if(isMainDev)
                                    {
                                        <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Hủy &amp; Xóa cứng Đơn gia hạn" data-confirm-msg="@($"Bạn có chắc chắn muốn xóa cứng Đơn gia hạn {o.Code} ({o.CustomerB2BDisplay}), khôi phục mốc hạn cũ cho thiết bị và xóa hóa đơn gia hạn liên quan không?")" @onclick="() => QuickCancelOrder(o.Id)">
                                            🗑 Xóa cứng GH
                                        </button>
                                    }
                                    else if(canSoftDeleteOrder && !o.IsAccountingLocked)
                                    {
                                        <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Xóa mềm Đơn gia hạn" data-confirm-msg="@($"Xóa mềm Đơn gia hạn {o.Code}, khôi phục hạn cũ của xe và hủy chứng từ kế toán liên quan?")" @onclick="() => QuickSoftDeleteOrder(o.Id)">
                                            🗑 Xóa mềm GH
                                        </button>
                                    }
                                </div>
                            }
                            else if(!o.IsImmutable && o.Status != "CANCELLED")
                            {
                                <div style="display:flex;flex-direction:column;gap:5px;min-width:148px">
                                    <button type="button" class="btn btn-sm" data-confirm="none" @onclick="() => OpenOrderModal(o.Id)">
                                        ⚙ Điều chỉnh / Xử lý
                                    </button>
                                    <div style="display:flex;gap:5px">
                                        <button type="button" class="btn secondary btn-sm" style="flex:1" data-confirm="none" @onclick="() => OpenOrderModal(o.Id)">
                                            Nhập IMEI
                                        </button>
                                        <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="@(isMainDev ? "Xác nhận Hủy & Xóa cứng đơn hàng" : "Xác nhận Hủy đơn & Hoàn trả Kho")" data-confirm-msg="@(isMainDev ? $"Bạn có chắc chắn muốn hủy và xóa cứng đơn hàng {o.Code} ({o.CustomerB2BDisplay}) và trả thiết bị về kho không?" : $"Bạn có chắc chắn muốn hủy đơn hàng {o.Code} ({o.CustomerB2BDisplay}) và trả toàn bộ mã IMEI / thiết bị về lại Kho để dùng cho đơn khác không?")" @onclick="() => QuickCancelOrder(o.Id)">
                                            @(isMainDev ? "🗑 Xóa cứng" : "Hủy đơn")
                                        </button>
                                    </div>
                                </div>
                            }
                            else if(o.IsImmutable && o.HasMissingImei)
                            {
                                <div style="display:flex;flex-direction:column;gap:5px;min-width:148px">
                                    <button type="button" class="btn btn-sm" data-confirm="none" @onclick="() => OpenOrderModal(o.Id)">
                                        @(isMainDev && !o.IsAccountingLocked ? $"⚙ Điều chỉnh / IMEI ({o.MissingImeiCount})" : $"📝 Bổ sung IMEI ({o.MissingImeiCount})")
                                    </button>
                                    <div style="display:flex;gap:5px">
                                        <button type="button" class="btn secondary btn-sm" style="flex:1" data-confirm="none" @onclick="() => OpenOrderModal(o.Id)">
                                            👁 Xem
                                        </button>
                                        @if(isMainDev)
                                        {
                                            <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Hủy &amp; Xóa cứng đơn đã hoàn thành" data-confirm-msg="@($"Bạn có chắc chắn muốn hủy và xóa cứng đơn đã hoàn thành {o.Code} ({o.CustomerB2BDisplay}), hoàn trả tồn kho và xóa toàn bộ chứng từ kế toán liên quan không?")" @onclick="() => QuickCancelOrder(o.Id)">
                                                🗑 Xóa cứng
                                            </button>
                                        }
                                        else if(canSoftDeleteOrder && !o.IsAccountingLocked)
                                        {
                                            <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Xóa mềm &amp; Hoàn kho đơn hàng" data-confirm-msg="@($"Xóa mềm đơn {o.Code}, hoàn trả toàn bộ thiết bị về Kho và hủy chứng từ kế toán chưa chốt số?")" @onclick="() => QuickSoftDeleteOrder(o.Id)">
                                                🗑 Xóa mềm
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                            else if(o.IsImmutable)
                            {
                                <div style="display:flex;flex-direction:column;gap:5px;min-width:148px">
                                    <button type="button" class="btn @(isMainDev && !o.IsAccountingLocked ? "" : "secondary") btn-sm" data-confirm="none" @onclick="() => OpenOrderModal(o.Id)">
                                        @(isMainDev && !o.IsAccountingLocked ? "⚙ Điều chỉnh đơn / IMEI" : "👁 Xem / Sửa IMEI")
                                    </button>
                                    @if(isMainDev)
                                    {
                                        <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Hủy &amp; Xóa cứng đơn đã hoàn thành" data-confirm-msg="@($"Bạn có chắc chắn muốn hủy và xóa cứng đơn đã hoàn thành {o.Code} ({o.CustomerB2BDisplay}), hoàn trả tồn kho và xóa toàn bộ chứng từ kế toán liên quan không?")" @onclick="() => QuickCancelOrder(o.Id)">
                                            🗑 Hủy &amp; Xóa cứng
                                        </button>
                                    }
                                    else if(canSoftDeleteOrder && !o.IsAccountingLocked)
                                    {
                                        <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Xóa mềm &amp; Hoàn kho đơn hàng" data-confirm-msg="@($"Xóa mềm đơn {o.Code}, hoàn trả toàn bộ IMEI / số lượng về Kho và hủy chứng từ công nợ chưa chốt số?")" @onclick="() => QuickSoftDeleteOrder(o.Id)">
                                            🗑 Xóa mềm &amp; Hoàn kho
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div style="display:flex;flex-direction:column;gap:5px;min-width:148px">
                                    <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="() => OpenOrderModal(o.Id)">
                                        👁 Xem chi tiết
                                    </button>
                                    @if(isMainDev)
                                    {
                                        <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Xóa cứng đơn hàng" data-confirm-msg="@($"Bạn có chắc chắn muốn xóa cứng đơn hàng {o.Code} ({o.CustomerB2BDisplay}) khỏi cơ sở dữ liệu không?")" @onclick="() => QuickCancelOrder(o.Id)">
                                            🗑 Xóa cứng đơn
                                        </button>
                                    }
                                    else if(canSoftDeleteOrder)
                                    {
                                        <button type="button" class="btn secondary btn-sm" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Xóa mềm đơn đã hủy" data-confirm-msg="@($"Xóa mềm đơn đã hủy {o.Code} khỏi danh sách và đảm bảo hoàn trả thiết bị về Kho?")" @onclick="() => QuickSoftDeleteOrder(o.Id)">
                                            🗑 Xóa mềm đơn
                                        </button>
                                    }
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <TablePager Pager="orderPager" TotalCount="totalOrders" OnChange="StateHasChanged" />
</section>

@if(showOrderModal && SelectedOrder is not null)
{
    <div class="so-modal-overlay" @onclick="CloseOrderModal">
        <div class="so-modal-dialog" @onclick:stopPropagation="true">
            <div class="so-modal-header">
                <div>
                    <h2>
                        <span>@SelectedOrder.OrderKindDisplay: @SelectedOrder.Code</span>
                        <span class="chip @(SelectedOrder.Status == "COMPLETED" ? (SelectedOrder.HasMissingImei ? "orange-chip" : "green-chip") : SelectedOrder.Status == "CANCELLED" ? "orange-chip" : "blue-chip")">@SelectedOrder.StatusDisplay</span>
                        <span class="chip">@SelectedOrder.CustomerB2BDisplay</span>
                        @if(!string.IsNullOrWhiteSpace(SelectedOrder.SaleSource))
                        {
                            <span class="chip blue-chip">NV bán hàng: @SelectedOrder.SaleSource</span>
                        }
                    </h2>
                    <p>
                        @(SelectedOrder.OrderKind == "RENEWAL"
                            ? "Chi tiết Đơn gia hạn thiết bị, danh sách xe và mốc thời gian gia hạn đã đồng bộ sang Thiết bị & Kế toán."
                            : "Cập nhật thông tin, điều phối kho / ĐV lắp đặt, chỉnh đơn giá bán thực tế, nhập Số IMEI & xác nhận Hoàn thành đơn.")
                    </p>
                </div>
                <button type="button" class="btn secondary btn-sm" data-confirm="none" @onclick="CloseOrderModal">✕ Đóng</button>
            </div>

            <div class="so-modal-body">
                @if(!string.IsNullOrEmpty(message))
                {
                    <div style="margin-bottom:0.85rem;padding:0.7rem 0.95rem;border-radius:8px;background:@(message.StartsWith("Lỗi:") ? "#fef2f2" : "#eff6ff");border:1px solid @(message.StartsWith("Lỗi:") ? "#fecaca" : "#93c5fd");color:@(message.StartsWith("Lỗi:") ? "#b91c1c" : "#1e3a8a");font-weight:600;font-size:12px">
                        @message
                    </div>
                }

                @if(SelectedOrder.OrderKind == "RENEWAL")
                {
                    var canEditRenOrd = (!SelectedOrder.IsAccountingLocked || isMainDev) && SelectedOrder.Status != "CANCELLED";
                    var liveRenOrdTotal = canEditRenOrd
                        ? SelectedOrder.Lines.Sum(l => GetLinePriceInput(l))
                        : SelectedOrder.Price;

                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px;padding:12px;background:#f0fdf4;border:1px solid #86efac;border-radius:8px;margin-bottom:12px">
                        <div><small style="color:#475569">Mã Đơn gia hạn</small><div><strong>@SelectedOrder.Code</strong></div></div>
                        <div><small style="color:#475569">Đơn vị / Khách hàng</small><div><strong>@SelectedOrder.CustomerB2BDisplay</strong></div></div>
                        <div><small style="color:#475569">Tổng tiền Đơn gia hạn</small><div><strong style="color:#15803d;font-size:1.05rem">@liveRenOrdTotal.ToString("N0") ₫</strong>@(liveRenOrdTotal != SelectedOrder.Price ? $" (Trước: {SelectedOrder.Price:N0} ₫)" : "")</div></div>
                        <div><small style="color:#475569">Trạng thái Kế toán</small><div><strong>@(SelectedOrder.IsAccountingLocked ? "🔒 Đã chốt sổ KT" : "✏️ Cho phép cập nhật hạn & thông tin")</strong></div></div>
                    </div>

                    @if(canEditRenOrd)
                    {
                        <div style="margin-bottom:12px;padding:12px;background:#f8fafc;border:1px solid #cbd5e1;border-radius:8px">
                            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:8px">
                                <strong style="font-size:0.9rem;color:#0f172a">✏️ Cập nhật Thời gian Gia hạn (Ngày hết hạn) &amp; Thông tin chung Đơn @SelectedOrder.Code</strong>
                                <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                                    <small style="color:#475569;font-weight:600">Cộng nhanh hạn mới cho toàn đơn (từ Hạn cũ):</small>
                                    <button type="button" class="btn secondary btn-sm" style="padding:2px 8px;font-size:11.5px" data-confirm="none" @onclick="() => BatchExtendRenewalOrderLines(1)">+1 tháng</button>
                                    <button type="button" class="btn secondary btn-sm" style="padding:2px 8px;font-size:11.5px" data-confirm="none" @onclick="() => BatchExtendRenewalOrderLines(3)">+3 tháng</button>
                                    <button type="button" class="btn secondary btn-sm" style="padding:2px 8px;font-size:11.5px" data-confirm="none" @onclick="() => BatchExtendRenewalOrderLines(6)">+6 tháng</button>
                                    <button type="button" class="btn secondary btn-sm" style="padding:2px 8px;font-size:11.5px" data-confirm="none" @onclick="() => BatchExtendRenewalOrderLines(12)">+12 tháng</button>
                                </div>
                            </div>
                            <div class="form-grid">
                                @if(canTransferOnRenew || isMainDev)
                                {
                                    <label>Đại lý / HTX / Khách lẻ (Đổi đơn vị &amp; Tự tính lại giá GH) *
                                        <select @bind="editCustomerId" @bind:after="OnEditRenewalOrderCustomerChanged" style="@(editCustomerId > 0 && editCustomerId != SelectedOrder.CustomerId ? "border-color:#0284c7;font-weight:700;background:#f0f9ff" : "")">
                                            @foreach(var cu in customers)
                                            {
                                                <option value="@cu.Id">@cu.Code — @cu.B2BDisplayName @(string.IsNullOrWhiteSpace(cu.Group) || cu.Group == "-" ? "" : $"[{cu.Group}]")</option>
                                            }
                                        </select>
                                    </label>
                                }
                                <label>Ngày thực hiện gia hạn *
                                    <input type="date" @bind="activationDateInput" />
                                </label>
                                <label>Nhân viên bán hàng phụ trách
                                    <select @bind="editSellerId" @bind:after="OnEditSellerChanged">
                                        <option value="0">— Giữ nguyên / Chưa chọn —</option>
                                        @foreach(var sl in sellerChoices)
                                        {
                                            <option value="@sl.Id">@sl.Code — @sl.Name</option>
                                        }
                                    </select>
                                </label>
                                <label>Ghi chú Đơn gia hạn
                                    <input @bind="editNotes" placeholder="Ghi chú gia hạn..." />
                                </label>
                            </div>
                        </div>
                    }

                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Mã SP &amp; Dòng thiết bị</th>
                                    <th>Số IMEI</th>
                                    <th>Biển số xe</th>
                                    <th>Số khung / Chủ xe</th>
                                    <th>Hạn cũ</th>
                                    <th>Mốc hạn mới (Ngày hết hạn) *</th>
                                    <th>Đơn giá gia hạn (VND)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for(var i = 0; i < SelectedOrder.Lines.Count; i++)
                                {
                                    var ln = SelectedOrder.Lines[i];
                                    var rep = GetOrCreateLineReport(ln);
                                    var prevDt = GetOrInitRenewalLinePrevDate(ln);
                                    var nextDt = GetOrInitRenewalLineNewDate(ln);
                                    var linePrice = GetLinePriceInput(ln);
                                    <tr>
                                        <td><strong>@(i + 1)</strong></td>
                                        <td><strong>@ln.ProductSku</strong> — @ln.ProductName</td>
                                        <td><strong style="color:#0f766e">@(ln.Imei ?? "—")</strong></td>
                                        <td>
                                            @if(canEditRenOrd)
                                            {
                                                <input value="@rep.PlateNo" @onchange="e => SetLineReport(ln.Id, null, e.Value?.ToString(), null)" placeholder="Biển số..." style="min-width:105px" />
                                            }
                                            else
                                            {
                                                <strong>@(string.IsNullOrWhiteSpace(ln.PlateNo) ? "—" : ln.PlateNo)</strong>
                                            }
                                        </td>
                                        <td>
                                            @if(canEditRenOrd)
                                            {
                                                <input value="@rep.VinNo" @onchange="e => SetLineReport(ln.Id, null, null, e.Value?.ToString())" placeholder="Chủ xe / Số khung..." style="min-width:120px" />
                                            }
                                            else
                                            {
                                                @(string.IsNullOrWhiteSpace(ln.VinNo) ? "—" : ln.VinNo)
                                            }
                                        </td>
                                        <td>
                                            @if(canEditRenOrd)
                                            {
                                                <input type="date" value="@prevDt.ToString("yyyy-MM-dd")" @onchange="e => SetRenewalLinePrevDate(ln.Id, e.Value?.ToString())" style="width:auto;padding:4px 6px" />
                                            }
                                            else
                                            {
                                                <small>@ln.PrevExpiry</small>
                                            }
                                        </td>
                                        <td>
                                            @if(canEditRenOrd)
                                            {
                                                <input type="date" value="@nextDt.ToString("yyyy-MM-dd")" @onchange="e => SetRenewalLineNewDate(ln.Id, e.Value?.ToString())" style="width:auto;padding:4px 6px;border-color:#15803d;font-weight:700;color:#15803d" />
                                            }
                                            else
                                            {
                                                <strong style="color:#15803d">@ln.NewExpiry</strong>
                                            }
                                        </td>
                                        <td>
                                            @if(canEditRenOrd)
                                            {
                                                <input type="number" min="0" step="10000" value="@linePrice" @onchange="e => SetLinePriceInput(ln, e.Value?.ToString(), false)" style="min-width:110px;font-weight:700" />
                                            }
                                            else
                                            {
                                                <strong>@ln.UnitPrice.ToString("N0") ₫</strong>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    @if(SelectedOrder.IsImmutable)
                    {
                        @if(CanMainEditCompleted)
                        {
                            <div style="margin-bottom:0.85rem;padding:0.75rem 1rem;background:#eff6ff;border:1px solid #93c5fd;border-left:4px solid #2563eb;border-radius:8px;color:#1e3a8a;font-weight:600">
                                ⚙ <strong>Chế độ điều chỉnh đơn đã hoàn thành (Chưa chốt số):</strong> Cho phép chỉnh sửa lại Chế độ công lắp, Đơn giá bán từng dòng, Khách hàng, NV bán hàng, ĐV lắp đặt, Kho xuất và IMEI. Khi lưu, toàn bộ luồng phía sau (Hóa đơn <strong>SALE / SERVICE</strong>, Hoa hồng và Thiết bị) sẽ tự động cập nhật đồng bộ.
                            </div>
                        }
                        else if(isMainDev && SelectedOrder.IsAccountingLocked)
                        {
                            <div style="margin-bottom:0.85rem;padding:0.75rem 1rem;background:#eef2ff;border:1px solid #a5b4fc;border-radius:8px;color:#3730a3;font-weight:600">
                                🔒 Đơn hàng <strong>@SelectedOrder.Code</strong> hiện đã chốt số / khóa sổ bên mục Công nợ &amp; Kế toán.
                            </div>
                        }
                        @if(SelectedOrder.HasMissingImei)
                        {
                            <div style="margin-bottom:0.85rem;padding:0.75rem 1rem;background:#fffbeb;border:1px solid #fcd34d;border-radius:8px;color:#92400e;font-weight:600">
                                Đơn hàng <strong>@SelectedOrder.Code</strong> đã hoàn thành, hiện còn <strong>@SelectedOrder.MissingImeiCount thiết bị chờ bổ sung mã IMEI</strong>. Vui lòng nhập Số IMEI / Biển số ở bảng dưới và lưu cập nhật (không trừ tồn kho lần 2).
                            </div>
                        }
                    }

                    <div class="form-grid">
                        <label>Kho điều sản phẩm *
                            <select @bind="warehouse" disabled="@IsOrderFieldsLocked">
                                <option value="0">— Chọn kho xuất —</option>
                                @foreach(var w in warehouses)
                                {
                                    <option value="@w.Id">@w.Name (@w.Code)</option>
                                }
                            </select>
                        </label>
                        <label>Loại Đơn vị lắp đặt / Xuất hàng *
                            <select value="@source" @onchange="OnEditSourceChanged" disabled="@IsOrderFieldsLocked">
                                <option value="INTERNAL">ĐV lắp đặt / Kho nội bộ</option>
                                <option value="PARTNER">Hãng / Nhà cung cấp lắp đặt</option>
                            </select>
                        </label>
                        @if(source == "INTERNAL")
                        {
                            <label>Chọn ĐV lắp đặt (đã khai báo)
                                <select @bind="installerEmployeeId" @bind:after="OnInstallerEmployeeChanged" disabled="@IsOrderFieldsLocked">
                                    <option value="0">— Chọn nhân sự / ĐV lắp đặt —</option>
                                    @foreach(var emp in installers)
                                    {
                                        <option value="@emp.Id">@emp.Code — @emp.Name (@GetRateLabel(emp.Id))</option>
                                    }
                                </select>
                            </label>
                            <label>Tên ĐV lắp đặt *
                                <input @bind="installer" disabled="@IsOrderFieldsLocked" placeholder="Tự động điền hoặc nhập tên ĐV lắp đặt" />
                            </label>
                        }
                        else
                        {
                            <label>Chọn nhanh Hãng / NCC
                                <select @onchange="OnEditManufacturerPick" disabled="@IsOrderFieldsLocked">
                                    <option value="">— Chọn Hãng / NCC hoặc nhập tên bên cạnh —</option>
                                    @foreach(var s in suppliers)
                                    {
                                        <option value="@s.Name">Hãng/NCC: @s.Name</option>
                                    }
                                    @foreach(var emp in installers)
                                    {
                                        <option value="@emp.Name">@emp.Name (@emp.Department)</option>
                                    }
                                </select>
                            </label>
                            <label>Tên Hãng lắp đặt *
                                <input @bind="installer" disabled="@IsOrderFieldsLocked" placeholder="Bắt buộc nhập tên Hãng lắp đặt" />
                            </label>
                        }

                        <label class="checkbox-row" style="padding:0.5rem 0.75rem;background:@(editNoInstallFee ? "#fff7ed" : "#eff6ff");border:1px solid @(editNoInstallFee ? "#fdba74" : "#93c5fd");border-radius:8px">
                            <input type="checkbox" @bind="editNoInstallFee" @bind:after="OnEditNoInstallFeeChanged" disabled="@(IsOrderFieldsLocked || SelectedOrder.OrderKind == "COMMERCIAL")" />
                            <span>
                                <strong>Không tính công lắp (Giá thương mại)</strong>
                                <small style="display:block;color:#475569">
                                    @(editNoInstallFee ? "Đang áp dụng Giá thương mại & công lắp = 0 ₫." : "Đang áp dụng Giá có lắp đặt.")
                                </small>
                            </span>
                        </label>

                        <label class="checkbox-row" style="padding:0.5rem 0.75rem;background:@(noDeductStock ? "#fff7ed" : "#f0fdf4");border:1px solid @(noDeductStock ? "#fdba74" : "#86efac");border-radius:8px">
                            <input type="checkbox" checked="@noDeductStock" disabled="@IsOrderFieldsLocked" @onchange="OnEditNoDeductChanged" />
                            <span>
                                <strong>Không trừ tồn kho</strong>
                                <small style="display:block;color:#475569">
                                    @(noDeductStock ? "Không trừ kho (Hãng / NCC xuất trực tiếp)." : "Trừ tồn kho khi Hoàn thành đơn.")
                                </small>
                            </span>
                        </label>
                    </div>

                    <div style="margin-top:0.85rem;padding:0.75rem;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px">
                        <h3 style="font-size:0.9rem;margin-bottom:0.5rem">Thông tin khách, nhân viên bán hàng &amp; thời hạn của đơn <strong>@SelectedOrder.Code</strong></h3>
                        <div class="form-grid">
                            @if(CanMainEditCompleted)
                            {
                                <label>Đơn vị / Khách hàng *
                                    <select @bind="editCustomerId" @bind:after="OnEditCustomerChanged">
                                        @foreach(var c in customers)
                                        {
                                            <option value="@c.Id">@c.Code — @c.B2BDisplayName</option>
                                        }
                                    </select>
                                </label>
                                <label class="checkbox-row" style="align-self:end;padding-bottom:6px">
                                    <input type="checkbox" @bind="editCod" /> Thu hộ tiền mặt (COD)
                                </label>
                            }
                            <label>Họ tên khách (Chủ xe / Người liên hệ)
                                <input @bind="editContactName" disabled="@IsOrderFieldsLocked" />
                            </label>
                            <label>Số điện thoại khách
                                <input @bind="editCustomerPhone" disabled="@IsOrderFieldsLocked" />
                            </label>
                            <label>Nhân viên bán hàng
                                <select @bind="editSellerId" @bind:after="OnEditSellerChanged" disabled="@IsOrderFieldsLocked">
                                    <option value="0">— Chọn nhân viên bán hàng —</option>
                                    @foreach(var sl in sellerChoices)
                                    {
                                        <option value="@sl.Id">@sl.Code — @sl.Name</option>
                                    }
                                </select>
                            </label>
                            <label>Nguồn KH / Ghi chú NV bán hàng
                                <input @bind="editSaleSource" disabled="@IsOrderFieldsLocked" />
                            </label>
                            <label>Thời hạn
                                <select @bind="editDurationMonths" @bind:after="OnEditDurationChanged" disabled="@IsOrderFieldsLocked">
                                    <option value="12">1 năm (12 tháng)</option>
                                    <option value="24">2 năm (24 tháng)</option>
                                    <option value="36">3 năm (36 tháng)</option>
                                    <option value="6">6 tháng</option>
                                </select>
                            </label>
                            <label>Thời gian lắp / giao
                                <input @bind="editInstallAt" disabled="@IsOrderFieldsLocked" />
                            </label>
                            <label>Địa chỉ
                                <input @bind="editAddress" disabled="@IsOrderFieldsLocked" />
                            </label>
                            <label>Ghi chú đơn hàng
                                <input @bind="editNotes" disabled="@IsOrderFieldsLocked" />
                            </label>
                        </div>
                    </div>

                    @if(SelectedOrder.Lines.Count > 0)
                    {
                        var canEditLinePrices = !SelectedOrder.IsImmutable || CanMainEditCompleted;
                        <div style="margin-top:1rem;border-top:1px solid #e2e8f0;padding-top:0.85rem">
                            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.75rem;margin-bottom:0.6rem">
                                <h3 style="font-size:0.95rem;margin:0">Chi tiết mặt hàng, Đơn giá bán &amp; Kích hoạt IMEI</h3>
                                <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;background:#eff6ff;padding:0.45rem 0.85rem;border-radius:8px;border:1px solid #bfdbfe">
                                    <label style="margin:0;display:flex;align-items:center;gap:0.4rem;font-weight:600;color:#1e3a8a">
                                        <span>📅 Ngày kích hoạt *:</span>
                                        <input type="date" @bind="activationDateInput" @bind:after="OnActivationDateInputChanged" disabled="@(SelectedOrder.Status == "CANCELLED")" style="width:auto;padding:0.25rem 0.5rem;height:auto;background:#fff" />
                                    </label>
                                    <label style="margin:0;display:flex;align-items:center;gap:0.4rem;font-weight:600;color:#15803d">
                                        <span>⏳ Ngày hết hạn *:</span>
                                        <input type="date" @bind="completedOrderExpiresInput" disabled="@(SelectedOrder.Status == "CANCELLED")" style="width:auto;padding:0.25rem 0.5rem;height:auto;background:#fff;border-color:#15803d;font-weight:700" />
                                    </label>
                                </div>
                            </div>

                            <datalist id="in-stock-imeis-list">
                                @foreach(var s in inStockUnits)
                                {
                                    <option value="@s.Imei">@s.Sku — @s.Product (@s.Holder)</option>
                                }
                            </datalist>

                            @{
                                var pagedOrderLines = orderLinePager.Slice(SelectedOrder.Lines, out var totalOrderLines);
                                var totalDevicesInOrder = SelectedOrder.Lines.Sum(l => l.Quantity);
                                var serializedTotalInOrder = SelectedOrder.Lines.Where(l => l.IsSerialized).Sum(l => l.Quantity);
                                var imeiEnteredInOrder = SelectedOrder.Lines.Count(l => l.IsSerialized && !string.IsNullOrWhiteSpace(l.Imei));
                                var displayOrderTotal = canEditLinePrices
                                    ? SelectedOrder.Lines.Sum(l => GetLinePriceInput(l) * l.Quantity)
                                    : SelectedOrder.Price;
                            }
                            <div class="tnm-mt-summary-banner" style="margin-bottom:10px">
                                <div class="tnm-mt-sum-primary">
                                    <span>📦 Tổng số lượng SP:</span>
                                    <strong>@totalDevicesInOrder.ToString("N0")</strong>
                                    @if (canEditLinePrices)
                                    {
                                        <button type="button" class="btn secondary btn-sm" style="margin-left:8px" data-confirm="none" @onclick="RequoteCompletedLinesFromGroup">
                                            🔄 Áp lại giá chuẩn theo Nhóm KH (@(editNoInstallFee ? "Giá thương mại" : $"Giá có lắp {editDurationMonths}T"))
                                        </button>
                                    }
                                </div>
                                <div class="tnm-mt-sum-meta">
                                    @if (serializedTotalInOrder > 0)
                                    {
                                        <span>Đã nhập IMEI: <strong style="color:#0f766e">@imeiEnteredInOrder / @serializedTotalInOrder xe</strong> · </span>
                                    }
                                    <span>Giá Tổng Đơn: <strong style="color:#0284c7">@displayOrderTotal.ToString("N0") ₫</strong>@(displayOrderTotal != SelectedOrder.Price ? $" (Trước đó: {SelectedOrder.Price:N0} ₫)" : "")</span>
                                </div>
                            </div>
                            <div class="table-wrap">
                                <table>
                                    <thead><tr><th>STT</th><th>Sản phẩm</th><th>Tồn kho</th><th>SL</th><th>Đơn giá bán</th><th>Công lắp</th><th>Số IMEI</th><th>Biển số xe</th><th>Thông tin phụ / Số khung</th></tr></thead>
                                    <tbody>
                                        @foreach(var (stt, ln) in pagedOrderLines)
                                        {
                                            var rep = GetOrCreateLineReport(ln);
                                            var prodInfo = products.FirstOrDefault(p => p.Id == ln.ProductId);
                                            var displayLinePrice = canEditLinePrices ? GetLinePriceInput(ln) : ln.UnitPrice;
                                            var displayLineFee = editNoInstallFee
                                                ? 0L
                                                : (installerEmployeeId > 0 ? Catalog.QuoteInstallerRate(installerEmployeeId, ln.ProductId) : ln.InstallerFee);
                                            var sameProdCount = SelectedOrder.Lines.Count(x => x.ProductId == ln.ProductId);
                                            <tr>
                                                <td><span class="tnm-mt-stt-badge">@stt</span></td>
                                                <td><strong>@ln.ProductSku</strong> — @ln.ProductName</td>
                                                <td>
                                                    @if(prodInfo?.Kind == "GOODS")
                                                    {
                                                        <span class="chip @(prodInfo.StockInHand > 0 ? "green-chip" : "orange-chip")">Tồn: @prodInfo.StockInHand.ToString("N0")</span>
                                                    }
                                                    else
                                                    {
                                                        <span>—</span>
                                                    }
                                                </td>
                                                <td><strong>@ln.Quantity</strong></td>
                                                <td>
                                                    @if(canEditLinePrices && SelectedOrder.Status != "CANCELLED")
                                                    {
                                                        <div style="display:flex;flex-direction:column;gap:3px;min-width:128px">
                                                            <input type="number" min="0" step="1000" value="@displayLinePrice" @onchange="e => SetLinePriceInput(ln, e.Value?.ToString(), applySameProduct: false)" style="font-weight:700;padding:4px 7px" />
                                                            @if(sameProdCount > 1)
                                                            {
                                                                <button type="button" class="btn secondary btn-sm" style="font-size:11px;padding:2px 6px" data-confirm="none" @onclick="() => ApplyPriceToSameProduct(ln.ProductId, displayLinePrice)">
                                                                    Áp cho @sameProdCount dòng @ln.ProductSku
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <strong>@displayLinePrice.ToString("N0") ₫</strong>
                                                    }
                                                </td>
                                                <td>@displayLineFee.ToString("N0") ₫</td>
                                                @if(ln.IsSerialized)
                                                {
                                                    <td>
                                                        <input list="in-stock-imeis-list" disabled="@(SelectedOrder.Status == "CANCELLED")" value="@rep.Imei" @oninput="e => SetLineReport(ln.Id, e.Value?.ToString() ?? string.Empty, null, null)" placeholder="Nhập mã IMEI (hoặc để trống nhập sau)" />
                                                    </td>
                                                    <td>
                                                        <input disabled="@(SelectedOrder.Status == "CANCELLED")" value="@rep.PlateNo" @oninput="e => SetLineReport(ln.Id, null, e.Value?.ToString() ?? string.Empty, null)" placeholder="VD: 51H-123.45" />
                                                    </td>
                                                    <td>
                                                        <input disabled="@(SelectedOrder.Status == "CANCELLED")" value="@rep.VinNo" @oninput="e => SetLineReport(ln.Id, null, null, e.Value?.ToString() ?? string.Empty)" placeholder="Số khung / chủ xe..." />
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td colspan="3"><em>Sản phẩm quản lý theo số lượng (trừ @ln.Quantity khi hoàn thành đơn)</em></td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <TablePager Pager="orderLinePager" TotalCount="totalOrderLines" OnChange="StateHasChanged" />
                        </div>
                    }
                }
            </div>

            <div class="so-modal-footer">
                <div style="display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center">
                    @if(SelectedOrder.OrderKind == "RENEWAL")
                    {
                        @if(isMainDev)
                        {
                            <button type="button" class="btn secondary" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Hủy &amp; Xóa cứng Đơn gia hạn" data-confirm-msg="@($"Bạn có chắc chắn muốn xóa cứng Đơn gia hạn {SelectedOrder.Code}, khôi phục hạn cũ của thiết bị và xóa hóa đơn gia hạn liên quan không?")" @onclick="Cancel">
                                🗑 Xóa cứng Đơn gia hạn &amp; Khôi phục hạn cũ
                            </button>
                        }
                    }
                    else if(!SelectedOrder.IsImmutable && SelectedOrder.Status != "CANCELLED")
                    {
                        <button type="button" class="btn secondary" data-confirm="edit" data-confirm-title="Xác nhận Lưu thông tin &amp; Đơn giá" data-confirm-msg="@($"Lưu cập nhật thông tin, điều phối kho và đơn giá cho đơn {SelectedOrder.Code}?")" @onclick="SaveOrderAndDispatch">1. Lưu thông tin &amp; Điều phối</button>
                        <button type="button" class="btn secondary" data-confirm="edit" data-confirm-title="Xác nhận Lưu IMEI &amp; thông tin phụ" data-confirm-msg="@($"Lưu danh sách Số IMEI và biển số cho đơn {SelectedOrder.Code}?")" @onclick="Report">2. Lưu Số IMEI &amp; Biển số</button>
                        <button type="button" class="btn" data-confirm="edit" data-confirm-title="Xác nhận Hoàn thành đơn hàng" data-confirm-msg="@($"Hoàn thành đơn hàng {SelectedOrder.Code} ({(noDeductStock ? "Không trừ kho - Hãng" : "Trừ tồn kho & ghi nhận công nợ")})?")" @onclick="Complete">3. Hoàn thành đơn @(noDeductStock ? "(Không trừ kho)" : "(Trừ tồn kho)")</button>
                        <button type="button" class="btn secondary" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="@(isMainDev ? "Xác nhận Hủy & Xóa cứng đơn hàng" : "Xác nhận Hủy đơn hàng")" data-confirm-msg="@(isMainDev ? $"Xóa cứng đơn hàng {SelectedOrder.Code}?" : $"Hủy đơn hàng {SelectedOrder.Code}?")" @onclick="Cancel">@(isMainDev ? "🗑 Hủy & Xóa cứng" : "Hủy đơn")</button>
                    }
                    else if(SelectedOrder.OrderKind == "RENEWAL")
                    {
                        @if((!SelectedOrder.IsAccountingLocked || isMainDev) && SelectedOrder.Status != "CANCELLED")
                        {
                            <button type="button" class="btn" data-confirm="edit" data-confirm-title="Xác nhận Lưu cập nhật Đơn gia hạn &amp; Ngày hết hạn" data-confirm-msg="@($"Lưu cập nhật Thời gian gia hạn (Ngày hết hạn), thông tin xe và đơn giá cho Đơn gia hạn {SelectedOrder.Code}, đồng bộ sang Thiết bị & Kế toán và ghi Log hệ thống?")" @onclick="SaveRenewalOrderChanges">
                                💾 Lưu cập nhật Đơn gia hạn &amp; Ngày hết hạn
                            </button>
                        }
                        @if(isMainDev)
                        {
                            <button type="button" class="btn secondary" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Hủy &amp; Xóa cứng Đơn gia hạn" data-confirm-msg="@($"Xóa cứng Đơn gia hạn {SelectedOrder.Code} và khôi phục mốc hạn cũ cho thiết bị?")" @onclick="Cancel">
                                🗑 Hủy &amp; Xóa cứng Đơn GH
                            </button>
                        }
                        else if(canSoftDeleteOrder && !SelectedOrder.IsAccountingLocked)
                        {
                            <button type="button" class="btn secondary" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Xóa mềm Đơn gia hạn" data-confirm-msg="@($"Xóa mềm Đơn gia hạn {SelectedOrder.Code}, khôi phục hạn cũ của xe và hủy chứng từ kế toán liên quan?")" @onclick="() => QuickSoftDeleteOrder(SelectedOrder.Id)">
                                🗑 Xóa mềm Đơn gia hạn
                            </button>
                        }
                    }
                    else if(SelectedOrder.IsImmutable)
                    {
                        @if(CanMainEditCompleted)
                        {
                            <button type="button" class="btn" data-confirm="edit" data-confirm-title="Xác nhận Lưu điều chỉnh đơn hoàn thành &amp; Đồng bộ luồng sau" data-confirm-msg="@($"Lưu điều chỉnh đơn hoàn thành {SelectedOrder.Code} và cập nhật đồng bộ sang Hóa đơn công nợ, Hoa hồng và Thiết bị?")" @onclick="SaveMainCompletedOrder">
                                💾 Lưu điều chỉnh đơn hoàn thành &amp; Đồng bộ Công nợ / Thiết bị
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn" data-confirm="edit" data-confirm-title="Xác nhận Cập nhật IMEI đơn đã hoàn thành" data-confirm-msg="@($"Lưu cập nhật / bổ sung IMEI và biển số cho đơn {SelectedOrder.Code}?")" @onclick="SaveCompletedOrderImeis">
                                💾 @(SelectedOrder.HasMissingImei ? $"Lưu & Kích hoạt IMEI bổ sung ({SelectedOrder.MissingImeiCount} thiết bị)" : "Lưu cập nhật IMEI / Biển số / Ngày kích hoạt")
                            </button>
                        }
                        @if(isMainDev)
                        {
                            <button type="button" class="btn secondary" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Hủy &amp; Xóa cứng đơn đã hoàn thành" data-confirm-msg="@($"Hủy và xóa cứng đơn đã hoàn thành {SelectedOrder.Code}, hoàn trả tồn kho và xóa toàn bộ chứng từ kế toán liên quan?")" @onclick="Cancel">
                                🗑 Hủy &amp; Xóa cứng đơn hoàn thành
                            </button>
                        }
                        else if(canSoftDeleteOrder && !SelectedOrder.IsAccountingLocked)
                        {
                            <button type="button" class="btn secondary" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Xóa mềm &amp; Hoàn kho đơn hàng" data-confirm-msg="@($"Xóa mềm đơn {SelectedOrder.Code}, hoàn trả toàn bộ thiết bị IMEI / số lượng về Kho và hủy chứng từ kế toán chưa chốt số?")" @onclick="() => QuickSoftDeleteOrder(SelectedOrder.Id)">
                                🗑 Xóa mềm đơn &amp; Hoàn trả Kho
                            </button>
                        }
                    }
                    else if(SelectedOrder.Status == "CANCELLED")
                    {
                        @if(isMainDev)
                        {
                            <button type="button" class="btn secondary" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Xóa cứng đơn đã hủy" data-confirm-msg="@($"Xóa cứng đơn đã hủy {SelectedOrder.Code}?")" @onclick="Cancel">
                                🗑 Xóa cứng đơn đã hủy
                            </button>
                        }
                        else if(canSoftDeleteOrder)
                        {
                            <button type="button" class="btn secondary" style="color:#dc2626;border-color:#fecaca" data-confirm="delete" data-confirm-title="Xác nhận Xóa mềm đơn đã hủy" data-confirm-msg="@($"Xóa mềm đơn đã hủy {SelectedOrder.Code} khỏi danh sách?")" @onclick="() => QuickSoftDeleteOrder(SelectedOrder.Id)">
                                🗑 Xóa mềm đơn đã hủy
                            </button>
                        }
                    }
                </div>
                <button type="button" class="btn secondary" data-confirm="none" @onclick="CloseOrderModal">Đóng</button>
            </div>
        </div>
    </div>
}

