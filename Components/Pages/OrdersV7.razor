    private string PreviewDeviceNextExpiry(DeviceVm dv)
    {
        var baseStart = DateTime.TryParse(dv.ExpiresAt, out var pDt) && pDt.Date > renewOrderDate.Date
            ? pDt.Date
            : renewOrderDate.Date;
        var nextDt = renewExpiryMode == "MILESTONE"
            ? renewMilestoneDate.Date
            : baseStart.AddMonths(renewDurationMonths > 0 ? renewDurationMonths : 12);
        return nextDt.ToString("yyyy-MM-dd");
    }

    private long QuoteSingleRenewalAutoPrice(DeviceVm dv)
    {
        var effCustId = renewTargetCustomerId > 0 ? renewTargetCustomerId : dv.CustomerId;
        var baseStart = DateTime.TryParse(dv.ExpiresAt, out var pDt) && pDt.Date > renewOrderDate.Date
            ? pDt.Date
            : renewOrderDate.Date;
        DateTime? milestone = renewExpiryMode == "MILESTONE" ? renewMilestoneDate.Date : null;
        return Db.PreviewRenewalPriceForDuration(effCustId, dv.ProductId, renewDurationMonths, baseStart, milestone);
    }

