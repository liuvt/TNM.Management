@page "/sales-orders"
@page "/orders-v7"
@attribute [Authorize(Policy = Permissions.OrdersView)]
@inject V7Orders Orders
@inject InputCatalog Catalog
@inject DemoDb Db
@inject V6Ops Ops
@inject PermissionGate Gate
<PageTitle>Đơn hàng &amp; Lắp đặt · TNM.Management</PageTitle>
<div class="page-head">
    <div>
        <div class="eyebrow">KINH DOANH / ĐIỀU PHỐI CSKH &amp; KHO</div>
        <h1>Đơn hàng &amp; Điều phối lắp đặt (SO)</h1>
        <p>1. Nhận thông tin từ Seller → 2. CSKH tạo đơn &amp; điều sản phẩm ở kho, chọn ĐV lắp đặt | Hãng lắp đặt (tick Không/Trừ tồn kho) → 3. ĐV lắp đặt gửi về Số IMEI &amp; thông tin phụ → 4. CSKH bổ sung Ngày kích hoạt IMEI &amp; Hoàn thành đơn (chỉ trừ tồn kho khi đơn thành công).</p>
    </div>
    <div class="button-group">
        <button type="button" class="btn secondary" @onclick="() => showQuickPaste = !showQuickPaste">
            @(showQuickPaste ? "Đóng · 📋 Dán tin nhắn Seller" : "📋 Dán nhanh tin nhắn Seller")
        </button>
        <a class="btn secondary" href="/catalog/sellers">Quản lý Seller →</a>
        <a class="btn secondary" href="/inventory">Kiểm tra tồn kho →</a>
        <a class="btn secondary" href="/catalog/installers">Khai báo ĐV lắp đặt →</a>
    </div>
</div>

@if(showQuickPaste)
{
    <section class="panel edit-panel" style="border-left:4px solid #0284c7">
        <div class="panel-head">
            <div>
                <h2>📋 Dán nhanh thông tin đơn từ Seller gửi về</h2>
                <p>Dán nguyên nội dung tin nhắn của Seller (gồm Đơn vị/HTX, Họ tên khách, SĐT, Số lượng lắp, Thời hạn, Địa chỉ lắp, Thời gian lắp, Ghi chú) để tự động điền vào form tạo đơn.</p>
            </div>
        </div>
        <div class="form-grid one">
            <label>Nội dung tin nhắn Seller
                <textarea @bind="sellerRawText" rows="8" placeholder="HTX Nam Hi&#10;Thông tin khách &#10;   - Họ tên khách: Lâm Hằng ( xe Đỗ Văn Hội)&#10;   - Số điện thoại khách: 0886287429&#10;Thông tin lắp đặt: &#10;   - Số lượng lắp: 1&#10;   - Thời hạn: 1 năm &#10;   - Địa chỉ lắp: 55 đường 30/4&#10;   - Thời gian lắp: 15g00 thứ 3 ( 20/10/2026)&#10;   - Ghi chú: không thu tiền, khi đến địa chỉ lắp liên hệ sdt: 0886287429"></textarea>
            </label>
        </div>
        <div class="form-actions">
            <button type="button" class="btn" @onclick="ParseSellerText">Tự động điền vào đơn hàng</button>
            <button type="button" class="btn secondary" @onclick="FillSampleSellerText">Điền mẫu thử nghiệm</button>
        </div>
    </section>
}

<section class="panel">
    <div class="panel-head">
        <div>
            <h2>1. Tạo đơn hàng &amp; Điều sản phẩm ở kho (CSKH)</h2>
            <p>Nhập thông tin khách lắp đặt từ Seller và chọn Kho điều sản phẩm, Đơn vị lắp đặt hoặc Hãng lắp đặt. Tồn kho chỉ bị trừ sau khi đơn hàng lắp đặt hoàn thành.</p>
        </div>
    </div>

    <div class="form-grid">
        <label>Đơn vị / Khách hàng (HTX / Đại lý / Khách lẻ) *
            <select @bind="customer" @bind:after="OnCustomerChanged">
                <option value="0">— Chọn Đơn vị / Khách hàng —</option>
                @foreach(var x in customers)
                {
                    <option value="@x.Id">@x.Code — @x.B2BDisplayName</option>
                }
            </select>
        </label>
        <label>Tra nhanh ĐV/KH theo SĐT đăng ký
            <select @bind="customer" @bind:after="OnCustomerChanged">
                <option value="0">— Chọn theo SĐT ĐV/KH —</option>
                @foreach(var x in customers)
                {
                    <option value="@x.Id">@(string.IsNullOrWhiteSpace(x.Phone) ? $"Chưa có SĐT ({x.Code} - {x.Name})" : $"{x.Phone} — {x.Name}")</option>
                }
            </select>
        </label>
        <label>Họ tên khách lắp (Chủ xe / Người liên hệ) *
            <input @bind="contactName" placeholder="VD: Lâm Hằng ( xe Đỗ Văn Hội)" />
        </label>
        <label>Số điện thoại khách lắp *
            <input @bind="customerPhone" placeholder="VD: 0886287429" />
        </label>
        <label>Thời hạn lắp đặt *
            <select @bind="durationMonths">
                <option value="12">1 năm (12 tháng)</option>
                <option value="24">2 năm (24 tháng)</option>
                <option value="36">3 năm (36 tháng)</option>
                <option value="6">6 tháng</option>
            </select>
        </label>
        <label>Thời gian lắp đặt *
            <div style="display:flex;gap:0.4rem;align-items:center">
                <input value="@installAtText" @onchange="OnInstallAtChanged" placeholder="VD: 15g00 thứ 3 ( 20/10/2026) hoặc dd/MM/yyyy HH:mm" style="flex:1;font-weight:600" />
                <button type="button" class="btn secondary btn-sm" @onclick="SetInstallAtNow" title="Lấy thời gian hiện tại">Hiện tại</button>
            </div>
        </label>
        <label>Địa chỉ lắp đặt *
            <input @bind="address" placeholder="VD: 55 đường 30/4..." />
        </label>
        <label>Nhân viên bán hàng (Seller) *
            <select @bind="createSellerId" @bind:after="OnCreateSellerChanged">
                <option value="0">— Chọn nhân viên bán hàng (Seller) —</option>
                @foreach(var sl in sellerChoices)
                {
                    <option value="@sl.Id">@sl.Code — @sl.Name</option>
                }
            </select>
        </label>
        <label>Nguồn KH / Ghi chú Seller
            <input @bind="saleSource" placeholder="Tự động điền theo Seller hoặc ghi chú thêm..." />
        </label>
        <label>Ghi chú đơn hàng
            <input @bind="notes" placeholder="VD: không thu tiền, khi đến địa chỉ lắp liên hệ sdt: 0886287429" />
        </label>
        <label class="checkbox-row">
            <input type="checkbox" @bind="cod" /> Thu hộ tiền mặt khi lắp (COD)
        </label>
    </div>

    @if(SelectedCustomer is not null)
    {
        <div style="margin-top:0.75rem;padding:0.65rem 0.9rem;background:#f8fafc;border:1px solid var(--border,#e2e8f0);border-radius:8px;display:flex;flex-wrap:wrap;gap:1rem;align-items:center;font-size:0.9rem">
            <div><strong>Mã KH:</strong> @SelectedCustomer.Code</div>
            <div><strong>Đơn vị / KH:</strong> @SelectedCustomer.B2BDisplayName</div>
            <div><strong>Nhóm KH:</strong> <span class="chip">@SelectedCustomer.Group</span></div>
            @if(!string.IsNullOrWhiteSpace(contactName))
            {
                <div><strong>Khách lắp / Chủ xe:</strong> <span style="color:#0284c7;font-weight:600">@contactName</span></div>
            }
            <div><strong>SĐT liên hệ lắp:</strong> <span style="font-weight:600">@(string.IsNullOrWhiteSpace(customerPhone) ? "—" : customerPhone)</span></div>
        </div>
    }

    <div style="margin-top:1rem;border-top:1px solid var(--border,#e2e8f0);padding-top:0.85rem">
        <h3 style="font-size:0.95rem;margin-bottom:0.5rem">Điều sản phẩm ở kho &amp; Chọn ĐV lắp đặt | Hãng lắp đặt</h3>
        <div class="form-grid">
            <label>Kho điều sản phẩm *
                <select @bind="createWarehouse">
                    <option value="0">— Chưa chọn kho (duyệt sau) —</option>
                    @foreach(var w in warehouses)
                    {
                        <option value="@w.Id">@w.Name (@w.Code)</option>
                    }
                </select>
            </label>
            <label>Phân loại Đơn vị lắp đặt *
                <select value="@createSource" @onchange="OnCreateSourceChanged">
                    <option value="INTERNAL">ĐV lắp đặt (Nội bộ / CTV / Đại lý — Trừ tồn kho)</option>
                    <option value="PARTNER">Hãng lắp đặt (Cho phép tick Không trừ tồn kho)</option>
                </select>
            </label>
            @if(createSource == "INTERNAL")
            {
                <label>Chọn ĐV lắp đặt (đã khai báo)
                    <select @bind="createInstallerEmpId" @bind:after="OnCreateInstallerEmpChanged">
                        <option value="0">— Chọn ĐV lắp đặt hoặc nhập tên bên cạnh —</option>
                        @foreach(var emp in installers)
                        {
                            <option value="@emp.Id">@emp.Code — @emp.Name (@emp.Department)</option>
                        }
                    </select>
                </label>
                <label>Tên ĐV lắp đặt
                    <input @bind="createInstallerName" placeholder="Tên kỹ thuật / ĐV lắp đặt..." />
                </label>
            }
            else
            {
                <label>Chọn Hãng lắp đặt (từ NCC / ĐV)
                    <select @onchange="OnCreateManufacturerPick">
                        <option value="">— Chọn nhanh Hãng / NCC hoặc nhập tên bên cạnh —</option>
                        @foreach(var s in suppliers)
                        {
                            <option value="@s.Name">Hãng/NCC: @s.Name</option>
                        }
                        @foreach(var emp in installers)
                        {
                            <option value="@emp.Name">@emp.Name (@emp.Department)</option>
                        }
                    </select>
                </label>
                <label>Tên Hãng lắp đặt *
                    <input @bind="createInstallerName" placeholder="Bắt buộc nhập tên Hãng lắp đặt..." />
                </label>
            }
            <label class="checkbox-row" style="grid-column:span 2;padding:0.5rem 0.75rem;background:@(createNoDeductStock ? "#fff7ed" : "#f0fdf4");border:1px solid @(createNoDeductStock ? "#fdba74" : "#86efac");border-radius:8px">
                <input type="checkbox" checked="@createNoDeductStock" @onchange="OnCreateNoDeductChanged" />
                <span>
                    <strong>Không trừ tồn kho</strong>
                    <small style="display:block;color:#475569">
                        @(createNoDeductStock
                            ? "Đang bật KHÔNG TRỪ TỒN KHO (Bắt buộc Đơn vị lắp đặt là Hãng lắp đặt)."
                            : "Đang để mặc định: TRỪ TỒN KHO sau khi đơn hàng lắp đặt hoàn thành.")
                    </small>
                </span>
            </label>
        </div>
    </div>

    <div style="margin-top:1rem;border-top:1px solid var(--border,#e2e8f0);padding-top:0.85rem">
        <h3 style="font-size:0.95rem;margin-bottom:0.5rem">Danh sách sản phẩm lắp đặt (Kèm số lượng tồn kho hiện tại)</h3>
        <div class="form-grid">
            <label style="grid-column:span 2">Chọn sản phẩm thêm vào đơn *
                <select @bind="product">
                    <option value="0">— Chọn sản phẩm —</option>
                    @foreach(var x in products)
                    {
                        <option value="@x.Id">@x.Sku — @x.Name @(x.Kind == "GOODS" ? $"[Tồn kho: {x.StockInHand:N0}]" : "[Dịch vụ]") @(x.IsSerialized ? "(Có IMEI)" : "")</option>
                    }
                </select>
            </label>
            <label>Số lượng lắp *
                <input type="number" min="1" max="100" @bind="draftQty" />
            </label>
            <div style="display:flex;align-items:flex-end">
                <button type="button" class="btn secondary" @onclick="AddDraftLine">+ Thêm SP vào đơn</button>
            </div>
        </div>

        @if(draftLines.Count > 0)
        {
            var pagedDrafts = draftPager.Slice(draftLines.Select((item, idx) => (Idx: idx, Item: item)), out var totalDrafts);
            <div class="table-wrap" style="margin-top:0.75rem">
                <table>
                    <thead><tr><th>STT</th><th>Mã SP</th><th>Tên sản phẩm</th><th>Tồn kho hiện tại</th><th>Loại</th><th>Đơn giá dự kiến</th><th>Số lượng lắp</th><th>Thành tiền</th><th>Thao tác</th></tr></thead>
                    <tbody>
                        @foreach(var (stt, entry) in pagedDrafts)
                        {
                            var idx = entry.Idx;
                            var item = entry.Item;
                            var p = products.FirstOrDefault(x => x.Id == item.ProductId);
                            var unitPrice = Orders.PreviewUnitPrice(customer, item.ProductId);
                            <tr>
                                <td><strong>@stt</strong></td>
                                <td><strong>@(p?.Sku ?? "—")</strong></td>
                                <td>@(p?.Name ?? "—")</td>
                                <td>
                                    @if(p?.Kind == "GOODS")
                                    {
                                        <span class="chip @(p.StockInHand >= item.Quantity ? "green-chip" : "orange-chip")">Tồn: @p.StockInHand.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>@(p?.IsSerialized == true ? $"Thiết bị IMEI (tách {item.Quantity} dòng)" : "Theo số lượng")</td>
                                <td><strong>@unitPrice.ToString("N0") ₫</strong></td>
                                <td style="max-width:110px">
                                    <input type="number" min="1" max="100" value="@item.Quantity" @onchange="e => UpdateDraftQty(idx, e.Value)" />
                                </td>
                                <td><strong style="color:#0284c7">@((unitPrice * item.Quantity).ToString("N0")) ₫</strong></td>
                                <td>
                                    <button type="button" class="btn secondary btn-sm" @onclick="() => RemoveDraftLine(idx)">Xóa</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <TablePager Pager="draftPager" TotalCount="totalDrafts" />
        }
        else
        {
            <p class="panel-note" style="margin-top:0.5rem">Mẹo: Chọn sản phẩm ở trên (hệ thống sẽ tự thêm khi bấm Tạo đơn, hoặc bấm <strong>“+ Thêm SP vào đơn”</strong> nếu đơn có nhiều sản phẩm).</p>
        }
    </div>

    <div class="form-actions">
        <button class="btn" @onclick="Create">+ Tạo đơn hàng (SO)</button>
    </div>
</section>

<section class="panel">
    <div class="panel-head">
        <div>
            <h2>2. Cập nhật thông tin từ ĐV lắp đặt, Kích hoạt IMEI &amp; Hoàn thành đơn (Trừ tồn kho)</h2>
            <p>ĐV lắp đặt gửi số IMEI &amp; thông tin phụ về → CSKH cập nhật vào đơn, bổ sung Ngày kích hoạt IMEI và xác nhận Hoàn thành (chỉ trừ tồn kho khi đơn hàng thành công).</p>
        </div>
    </div>

    <div class="form-grid">
        <label style="grid-column:span 2">Chọn đơn hàng cần xử lý / cập nhật *
            <select @bind="selected" @bind:after="OnOrderSelected">
                <option value="0">— Chọn đơn hàng —</option>
                @foreach(var o in orders)
                {
                    <option value="@o.Id">@o.Code — @o.Customer @(string.IsNullOrWhiteSpace(o.ContactName) ? "" : $"({o.ContactName})") · @o.Product [@o.Status]</option>
                }
            </select>
        </label>
        <label>Kho điều sản phẩm *
            <select @bind="warehouse">
                <option value="0">— Chọn kho xuất —</option>
                @foreach(var w in warehouses)
                {
                    <option value="@w.Id">@w.Name (@w.Code)</option>
                }
            </select>
        </label>
        <label>Loại Đơn vị lắp đặt *
            <select value="@source" @onchange="OnEditSourceChanged">
                <option value="INTERNAL">ĐV lắp đặt (Nội bộ / CTV / Đại lý)</option>
                <option value="PARTNER">Hãng lắp đặt</option>
            </select>
        </label>
        @if(source == "INTERNAL")
        {
            <label>Chọn ĐV lắp đặt (đã khai báo)
                <select @bind="installerEmployeeId" @bind:after="OnInstallerEmployeeChanged">
                    <option value="0">— Chọn nhân sự / ĐV lắp đặt —</option>
                    @foreach(var emp in installers)
                    {
                        <option value="@emp.Id">@emp.Code — @emp.Name (@GetRateLabel(emp.Id))</option>
                    }
                </select>
            </label>
            <label>Tên ĐV lắp đặt *
                <input @bind="installer" placeholder="Tự động điền khi chọn hoặc nhập tên ĐV lắp đặt" />
            </label>
        }
        else
        {
            <label>Chọn nhanh Hãng lắp đặt
                <select @onchange="OnEditManufacturerPick">
                    <option value="">— Chọn Hãng / NCC hoặc nhập tên bên cạnh —</option>
                    @foreach(var s in suppliers)
                    {
                        <option value="@s.Name">Hãng/NCC: @s.Name</option>
                    }
                    @foreach(var emp in installers)
                    {
                        <option value="@emp.Name">@emp.Name (@emp.Department)</option>
                    }
                </select>
            </label>
            <label>Tên Hãng lắp đặt *
                <input @bind="installer" placeholder="Bắt buộc nhập tên Hãng lắp đặt" />
            </label>
        }

        <label class="checkbox-row" style="grid-column:span 2;padding:0.5rem 0.75rem;background:@(noDeductStock ? "#fff7ed" : "#f0fdf4");border:1px solid @(noDeductStock ? "#fdba74" : "#86efac");border-radius:8px">
            <input type="checkbox" checked="@noDeductStock" @onchange="OnEditNoDeductChanged" />
            <span>
                <strong>Không trừ tồn kho</strong>
                <small style="display:block;color:#475569">
                    @(noDeductStock
                        ? "Đang bật KHÔNG TRỪ TỒN KHO (Chỉ hợp lệ khi Đơn vị lắp đặt là Hãng lắp đặt)."
                        : "Đang bật TRỪ TỒN KHO: Số lượng tồn kho sẽ giảm ngay khi bấm Hoàn thành đơn hàng.")
                </small>
            </span>
        </label>
    </div>

    @if(SelectedOrder is not null)
    {
        @if(SelectedOrder.IsImmutable)
        {
            <div style="margin-top:0.85rem;padding:0.75rem 1rem;background:#f0fdf4;border:1px solid #86efac;border-radius:8px;color:#166534;font-weight:600">
                Đơn hàng <strong>@SelectedOrder.Code</strong> đã hoàn thành: Giá bán (@SelectedOrder.Price.ToString("N0") ₫), giá vốn (@SelectedOrder.CostSnapshot.ToString("N0") ₫), công lắp (@SelectedOrder.InstallerFee.ToString("N0") ₫), Seller (@(string.IsNullOrWhiteSpace(SelectedOrder.SaleSource) ? "—" : SelectedOrder.SaleSource)) và mã IMEI đã chốt.
            </div>
        }
        <div style="margin-top:0.85rem;padding:0.75rem;background:#f8fafc;border:1px solid var(--border,#e2e8f0);border-radius:8px">
            <h3 style="font-size:0.9rem;margin-bottom:0.5rem">Thông tin khách, Seller &amp; lịch lắp đặt của đơn <strong>@SelectedOrder.Code</strong> @(SelectedOrder.IsImmutable ? "(Đã hoàn thành)" : "(CSKH có thể cập nhật)")</h3>
            <div class="form-grid">
                <label>Họ tên khách (Chủ xe / Người liên hệ)
                    <input @bind="editContactName" disabled="@SelectedOrder.IsImmutable" placeholder="VD: Lâm Hằng ( xe Đỗ Văn Hội)" />
                </label>
                <label>Số điện thoại khách
                    <input @bind="editCustomerPhone" disabled="@SelectedOrder.IsImmutable" placeholder="VD: 0886287429" />
                </label>
                <label>Nhân viên bán hàng (Seller)
                    <select @bind="editSellerId" @bind:after="OnEditSellerChanged" disabled="@SelectedOrder.IsImmutable">
                        <option value="0">— Chọn Seller bán hàng —</option>
                        @foreach(var sl in sellerChoices)
                        {
                            <option value="@sl.Id">@sl.Code — @sl.Name</option>
                        }
                    </select>
                </label>
                <label>Nguồn KH / Ghi chú Seller
                    <input @bind="editSaleSource" disabled="@SelectedOrder.IsImmutable" placeholder="Ghi nhận người bán..." />
                </label>
                <label>Thời hạn
                    <select @bind="editDurationMonths" disabled="@SelectedOrder.IsImmutable">
                        <option value="12">1 năm (12 tháng)</option>
                        <option value="24">2 năm (24 tháng)</option>
                        <option value="36">3 năm (36 tháng)</option>
                        <option value="6">6 tháng</option>
                    </select>
                </label>
                <label>Thời gian lắp đặt
                    <input @bind="editInstallAt" disabled="@SelectedOrder.IsImmutable" placeholder="VD: 15g00 thứ 3 ( 20/10/2026)" />
                </label>
                <label>Địa chỉ lắp đặt
                    <input @bind="editAddress" disabled="@SelectedOrder.IsImmutable" placeholder="VD: 55 đường 30/4" />
                </label>
                <label>Ghi chú đơn hàng
                    <input @bind="editNotes" disabled="@SelectedOrder.IsImmutable" placeholder="Ghi chú..." />
                </label>
            </div>
        </div>
    }

    @if(SelectedOrder is not null && SelectedOrder.Lines.Count > 0)
    {
        <div style="margin-top:1rem;border-top:1px solid var(--border,#e2e8f0);padding-top:0.85rem">
            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.75rem;margin-bottom:0.6rem">
                <h3 style="font-size:0.95rem;margin:0">Thông tin ĐV lắp đặt gửi về (Số IMEI &amp; Thông tin phụ) + Kích hoạt IMEI</h3>
                <div style="display:flex;align-items:center;gap:0.75rem;background:#eff6ff;padding:0.45rem 0.85rem;border-radius:8px;border:1px solid #bfdbfe">
                    <label style="margin:0;display:flex;align-items:center;gap:0.4rem;font-weight:600;color:#1e3a8a">
                        <span>📅 Ngày kích hoạt IMEI *:</span>
                        <input type="date" @bind="activationDateInput" disabled="@SelectedOrder.IsImmutable" style="width:auto;padding:0.25rem 0.5rem;height:auto;background:#fff" />
                    </label>
                    <span class="chip blue-chip">Hết hạn dự kiến: @activationDateInput.AddMonths((int)(editDurationMonths > 0 ? editDurationMonths : 12)).ToString("dd/MM/yyyy") (@(editDurationMonths == 12 ? "1 năm" : $"{editDurationMonths} tháng"))</span>
                </div>
            </div>

            <datalist id="in-stock-imeis-list">
                @foreach(var s in inStockUnits)
                {
                    <option value="@s.Imei">@s.Sku — @s.Product (@s.Holder)</option>
                }
            </datalist>

            @{ var pagedOrderLines = orderLinePager.Slice(SelectedOrder.Lines, out var totalOrderLines); }
            <div class="table-wrap">
                <table>
                    <thead><tr><th>STT</th><th>Sản phẩm</th><th>Tồn kho hiện tại</th><th>SL lắp</th><th>Đơn giá bán</th><th>Công lắp</th><th>Số IMEI (ĐV lắp đặt gửi về) *</th><th>Biển số xe</th><th>Thông tin phụ / Số khung / Chủ xe</th></tr></thead>
                    <tbody>
                        @foreach(var (stt, ln) in pagedOrderLines)
                        {
                            var rep = GetOrCreateLineReport(ln);
                            var prodInfo = products.FirstOrDefault(p => p.Id == ln.ProductId);
                            <tr>
                                <td><strong>@stt</strong></td>
                                <td><strong>@ln.ProductSku</strong> — @ln.ProductName</td>
                                <td>
                                    @if(prodInfo?.Kind == "GOODS")
                                    {
                                        <span class="chip @(prodInfo.StockInHand > 0 ? "green-chip" : "orange-chip")">Tồn: @prodInfo.StockInHand.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td><strong>@ln.Quantity</strong></td>
                                <td><strong>@ln.UnitPrice.ToString("N0") ₫</strong></td>
                                <td>@ln.InstallerFee.ToString("N0") ₫</td>
                                @if(ln.IsSerialized)
                                {
                                    <td>
                                        <input list="in-stock-imeis-list" disabled="@SelectedOrder.IsImmutable" value="@rep.Imei" @oninput="e => SetLineReport(ln.Id, e.Value?.ToString() ?? string.Empty, null, null)" placeholder="Nhập hoặc chọn mã IMEI @stt" />
                                    </td>
                                    <td>
                                        <input disabled="@SelectedOrder.IsImmutable" value="@rep.PlateNo" @oninput="e => SetLineReport(ln.Id, null, e.Value?.ToString() ?? string.Empty, null)" placeholder="VD: 51H-123.45" />
                                    </td>
                                    <td>
                                        <input disabled="@SelectedOrder.IsImmutable" value="@rep.VinNo" @oninput="e => SetLineReport(ln.Id, null, null, e.Value?.ToString() ?? string.Empty)" placeholder="Thông tin phụ, số khung, xe Đỗ Văn Hội..." />
                                    </td>
                                }
                                else
                                {
                                    <td colspan="3"><em>Sản phẩm quản lý theo số lượng (tự động trừ @ln.Quantity khi hoàn thành đơn)</em></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <TablePager Pager="orderLinePager" TotalCount="totalOrderLines" />
        </div>
    }

    <div class="form-actions" style="flex-wrap:wrap;gap:0.5rem">
        <button class="btn secondary" disabled="@(SelectedOrder?.IsImmutable == true)" @onclick="SaveOrderAndDispatch">1. Lưu thông tin &amp; Điều phối kho / ĐV lắp</button>
        <button class="btn secondary" disabled="@(SelectedOrder?.IsImmutable == true)" @onclick="Report">2. Lưu Số IMEI &amp; Thông tin phụ</button>
        <button class="btn" disabled="@(SelectedOrder?.IsImmutable == true)" @onclick="Complete">3. Hoàn thành đơn &amp; Kích hoạt IMEI @(noDeductStock ? "(Không trừ kho - Hãng)" : "(Trừ tồn kho)")</button>
        <button class="btn secondary" disabled="@(SelectedOrder?.IsImmutable == true)" @onclick="Cancel">Hủy đơn</button>
    </div>
</section>

@if(!string.IsNullOrEmpty(message))
{
    <p class="feedback" style="font-weight:600;padding:0.75rem 1rem;border-radius:8px;background:#eff6ff;border:1px solid #93c5fd;color:#1e3a8a">@message</p>
}

<section class="panel">
    <div class="panel-head">
        <div>
            <h2>Danh sách đơn hàng lắp đặt (SO)</h2>
            <p>Theo dõi trạng thái đơn, Seller bán hàng, thông tin khách lắp, kho xuất, ĐV lắp đặt | Hãng lắp đặt và Ngày kích hoạt IMEI.</p>
        </div>
    </div>
    @{ var pagedOrders = orderPager.Slice(orders, out var totalOrders); }
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Mã đơn</th>
                    <th>Đơn vị (HTX/ĐL) &amp; Khách lắp</th>
                    <th>Seller (Người bán)</th>
                    <th>Sản phẩm &amp; Thời hạn</th>
                    <th>Giá bán</th>
                    <th>Thời gian &amp; Địa chỉ lắp</th>
                    <th>Trạng thái</th>
                    <th>Kho &amp; Chế độ tồn kho</th>
                    <th>ĐV lắp đặt | Hãng lắp</th>
                    <th>IMEI / Thông tin phụ / Ngày kích hoạt</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var (stt, o) in pagedOrders)
                {
                    <tr style="@(o.Id == selected ? "background:#f0f9ff" : "")" @onclick="() => SelectOrderRow(o.Id)">
                        <td><strong>@stt</strong></td>
                        <td>
                            <div><strong>@o.Code</strong></div>
                            @if(o.IsImmutable)
                            {
                                <small style="color:#15803d;font-weight:600">Đã hoàn thành</small>
                            }
                        </td>
                        <td class="wrap-cell">
                            <div><strong>@o.CustomerB2BDisplay</strong> @(!string.IsNullOrWhiteSpace(o.CustomerCode) ? $"({o.CustomerCode})" : "")</div>
                            @if(!string.IsNullOrWhiteSpace(o.ContactName))
                            {
                                <div><small style="color:#0284c7;font-weight:600">Khách lắp: @o.ContactName</small></div>
                            }
                            <small>SĐT: @(string.IsNullOrWhiteSpace(o.CustomerPhone) ? "—" : o.CustomerPhone)</small>
                        </td>
                        <td>
                            @if(!string.IsNullOrWhiteSpace(o.SaleSource))
                            {
                                <span class="chip blue-chip">@o.SaleSource</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td class="wrap-cell">
                            <div><strong>@o.Product</strong></div>
                            <span class="chip">Thời hạn: @o.DurationDisplay</span>
                        </td>
                        <td>
                            <div><strong>@o.Price.ToString("N0") ₫</strong></div>
                            @if(o.CostSnapshot > 0)
                            {
                                <small style="color:#64748b">Giá vốn: @o.CostSnapshot.ToString("N0") ₫</small>
                            }
                        </td>
                        <td class="wrap-cell">
                            <div><strong>@(string.IsNullOrWhiteSpace(o.InstallAt) ? "—" : o.InstallAt)</strong></div>
                            <small>@(string.IsNullOrWhiteSpace(o.InstallAddress) ? "—" : o.InstallAddress)</small>
                            @if(!string.IsNullOrWhiteSpace(o.Notes))
                            {
                                <div><small style="color:#64748b">Ghi chú: @o.Notes</small></div>
                            }
                        </td>
                        <td><span class="chip @(o.Status == "COMPLETED" ? "green-chip" : o.Status == "CANCELLED" ? "orange-chip" : "blue-chip")">@o.Status</span></td>
                        <td>
                            <div><strong>@(o.Warehouse ?? "Chưa chọn kho")</strong></div>
                            <span class="chip @(o.DeductStock ? "green-chip" : "orange-chip")">@o.StockEffectDisplay</span>
                        </td>
                        <td class="wrap-cell">
                            <div><span class="chip">@o.InstallerTypeDisplay</span></div>
                            <div><strong>@(string.IsNullOrWhiteSpace(o.Installer) ? "—" : o.Installer)</strong></div>
                            @if(o.InstallerFee > 0)
                            {
                                <small>Công lắp: @o.InstallerFee.ToString("N0") ₫</small>
                            }
                        </td>
                        <td class="wrap-cell">
                            @if(o.Lines.Any(l => !string.IsNullOrWhiteSpace(l.Imei)))
                            {
                                @foreach(var l in o.Lines.Where(x => !string.IsNullOrWhiteSpace(x.Imei)))
                                {
                                    <div>
                                        <small>
                                            <strong>@l.ProductSku:</strong> @l.Imei
                                            @(!string.IsNullOrWhiteSpace(l.PlateNo) ? $" · BS: {l.PlateNo}" : "")
                                            @(!string.IsNullOrWhiteSpace(l.VinNo) ? $" · ({l.VinNo})" : "")
                                        </small>
                                    </div>
                                }
                            }
                            else
                            {
                                <span>@(o.Imei ?? "—")</span>
                            }
                            @if(!string.IsNullOrWhiteSpace(o.ActivatedAt))
                            {
                                <div><small style="color:#15803d;font-weight:600">Kích hoạt: @o.ActivatedAt</small></div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <TablePager Pager="orderPager" TotalCount="totalOrders" />
</section>

@code {
    private sealed class LineReportInput { public string Imei { get; set; } = ""; public string PlateNo { get; set; } = ""; public string VinNo { get; set; } = ""; }
    private readonly PagerState draftPager = new();
    private readonly PagerState orderLinePager = new();
    private readonly PagerState orderPager = new();
    private List<V7Order> orders = [];
    private List<CustomerVm> customers = [];
    private List<ProductVm> products = [];
    private List<StockVm> inStockUnits = [];
    private List<WarehousePick> warehouses = [];
    private List<InputCatalog.Installer> installers = [];
    private List<InputCatalog.Choice> sellerChoices = [];
    private List<(long Id, string Name)> suppliers = [];
    private readonly List<V7OrderLineDraft> draftLines = [];
    private readonly Dictionary<long, LineReportInput> lineReports = [];

    private bool showQuickPaste;
    private string sellerRawText = "";

    // Create form state
    private long customer, product, draftQty = 1, durationMonths = 12, createWarehouse, createInstallerEmpId, createSellerId;
    private bool cod, createNoDeductStock;
    private string contactName = "", customerPhone = "", saleSource = "", address = "", notes = "";
    private string installAtText = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    private string createSource = "INTERNAL", createInstallerName = "";

    // Edit / Process form state
    private long selected, warehouse, installerEmployeeId, editDurationMonths = 12, editSellerId;
    private bool noDeductStock, editCod;
    private string installer = "", source = "INTERNAL", message = "";
    private string editContactName = "", editCustomerPhone = "", editInstallAt = "", editAddress = "", editNotes = "", editSaleSource = "";
    private DateTime activationDateInput = DateTime.Today;

    private CustomerVm? SelectedCustomer => customers.FirstOrDefault(x => x.Id == customer);
    private V7Order? SelectedOrder => orders.FirstOrDefault(x => x.Id == selected);

    protected override void OnInitialized()
    {
        customers = Db.Customers();
        warehouses = Ops.AllWarehouses();
        installers = Catalog.Installers();
        sellerChoices = Catalog.SellerChoices();
        suppliers = Db.Suppliers();
        if (warehouses.Count > 0)
        {
            createWarehouse = warehouses[0].Id;
            warehouse = warehouses[0].Id;
        }
        if (sellerChoices.Count > 0)
        {
            createSellerId = sellerChoices[0].Id;
            saleSource = sellerChoices[0].Name;
        }
        installAtText = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
        Refresh();
    }

    private void Refresh()
    {
        sellerChoices = Catalog.SellerChoices();
        products = Db.Products();
        inStockUnits = Db.Stock().Where(s => s.Status == "IN_STOCK").ToList();
        orders = Orders.List();
        SyncSelectedOrderLines();
    }

    private void FillSampleSellerText()
    {
        sellerRawText = "HTX Nam Hi\nThông tin khách \n   - Họ tên khách: Lâm Hằng ( xe Đỗ Văn Hội)\n   - Số điện thoại khách: 0886287429\nThông tin lắp đặt: \n   - Số lượng lắp: 1\n   - Thời hạn: 1 năm \n   - Địa chỉ lắp: 55 đường 30/4\n   - Thời gian lắp: 15g00 thứ 3 ( 20/10/2026)\n   - Ghi chú: không thu tiền, khi đến địa chỉ lắp liên hệ sdt: 0886287429";
        ParseSellerText();
    }

    private void ParseSellerText()
    {
        if (string.IsNullOrWhiteSpace(sellerRawText)) return;
        var lines = sellerRawText.Replace("\r", "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        foreach (var rawLine in lines)
        {
            var line = rawLine.TrimStart('-', '+', '*', '•', ' ');
            var lower = line.ToLowerInvariant();
            int colonIdx = line.IndexOf(':');
            string val = colonIdx >= 0 ? line[(colonIdx + 1)..].Trim() : "";

            if (lower.StartsWith("họ tên khách") || lower.StartsWith("tên khách"))
            {
                contactName = val;
            }
            else if (lower.StartsWith("số điện thoại") || lower.StartsWith("sđt") || lower.StartsWith("sdt"))
            {
                customerPhone = val;
            }
            else if (lower.StartsWith("số lượng"))
            {
                var digits = new string(val.Where(char.IsDigit).ToArray());
                if (long.TryParse(digits, out var q) && q > 0)
                {
                    draftQty = q;
                    if (draftLines.Count == 1) draftLines[0] = draftLines[0] with { Quantity = q };
                }
            }
            else if (lower.StartsWith("thời hạn"))
            {
                var digits = new string(val.Where(char.IsDigit).ToArray());
                if (int.TryParse(digits, out var n) && n > 0)
                {
                    durationMonths = lower.Contains("tháng") ? n : n * 12;
                }
            }
            else if (lower.StartsWith("địa chỉ"))
            {
                address = val;
            }
            else if (lower.StartsWith("thời gian"))
            {
                installAtText = val;
            }
            else if (lower.StartsWith("ghi chú"))
            {
                notes = val;
                if (val.Contains("không thu tiền", StringComparison.OrdinalIgnoreCase))
                    cod = false;
                else if (val.Contains("thu hộ", StringComparison.OrdinalIgnoreCase) || val.Contains("cod", StringComparison.OrdinalIgnoreCase))
                    cod = true;
            }
            else if (colonIdx < 0 && !lower.Contains("thông tin"))
            {
                var matchedCust = customers.FirstOrDefault(c =>
                    c.Name.Contains(line, StringComparison.OrdinalIgnoreCase) ||
                    line.Contains(c.Name, StringComparison.OrdinalIgnoreCase) ||
                    c.Code.Equals(line, StringComparison.OrdinalIgnoreCase));
                if (matchedCust is not null)
                {
                    customer = matchedCust.Id;
                    if (matchedCust.SellerId is > 0)
                        createSellerId = matchedCust.SellerId.Value;
                    if (string.IsNullOrWhiteSpace(saleSource))
                        saleSource = !string.IsNullOrWhiteSpace(matchedCust.Source) ? matchedCust.Source : matchedCust.Name;
                }
            }
        }
        if (product == 0 && draftLines.Count == 0)
        {
            var firstGoods = products.FirstOrDefault(p => p.IsSerialized && p.StockInHand > 0) ?? products.FirstOrDefault(p => p.IsSerialized);
            if (firstGoods is not null) product = firstGoods.Id;
        }
        message = "Đã tự động điền thông tin từ tin nhắn Seller. Vui lòng kiểm tra sản phẩm lắp đặt và bấm '+ Tạo đơn hàng (SO)'.";
    }

    private void OnCustomerChanged()
    {
        var c = customers.FirstOrDefault(x => x.Id == customer);
        if (c is not null)
        {
            if (string.IsNullOrWhiteSpace(customerPhone)) customerPhone = c.Phone;
            if (c.SellerId is > 0)
            {
                createSellerId = c.SellerId.Value;
                var sl = sellerChoices.FirstOrDefault(s => s.Id == c.SellerId.Value);
                saleSource = sl is not null ? sl.Name : c.Source;
            }
            else if (string.IsNullOrWhiteSpace(saleSource))
            {
                saleSource = c.Source;
            }
            if (string.IsNullOrWhiteSpace(address) && !string.IsNullOrWhiteSpace(c.Address)) address = c.Address;
        }
    }

    private void OnCreateSellerChanged()
    {
        var sl = sellerChoices.FirstOrDefault(x => x.Id == createSellerId);
        if (sl is not null)
        {
            saleSource = sl.Name;
        }
    }

    private void OnEditSellerChanged()
    {
        var sl = sellerChoices.FirstOrDefault(x => x.Id == editSellerId);
        if (sl is not null)
        {
            editSaleSource = sl.Name;
        }
    }

    private void OnCreateSourceChanged(ChangeEventArgs e)
    {
        createSource = e.Value?.ToString() == "PARTNER" ? "PARTNER" : "INTERNAL";
        if (createSource == "INTERNAL")
        {
            createNoDeductStock = false;
        }
    }

    private void OnCreateInstallerEmpChanged()
    {
        var emp = installers.FirstOrDefault(x => x.Id == createInstallerEmpId);
        if (emp is not null) createInstallerName = emp.Name;
    }

    private void OnCreateManufacturerPick(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(val)) createInstallerName = val;
    }

    private void OnCreateNoDeductChanged(ChangeEventArgs e)
    {
        var wantNoDeduct = e.Value is bool b && b;
        if (wantNoDeduct && createSource != "PARTNER")
        {
            createSource = "PARTNER";
            createInstallerEmpId = 0;
            message = "Lưu ý: Chế độ 'Không trừ tồn kho' yêu cầu Đơn vị lắp đặt phải là Hãng lắp đặt. Đã chuyển phân loại sang 'Hãng lắp đặt', vui lòng chọn/nhập tên Hãng.";
        }
        createNoDeductStock = wantNoDeduct;
    }

    private void OnEditSourceChanged(ChangeEventArgs e)
    {
        source = e.Value?.ToString() == "PARTNER" ? "PARTNER" : "INTERNAL";
        if (source == "INTERNAL")
        {
            noDeductStock = false;
        }
    }

    private void OnEditManufacturerPick(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(val))
        {
            installerEmployeeId = 0;
            installer = val;
        }
    }

    private void OnEditNoDeductChanged(ChangeEventArgs e)
    {
        var wantNoDeduct = e.Value is bool b && b;
        if (wantNoDeduct && source != "PARTNER")
        {
            source = "PARTNER";
            installerEmployeeId = 0;
            message = "Lưu ý: Chế độ 'Không trừ tồn kho' bắt buộc Đơn vị lắp đặt phải là Hãng lắp đặt. Vui lòng chọn/nhập tên Hãng lắp đặt.";
        }
        noDeductStock = wantNoDeduct;
    }

    private void SetInstallAtNow()
    {
        installAtText = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    }

    private void OnInstallAtChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString()?.Trim() ?? "";
        installAtText = string.IsNullOrWhiteSpace(val)
            ? DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
            : V7Orders.FormatInstallDateTime(val);
    }

    private void AddDraftLine()
    {
        if (product <= 0 || draftQty <= 0) { message = "Hãy chọn sản phẩm và số lượng hợp lệ."; return; }
        var existingIdx = draftLines.FindIndex(x => x.ProductId == product);
        if (existingIdx >= 0)
            draftLines[existingIdx] = new V7OrderLineDraft(product, draftLines[existingIdx].Quantity + draftQty);
        else
            draftLines.Add(new V7OrderLineDraft(product, draftQty));
        product = 0;
        draftQty = 1;
        message = "";
    }

    private void UpdateDraftQty(int index, object? val)
    {
        if (index >= 0 && index < draftLines.Count && long.TryParse(val?.ToString(), out var q) && q > 0)
            draftLines[index] = draftLines[index] with { Quantity = Math.Min(100, q) };
    }

    private void RemoveDraftLine(int index)
    {
        if (index >= 0 && index < draftLines.Count) draftLines.RemoveAt(index);
    }

    private void SelectOrderRow(long id)
    {
        selected = id;
        OnOrderSelected();
    }

    private void OnOrderSelected()
    {
        var o = SelectedOrder;
        if (o is not null)
        {
            warehouse = o.WarehouseId ?? (warehouses.FirstOrDefault()?.Id ?? 0);
            installerEmployeeId = o.InstallerEmployeeId ?? 0;
            installer = o.Installer ?? "";
            source = o.Source;
            noDeductStock = !o.DeductStock;
            editSellerId = o.SellerRecordId ?? 0;
            editSaleSource = o.SaleSource;
            editContactName = o.ContactName;
            editCustomerPhone = o.CustomerPhone;
            editDurationMonths = o.DurationMonths > 0 ? o.DurationMonths : 12;
            editInstallAt = o.InstallAt;
            editAddress = o.InstallAddress;
            editNotes = o.Notes;
            editCod = o.Cod;
            if (!string.IsNullOrWhiteSpace(o.ActivatedAt) && DateTime.TryParse(o.ActivatedAt, out var actDt))
                activationDateInput = actDt.Date;
            else
                activationDateInput = DateTime.Today;
            SyncSelectedOrderLines();
        }
    }

    private void SyncSelectedOrderLines()
    {
        lineReports.Clear();
        var o = SelectedOrder;
        if (o is null) return;
        foreach (var ln in o.Lines)
        {
            var defaultVin = !string.IsNullOrWhiteSpace(ln.VinNo) ? ln.VinNo : o.ContactName;
            lineReports[ln.Id] = new LineReportInput { Imei = ln.Imei ?? "", PlateNo = ln.PlateNo ?? "", VinNo = defaultVin ?? "" };
        }
    }

    private LineReportInput GetOrCreateLineReport(V7OrderLine ln)
    {
        if (!lineReports.TryGetValue(ln.Id, out var r))
        {
            r = new LineReportInput { Imei = ln.Imei ?? "", PlateNo = ln.PlateNo ?? "", VinNo = ln.VinNo ?? "" };
            lineReports[ln.Id] = r;
        }
        return r;
    }

    private void SetLineReport(long lineId, string? imeiVal, string? plateVal, string? vinVal)
    {
        if (!lineReports.TryGetValue(lineId, out var r))
        {
            r = new LineReportInput();
            lineReports[lineId] = r;
        }
        if (imeiVal is not null) r.Imei = imeiVal;
        if (plateVal is not null) r.PlateNo = plateVal;
        if (vinVal is not null) r.VinNo = vinVal;
    }

    private void OnInstallerEmployeeChanged()
    {
        var emp = installers.FirstOrDefault(x => x.Id == installerEmployeeId);
        if (emp is not null) installer = emp.Name;
    }

    private string GetRateLabel(long empId)
    {
        var o = SelectedOrder;
        if (o is not null && o.Lines.Count > 0)
        {
            var total = o.Lines.Sum(l => Catalog.QuoteInstallerRate(empId, l.ProductId) * l.Quantity);
            return $"Tổng công lắp đơn này: {total:N0} ₫";
        }
        return installers.FirstOrDefault(x => x.Id == empId)?.RateSummary ?? "";
    }

    private async Task Act(Func<long, string> fn)
    {
        try
        {
            var actor = await Gate.RequireAsync(Permissions.OrdersView);
            var msg = fn(actor);
            Refresh();
            message = string.IsNullOrWhiteSpace(msg) ? "Thao tác thành công." : msg;
        }
        catch (Exception ex)
        {
            message = "Lỗi: " + ex.Message;
        }
    }

    private Task Create() => Act(actor =>
    {
        var items = draftLines.ToList();
        if (product > 0 && draftQty > 0)
        {
            var existingIdx = items.FindIndex(x => x.ProductId == product);
            if (existingIdx >= 0)
                items[existingIdx] = new V7OrderLineDraft(product, items[existingIdx].Quantity + Math.Max(1, draftQty));
            else
                items.Add(new V7OrderLineDraft(product, Math.Max(1, draftQty)));
        }
        var formattedWhen = V7Orders.FormatInstallDateTime(installAtText);
        if (string.IsNullOrWhiteSpace(formattedWhen)) formattedWhen = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
        var isPartner = createSource == "PARTNER";
        var deduct = !createNoDeductStock;
        var createdId = Orders.CreateMulti(
            actor,
            customer,
            items,
            address,
            notes,
            cod,
            customerPhone,
            formattedWhen,
            saleSource,
            contactName,
            durationMonths,
            createWarehouse > 0 ? createWarehouse : null,
            isPartner,
            createInstallerName,
            createInstallerEmpId > 0 ? createInstallerEmpId : null,
            deduct,
            createSellerId > 0 ? createSellerId : null);
        draftLines.Clear();
        product = 0;
        draftQty = 1;
        selected = createdId;
        OnOrderSelected();
        return $"Đã tạo đơn SO7-{createdId:000000} (chưa trừ tồn kho). Khi ĐV lắp đặt gửi IMEI về, hãy nhập IMEI, chọn Ngày kích hoạt và bấm '3. Hoàn thành đơn & Kích hoạt IMEI'.";
    });

    private Task SaveOrderAndDispatch() => Act(actor =>
    {
        if (selected <= 0) throw new InvalidOperationException("Vui lòng chọn đơn hàng.");
        Orders.UpdateOrderInfo(
            actor,
            selected,
            editContactName,
            editCustomerPhone,
            editAddress,
            editInstallAt,
            editDurationMonths,
            editNotes,
            editCod,
            warehouse > 0 ? warehouse : null,
            source == "PARTNER",
            installer,
            installerEmployeeId > 0 ? installerEmployeeId : null,
            !noDeductStock,
            editSellerId > 0 ? editSellerId : null,
            editSaleSource);
        return $"Đã cập nhật thông tin & điều phối đơn SO7-{selected:000000} (Tồn kho chỉ trừ khi bấm Hoàn thành đơn).";
    });

    private Task Report() => Act(actor =>
    {
        if (selected <= 0) throw new InvalidOperationException("Vui lòng chọn đơn hàng.");
        var o = SelectedOrder;
        if (o is not null && o.Status is "PENDING" or "APPROVED")
        {
            if (warehouse > 0) Orders.Approve(actor, selected, warehouse);
            var effInstaller = !string.IsNullOrWhiteSpace(installer) ? installer : "ĐV lắp đặt";
            Orders.Dispatch(actor, selected, source == "PARTNER", effInstaller, installerEmployeeId > 0 ? installerEmployeeId : null, !noDeductStock, warehouse > 0 ? warehouse : null);
        }
        var payload = lineReports.Select(kv => new V7OrderLineReport(kv.Key, kv.Value.Imei, kv.Value.PlateNo, kv.Value.VinNo)).ToList();
        Orders.ReportLines(actor, selected, payload);
        return $"Đã lưu thông tin Số IMEI & Thông tin phụ từ ĐV lắp đặt gửi về cho đơn SO7-{selected:000000}.";
    });

    private Task Complete() => Act(actor =>
    {
        if (selected <= 0) throw new InvalidOperationException("Vui lòng chọn đơn hàng.");
        var o = SelectedOrder ?? throw new InvalidOperationException("Không tìm thấy đơn hàng.");

        // Lưu thông tin cập nhật & điều phối nếu CSKH vừa sửa trên form
        var effInstaller = !string.IsNullOrWhiteSpace(installer)
            ? installer
            : (source == "PARTNER" ? "" : "ĐV lắp đặt nội bộ");
        Orders.UpdateOrderInfo(
            actor,
            selected,
            editContactName,
            editCustomerPhone,
            editAddress,
            editInstallAt,
            editDurationMonths,
            editNotes,
            editCod,
            warehouse > 0 ? warehouse : (warehouses.FirstOrDefault()?.Id ?? null),
            source == "PARTNER",
            effInstaller,
            installerEmployeeId > 0 ? installerEmployeeId : null,
            !noDeductStock,
            editSellerId > 0 ? editSellerId : null,
            editSaleSource);

        if (o.Lines.Any(x => x.IsSerialized))
        {
            var payload = lineReports.Select(kv => new V7OrderLineReport(kv.Key, kv.Value.Imei, kv.Value.PlateNo, kv.Value.VinNo)).ToList();
            Orders.ReportLines(actor, selected, payload);
        }

        var actDateStr = activationDateInput.ToString("yyyy-MM-dd");
        Orders.Complete(actor, selected, actDateStr);
        var expDateStr = activationDateInput.AddMonths((int)(editDurationMonths > 0 ? editDurationMonths : 12)).ToString("dd/MM/yyyy");
        var stockMsg = noDeductStock
            ? $"Không trừ tồn kho (Hãng lắp đặt: {effInstaller})"
            : "Đã trừ số lượng sản phẩm tồn kho";
        return $"Hoàn thành đơn {o.Code}! {stockMsg} · Đã kích hoạt IMEI (Ngày kích hoạt: {activationDateInput:dd/MM/yyyy} → Hết hạn: {expDateStr}).";
    });

    private Task Cancel() => Act(actor =>
    {
        Orders.Cancel(actor, selected);
        return $"Đã hủy đơn SO7-{selected:000000}.";
    });
}
