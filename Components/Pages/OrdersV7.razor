    private Task QuickSoftDeleteOrder(long id) => Act(actor =>
    {
        var res = Orders.SoftDeleteOrder(actor, id);
        if (selected == id) selected = 0;
        showOrderModal = false;
        return res;
    });

    private void OnOrderSelected()
    {
        var o = SelectedOrder;
        if (o is not null)
        {
            editCustomerId = o.CustomerId > 0 ? o.CustomerId : (customers.FirstOrDefault(c => c.Code == o.CustomerCode)?.Id ?? 0);
            warehouse = o.WarehouseId ?? (warehouses.FirstOrDefault()?.Id ?? 0);
            installerEmployeeId = o.InstallerEmployeeId ?? 0;
            installer = o.Installer ?? "";
            source = o.Source;
            noDeductStock = !o.DeductStock;
            editNoInstallFee = o.NoInstallFee || o.OrderKind == "COMMERCIAL";
            editSellerId = o.SellerRecordId ?? 0;
            editSaleSource = o.SaleSource;
            editContactName = o.ContactName;
            editCustomerPhone = o.CustomerPhone;
            editDurationMonths = o.DurationMonths > 0 ? o.DurationMonths : 12;
            editInstallAt = o.InstallAt;
            editAddress = o.InstallAddress;
            editNotes = o.Notes;
            editCod = o.Cod;
            if (!string.IsNullOrWhiteSpace(o.ActivatedAt) && DateTime.TryParse(o.ActivatedAt, out var actDt))
                activationDateInput = actDt.Date;
            else
                activationDateInput = DateTime.Today;

            var matchedDevExp = o.Lines
                .Select(ln => allDevices.FirstOrDefault(d => (ln.ActivationId is > 0 && d.ActivationId == ln.ActivationId.Value) || (!string.IsNullOrWhiteSpace(ln.Imei) && string.Equals(d.Imei, ln.Imei, StringComparison.OrdinalIgnoreCase))))
                .FirstOrDefault(d => d is not null && DateTime.TryParse(d.ExpiresAt, out _));
            if (matchedDevExp is not null && DateTime.TryParse(matchedDevExp.ExpiresAt, out var devExpDt))
                completedOrderExpiresInput = devExpDt.Date;
            else
                completedOrderExpiresInput = activationDateInput.AddMonths((int)editDurationMonths);

            SyncSelectedOrderLines();
        }
    }

    private void OnActivationDateInputChanged()
    {
        completedOrderExpiresInput = activationDateInput.AddMonths((int)(editDurationMonths > 0 ? editDurationMonths : 12));
    }

    private void SyncSelectedOrderLines()
    {
        lineReports.Clear();
        linePriceInputs.Clear();
        renewalLinePrevDates.Clear();
        renewalLineNewDates.Clear();
        var o = SelectedOrder;
        if (o is null) return;
        foreach (var ln in o.Lines)
        {
            var defaultVin = !string.IsNullOrWhiteSpace(ln.VinNo) ? ln.VinNo : o.ContactName;
            lineReports[ln.Id] = new LineReportInput { Imei = ln.Imei ?? "", PlateNo = ln.PlateNo ?? "", VinNo = defaultVin ?? "" };
            linePriceInputs[ln.Id] = ln.UnitPrice;
            if (DateTime.TryParse(ln.PrevExpiry, out var pDt))
                renewalLinePrevDates[ln.Id] = pDt.Date;
            if (DateTime.TryParse(ln.NewExpiry, out var nDt))
                renewalLineNewDates[ln.Id] = nDt.Date;
        }
    }

    private DateTime GetOrInitRenewalLinePrevDate(V7OrderLine ln)
    {
        if (renewalLinePrevDates.TryGetValue(ln.Id, out var dt)) return dt;
        var parsed = DateTime.TryParse(ln.PrevExpiry, out var p) ? p.Date : activationDateInput;
        renewalLinePrevDates[ln.Id] = parsed;
        return parsed;
    }

    private DateTime GetOrInitRenewalLineNewDate(V7OrderLine ln)
    {
        if (renewalLineNewDates.TryGetValue(ln.Id, out var dt)) return dt;
        var parsed = DateTime.TryParse(ln.NewExpiry, out var n) ? n.Date : GetOrInitRenewalLinePrevDate(ln).AddMonths(12);
        renewalLineNewDates[ln.Id] = parsed;
        return parsed;
    }

    private void SetRenewalLinePrevDate(long lineId, string? rawVal)
    {
        if (DateTime.TryParse(rawVal, out var dt))
            renewalLinePrevDates[lineId] = dt.Date;
    }

    private void SetRenewalLineNewDate(long lineId, string? rawVal)
    {
        if (DateTime.TryParse(rawVal, out var dt))
            renewalLineNewDates[lineId] = dt.Date;
    }

    private void BatchExtendRenewalOrderLines(int months)
    {
        if (SelectedOrder is null) return;
        var effCustId = editCustomerId > 0 ? editCustomerId : SelectedOrder.CustomerId;
        foreach (var ln in SelectedOrder.Lines)
        {
            var basePrev = GetOrInitRenewalLinePrevDate(ln);
            var effBase = basePrev > activationDateInput ? basePrev : activationDateInput;
            var nextTarget = effBase.AddMonths(months);
            renewalLineNewDates[ln.Id] = nextTarget;
            if (effCustId > 0)
            {
                linePriceInputs[ln.Id] = Db.PreviewRenewalPriceForDuration(effCustId, ln.ProductId, months, effBase, nextTarget);
            }
        }
    }

    private void OnEditRenewalOrderCustomerChanged()
    {
        if (SelectedOrder is null) return;
        var c = customers.FirstOrDefault(x => x.Id == editCustomerId);
        if (c is not null)
        {
            editSellerId = c.SellerId ?? 0;
            var sl = c.SellerId is > 0 ? sellerChoices.FirstOrDefault(s => s.Id == c.SellerId.Value) : null;
            editSaleSource = sl?.Name ?? "";
            foreach (var ln in SelectedOrder.Lines)
            {
                var prevDt = GetOrInitRenewalLinePrevDate(ln);
                var newDt = GetOrInitRenewalLineNewDate(ln);
                var approxM = Math.Max(1, (int)Math.Round((newDt - prevDt).TotalDays / 30.4375));
                linePriceInputs[ln.Id] = Db.PreviewRenewalPriceForDuration(c.Id, ln.ProductId, approxM, prevDt, newDt);
            }
        }
    }

    private long GetLinePriceInput(V7OrderLine ln) =>
        linePriceInputs.TryGetValue(ln.Id, out var val) ? val : ln.UnitPrice;

    private void SetLinePriceInput(V7OrderLine ln, string? rawVal, bool applySameProduct)
    {
        if (long.TryParse((rawVal ?? "").Trim(), out var parsed) && parsed >= 0)
        {
            linePriceInputs[ln.Id] = parsed;
            if (applySameProduct && SelectedOrder is not null)
            {
                foreach (var other in SelectedOrder.Lines.Where(x => x.ProductId == ln.ProductId))
                    linePriceInputs[other.Id] = parsed;
            }
        }
    }

    private void ApplyPriceToSameProduct(long productId, long unitPrice)
    {
        if (SelectedOrder is null) return;
        foreach (var ln in SelectedOrder.Lines.Where(x => x.ProductId == productId))
            linePriceInputs[ln.Id] = Math.Max(0, unitPrice);
    }

    private void RequoteCompletedLinesFromGroup()
    {
        var o = SelectedOrder;
        if (o is null) return;
        var effCustId = editCustomerId > 0 ? editCustomerId : (o.CustomerId > 0 ? o.CustomerId : (customers.FirstOrDefault(c => c.Code == o.CustomerCode)?.Id ?? 0));
        if (effCustId <= 0) return;
        foreach (var ln in o.Lines)
        {
            linePriceInputs[ln.Id] = Orders.PreviewUnitPrice(effCustId, ln.ProductId, includeInstallPrice: !editNoInstallFee, durationMonths: editNoInstallFee ? 12 : editDurationMonths);
        }
    }

    private void OnEditNoInstallFeeChanged() => RequoteCompletedLinesFromGroup();
    private void OnEditDurationChanged() => RequoteCompletedLinesFromGroup();

    private void OnEditCustomerChanged()
    {
        var c = customers.FirstOrDefault(x => x.Id == editCustomerId);
        if (c is not null)
        {
            if (c.SellerId is > 0)
            {
                editSellerId = c.SellerId.Value;
                var sl = sellerChoices.FirstOrDefault(s => s.Id == c.SellerId.Value);
                if (sl is not null) editSaleSource = sl.Name;
            }
            RequoteCompletedLinesFromGroup();
        }
    }

    private LineReportInput GetOrCreateLineReport(V7OrderLine ln)
    {
        if (!lineReports.TryGetValue(ln.Id, out var r))
        {
            r = new LineReportInput { Imei = ln.Imei ?? "", PlateNo = ln.PlateNo ?? "", VinNo = ln.VinNo ?? "" };
            lineReports[ln.Id] = r;
        }
        return r;
    }

    private void SetLineReport(long lineId, string? imeiVal, string? plateVal, string? vinVal)
    {
        if (!lineReports.TryGetValue(lineId, out var r))
        {
            r = new LineReportInput();
            lineReports[lineId] = r;
        }
        if (imeiVal is not null) r.Imei = imeiVal;
        if (plateVal is not null) r.PlateNo = plateVal;
        if (vinVal is not null) r.VinNo = vinVal;
    }

    private void OnInstallerEmployeeChanged()
    {
        var emp = installers.FirstOrDefault(x => x.Id == installerEmployeeId);
        if (emp is not null) installer = emp.Name;
    }

    private string GetRateLabel(long empId)
    {
        if (editNoInstallFee) return "0 ₫ (Không tính công lắp)";
        var o = SelectedOrder;
        if (o is not null && o.Lines.Count > 0)
        {
            var total = o.Lines.Sum(l => Catalog.QuoteInstallerRate(empId, l.ProductId) * l.Quantity);
            return $"Tổng công lắp: {total:N0} ₫";
        }
        return installers.FirstOrDefault(x => x.Id == empId)?.RateSummary ?? "";
    }

    private async Task Act(Func<long, string> fn)
    {
        try
        {
            var actor = await Gate.RequireAsync(Permissions.OrdersView);
            var msg = fn(actor);
            Refresh();
            message = string.IsNullOrWhiteSpace(msg) ? "Thao tác thành công." : msg;
        }
        catch (Exception ex)
        {
            message = "Lỗi: " + ex.Message;
        }
    }

    private Task CreateOrderSubmit(bool completeImmediately) => Act(actor =>
    {
        var items = draftLines.ToList();
        if (product > 0 && draftQty > 0)
        {
            var existingIdx = items.FindIndex(x => x.ProductId == product && x.TargetActivationId is null && x.CustomUnitPrice == pendingDraftCustomPrice);
            if (existingIdx >= 0)
                items[existingIdx] = items[existingIdx] with { Quantity = items[existingIdx].Quantity + Math.Max(1, draftQty) };
            else
                items.Add(new V7OrderLineDraft(product, Math.Max(1, draftQty), CustomUnitPrice: pendingDraftCustomPrice));
        }

        var isComm = createOrderKind == "COMMERCIAL";
        var formattedWhen = isComm
            ? commercialActivatedDate.ToString("dd/MM/yyyy") + " 08:00:00"
            : V7Orders.FormatInstallDateTime(installAtText);
        if (string.IsNullOrWhiteSpace(formattedWhen)) formattedWhen = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");

        var isPartner = createSource == "PARTNER";
        var deduct = !createNoDeductStock;
        var noInst = EffectiveCreateNoInstallFee;
        var effWh = createWarehouse > 0 ? createWarehouse : (completeImmediately ? warehouses.FirstOrDefault()?.Id : null);

        var createdId = Orders.CreateMulti(
            actor,
            customer,
            items,
            address,
            notes,
            cod,
            customerPhone,
            formattedWhen,
            saleSource,
            contactName,
            durationMonths,
            effWh,
            isPartner,
            createInstallerName,
            isComm ? null : (createInstallerEmpId > 0 ? createInstallerEmpId : null),
            deduct,
            createSellerId > 0 ? createSellerId : null,
            noInst,
            orderKind: isComm ? "COMMERCIAL" : "INSTALL",
            completeImmediately: completeImmediately,
            activatedDate: isComm ? commercialActivatedDate.ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd"));

        draftLines.Clear();
        product = 0;
        draftQty = 1;
        pendingDraftCustomPrice = null;
        pickedPreDeclaredActivationId = 0;
        selected = createdId;
        showCreateModal = false;
        showQuickPaste = false;
        OnOrderSelected();

        var prefix = isComm ? "TM7" : "SO7";
        if (completeImmediately)
            return $"Đã tạo & hoàn thành ngay Đơn thương mại {prefix}-{createdId:000000} (Giá thương mại · Không công lắp · Đã ghi nhận công nợ Kế toán).";
        return $"Đã tạo {(isComm ? "Đơn bán thương mại" : "Đơn lắp đặt")} {prefix}-{createdId:000000} thành công.";
    });

    private Task SaveOrderAndDispatch() => Act(actor =>
    {
        if (selected <= 0) throw new InvalidOperationException("Vui lòng chọn đơn hàng.");
        var o = SelectedOrder ?? throw new InvalidOperationException("Không tìm thấy đơn hàng.");
        var customPrices = o.Lines.Select(ln => (ln.Id, GetLinePriceInput(ln))).ToList();
        Orders.UpdateOrderInfo(
            actor,
            selected,
            editContactName,
            editCustomerPhone,
            editAddress,
            editInstallAt,
            editDurationMonths,
            editNotes,
            editCod,
            warehouse > 0 ? warehouse : null,
            source == "PARTNER",
            installer,
            installerEmployeeId > 0 ? installerEmployeeId : null,
            !noDeductStock,
            editSellerId > 0 ? editSellerId : null,
            editSaleSource,
            editNoInstallFee,
            customPrices);
        return $"Đã lưu thông tin, điều phối & đơn giá cho đơn {o.Code}.";
    });

    private Task Report() => Act(actor =>
    {
        if (selected <= 0) throw new InvalidOperationException("Vui lòng chọn đơn hàng.");
        var o = SelectedOrder ?? throw new InvalidOperationException("Không tìm thấy đơn hàng.");
        if (!o.IsImmutable)
        {
            var customPrices = o.Lines.Select(ln => (ln.Id, GetLinePriceInput(ln))).ToList();
            Orders.UpdateOrderInfo(
                actor,
                selected,
                editContactName,
                editCustomerPhone,
                editAddress,
                editInstallAt,
                editDurationMonths,
                editNotes,
                editCod,
                warehouse > 0 ? warehouse : null,
                source == "PARTNER",
                installer,
                installerEmployeeId > 0 ? installerEmployeeId : null,
                !noDeductStock,
                editSellerId > 0 ? editSellerId : null,
                editSaleSource,
                editNoInstallFee,
                customPrices);
        }
        if (o.Status is "PENDING" or "APPROVED")
        {
            if (warehouse > 0) Orders.Approve(actor, selected, warehouse);
            var effInstaller = !string.IsNullOrWhiteSpace(installer)
                ? installer
                : (editNoInstallFee ? "Bán thương mại (Không lắp đặt)" : "ĐV lắp đặt");
            Orders.Dispatch(actor, selected, source == "PARTNER", effInstaller, installerEmployeeId > 0 ? installerEmployeeId : null, !noDeductStock, warehouse > 0 ? warehouse : null);
        }
        var payload = lineReports.Select(kv => new V7OrderLineReport(kv.Key, kv.Value.Imei, kv.Value.PlateNo, kv.Value.VinNo)).ToList();
        Orders.ReportLines(actor, selected, payload, allowMissingImei: true);
        return $"Đã lưu thông tin Số IMEI & Biển số cho đơn {o.Code}.";
    });

    private Task SaveMainCompletedOrder() => Act(actor =>
    {
        if (selected <= 0) throw new InvalidOperationException("Vui lòng chọn đơn hàng.");
        var o = SelectedOrder ?? throw new InvalidOperationException("Không tìm thấy đơn hàng.");
        var effCustId = editCustomerId > 0 ? editCustomerId : o.CustomerId;
        var actDateStr = activationDateInput.ToString("yyyy-MM-dd");
        var lineEdits = o.Lines.Select(ln =>
        {
            var rep = GetOrCreateLineReport(ln);
            var priceVal = GetLinePriceInput(ln);
            return new V7OrderLineEdit(ln.Id, priceVal, rep.Imei, rep.PlateNo, rep.VinNo);
        }).ToList();

        Orders.UpdateCompletedOrderMain(
            actor,
            selected,
            effCustId,
            editContactName,
            editCustomerPhone,
            editAddress,
            editInstallAt,
            editDurationMonths,
            editNotes,
            editCod,
            warehouse > 0 ? warehouse : null,
            source == "PARTNER",
            installer,
            installerEmployeeId > 0 ? installerEmployeeId : null,
            !noDeductStock,
            editNoInstallFee,
            editSellerId > 0 ? editSellerId : null,
            editSaleSource,
            actDateStr,
            lineEdits);

        showOrderModal = false;
        var newTotal = lineEdits.Sum(le => (le.UnitPriceOverride ?? 0) * (o.Lines.FirstOrDefault(x => x.Id == le.LineId)?.Quantity ?? 1));
        return $"Đã cập nhật đơn hoàn thành {o.Code} (Tổng tiền: {newTotal:N0} ₫) và đồng bộ Hóa đơn công nợ, Hoa hồng & Thiết bị!";
    });

    private Task SaveRenewalOrderChanges() => Act(actor =>
    {
        if (selected <= 0) throw new InvalidOperationException("Vui lòng chọn Đơn gia hạn.");
        var o = SelectedOrder ?? throw new InvalidOperationException("Không tìm thấy Đơn gia hạn.");
        var updates = o.Lines.Select(ln =>
        {
            var rep = GetOrCreateLineReport(ln);
            var prevStr = GetOrInitRenewalLinePrevDate(ln).ToString("yyyy-MM-dd");
            var newStr = GetOrInitRenewalLineNewDate(ln).ToString("yyyy-MM-dd");
            var price = GetLinePriceInput(ln);
            return new V7RenewalOrderLineUpdate(ln.Id, prevStr, newStr, price, rep.PlateNo, rep.VinNo);
        }).ToList();

        var resMsg = Orders.UpdateRenewalOrder(
            actor,
            selected,
            activationDateInput.ToString("yyyy-MM-dd"),
            editSellerId > 0 ? editSellerId : null,
            editSaleSource,
            editNotes,
            updates,
            editCustomerId > 0 ? editCustomerId : null);
        showOrderModal = false;
        return resMsg;
    });

    private Task SaveCompletedOrderImeis() => Act(actor =>
    {
        if (selected <= 0) throw new InvalidOperationException("Vui lòng chọn đơn hàng.");
        var o = SelectedOrder ?? throw new InvalidOperationException("Không tìm thấy đơn hàng.");
        var payload = lineReports.Select(kv => new V7OrderLineReport(kv.Key, kv.Value.Imei, kv.Value.PlateNo, kv.Value.VinNo)).ToList();
        if (payload.All(x => string.IsNullOrWhiteSpace(x.Imei)))
            throw new InvalidOperationException("Vui lòng nhập ít nhất 1 mã IMEI để lưu và kích hoạt.");
        var actDateStr = activationDateInput.ToString("yyyy-MM-dd");
        var customExpIso = completedOrderExpiresInput.ToString("yyyy-MM-dd");
        var newlyActivated = Orders.SupplementCompletedOrderImeis(actor, selected, payload, actDateStr, customExpIso);
        showOrderModal = false;
        var expDateStr = completedOrderExpiresInput.ToString("dd/MM/yyyy");
        return newlyActivated > 0
            ? $"Đã bổ sung & kích hoạt {newlyActivated} IMEI cho đơn {o.Code} (Hết hạn: {expDateStr}, không trừ tồn kho lần 2) — Đã lưu Log."
            : $"Đã cập nhật thông tin IMEI / Biển số / Ngày hết hạn ({expDateStr}) cho đơn {o.Code} — Đã lưu Log.";
    });

    private Task Complete() => Act(actor =>
    {
        if (selected <= 0) throw new InvalidOperationException("Vui lòng chọn đơn hàng.");
        var o = SelectedOrder ?? throw new InvalidOperationException("Không tìm thấy đơn hàng.");

        var effInstaller = !string.IsNullOrWhiteSpace(installer)
            ? installer
            : (source == "PARTNER" ? "" : (editNoInstallFee ? "Bán thương mại (Không lắp đặt)" : "ĐV lắp đặt nội bộ"));
        var customPrices = o.Lines.Select(ln => (ln.Id, GetLinePriceInput(ln))).ToList();
        Orders.UpdateOrderInfo(
            actor,
            selected,
            editContactName,
            editCustomerPhone,
            editAddress,
            editInstallAt,
            editDurationMonths,
            editNotes,
            editCod,
            warehouse > 0 ? warehouse : (warehouses.FirstOrDefault()?.Id ?? null),
            source == "PARTNER",
            effInstaller,
            installerEmployeeId > 0 ? installerEmployeeId : null,
            !noDeductStock,
            editSellerId > 0 ? editSellerId : null,
            editSaleSource,
            editNoInstallFee,
            customPrices);

        var payload = lineReports.Select(kv => new V7OrderLineReport(kv.Key, kv.Value.Imei, kv.Value.PlateNo, kv.Value.VinNo)).ToList();
        if (o.Lines.Any(x => x.IsSerialized))
        {
            Orders.ReportLines(actor, selected, payload, allowMissingImei: true);
        }

        var actDateStr = activationDateInput.ToString("yyyy-MM-dd");
        Orders.Complete(actor, selected, actDateStr);
        showOrderModal = false;
        var expDateStr = activationDateInput.AddMonths((int)(editDurationMonths > 0 ? editDurationMonths : 12)).ToString("dd/MM/yyyy");
        var stockMsg = noDeductStock ? "Không trừ tồn kho (Hãng/NCC)" : "Đã trừ tồn kho";
        var missingCount = o.Lines.Count(l => l.IsSerialized && (!lineReports.TryGetValue(l.Id, out var r) || string.IsNullOrWhiteSpace(r.Imei)));
        if (missingCount > 0)
            return $"Hoàn thành đơn {o.Code}! {stockMsg} · Hiện còn {missingCount} thiết bị chờ bổ sung IMEI.";
        return $"Hoàn thành đơn {o.Code}! {stockMsg} · Đã kích hoạt IMEI (Hết hạn: {expDateStr}).";
    });

    private Task Cancel() => Act(actor =>
    {
        var targetId = selected;
        var code = SelectedOrder?.Code ?? $"#{targetId}";
        var wasHardDelete = isMainDev;
        Orders.Cancel(actor, targetId);
        showOrderModal = false;
        if (wasHardDelete)
        {
            selected = 0;
            return $"Đã hủy & xóa cứng hoàn toàn đơn {code} và đồng bộ hoàn trả thiết bị IMEI / tồn kho về lại Kho.";
        }
        return $"Đã hủy đơn {code} và giải phóng toàn bộ IMEI / thiết bị về lại Kho để thực hiện đơn khác.";
    });
