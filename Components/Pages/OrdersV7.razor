@if(canViewLog)
{
    <SystemLogModal IsOpen="showLogModal"
                    OnClose="() => showLogModal = false"
                    Title="Lịch sử &amp; Lưu vết — Đơn hàng (Lắp đặt · Thương mại · Gia hạn)"
                    ScopedTables="@orderLogTables"
                    ScopedAuditEntities="@orderAuditEntities"
                    InitialTable="@logInitialTable"
                    InitialRecordId="@logInitialRecordId" />
}

@code {
    [SupplyParameterFromQuery(Name = "create")] public string? QueryCreateKind { get; set; }
    [SupplyParameterFromQuery(Name = "deviceId")] public long? QueryDeviceId { get; set; }

    private sealed class LineReportInput { public string Imei { get; set; } = ""; public string PlateNo { get; set; } = ""; public string VinNo { get; set; } = ""; }
    private static readonly string[] orderLogTables = ["v7_orders", "v7_order_lines", "v7_order_events", "v7_stock_effects", "renewals"];
    private static readonly string[] orderAuditEntities = ["V7_ORDER", "ORDER", "SALE_ORDER", "RENEWAL"];
    private bool canViewLog, showLogModal, showWorkflowHelp, canTransferOnRenew, canSoftDeleteOrder;
    private string? logInitialTable;
    private long? logInitialRecordId;
    private void OpenModuleLog() { logInitialTable = null; logInitialRecordId = null; showLogModal = true; }
    private readonly PagerState draftPager = new();
    private readonly PagerState orderLinePager = new();
    private readonly PagerState orderPager = new();

    private List<V7Order> orders = [];
    private List<DeviceVm> allDevices = [];
    private List<CustomerVm> customers = [];
    private List<ProductVm> products = [];
    private List<StockVm> inStockUnits = [];
    private List<WarehousePick> warehouses = [];
    private List<InputCatalog.Installer> installers = [];
    private List<InputCatalog.Choice> sellerChoices = [];
    private List<(long Id, string Name)> suppliers = [];
    private readonly List<V7OrderLineDraft> draftLines = [];
    private readonly Dictionary<long, LineReportInput> lineReports = [];

    private bool showQuickPaste, showCreateModal, isMainDev;
    private string createOrderKind = "INSTALL";
    private string sellerRawText = "";
    private string lastHandledQuerySig = "";

    // Search & Filter state for Danh sách Đơn hàng
    private string soKindFilter = "ALL", soSearch = "", soStatusFilter = "ALL", soCustomerFilter = "", soSellerFilter = "";
    private long soWarehouseFilter = 0;

    // Create form state (INSTALL & COMMERCIAL)
    private long customer, product, draftQty = 1, durationMonths = 12, createWarehouse, createInstallerEmpId, createSellerId;
    private long? pendingDraftCustomPrice;
    private long pickedPreDeclaredActivationId;
    private bool cod, createNoDeductStock, createNoInstallFee;
    private string contactName = "", customerPhone = "", saleSource = "", address = "", notes = "";
    private string installAtText = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
    private DateTime commercialActivatedDate = DateTime.Today;
    private string createSource = "INTERNAL", createInstallerName = "";

    // Create form state (3/ RENEWAL)
    private string renewLookupTab = "DUE", renewDeviceSearch = "", renewExpiryMode = "PACKAGE", renewSourceType = "TNM", renewPaymentMethod = "DEBT", renewNotes = "";
    private long renewFilterCustomerId, renewTargetCustomerId, renewSellerId;
    private int renewDurationMonths = 12;
    private DateTime renewOrderDate = DateTime.Today;
    private DateTime renewMilestoneDate = DateTime.Today.AddMonths(12);
    private readonly HashSet<long> selectedRenewIds = [];
    private readonly Dictionary<long, long> renewCustomPrices = [];

    // Edit / Process form state
    private long selected, warehouse, installerEmployeeId, editDurationMonths = 12, editSellerId, editCustomerId;
    private bool noDeductStock, editNoInstallFee, editCod, showOrderModal;
    private string installer = "", source = "INTERNAL", message = "";
    private string editContactName = "", editCustomerPhone = "", editInstallAt = "", editAddress = "", editNotes = "", editSaleSource = "";
    private DateTime activationDateInput = DateTime.Today;
    private DateTime completedOrderExpiresInput = DateTime.Today.AddYears(1);
    private readonly Dictionary<long, long> linePriceInputs = [];
    private readonly Dictionary<long, DateTime> renewalLinePrevDates = [];
    private readonly Dictionary<long, DateTime> renewalLineNewDates = [];

    private bool EffectiveCreateNoInstallFee => createOrderKind == "COMMERCIAL" || createNoInstallFee;
    private CustomerVm? SelectedCustomer => customers.FirstOrDefault(x => x.Id == customer);
    private V7Order? SelectedOrder => orders.FirstOrDefault(x => x.Id == selected);
    private bool CanMainEditCompleted => isMainDev && SelectedOrder is { IsImmutable: true, IsAccountingLocked: false } && SelectedOrder.OrderKind != "RENEWAL";
    private bool IsOrderFieldsLocked => SelectedOrder is not null && SelectedOrder.IsImmutable && !CanMainEditCompleted;

    private List<DeviceVm> PreDeclaredDevices => allDevices.Where(d => d.IsPreDeclared).ToList();
    private List<DeviceVm> ActiveDevicesForRenew => allDevices.Where(d => !d.IsPreDeclared).ToList();

    private static int DaysToDeviceExpiry(DeviceVm x) =>
        DateTime.TryParse(x.ExpiresAt, out var dt) ? (dt.Date - DateTime.Today).Days : -9999;

    private List<DeviceVm> FilteredRenewalDevices
    {
        get
        {
            IEnumerable<DeviceVm> query = renewLookupTab switch
            {
                "DUE" => ActiveDevicesForRenew.Where(d => DaysToDeviceExpiry(d) <= 30),
                "NO_ORDER_DUE" => ActiveDevicesForRenew.Where(d => !d.HasInstallOrder && DaysToDeviceExpiry(d) <= 30),
                _ => ActiveDevicesForRenew
            };
            if (renewFilterCustomerId > 0)
                query = query.Where(d => d.CustomerId == renewFilterCustomerId);
            if (!string.IsNullOrWhiteSpace(renewDeviceSearch))
            {
                var q = renewDeviceSearch.Trim();
                query = query.Where(d => ($"{d.DisplayImei} {d.Plate} {d.VinNo} {d.Customer} {d.AgencyName} {d.OwnerName} {d.OwnerPhone} {d.DeviceTypeLabel} {d.Sku}").Contains(q, StringComparison.OrdinalIgnoreCase));
            }
            return query.OrderBy(DaysToDeviceExpiry).ToList();
        }
    }

    private List<DeviceVm> SelectedRenewalDevicesList =>
        ActiveDevicesForRenew.Where(d => selectedRenewIds.Contains(d.ActivationId)).ToList();

    private long SelectedRenewalTotalVnd =>
        SelectedRenewalDevicesList.Sum(sd => GetRenewCustomPrice(sd.ActivationId, QuoteSingleRenewalAutoPrice(sd)));

    private long EffectivePendingDraftPrice
    {
        get
        {
            if (pendingDraftCustomPrice.HasValue) return pendingDraftCustomPrice.Value;
            if (customer <= 0 || product <= 0) return 0;
            return Orders.PreviewUnitPrice(customer, product, includeInstallPrice: !EffectiveCreateNoInstallFee, durationMonths: EffectiveCreateNoInstallFee ? 12 : durationMonths);
        }
    }

    private long CurrentDraftTotalVnd
    {
        get
        {
            long sum = 0;
            foreach (var item in draftLines)
            {
                var autoP = Orders.PreviewUnitPrice(customer, item.ProductId, includeInstallPrice: !EffectiveCreateNoInstallFee, durationMonths: EffectiveCreateNoInstallFee ? 12 : durationMonths);
                sum += (item.CustomUnitPrice ?? autoP) * item.Quantity;
            }
            if (product > 0 && draftQty > 0)
            {
                sum += EffectivePendingDraftPrice * Math.Max(1, draftQty);
            }
            return sum;
        }
    }

    private bool HasActiveOrderFilter =>
        soKindFilter != "ALL" ||
        !string.IsNullOrWhiteSpace(soSearch) ||
        soStatusFilter != "ALL" ||
        !string.IsNullOrWhiteSpace(soCustomerFilter) ||
        !string.IsNullOrWhiteSpace(soSellerFilter) ||
        soWarehouseFilter > 0;

    private List<V7Order> FilteredOrders => orders.Where(MatchOrderFilter).ToList();

    private bool MatchOrderFilter(V7Order o)
    {
        if (soKindFilter != "ALL" && o.OrderKind != soKindFilter)
            return false;
        if (soStatusFilter == "PROCESSING" && o.Status is not ("PENDING" or "APPROVED" or "DISPATCHED" or "REPORTED"))
            return false;
        if (soStatusFilter == "MISSING_IMEI" && !(o.IsImmutable && o.HasMissingImei))
            return false;
        if (soStatusFilter is not ("ALL" or "PROCESSING" or "MISSING_IMEI") && o.Status != soStatusFilter)
            return false;

        if (!string.IsNullOrWhiteSpace(soCustomerFilter) &&
            !string.Equals(o.CustomerCode, soCustomerFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (!string.IsNullOrWhiteSpace(soSellerFilter) &&
            !(o.SaleSource ?? "").Contains(soSellerFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (soWarehouseFilter > 0 && o.WarehouseId != soWarehouseFilter)
            return false;

        if (!string.IsNullOrWhiteSpace(soSearch))
        {
            var q = soSearch.Trim();
            var lineText = o.Lines is { Count: > 0 }
                ? string.Join(" ", o.Lines.Select(l => $"{l.ProductSku} {l.ProductName} {l.Imei} {l.PlateNo} {l.VinNo} {l.PrevExpiry} {l.NewExpiry}"))
                : "";
            var haystack = $"{o.Code} {o.OrderKindDisplay} {o.Customer} {o.CustomerB2BDisplay} {o.CustomerCode} {o.CustomerGroup} {o.ContactName} {o.CustomerPhone} {o.SaleSource} {o.Product} {o.Imei} {o.PlateNo} {o.InstallAddress} {o.InstallAt} {o.Notes} {o.Warehouse} {o.Installer} {o.StatusDisplay} {o.InstallPriceModeDisplay} {lineText}";
            if (!haystack.Contains(q, StringComparison.OrdinalIgnoreCase))
                return false;
        }
        return true;
    }

