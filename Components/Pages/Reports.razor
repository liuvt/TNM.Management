@attribute [Authorize(Policy = Permissions.ReportsView)]
@page "/reports"
@inject DemoDb Db
@inject PermissionGate Gate
<PageTitle>Báo cáo · TNM</PageTitle>
<div class="page-head"><div><div class="eyebrow">REPORTS / TRACEABILITY</div><h1>Báo cáo & nhật ký hệ thống</h1><p>Truy vết IMEI, phiếu xuất nhập kho, người tác động và lịch sử dữ liệu.</p></div>
<div class="button-group">@if(canInventoryExport){<a class="btn secondary" href="/export/inventory.csv">↓ Báo cáo kho CSV</a>}@if(canFinanceExport){<a class="btn secondary" href="/export/invoices.csv">↓ Công nợ CSV</a>}</div></div>
@if(canLedger){<section class="panel"><div class="panel-head"><div><h2>Sổ nhập / xuất / điều chuyển</h2><p>Giao dịch phát sinh được lưu kể cả sau khi IMEI thay đổi vị trí.</p></div><input class="search-input" @bind="search" @bind:event="oninput" placeholder="IMEI / SKU / người tác động..." /></div>
<div class="table-wrap"><table><thead><tr><th>MÃ GIAO DỊCH</th><th>THỜI GIAN</th><th>NGHIỆP VỤ</th><th>SKU</th><th>IMEI</th><th>ĐỐI TƯỢNG NHẬN</th><th>NGƯỜI THỰC HIỆN</th></tr></thead><tbody>
@foreach(var r in ledger.Where(x=>(x.Imei+x.Sku+x.Target+x.Actor).Contains(search,StringComparison.OrdinalIgnoreCase))){<tr><td>#@r.Id</td><td>@r.At</td><td><span class="chip">@r.Type</span></td><td>@r.Sku</td><td><strong>@r.Imei</strong></td><td>@r.Target</td><td>@r.Actor</td></tr>}
</tbody></table></div></section>}
@if(canAudit){<section class="panel"><div class="panel-head"><div><h2>Audit log</h2><p>Ghi nhận thao tác, bảng dữ liệu bị ảnh hưởng và nội dung thay đổi.</p></div></div>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>THỜI GIAN</th><th>NGƯỜI DÙNG</th><th>HÀNH ĐỘNG</th><th>ĐỐI TƯỢNG</th><th>GHI CHÚ</th></tr></thead><tbody>
@foreach(var a in audit){<tr><td>#@a.Id</td><td>@a.At</td><td>@a.Actor</td><td><span class="chip">@a.Action</span></td><td>@a.Entity</td><td>@a.Details</td></tr>}
</tbody></table></div></section>}
@code {
 private bool canInventoryExport,canFinanceExport,canLedger,canAudit;
 private List<LedgerVm> ledger=[];private List<AuditVm> audit=[];private string search="";
 protected override async Task OnInitializedAsync(){
 canLedger=await Gate.CanAsync(Permissions.InventoryLedgerView);
 canAudit=await Gate.CanAsync(Permissions.ReportsAuditView);
 canInventoryExport=await Gate.CanAsync(Permissions.InventoryLedgerExport);
 canFinanceExport=await Gate.CanAsync(Permissions.FinanceExport);
 if(canLedger)ledger=Db.Ledger();if(canAudit)audit=Db.Audits();
 }
}
