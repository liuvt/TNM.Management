            overflow: hidden !important;
        }
        .name-cell, .wrap-cell {
            min-width: 160px;
        }
        .name-cell *, .wrap-cell *, td[style*="max-width"] * {
            white-space: normal !important;
            overflow-wrap: anywhere !important;
            word-break: break-word !important;
            max-width: 100%;
        }
    </style>
