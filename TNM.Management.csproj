<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TNM.Management</RootNamespace>
    <AssemblyName>TNM.Management</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Data\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Never overwrite production SQLite or keyring when publishing from a dev machine. -->
  <ItemGroup>
    <Content Update="App_Data/**" CopyToPublishDirectory="Never" />
    <None Update="App_Data/**" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
